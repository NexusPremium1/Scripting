register("touchfling", "movement", "Hidden velocity fling (touch)", function()
    if isBound("tf1") then
        unbind("tf1"); unbind("tf2"); unbind("tf3")
        logOk("TouchFling OFF")
        return
    end
    -- detection marker from original script
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        if not rs:FindFirstChild("juisdfj0i32i0eidsuf0iok") then
            local d = Instance.new("Decal")
            d.Name = "juisdfj0i32i0eidsuf0iok"
            d.Parent = rs
        end
    end)
    local movel = 0.1
    local spikeBase = Vector3.zero
    bind("tf1", RunService.Heartbeat:Connect(function()
        local c = lpChar()
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if hrp then
            local vel = hrp.Velocity
            if vel.Magnitude < 5000 then spikeBase = vel end
            hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
        end
    end))
    bind("tf2", RunService.RenderStepped:Connect(function()
        local c = lpChar()
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Velocity = spikeBase
        end
    end))
    bind("tf3", RunService.Stepped:Connect(function()
        local c = lpChar()
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Velocity = spikeBase + Vector3.new(0, movel, 0)
            movel = -movel
        end
    end))
    logOk("TouchFling ON")
end, { "tfling", "hiddenfling" })
