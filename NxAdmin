local espFolder = nil
local espCache = {}
local espNames, espDist = true, true
local espTeamMode = false
local espBoxAlpha = 0

local function ensureEspFolder()
    if not espFolder or not espFolder.Parent then
        espFolder = Instance.new("Folder")
        espFolder.Name = "NexusESP"
        espFolder.Parent = ScreenGui
        espCache = {}
    end
    return espFolder
end

local function espLoop()
    local folder = ensureEspFolder()
    local alive = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root, hum = getRoot(p.Character), getHum(p.Character)
            if root and hum and hum.Health > 0 then
                alive[p] = true
                local vector, onScreen = Camera:WorldToViewportPoint(root.Position)
                local entry = espCache[p]
                if onScreen then
                    if not entry then
                        local box = Instance.new("Frame")
                        box.BackgroundTransparency = 1
                        box.Parent = folder
                        Instance.new("UIStroke", box).Color = theme().accent
                        local tag = Instance.new("TextLabel")
                        tag.Size = UDim2.new(0, 160, 0, 16)
                        tag.Position = UDim2.new(0.5, -80, 0, -18)
                        tag.BackgroundTransparency = 1
                        tag.TextColor3 = theme().accent
                        tag.TextSize = 10
                        tag.Font = Enum.Font.Code
                        tag.TextXAlignment = Enum.TextXAlignment.Center
                        tag.TextStrokeTransparency = 0.4
                        tag.Parent = box
                        espCache[p] = { box = box, tag = tag }
                        entry = espCache[p]
                    end
                    local dist = (Camera.CFrame.Position - root.Position).Magnitude
                    local top = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
                    local btm = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(top.Y - btm.Y)
                    local width = height / 2
                    entry.box.Visible = true
                    entry.box.Size = UDim2.new(0, width, 0, height)
                    entry.box.Position = UDim2.new(0, vector.X - width / 2, 0, vector.Y - height / 2)
                    local stroke = entry.box:FindFirstChildOfClass("UIStroke")
                    if stroke then
                        stroke.Transparency = espBoxAlpha
                        if espTeamMode and p.Team then
                            stroke.Color = p.Team.TeamColor.Color
                        elseif espTeamMode then
                            stroke.Color = Color3.fromRGB(200, 200, 200)
                        else
                            stroke.Color = theme().accent
                        end
                    end
                    local txt = ""
                    if espNames then txt = p.Name end
                    if espDist then txt = txt .. (txt ~= "" and " " or "") .. math.floor(dist) .. "m" end
                    entry.tag.Text = txt
                    entry.tag.Visible = txt ~= ""
                elseif entry then
                    entry.box.Visible = false
                end
            end
        end
    end
    for p, entry in pairs(espCache) do
        if not alive[p] then
            if entry.box then entry.box:Destroy() end
            espCache[p] = nil
        end
    end
end

