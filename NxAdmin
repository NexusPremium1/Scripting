-- EXECUTE
-- ═══════════════════════════════════════════
local history, historyIndex = {}, 0

function executeCommand(text)
    local args = {}
    for word in string.gmatch(text or "", "%S+") do table.insert(args, word) end
    if #args == 0 then return end
    local cmdName = string.lower(args[1])
    local entry = Commands[cmdName]
    if not entry then
        -- fuzzy: find first command containing the input
        local q = cmdName
        local best = nil
        for _, name in ipairs(CommandOrder) do
            if string.find(name, q, 1, true) then best = name break end
        end
        if best then
            entry = Commands[best]
            cmdName = best
        else
            Nexus_Log("Unknown: " .. cmdName, "err")
            return
        end
    end
    Nexus_Log("> " .. text, "dim")
    local rest = {}
    for i = 2, #args do table.insert(rest, args[i]) end
    safeCall(function() entry.payload(rest, entry) end)
end

-- ghost suggestion
local function updateGhost()
    local txt = string.lower(CommandBar.Text)
    if txt == "" then GhostLabel.Text = "" return end
    if Commands[txt] then GhostLabel.Text = "" return end
    for _, name in ipairs(CommandOrder) do
        if string.sub(name, 1, #txt) == txt and name ~= txt then
            GhostLabel.Text = string.sub(name, #txt + 1)
            return
        end
    end
    GhostLabel.Text = ""
end
CommandBar:GetPropertyChangedSignal("Text"):Connect(updateGhost)

-- input keys: tab complete, history
UserInputService.InputBegan:Connect(function(input, gp)
    if not CommandBar:IsFocused() then return end
    if input.KeyCode == Enum.KeyCode.Tab and GhostLabel.Text ~= "" then
        CommandBar.Text = CommandBar.Text .. GhostLabel.Text
        CommandBar.CursorPosition = #CommandBar.Text + 1
        GhostLabel.Text = ""
    elseif input.KeyCode == Enum.KeyCode.Up and #history > 0 then
        historyIndex = math.max(1, historyIndex - 1)
        CommandBar.Text = history[historyIndex]
    elseif input.KeyCode == Enum.KeyCode.Down and #history > 0 then
        historyIndex = math.min(#history + 1, historyIndex + 1)
        CommandBar.Text = historyIndex > #history and "" or history[historyIndex]
    end
end)

CommandBar.FocusLost:Connect(function(enter)
    if enter then
        local txt = CommandBar.Text
        CommandBar.Text = ""
        GhostLabel.Text = ""
        if txt ~= "" then
            table.insert(history, txt)
            historyIndex = #history + 1
            executeCommand(txt)
        end
        task.defer(function() CommandBar:CaptureFocus() end)
    end
end)

