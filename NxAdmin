local themeIndex = 1
local function theme() return THEMES[themeIndex] end

-- registries so theme changes repaint live elements
local ThemeStrokes = {}   -- UIStroke
local ThemeAccents = {}   -- TextLabel/TextButton using accent color
local ThemeAccentBG = {}  -- frames/buttons tinted with accent (low alpha via blend)
local function bindStroke(s) table.insert(ThemeStrokes, s) end
local function bindAccent(t) table.insert(ThemeAccents, t) end

local function applyTheme()
    local t = theme()
    for _, s in ipairs(ThemeStrokes) do
        if s.Parent then s.Color = t.accent end
    end
    for _, o in ipairs(ThemeAccents) do
        if o.Parent then o.TextColor3 = t.accent end
    end
end

