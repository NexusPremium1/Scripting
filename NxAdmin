local toastOrder = 0
local function toast(msg, kind)
    toastOrder += 1
    local accent = kind == "err" and C.err or kind == "warn" and C.warn or theme().accent
    local t = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = C.topbar,
        BorderSizePixel = 0,
        LayoutOrder = toastOrder,
        ZIndex = 101,
    }, ToastHolder)
    Round(t, 9)
    Stroke(t, accent, 1, 0.25)
    New("Frame", {
        Size = UDim2.new(0, 3, 1, -12),
        Position = UDim2.new(0, 5, 0, 6),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        ZIndex = 102,
    }, t)
    local lbl = New("TextLabel", {
        Size = UDim2.new(1, -22, 0, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(msg),
        TextColor3 = C.text,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 102,
    }, t)
    -- auto size
    task.defer(function()
        local ts = TextService:GetTextSize(lbl.Text, 12, lbl.Font, Vector2.new(lbl.AbsoluteSize.X - 8, 1000))
        local h = math.max(30, ts.Y + 14)
        lbl.Size = UDim2.new(1, -22, 0, ts.Y + 4)
        lbl.Position = UDim2.new(0, 14, 0, (h - ts.Y - 4) / 2)
        t.Size = UDim2.new(1, 0, 0, h)
    end)
    t.BackgroundTransparency = 1
    lbl.TextTransparency = 1
    TweenService:Create(t, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { BackgroundTransparency = 0 }):Play()
    TweenService:Create(lbl, TweenInfo.new(0.22), { TextTransparency = 0 }):Play()
    task.delay(3.4, function()
        if not t.Parent then return end
        local out = TweenService:Create(t, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), { BackgroundTransparency = 1 })
        local out2 = TweenService:Create(lbl, TweenInfo.new(0.25), { TextTransparency = 1 })
        out:Play(); out2:Play()
        out.Completed:Wait()
        t:Destroy()
    end)
end

