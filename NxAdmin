register("tracers", "visual", "Screen tracers to players", function()
    if isBound("tracers") then
        unbind("tracers")
        local f = ScreenGui:FindFirstChild("NexusTracers")
        if f then f:Destroy() end
        logOk("Tracers OFF")
        return
    end
    local folder = Instance.new("Folder")
    folder.Name = "NexusTracers"
    folder.Parent = ScreenGui
    local lines = {}
    bind("tracers", RunService.RenderStepped:Connect(function()
        local camPos = Camera.CFrame.Position
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local root = getRoot(p.Character)
                local hum = getHum(p.Character)
                if root and hum and hum.Health > 0 then
                    local vp, on = Camera:WorldToViewportPoint(root.Position)
                    if on then
                        local line = lines[p]
                        if not line then
                            line = Instance.new("Frame")
                            line.AnchorPoint = Vector2.new(0.5, 1)
                            line.BackgroundColor3 = theme().accent
                            line.BorderSizePixel = 0
                            line.BackgroundTransparency = 0.35
                            line.ZIndex = 5
                            line.Parent = folder
                            lines[p] = line
                        end
                        local sx, sy = vp.X, vp.Y
                        local bx, by = Camera.ViewportSize.X / 2, Camera.ViewportSize.Y
                        local dx, dy = sx - bx, sy - by
                        local len = math.sqrt(dx * dx + dy * dy)
                        line.Size = UDim2.new(0, 2, 0, len)
                        line.Position = UDim2.new(0, bx, 0, by)
                        line.Rotation = math.deg(math.atan2(dy, dx)) - 90
                        line.Visible = true
                    elseif lines[p] then
                        lines[p].Visible = false
                    end
                end
            end
        end
        for p, line in pairs(lines) do
            if not p.Parent or not p.Character then
                line:Destroy(); lines[p] = nil
            end
        end
    end))
    logOk("Tracers ON")
end)

