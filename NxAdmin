register("btools", "tools", "Building tools (clone/delete/anchor)", function()
    local char = lpChar()
    if not char then return end
    if char:FindFirstChild("NexusBTools") then
        char.NexusBTools:Destroy(); logOk("BTools OFF"); return
    end
    local folder = Instance.new("Folder")
    folder.Name = "NexusBTools"
    local function makeTool(name, tip)
        local t = Instance.new("Tool")
        t.Name = name
        t.CanBeDropped = false
        local h = Instance.new("Part")
        h.Name = "Handle"
        h.Size = Vector3.new(1, 1, 1)
        h.Color = Color3.fromRGB(40, 40, 40)
        h.Anchored = false
        h.CanCollide = false
        h.Parent = t
        t.Activated:Connect(function()
            if not Mouse.Hit then return end
            if name == "Clone" then
                local c = Mouse.Hit.Target:Clone()
                c.CFrame = Mouse.Hit.Target.CFrame + Vector3.new(3, 0, 0)
                c.Parent = Workspace
            elseif name == "Delete" then
                Mouse.Hit.Target:Destroy()
            elseif name == "Anchor" then
                Mouse.Hit.Target.Anchored = not Mouse.Hit.Target.Anchored
            elseif name == "Unanchor" then
                Mouse.Hit.Target.Anchored = false
            elseif name == "Resize" then
                Mouse.Hit.Target.Size = Mouse.Hit.Target.Size + Vector3.new(2, 2, 2)
            end
        end)
        t.Parent = folder
    end
    makeTool("Clone")
    makeTool("Delete")
    makeTool("Anchor")
    makeTool("Unanchor")
    makeTool("Resize")
    folder.Parent = char
    logOk("BTools ON (5 tools in backpack folder)")
end, { "unbtools" })

