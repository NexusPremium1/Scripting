register("pathfindwalktowaypoint", "teleport", "Pathfind to waypoint <name>", function(args)
    local name = args[1] and string.lower(args[1])
    if not name or not waypoints[name] then logErr("Waypoint not found") return end
    local target = waypoints[name].Position
    local h, r = lpHum(), lpRoot()
    if not h or not r then logErr("No character") return end
    task.spawn(function()
        local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
        local ok = pcall(function() path:ComputeAsync(r.Position, target) end)
        if not ok or path.Status ~= Enum.PathStatus.Success then
            h:MoveTo(target)
            return
        end
        for _, wp in ipairs(path:GetWaypoints()) do
            h:MoveTo(wp.Position)
            if wp.Action == Enum.PathWaypointAction.Jump then h.Jump = true end
            local done = false
            local c
            c = h.MoveToFinished:Connect(function() done = true end)
            local t0 = os.clock()
            while not done and os.clock() - t0 < 4 do task.wait(0.1) end
            if c then c:Disconnect() end
        end
        logOk("Pathfind → " .. name)
    end)
end, { "pathfindwalktowp" })

