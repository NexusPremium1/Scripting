    bind("nccam", RunService.RenderStepped:Connect(function()
        local char = lpChar()
        local head = char and char:FindFirstChild("Head")
        if not head then return end
        local cf = Camera.CFrame
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char }
        local delta = cf.Position - head.Position
        if delta.Magnitude < 0.5 then return end
        local hit = Workspace:Raycast(head.Position, delta, params)
        if hit then
            local newDist = math.max(0.5, (hit.Position - head.Position).Magnitude - 0.5)
            local dir = delta.Unit
            local np = head.Position + dir * newDist
            Camera.CFrame = CFrame.new(np, np + cf.LookVector)
        end
    end))
    logOk("NoclipCam ON")
end, { "nccam" })

