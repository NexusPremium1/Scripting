    if isBound("silent") then unbind("silent"); logOk("SilentAim OFF") return end
    bind("silent", RunService.RenderStepped:Connect(function()
        local best, bestDist = nil, math.huge
        local mouse = UserInputService:GetMouseLocation()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local head = p.Character:FindFirstChild("Head")
                local h = getHum(p.Character)
                if head and h and h.Health > 0 then
                    local vp, on = Camera:WorldToViewportPoint(head.Position)
                    if on then
                        local d = (Vector2.new(vp.X, vp.Y) - mouse).Magnitude
                        if d < bestDist then bestDist = d; best = head end
                    end
                end
            end
        end
        if best and bestDist < 350 then
            local pos = Camera.CFrame.LookVector:Lerp((best.Position - Camera.CFrame.Position).Unit, 0.35)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + pos)
        end
    end))
    logOk("SilentAim ON")
