register("walkto", "teleport", "Walk to <player> (pathfind)", function(args)
    local found = findPlayer(args[1])
    if not found then logErr("Player not found") return end
    unbind("walkto")
    local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
    bind("walkto", task.spawn(function()
        while isBound("walkto") do
            local root, tr = lpRoot(), getRoot(found.Character)
            if root and tr then
                local ok = pcall(function()
                    path:ComputeAsync(root.Position, tr.Position)
                end)
                if ok and path.Status == Enum.PathStatus.Success then
                    local waypoints = path:GetWaypoints()
                    for _, wp in ipairs(waypoints) do
                        if not isBound("walkto") then break end
                        local h = lpHum()
                        if h then h:MoveTo(wp.Position) end
                        if wp.Action == Enum.PathWaypointAction.Jump then
                            if h then h.Jump = true end
                        end
                        local reached = false
                        local conn2
                        conn2 = h and h.MoveToFinished:Connect(function() reached = true end)
                        local t0 = os.clock()
                        while not reached and os.clock() - t0 < 4 do task.wait(0.1) end
                        if conn2 then conn2:Disconnect() end
                        if not isBound("walkto") then break end
                    end
                end
            end
            task.wait(1)
        end
    end))
    logOk("WalkTo → " .. found.Name)
end)
