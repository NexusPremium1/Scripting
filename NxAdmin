-- ═══ ANIMATION-BASED JERK (from Nexus Premium Hub) ═══
local jerkTrack = nil
local jerkTarget = nil
local jerkChar = nil

local function jerkStop()
    if jerkTrack then
        pcall(function() jerkTrack:Stop() end)
        jerkTrack = nil
    end
    jerkTarget = nil
    jerkChar = nil
end

register("jerk", "fun", "Jerk anim (self or <player>)", function(args)
    if isBound("jerk") then
        unbind("jerk")
        jerkStop()
        logOk("Jerk OFF")
        return
    end
    local target = LocalPlayer
    if args[1] then
        local found = findPlayer(args[1])
        if not found then logErr("Player not found: " .. args[1]) return end
        target = found
    end
    local nextTick = 0
    bind("jerk", RunService.Heartbeat:Connect(function()
        local now = os.clock()
        if now < nextTick then return end
        nextTick = now + 0.05
        local char = target.Character
        local hum = getHum(char)
        if not hum or hum.Health <= 0 then
            jerkStop()
            return
        end
        -- reset track if target/character changed (respawn)
        if jerkTarget ~= target or jerkChar ~= char then
            jerkStop()
        end
        jerkTarget = target
        jerkChar = char
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then return end
        local r15 = hum.RigType == Enum.HumanoidRigType.R15
        if not jerkTrack then
            local anim = Instance.new("Animation")
            anim.AnimationId = r15 and "rbxassetid://698251653" or "rbxassetid://72042024"
            local ok, tr = pcall(function() return animator:LoadAnimation(anim) end)
            if ok and tr then
                jerkTrack = tr
                pcall(function()
                    jerkTrack.Priority = Enum.AnimationPriority.Action4
                    jerkTrack.Looped = true
                end)
            end
        end
        if jerkTrack then
            if not jerkTrack.IsPlaying then
                pcall(function()
                    jerkTrack:Play()
                    jerkTrack:AdjustSpeed(r15 and 2.6 or 2.4)
                end)
            end
            -- keep looping around the middle of the clip (~45%)
            pcall(function()
                local len = jerkTrack.Length
                if len and len > 0 then
                    local mid = len * 0.45
                    if jerkTrack.TimePosition < mid - 0.08 or jerkTrack.TimePosition > mid + 0.35 then
                        jerkTrack.TimePosition = mid
                    end
                else
                    jerkTrack.TimePosition = 0.42
                end
            end)
        end
    end))
    logOk("Jerk ON → " .. target.Name)
end, { "jork" })

register("unjerk", "fun", "Stop jerk", function()
    unbind("jerk")
    jerkStop()
    logOk("Jerk OFF")
end, { "unjork" })

-- ═══ NEXUS PREMIUM HUB FEATURES (GUI-less commands) ═══
local gsRunning = false
local gsAttach = nil
local gsAnim = nil
local gsGravity = nil

local function gsCleanup()
    gsRunning = false
    unbind("getsuck")
    if gsAttach then pcall(function() gsAttach:Disconnect() end) gsAttach = nil end
    if gsAnim then pcall(function() gsAnim:Stop() end) gsAnim = nil end
    if gsGravity then pcall(function() workspace.Gravity = gsGravity end) gsGravity = nil end
end

register("getsuck", "fun", "Get sucked onto <player>", function(args)
    if gsRunning then
        gsCleanup()
        logOk("GetSuck OFF")
        return
    end
    if not args[1] then logErr("Usage: getsuck <player>") return end
    local found = findPlayer(args[1])
    if not found then logErr("Player not found: " .. args[1]) return end
    local char = lpChar()
    local hrp = getRoot(char)
    local targetRoot = found.Character and getRoot(found.Character)
    if not hrp or not targetRoot then logErr("Need both characters alive") return end

    gsRunning = true
    gsGravity = workspace.Gravity
    workspace.Gravity = 0
    local attach = nil

    task.spawn(function()
        -- phase 1: rise
        while gsRunning and hrp.Parent and targetRoot.Parent and hrp.Position.Y <= 44 do
            task.wait()
            if not gsRunning then break end
            hrp.CFrame = hrp.CFrame * CFrame.new(0, 1.5, 0)
        end
        task.wait(1)
        if not gsRunning then return end
        -- phase 2: attach behind target
        attach = RunService.Stepped:Connect(function()
            if gsRunning and hrp.Parent and targetRoot.Parent then
                hrp.CFrame = targetRoot.CFrame * CFrame.new(0, 2.3, -1.1) * CFrame.Angles(0, math.pi, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        end)
        bind("getsuck", attach)
        gsAttach = attach
        task.wait(1)
        if not gsRunning then return end
        -- phase 3: play animation
        local hum = getHum(char)
        local r15 = hum and hum.RigType == Enum.HumanoidRigType.R15
        local anim = Instance.new("Animation")
        anim.AnimationId = r15 and "rbxassetid://5918726674" or "rbxassetid://148840371"
        if hum then
            local animator = hum:FindFirstChildOfClass("Animator") or hum
            pcall(function()
                gsAnim = animator:LoadAnimation(anim)
                gsAnim:Play()
                gsAnim:AdjustSpeed(r15 and 1 or 3)
            end)
        end
    end)
    logOk("GetSuck ON → " .. found.Name)
end, { "getsucked" })

