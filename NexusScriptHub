function Library:MakeLine(Frame: GuiObject, Info)
    local Line = New("Frame", {
        AnchorPoint = Info.AnchorPoint or Vector2.zero,
        BackgroundColor3 = "OutlineColor",
        Position = Info.Position,
        Size = Info.Size,
        ZIndex = Info.ZIndex or Frame.ZIndex,
        Parent = Frame,
    })

    -- v5.8 · thin lines become a little colour accent
    pcall(function()
        local h = Info.Size and Info.Size.Y and Info.Size.Y.Offset or 0
        if h <= 2 then
            Line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            local grad = Instance.new("UIGradient")
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(168, 85, 247)),
                ColorSequenceKeypoint.new(0.45, Color3.fromRGB(96, 165, 250)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(244, 114, 182)),
            })
            grad.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.25),
                NumberSequenceKeypoint.new(0.5, 0.55),
                NumberSequenceKeypoint.new(1, 0.25),
            })
            grad.Parent = Line
        end
    end)

    return Line
end

