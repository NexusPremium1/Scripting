-- Applies all 46 skins in a single pass. Returns: applied, total, missingList
nexusApplyPack46 = function()
	local vm = nexusRefreshViewModels()
	if not vm then
		return 0, #NEXUS_PACK_46, { "ViewModels missing - join a match first" }
	end
	-- clear the applied-cache so pressing the button again re-applies the same skin
	if type(nexusSkinApplied) == "table" then
		for key in pairs(nexusSkinApplied) do nexusSkinApplied[key] = nil end
	end
	local applied, missing = 0, {}
	for _, pair in ipairs(NEXUS_PACK_46) do
		local ok, result = pcall(function() return bj(pair[1], pair[2], true) end)
		if ok and result then
			applied = applied + 1
		else
		table.insert(missing, pair[1])
		end
	end
	if type(go) == "function" then pcall(go) end
	if type(bk) == "function" then
		for _, pair in ipairs(NEXUS_PACK_46) do
			if ai.ActiveSkins[pair[1]] then pcall(function() bk(pair[1], pair[2], true) end) end
		end
	end
	return applied, #NEXUS_PACK_46, missing
end

