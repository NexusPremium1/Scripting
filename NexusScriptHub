-- v6.2 · SMART RAGE BURST:
--   * Fires full RAGE_BURST when enemy is vulnerable & we have clean LOS
--   * INSTANT CEASEFIRE on Katana Deflect / SpaceBlink / Lobby / Chat focus (0 self-kill!)
--   * Controlled single bait shot if enemy is holding Katana waiting to deflect!
task.spawn(function()
	local lastBaitAt = 0
	while not __nexusRivalsUnloaded do
		local liveTarget = rageLockTarget
		local hasTarget = liveTarget and liveTarget.Character and isPlayerAlive(liveTarget) and not isRivalsMateOrImmune(liveTarget)
		if rageModeEnabled and hasTarget then
			local hold = false
			local katanaBait = false
			local dodgeTbl = getgenv and getgenv().NexusDodge
			if type(dodgeTbl) == "table" and type(dodgeTbl.ShouldHoldFire) == "function" then
				local okH, h, bait = pcall(dodgeTbl.ShouldHoldFire, liveTarget)
				if okH then
					hold = (h == true)
					katanaBait = (bait == true)
				end
			end
			local typingNow = false
			pcall(function() typingNow = UserInputService:GetFocusedTextBox() ~= nil end)

			if not hold and not typingNow then
				if katanaBait then
					-- Enemy holds Katana: fire 1 controlled bait shot every 0.35s instead of 10x self-kill burst!
					if tick() - lastBaitAt >= 0.35 then
						lastBaitAt = tick()
						rageClick(liveTarget)
						rageToolActivate()
					end
					task.wait(0.03)
				else
					local shots = math.clamp(tonumber(RAGE_BURST) or 10, 1, 12)
					for _ = 1, shots do
						rageClick(liveTarget)
					end
					rageToolActivate()
					task.wait()
				end
			else
				task.wait(0.025)
			end
		else
			task.wait(0.05)
		end
	end
end)

