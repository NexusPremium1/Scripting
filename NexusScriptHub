	local function SafeServerHop()
		Apex.Toast("Finding fresh server...", getTheme().Primary)
		task.spawn(function()
			pcall(function()
				-- In games with sub-places (like Rivals/DOORS), join root place to avoid Error 773
				local targetPlaceId = game.PlaceId
				if game.GameId == 6035872082 then
					targetPlaceId = 17625359962 -- Rivals main lobby
				elseif game.GameId == 2440500124 then
					targetPlaceId = 6516141723 -- DOORS main lobby
				end

				local url = "https://games.roblox.com/v1/games/" .. tostring(targetPlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
				local res = game:HttpGet(url)
				local data = HttpService:JSONDecode(res)
				if data and data.data then
					for _, s in ipairs(data.data) do
						if s.playing < s.maxPlayers and s.id ~= game.JobId then
							TeleportService:TeleportToPlaceInstance(targetPlaceId, s.id, LocalPlayer)
							return
						end
					end
				end
				TeleportService:Teleport(targetPlaceId, LocalPlayer)
			end)
		end)
	end

