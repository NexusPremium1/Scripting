function Eng.World.StopTornado()
	S.TornadoActive = false
	if S.TornadoConn then
		pcall(function() S.TornadoConn:Disconnect() end)
		S.TornadoConn = nil
	end
	S.TornadoBoat = nil
	Net.DeleteCars()
	notify("FE Tornado", "Tornado stopped and vehicle cleaned up.", 3)
end

function Eng.World.StartTornado()
	if S.TornadoActive then
		Eng.World.StopTornado()
		return
	end
	local root = getRoot()
	local hum = getHum()
	if not root or not hum then return end
	local origCF = root.CFrame
	S.TornadoActive = true
	notify("FE Tornado", "Spawning Pirate Ship Tornado across town...", 3.5)

	trackThread(function()
		pcall(function()
			Net.DeleteCars()
			task.wait(0.25)
			root.CFrame = CFrame.new(1754, 4, 58)
			task.wait(0.35)
			Net.SpawnBoat("PirateFree")
			task.wait(0.95)
			local folder = Eng.Vehicle.GetFolder()
			local boat = folder and folder:FindFirstChild(LocalPlayer.Name .. "Car")
			local seat = Eng.Vehicle.GetSeat(boat)
			if not boat or not seat then
				S.TornadoActive = false
				notify("FE Tornado", "Failed to spawn Pirate Ship.", 3)
				safePivot(getChar(), origCF)
				return
			end
			S.TornadoBoat = boat
			local t0 = os.clock()
			while hum.SeatPart ~= seat and (os.clock() - t0) < 2.5 and S.TornadoActive do
				root.CFrame = seat.CFrame + Vector3.new(0, 1.5, 0)
				pcall(function() seat:Sit(hum) end)
				task.wait(0.08)
			end

			-- Global siren sound burst
			trackThread(function()
				for _ = 1, 3 do
					if not S.TornadoActive or S.Unloaded then break end
					Net.GlobalSound(9068077052)
					task.wait(1.6)
				end
			end)

			-- Periodic flip pulses while active
			trackThread(function()
				while S.TornadoActive and not S.Unloaded and boat and boat.Parent do
					Net.CarEvent("Flip")
					task.wait(0.5)
				end
			end)

			local waypoints = {
				Vector3.new(-16, 4, -47),
				Vector3.new(150, 8, -140),
				Vector3.new(-120, 6, 15),
				Vector3.new(-300, 8, 120),
				Vector3.new(0, 6, 220),
			}
			local idx = 1
			local prog = 0
			local angle = 0
			S.TornadoConn = RunService.Heartbeat:Connect(function(dt)
				if not S.TornadoActive or S.Unloaded or not boat or not boat.Parent then
					if S.TornadoConn then
						S.TornadoConn:Disconnect()
						S.TornadoConn = nil
					end
					return
				end
				local p1 = waypoints[idx]
				local p2 = waypoints[(idx % #waypoints) + 1]
				prog = prog + (dt * 0.28)
				if prog >= 1 then
					prog = 0
					idx = (idx % #waypoints) + 1
				end
				angle = angle + (dt * 9)
				local pos = p1:Lerp(p2, prog)
				safePivot(boat, CFrame.new(pos) * CFrame.Angles(0, angle, 0))
			end)
			trackConn(S.TornadoConn)
		end)
	end)
end

