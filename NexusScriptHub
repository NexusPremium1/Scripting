                local target = p.Character:FindFirstChild(part)
                    or p.Character:FindFirstChild(part:gsub("^%l", string.upper))
                    or p.Character:FindFirstChild("HumanoidRootPart")
                local h = getHum(p.Character)
                if target and h and h.Health > 0 then
                    local vp, on = Camera:WorldToViewportPoint(target.Position)
                    if on then
                        local d = (Vector2.new(vp.X, vp.Y) - mouse).Magnitude
                        if d < bestDist then bestDist = d; best = target end
                    end
                end
            end
        end
