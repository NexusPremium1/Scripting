-- ---- animations ---------------------------------------------------------
local function flyAnimId(raw)
    local num = tostring(raw or ""):match("%d+")
    if not num then return nil end
    return "rbxassetid://" .. num
end

local function flyLoadAnims(hum)
    if not Nexus.Values.FlyAnimated then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        pcall(function()
            animator = Instance.new("Animator")
            animator.Parent = hum
        end)
    end
    if not animator then return end
    local function make(raw, priority)
        local id = flyAnimId(raw)
        if not id then return nil end
        local a = Instance.new("Animation")
        a.AnimationId = id
        table.insert(Nexus.CreatedInstances, a)
        local ok, track = pcall(function() return animator:LoadAnimation(a) end)
        if not ok or not track then return nil end
        pcall(function()
            track.Priority = priority
            track.Looped = true
        end)
        return track
    end
    FlyTracks.Idle = make(Nexus.Values.FlyIdleAnim, Enum.AnimationPriority.Idle)
    FlyTracks.Move = make(Nexus.Values.FlyMoveAnim, Enum.AnimationPriority.Movement)
    FlyTracks.Boost = make(Nexus.Values.FlyBoostAnim, Enum.AnimationPriority.Action)
    for _, track in pairs(FlyTracks) do
        if track then pcall(function() track:AdjustSpeed(Nexus.Values.FlyAnimSpeed or 1) end) end
    end
    if FlyTracks.Idle then pcall(function() FlyTracks.Idle:Play() end) end
end

local function flyStopTracks()
    for _, track in pairs(FlyTracks) do
        if track then pcall(function() track:Stop() end) end
    end
end

local function flyPlay(state)
    local want = (state == "boost" and FlyTracks.Boost)
        or (state == "move" and FlyTracks.Move)
        or FlyTracks.Idle
    if not want then return end
    for _, track in pairs(FlyTracks) do
        if track and track ~= want and track.IsPlaying then
            pcall(function() track:Stop() end)
        end
    end
    if not want.IsPlaying then pcall(function() want:Play() end) end
end

setFly = function(on)
    Nexus.Toggles.Fly = on and true or false
    if Nexus.Connections.Fly then
        pcall(function() Nexus.Connections.Fly:Disconnect() end)
        Nexus.Connections.Fly = nil
    end
    flyCleanup()
    if on and Nexus.Fling.Active then flingCleanup() end
    local char, hrp, hum = getRealChar(), getRealHRP(), getRealHum()
    if not (on and char and hrp and hum) then
        flyProtectDisarm()
        notify("Nexus", "Fly OFF", 1.5)
        return
    end

    flyRestoreMouse()
    flyProtectArm()
    flyLoadAnims(hum)
    flyBuildTrail(hrp)

    local built = pcall(function()
        local att = Instance.new("Attachment")
        att.Name = "NexusFlyAttach"
        att.Parent = hrp
        local lv = Instance.new("LinearVelocity")
        lv.Name = "NexusFlyVelocity"
        lv.Attachment0 = att
        lv.RelativeTo = Enum.ActuatorRelativeTo.World
        lv.MaxForce = math.huge
        lv.VectorVelocity = Vector3.zero
        lv.Parent = hrp
        local ao = Instance.new("AlignOrientation")
        ao.Name = "NexusFlyAlign"
        ao.Attachment0 = att
        ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
        ao.MaxTorque = math.huge
        ao.Responsiveness = 60
        ao.Parent = hrp
        for _, inst in ipairs({ att, lv, ao }) do
            table.insert(FlyParts, inst)
            table.insert(Nexus.CreatedInstances, inst)
        end

        Nexus.Connections.Fly = RunService.RenderStepped:Connect(function()
            if not Nexus.Toggles.Fly then return end
            local r, h = getRealHRP(), getRealHum()
            local cam = Workspace.CurrentCamera
            if not (r and h and cam) then return end
            local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + look end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - look end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end
            local up = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then up = up + 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then up = up - 1 end
            -- phone / joystick: the humanoid already receives MoveDirection from the game
            if dir.Magnitude < 0.01 then
                local md = h.MoveDirection
                if md and md.Magnitude > 0.01 then
                    dir = right * md.X + look * -md.Z
                end
            end
            local moving = dir.Magnitude > 0.01
            local boost = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
            local speed = Nexus.Values.FlySpeed * (boost and 2 or 1)
            local velocity = moving and dir.Unit * speed or Vector3.zero
            velocity = velocity + Vector3.new(0, up * Nexus.Values.FlyUpSpeed, 0)

            if lv and lv.Parent then lv.VectorVelocity = velocity end

            if ao and ao.Parent then
                if moving then
                    -- bank into the turn: cool, and it never fights the camera
                    local roll = Nexus.Values.FlyTilt and math.rad(18) * (dir.Unit:Dot(right)) or 0
                    ao.CFrame = CFrame.lookAt(r.Position, r.Position + dir.Unit) * CFrame.Angles(0, 0, -roll)
                else
                    ao.CFrame = CFrame.new(r.Position, r.Position + look)
                end
            end

            if boost then
                flyPlay(moving and "boost" or "idle")
            elseif moving then
                flyPlay("move")
            else
                flyPlay("idle")
            end
        end)
    end)

    if not built then
        flyCleanup()
        Nexus.Toggles.Fly = false
        notify("Nexus", "Fly needs LinearVelocity support", 2)
        return
    end
    notify("Nexus", "Fly ON - WASD / Space / Ctrl / Shift boost - F toggles", 1.5)
end

