local function fireMusicChannels(mode, strId, isReset)
	local sent = false
	local allSync = (mode == "All 6 (2026 Sync)" or mode == "All 4 (Sync)")
	if allSync or mode == "Car Only" then
		-- 2026 protocol ("Music", id, true) + Legacy protocol ("PickingCarMusicText", id)
		if Net.CarEvent("Music", strId, true) then sent = true end
		if Net.CarEvent("PickingCarMusicText", isReset and "" or strId) then sent = true end
	end
	if allSync or mode == "House Only" then
		if Net.HouseEvent("PickHouseMusicText", strId, true) then sent = true end
		if isReset then Net.HouseEvent("PickHouseMusicText", "") end
	end
	if allSync or mode == "Scooter / Board Only" or mode == "Scooter Only" then
		-- 2026 Gaming_Spirit 4-arg protocol (nil, true) + 3-arg + 2-arg compatibility
		if Net.ScooterEvent("PickingScooterMusicText", strId, nil, true) then sent = true end
		if Net.ScooterEvent("PickingScooterMusicText", strId, true) then sent = true end
		if not isReset then Net.ScooterEvent("PickingScooterMusicText", strId) end
		if isReset then Net.ScooterEvent("PickingScooterMusicText", "") end
	end
	if allSync or mode == "Radio / Boombox Only" or mode == "Radio/Boombox Only" then
		local r = Net.FindRemote(Net.REFolder(), { "PlayerToolEvent", "1Playe1rToo1lEven1t" })
		if r then
			if Net.FireOrInvoke(r, "ToolMusicText", strId, nil, true) then sent = true end
			if Net.FireOrInvoke(r, "ToolMusicText", strId, true) then sent = true end
		end
	end
	if allSync or mode == "Props Only (2026)" then
		if Net.PropEvent("PropMusicText", strId, true) then sent = true end
	end
	if allSync or mode == "Horse Only (2026)" then
		if Net.HorseEvent("HorseMusicText", strId, true) then sent = true end
	end
	return sent
end

function Net.PlayAudio(id, mode)
	local strId = tostring(id or ""):gsub("%D", "")
	if strId == "" then return false end
	mode = mode or S.AudioTarget or "All 6 (2026 Sync)"
	-- 2026 Reset-then-Play handshake prevents Brookhaven stream lockup
	fireMusicChannels(mode, "0", true)
	task.wait(0.18)
	local sent = fireMusicChannels(mode, strId, false)
	if S.AudioMaxVolBoost then
		Net.BoostMainAudioVolume(100)
	end
	return sent
end

function Net.StopAudio(mode)
	mode = mode or "All 6 (2026 Sync)"
	return fireMusicChannels(mode, "0", true)
end

-- Dynamic Multi-Era Brookhaven Gun Sound Remote Resolver (2021-2026)
local GUN_SOUND_EXACT = {
	"1Gu1nSound1s",
	"GunSounds",
	"G1unSounds12458",
	"1GunSound1s",
	"Gun1Sound",
	"GunSound",
	"PlayGunSound",
	"GunSoundEvent",
}

function Net.FindGunSoundRemotes(forceRefresh)
	if not forceRefresh and type(S.GunSoundRemoteCache) == "table" and #S.GunSoundRemoteCache > 0 then
		local valid = {}
		for _, r in ipairs(S.GunSoundRemoteCache) do
			if r and r.Parent then
				table.insert(valid, r)
			end
		end
		if #valid > 0 then
			return valid
		end
	end

	local found = {}
	local seen = {}
	local function addR(r)
		if r and not seen[r] and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
			seen[r] = true
			table.insert(found, r)
		end
	end

	local folders = {
		Net.REFolder(),
		Net.RemotesFolder(),
		ReplicatedStorage:FindFirstChild("RemoteEvents"),
		ReplicatedStorage,
	}

	-- Pass 1: Exact known Brookhaven Gun Sound remote names across RE / Remotes / RemoteEvents
	for _, folder in ipairs(folders) do
		if folder then
			for _, name in ipairs(GUN_SOUND_EXACT) do
				addR(folder:FindFirstChild(name))
			end
		end
	end

	-- Pass 2: Fast targeted scan inside RE / Remotes / RemoteEvents / RS children (avoids 20k-asset RS:GetDescendants freeze!)
	for _, folder in ipairs(folders) do
		if folder then
			for _, d in ipairs(folder:GetChildren()) do
				if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
					local low = string.lower(d.Name)
					local isGunSound = (low:find("gu1n", 1, true) and low:find("sound", 1, true))
						or (low:find("g1un", 1, true) and low:find("sound", 1, true))
						or (low:find("gun", 1, true) and low:find("sound", 1, true))
					if isGunSound then
						addR(d)
					end
				end
			end
		end
	end

	-- Pass 3: Fallback scan inside RE/Remotes for any generic sound remote (excluding music/volume)
	if #found == 0 then
		for _, folder in ipairs({ Net.REFolder(), Net.RemotesFolder() }) do
			if folder then
				for _, c in ipairs(folder:GetChildren()) do
					if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") then
						local low = string.lower(c.Name)
						if low:find("sound", 1, true) and not low:find("music", 1, true) and not low:find("volume", 1, true) then
							addR(c)
						end
					end
				end
			end
		end
	end

	S.GunSoundRemoteCache = found
	return found
end

function Net.InspectSoundRemotes()
	local list = Net.FindGunSoundRemotes(true)
	if #list == 0 then
		return "No GunSound remote detected (RE=" .. tostring(Net.REFolder() ~= nil) .. ", Remotes=" .. tostring(Net.RemotesFolder() ~= nil) .. ")"
	end
	local names = {}
	for i = 1, math.min(#list, 4) do
		local r = list[i]
		local pName = (r.Parent and r.Parent.Name) or "RS"
		table.insert(names, pName .. "." .. r.Name)
	end
	return string.format("Found %d: %s", #list, table.concat(names, ", "))
end

local GUN_TOOL_PRIORITY = {
	"GlockBrown", "Glock", "Assault", "Shotgun", "Sniper",
	"Pistol", "Revolver", "Rifle", "SilencedPistol", "Submachine",
}

local function extractToolHandle(tool)
	if not tool or not tool:IsA("Tool") then return nil end
	local h = tool:FindFirstChild("Handle")
	if h and h:IsA("BasePart") then return h end
	return tool:FindFirstChildWhichIsA("BasePart", true)
end

local function isGunToolName(name)
	local low = string.lower(tostring(name or ""))
	for _, g in ipairs(GUN_TOOL_PRIORITY) do
		if low == string.lower(g) or low:find(string.lower(g), 1, true) then
			return true
		end
	end
	return false
end

function Net.FindGunTool(preferredGun)
	local char = getChar()
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	local containers = {}
	if char then table.insert(containers, char) end
	if bp then table.insert(containers, bp) end

	-- 1. Try exact preferred gun first
	if preferredGun and preferredGun ~= "" and preferredGun ~= "Auto Detect Any Gun" then
		local lowPref = string.lower(preferredGun)
		for _, box in ipairs(containers) do
			local exact = box:FindFirstChild(preferredGun)
			if exact and exact:IsA("Tool") then
				return exact, extractToolHandle(exact)
			end
			for _, child in ipairs(box:GetChildren()) do
				if child:IsA("Tool") and string.lower(child.Name) == lowPref then
					return child, extractToolHandle(child)
				end
			end
		end
	end

	-- 2. Try any known Brookhaven firearm
	for _, gName in ipairs(GUN_TOOL_PRIORITY) do
		local lowG = string.lower(gName)
		for _, box in ipairs(containers) do
			for _, child in ipairs(box:GetChildren()) do
				if child:IsA("Tool") and (string.lower(child.Name) == lowG or string.lower(child.Name):find(lowG, 1, true)) then
					local h = extractToolHandle(child)
					if h then return child, h end
				end
			end
		end
	end

	return nil, nil
end

function Net.EnsureGunHandle(preferredGun, wantEquipped, allowAutoPick)
	preferredGun = preferredGun or S.GlobalSoundGun or "GlockBrown"
	local tool, handle = Net.FindGunTool(preferredGun)

	if (not tool or not handle) and allowAutoPick then
		local pickOrder = {}
		if preferredGun ~= "Auto Detect Any Gun" and preferredGun ~= "" then
			table.insert(pickOrder, preferredGun)
		end
		for _, fallbackGun in ipairs({ "GlockBrown", "Glock", "Sniper", "Assault", "Shotgun" }) do
			if fallbackGun ~= preferredGun then
				table.insert(pickOrder, fallbackGun)
			end
		end

		for _, pickName in ipairs(pickOrder) do
			Net.PickTool(pickName)
			local t0 = os.clock()
			while (os.clock() - t0) < 0.75 do
				tool, handle = Net.FindGunTool(pickName)
				if tool and handle then break end
				task.wait(0.05)
			end
			if tool and handle then break end
		end
	end

	if not tool or not handle then
		return nil, nil
	end

	local char = getChar()
	local hum = getHum()
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")

	if wantEquipped == true then
		if char and tool.Parent ~= char then
			pcall(function()
				if hum then
					hum:EquipTool(tool)
				else
					tool.Parent = char
				end
			end)
			task.wait(0.04)
		end
	elseif wantEquipped == false then
		-- Stealth Backpack Mode (Dec 2025 method: Backpack.<Gun>.Handle)
		if bp and tool.Parent ~= bp then
			pcall(function()
				if hum then hum:UnequipTools() end
				tool.Parent = bp
			end)
		end
	end

	handle = extractToolHandle(tool) or handle
	return handle, tool
end

