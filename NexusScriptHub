Eng.PvP = {}

function Eng.PvP.GetPlayerNames()
	local out = { "(Nearest Enemy)" }
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then table.insert(out, p.Name) end
	end
	table.sort(out, function(a, b)
		if a == "(Nearest Enemy)" then return true end
		if b == "(Nearest Enemy)" then return false end
		return a < b
	end)
	return out
end

function Eng.PvP.FindPlayer(name)
	if not name or name == "" or name == "(Nearest Enemy)" then return nil end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and (p.Name == name or p.DisplayName == name) then
			return p
		end
	end
	return nil
end

function Eng.PvP.NearestEnemyPlayer(maxRange)
	local root = getRoot()
	if not root then return nil end
	local best, bestD = nil, maxRange or 250
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local pr = getRoot(p)
			local ph = getHum(p)
			if pr and ph and ph.Health > 0 then
				local d = (pr.Position - root.Position).Magnitude
				if d < bestD then bestD = d; best = p end
			end
		end
	end
	return best
end

function Eng.PvP.SetSpectate(nameOrNil)
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local p = Eng.PvP.FindPlayer(nameOrNil)
	if not p then
		S.Spectating = nil
		local h = getHum()
		if h then cam.CameraSubject = h end
		return
	end
	local ph = getHum(p)
	if ph then
		S.Spectating = p.Name
		cam.CameraSubject = ph
		notify("Spectate", "Spectating " .. p.DisplayName, 2.5)
	end
end

function Eng.PvP.RestoreHitboxes()
	for part, orig in pairs(S.OrigHitboxes) do
		if part and part.Parent then
			pcall(function()
				part.Size = orig.Size
				part.Transparency = orig.Transparency
			end)
		end
	end
	S.OrigHitboxes = {}
end

function Eng.PvP.UpdateHitboxes()
	if not S.HitboxExpand then
		if next(S.OrigHitboxes) then Eng.PvP.RestoreHitboxes() end
		return
	end
	local sz = Vector3.new(S.HitboxSize, S.HitboxSize, S.HitboxSize)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local rt = getRoot(p)
			local hm = getHum(p)
			if rt and hm and hm.Health > 0 then
				if not S.OrigHitboxes[rt] then
					S.OrigHitboxes[rt] = { Size = rt.Size, Transparency = rt.Transparency }
				end
				pcall(function()
					rt.Size = sz
					rt.Transparency = 0.72
					rt.CanCollide = false
				end)
			end
		end
	end
end

function Eng.PvP.RemoveLava()
	local removed = 0
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("BasePart") and string.lower(d.Name):find("lava") then
			pcall(function()
				d.CanTouch = false
				d.CanCollide = true
			end)
			removed = removed + 1
		end
	end
	notify("Anti-Lava", "Neutralized " .. tostring(removed) .. " lava hazard part(s).", 2.5)
end

function Eng.PvP.TickCombat()
	-- AimLock
	if S.AimLockPlayer then
		local cam = Workspace.CurrentCamera
		local target = Eng.PvP.FindPlayer(S.SelectedPlayer) or Eng.PvP.NearestEnemyPlayer(260)
		if cam and target then
			local ch = getChar(target)
			local head = ch and (ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart"))
			local hum = getHum(target)
			if head and hum and hum.Health > 0 then
				local goal = CFrame.lookAt(cam.CFrame.Position, head.Position)
				cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(S.AimSmooth or 0.45, 0.05, 1))
			end
		end
	end

	-- PvP Kill Aura (uses Fast Attack v2!)
	if S.KillAura then
		local now = os.clock()
		if (now - S.LastFastAtk) >= (S.FastAttackDelay or 0.08) then
			S.LastFastAtk = now
			Eng.Combat.EnsureBuffs()
			Net.FastAttackBurst(S.KillAuraRange, S.KillAuraMobs, S.KillAuraPlayers)
		end
	end

	-- No Dash Cooldown / Instant Dash Boost
	if S.NoDashCooldown then
		local ch = getChar()
		if ch then
			pcall(function()
				ch:SetAttribute("DashLength", 35)
				ch:SetAttribute("DashCooldown", 0)
			end)
		end
	end
end

Eng.Stats = {}

function Eng.Stats.SpendTick()
	if not S.AutoStats then return end
	local pts = getStatPoints()
	if pts <= 0 then return end
	local batch = math.min(pts, math.max(1, math.floor(S.StatPointsPerTick or 3)))
	Net.Comm("AddPoint", S.StatTarget or "Melee", batch)
end

function Eng.Stats.RedeemList(codeList, label)
	trackThread(function()
		local tried = 0
		for _, code in ipairs(codeList) do
			if S.Unloaded then return end
			Net.RedeemCode(code)
			tried = tried + 1
			task.wait(0.28)
		end
		notify("Codes Redeemed", string.format("Submitted %d %s code(s)!", tried, tostring(label or "Blox Fruits")), 3.5)
	end)
end

