			for _, obj in ipairs(Lighting:GetChildren()) do
				if (obj:IsA("Sky") or obj:IsA("Atmosphere") or obj:IsA("ColorCorrectionEffect")) and not string.find(obj.Name, "NexusDramatic", 1, true) then
