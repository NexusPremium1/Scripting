local function disableBypassForFling()
    if not Nexus.Toggles.Bypass and LocalPlayer.Character ~= fakeChar then return end
    Nexus.Toggles.Bypass = false
    local char, hum = getRealChar(), getRealHum()
    if LocalPlayer.Character == fakeChar and char then
        pcall(function()
            char:PivotTo(fakeChar:GetPivot())
            LocalPlayer.Character = char
            if hum then hum.PlatformStand = false end
            if Camera and hum then Camera.CameraSubject = hum end
            fakeChar.Parent = nil
        end)
    end
    if BypassToggle then pcall(function() BypassToggle:Set(false) end) end
