local function fireNexusFling()
    local now = os.clock()
    if now - Nexus.Fling.LastFire < Nexus.Fling.Cooldown then return end
    Nexus.Fling.LastFire = now
    if Nexus.Fling.Active then
        flingCleanup()
        flingNotify("Nexus Fling", "Stopped", 1.5)
        return
    end
    if Nexus.Fling.Resolving then return end
    if not Nexus.Fling.Armed then
        flingNotify("Nexus Fling", "Enable the fling first", 2)
        return
    end
    local rawId = Nexus.Fling.UseCustomId and Nexus.Fling.CustomId or Nexus.Fling.AnimId
    local finalId = resolveFlingId(rawId)
    if not finalId then
        flingNotify("Nexus Fling", "Invalid animation ID", 2)
        return
    end
    local char, hrp, hum = getRealChar(), getRealHRP(), getRealHum()
    if not (char and hrp and hum) then
        flingNotify("Nexus Fling", "Character not found", 2)
        return
    end
    -- fly and bypass both own the root part; only one may drive it
    if Nexus.Toggles.Fly then setFly(false) end
    disableBypassForFling()
    Nexus.Fling.Resolving = true
    flingNotify("Nexus Fling", "Resolving animation...", 1.2)
    task.spawn(function()
        Nexus.Fling.Resolving = false
        local c, r, h = getRealChar(), getRealHRP(), getRealHum()
        if not (c and r and h) then return end
        local anim = Instance.new("Animation")
        anim.AnimationId = finalId
        table.insert(Nexus.CreatedInstances, anim)
        local ok, track = pcall(function() return h:LoadAnimation(anim) end)
        if not ok or not track then
            flingNotify("Nexus Fling", "Failed to load animation", 2)
            return
        end
        Nexus.Fling.Track = track
        pcall(function()
            track.Priority = Enum.AnimationPriority.Action
            track.Looped = false
            track:Play()
        end)
        Nexus.Fling.Active = true
        local stopped = false
        pcall(function() track.Stopped:Once(function() stopped = true end) end)
        flingNotify("Nexus Fling", "Active - press T again to stop", 2)
        -- Faithful port of the original Emote Fling Offline loop: we spin our OWN body at
        -- 100000 velocity every frame and hand the movement back on the next frame. That is
        -- what actually transfers the fling on contact - writing velocity on another player's
        -- part is ignored by the server, which is why "throw the target" did nothing.
        local flip = 1
        local timeout = os.clock() + 300
        while Nexus.Fling.Active and not stopped do
            if os.clock() > timeout or Nexus.Round.Respawning then break end
            RunService.Heartbeat:Wait()
            local cr, ch = getRealHRP(), getRealHum()
            if not (cr and ch) then break end
            local dir = ch.MoveDirection
            flip = flip * -1
            pcall(function()
                cr.AssemblyLinearVelocity = Vector3.new(100000 * flip, 0, 100000 * flip)
                cr.AssemblyAngularVelocity = Vector3.new(100000 * flip, 100000 * flip, 100000 * flip)
            end)
            RunService.RenderStepped:Wait()
            if not Nexus.Fling.Active then break end
            pcall(function()
                local spd = Nexus.Fling.Speed
                if dir.Magnitude > 0 then
                    cr.AssemblyLinearVelocity = Vector3.new(dir.X * spd, -2, dir.Z * spd)
                else
                    cr.AssemblyLinearVelocity = Vector3.new(0, -2, 0)
                end
                cr.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        flingCleanup()
        flingNotify("Nexus Fling", "Physics restored", 2)
    end)
end

