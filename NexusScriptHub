-- 5D2. FE AUDIO & GUN1GUN SOUND ENGINE (Local Mirror, Burst, Shoot-to-Play, Vol Boost)
--============================================================================--
Eng.Audio = {}

function Eng.Audio.StopLocalMirrors()
	for i = #S.ActiveMirrorSounds, 1, -1 do
		local snd = S.ActiveMirrorSounds[i]
		S.ActiveMirrorSounds[i] = nil
		if snd and snd.Parent then
			pcall(function()
				snd:Stop()
				snd:Destroy()
			end)
		end
	end
	local containers = {
		getRoot(),
		LocalPlayer:FindFirstChild("PlayerGui"),
		SoundService,
	}
	for _, cont in ipairs(containers) do
		if cont then
			pcall(function()
				for _, c in ipairs(cont:GetChildren()) do
					if c:IsA("Sound") and c.Name == "NexusGunMirror" then
						c:Stop()
						c:Destroy()
					end
				end
			end)
		end
	end
end

function Eng.Audio.PlayLocalMirror(numId, arg3, looped)
	if S.Unloaded then return end
	Eng.Audio.StopLocalMirrors()
	pcall(function()
		local parentObj = getRoot() or SoundService or LocalPlayer:FindFirstChild("PlayerGui")
		local snd = Instance.new("Sound")
		snd.Name = "NexusGunMirror"
		snd.SoundId = "rbxassetid://" .. tostring(numId)
		snd.Volume = math.clamp((tonumber(arg3) or 1) * 1.5, 0.5, 5.0)
		snd.PlaybackSpeed = 1
		snd.RollOffMaxDistance = 150
		snd.Looped = looped == true
		snd.Parent = parentObj
		table.insert(S.ActiveMirrorSounds, snd)
		snd:Play()
		if not looped then
			local cleaned = false
			local function cleanup()
				if cleaned then return end
				cleaned = true
				pcall(function()
					if snd and snd.Parent then
						snd:Stop()
						snd:Destroy()
					end
				end)
			end
			snd.Ended:Connect(cleanup)
		end
	end)
end

function Eng.Audio.PlayBurst(soundId, count, interval)
	count = math.clamp(tonumber(count) or 5, 1, 15)
	interval = math.clamp(tonumber(interval) or 0.35, 0.12, 3.0)
	S.GunSoundBurstToken = (S.GunSoundBurstToken or 0) + 1
	local myToken = S.GunSoundBurstToken
	trackThread(function()
		for i = 1, count do
			if S.Unloaded or S.GunSoundBurstToken ~= myToken then break end
			Net.GlobalSound(soundId, { skipLocal = (i > 1) })
			if i < count then
				task.wait(interval)
			end
		end
	end)
end

local function clearSoundGunConns()
	for _, c in ipairs(S.SoundGunActiveConns) do
		pcall(function() c:Disconnect() end)
	end
	S.SoundGunActiveConns = {}
end

local function bindToolForSoundGun(tool)
	if not tool or not tool:IsA("Tool") then return end
	if not isGunToolName(tool.Name) then return end
	local c = tool.Activated:Connect(function()
		if S.Unloaded or not S.SoundGunHookOn then return end
		local handle = extractToolHandle(tool)
		if handle then
			local numId = tonumber((tostring(S.GlobalSoundId or ""):gsub("%D", "")))
			if numId and numId > 0 then
				local remotes = Net.FindGunSoundRemotes(false)
				if #remotes == 0 then remotes = Net.FindGunSoundRemotes(true) end
				local arg3 = math.clamp(tonumber(S.GlobalSoundArg3) or 1, 0.1, 10)
				if #remotes > 0 then
					fireGunSoundRemotes(remotes, handle, numId, arg3)
				end
				if S.GlobalSoundLocalMirror then
					Eng.Audio.PlayLocalMirror(numId, arg3)
				end
			end
		end
	end)
	table.insert(S.SoundGunActiveConns, c)
end

function Eng.Audio.SetSoundGunHook(state)
	S.SoundGunHookOn = state == true
	clearSoundGunConns()
	if not S.SoundGunHookOn then
		notify("FE Sound Gun", "Shoot-to-Play Sound Gun disabled.", 2)
		return
	end

	-- Auto-acquire & equip chosen gun tool so clicking shoots custom FE sound
	if S.GlobalSoundAutoPick then
		trackThread(function()
			Net.EnsureGunHandle(S.GlobalSoundGun, true, true)
		end)
	end

	local function bindContainer(box)
		if not box then return end
		for _, child in ipairs(box:GetChildren()) do
			bindToolForSoundGun(child)
		end
		table.insert(S.SoundGunActiveConns, box.ChildAdded:Connect(function(child)
			if S.Unloaded or not S.SoundGunHookOn then return end
			bindToolForSoundGun(child)
		end))
	end

	bindContainer(getChar())
	bindContainer(LocalPlayer:FindFirstChildOfClass("Backpack"))
	table.insert(S.SoundGunActiveConns, LocalPlayer.CharacterAdded:Connect(function(newChar)
		if S.Unloaded or not S.SoundGunHookOn then return end
		task.wait(0.4)
		bindContainer(newChar)
		bindContainer(LocalPlayer:FindFirstChildOfClass("Backpack"))
	end))

	notify("FE Sound Gun", "Shoot any gun to fire FE Sound ID " .. tostring(S.GlobalSoundId) .. "!", 3)
end

function Eng.Audio.StopAll()
	S.GlobalSoundLoop = false
	S.GunSoundBurstToken = (S.GunSoundBurstToken or 0) + 1
	S.Gun1AudioToken = (S.Gun1AudioToken or 0) + 1
	S._AudioLoopToken = (S._AudioLoopToken or 0) + 1
	if S.SoundGunHookOn then
		S.SoundGunHookOn = false
		clearSoundGunConns()
	end
	Eng.Audio.StopLocalMirrors()
end

function Eng.Audio.TickMaxVolumeBoost()
	if not S.AudioMaxVolBoost or S.Unloaded then return end
	local maxVol = 5
	local function boostObj(obj)
		if not obj then return end
		if obj:IsA("Sound") then
			if obj.Volume ~= maxVol then obj.Volume = maxVol end
			return
		end
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("Sound") and d.Volume ~= maxVol then
				d.Volume = maxVol
			end
		end
	end
	pcall(function()
		local lpLow = string.lower(LocalPlayer.Name)
		local vehicles = Workspace:FindFirstChild("Vehicles")
		if vehicles then
			for _, veh in ipairs(vehicles:GetChildren()) do
				if string.lower(veh.Name):find(lpLow, 1, true) then
					local body = veh:FindFirstChild("Body")
					local turbo = body and body:FindFirstChild("TurboPosition")
					local emitter = turbo and turbo:FindFirstChild("SoundEmmiter")
					if emitter then boostObj(emitter) end
				end
			end
		end
		local char = getChar()
		if char then
			local noMotor = char:FindFirstChild("NoMotorVehicleModel")
			if noMotor then boostObj(noMotor) end
			local boombox = char:FindFirstChild("Boombox") or char:FindFirstChild("BoomBox")
			local handle = boombox and boombox:FindFirstChild("Handle")
			if handle then
				boostObj(handle:FindFirstChild("PlayersChoice") or handle)
			end
		end
	end)
end

