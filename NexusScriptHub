-- ==========================================================================
-- NEXUS TSB · FARM PACK (v3)
-- Under-map / feet-targeting auto farm + 35 new features.
-- Everything here is self-contained: it only uses helpers that already exist
-- in this script (LegacyFireRemote, Notify, Toggles, Library, State).
-- ==========================================================================
do
	local NX = {
		-- under-map feet farm
		UnderFarm = false,
		Mode = "Below · feet (look up)",
		Pick = "Nearest",
		FeetPart = "Auto (foot part)",
		Depth = 9,
		Range = 150,
		M1Delay = 0.12,
		AimOffset = 0,
		HeightFine = 0,        -- v5: manual fine height adjustment (studs)
		Combo = false,         -- v5: 1 -> 2 -> 3 -> 4 in order
		RandomSkill = false,   -- v5: random pick between 1-4
		ComboDelay = 0.35,     -- v5: gap between two skills
		ComboIndex = 0,        -- v5: next key
		LastCombo = -10,
		Hover = true,
		Platform = true,
		KeepUnder = true,
		Jitter = true,
		CamUnder = false,
		ReturnOnStop = true,
		-- skills / combat
		SkillSpam = false,
		SkillKey = "E",
		SkillDelay = 0.8,
		AutoM1 = false,
		AutoM1Delay = 0.15,
		AntiFling = false,
		AntiVoid = false,
		VoidY = -80,
		AutoRespawn = false,
		-- misc
		AntiAFK = false,
		WalkOnAir = false,
		Scale = 1,
		FpsCap = 0,
		LastM1 = -10,
		LastSkill = -10,
		LastStatus = "",
	}

	local hoverBV = nil
	local airPart = nil
	local savedCF = nil
	local statusLabel = nil
	local afkConn = nil

	-- ---------------------------------------------------------------- helpers
	local function nxChar(plr)
		local char = (plr or LocalPlayer).Character
		if not char or not char.Parent then return nil end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
			or char:FindFirstChild("Torso")
			or char:FindFirstChild("UpperTorso")
		if not hum or not root or hum.Health <= 0 then return nil end
		return char, hum, root
	end

	local function nxFeetPosition(char, hum, root)
		local part
		if NX.FeetPart == "LeftFoot" then
			part = char:FindFirstChild("LeftFoot") or char:FindFirstChild("Left Leg")
		elseif NX.FeetPart == "RightFoot" then
			part = char:FindFirstChild("RightFoot") or char:FindFirstChild("Right Leg")
		elseif NX.FeetPart == "Legs" then
			part = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
				or char:FindFirstChild("LeftLowerLeg")
		elseif NX.FeetPart == "HumanoidRootPart" then
			part = root
		else
			-- "Auto": real foot parts first (R15), then R6 legs, then HRP
			part = char:FindFirstChild("LeftFoot") or char:FindFirstChild("RightFoot")
				or char:FindFirstChild("Left Leg") or char:FindFirstChild("Right Leg")
				or char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("RightUpperLeg")
		end
		if part then return part.Position end
		if root then
			local hip = (hum and hum.HipHeight) or 2
			return root.Position - Vector3.new(0, hip + 1, 0)
		end
		return nil
	end

	local function nxCandidates()
		local list = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local char, hum, root = nxChar(plr)
				if char and root then
					list[#list + 1] = { plr = plr, char = char, hum = hum, root = root }
				end
			end
		end
		return list
	end

	local function nxPickTarget(origin)
		local best, bestScore = nil, nil
		for _, entry in ipairs(nxCandidates()) do
			local dist = (entry.root.Position - origin).Magnitude
			if dist <= NX.Range then
				local score
				if NX.Pick == "Lowest HP" then
					score = entry.hum.Health
				elseif NX.Pick == "Highest HP" then
					score = -entry.hum.Health
				elseif NX.Pick == "Random" then
					score = math.random() * 1000
				elseif NX.Pick == "Farthest" then
					score = -dist
				else
					score = dist
				end
				if not bestScore or score < bestScore then
					best, bestScore = entry, score
				end
			end
		end
		return best
	end

