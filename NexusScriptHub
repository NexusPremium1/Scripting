	local function NexusEntityActive(names)
		for _, name in ipairs(names) do
			if workspace:FindFirstChild(name) or workspace:FindFirstChild(name, true) then
				return true
			end
		end
		return false
	end

	local function NexusUpdateMonsterAnti()
		if S.Unloaded then return end
		local char = GetChar()
		if not char then return end

		local shouldProtect = false
		for toggleName, names in pairs(NexusAntiEntityDefs) do
			local tog = Toggles[toggleName]
			if tog and tog.Value and NexusEntityActive(names) then
				shouldProtect = true
				break
			end
		end

		-- Archives/Stairwell anti: CHEAP path (FPS-safe).
		-- No per-tick GetDescendants (that tanked FPS); spawn-time application
		-- happens event-driven in OnEntityDetected — this loop only keeps
		-- godmode/NoTouch refreshed on the tiny registry + top-level children.
		local function nexusProtectNamed(names)
			for obj, info in pairs(S.ActiveEntities) do
				if obj.Parent and names[obj.Name] then
					ApplyModelTouch(obj, true)
					if info.Danger then shouldProtect = true end
				end
			end
			for _, child in ipairs(workspace:GetChildren()) do
				if names[child.Name] then
					ApplyModelTouch(child, true)
					local info = Catalog.Entities[child.Name]
					if info and info.Danger then shouldProtect = true end
				end
			end
			local camS = workspace.CurrentCamera
			if camS then
				for _, d in ipairs(camS:GetChildren()) do
					if names[d.Name] then
						ApplyModelTouch(d, true)
						local info = Catalog.Entities[d.Name]
						if info and info.Danger then shouldProtect = true end
					end
				end
			end
		end
		if Toggles.AntiArchivesEntities and Toggles.AntiArchivesEntities.Value then
			nexusProtectNamed(NexusArchivesNames)
		end
		if Toggles.AntiStairwellEntities and Toggles.AntiStairwellEntities.Value then
			nexusProtectNamed(NexusStairwellNames)
		end

		-- Anti ALL Entities master: NoTouch everything tracked + godmode while a Danger entity lives
		if Toggles.AntiAllEntities and Toggles.AntiAllEntities.Value then
			for obj, info in pairs(S.ActiveEntities) do
				if obj.Parent then
					ApplyModelTouch(obj, true)
					if info.Danger then shouldProtect = true end
				end
			end
			local cam = workspace.CurrentCamera
			if cam then
				for _, child in ipairs(cam:GetChildren()) do
					local info = Catalog.Entities[child.Name]
					if info then
						ApplyModelTouch(child, true)
						if info.Danger then shouldProtect = true end
					end
				end
			end
		end

		if shouldProtect then
			S.GodmodeReleaseAt = nil -- cancel pending release (entity stream-in flicker)
			if Toggles.Godmode and not Toggles.Godmode.Value then
				pcall(function() Toggles.Godmode:SetValue(true) end)
				S.MonsterAntiForcedGodmode = true
			end

			for toggleName, names in pairs(NexusAntiEntityDefs) do
				local tog = Toggles[toggleName]
				if tog and tog.Value then
					for _, name in ipairs(names) do
						for _, obj in ipairs(workspace:GetChildren()) do
							if obj.Name == name then
								ApplyModelTouch(obj, true)
							end
						end
						local curRooms = workspace:FindFirstChild("CurrentRooms")
						if curRooms then
							for _, obj in ipairs(curRooms:GetChildren()) do
								if obj.Name == name then
									ApplyModelTouch(obj, true)
								end
							end
						end
					end
				end
			end
		elseif S.MonsterAntiForcedGodmode then
			-- Debounced release: entity models flicker in/out while streaming in,
			-- and SetValue ALWAYS re-fires the callback — an instant release would
			-- pivot the character down/up on every flicker ("bouncing when
			-- something spawns"). Only let go after 0.8s of continuous calm.
			local now = os.clock()
			if not S.GodmodeReleaseAt then
				S.GodmodeReleaseAt = now + 0.8
			end
			if now >= S.GodmodeReleaseAt then
				if Toggles.Godmode and Toggles.Godmode.Value then
					pcall(function() Toggles.Godmode:SetValue(false) end)
				end
				S.MonsterAntiForcedGodmode = false
				S.GodmodeReleaseAt = nil
			end
		else
			S.GodmodeReleaseAt = nil
		end
	end

	-- Entity Spawn Alert & Auto-Hide Handler (zero workspace polling!)
	local function OnEntityDetected(obj)
		task.defer(NexusUpdateMonsterAnti)
		if S.Unloaded or not obj or not obj.Parent then return end
		local info = Catalog.Entities[obj.Name]
		if not info then return end
		S.ActiveEntities[obj] = info

		-- Screech can also spawn outside the camera (retro/glitch variants): keep the look-assist on it
		if obj.Name == "Screech" or obj.Name == "ScreechRetro" or obj.Name == "SCJVEREECH" then
			task.delay(0.05, function() pcall(LookAtScreech, obj) end)
		end

		if Toggles.ESPEntity and Toggles.ESPEntity.Value then
			ESP:Add(obj, "Entity", info.Name)
		end

		-- Alert check
		if Toggles.NotifySpawn and Toggles.NotifySpawn.Value and info.Alert and not S.NotifiedEntities[obj] then
			local selected = Options.NotifyEntities and Options.NotifyEntities.Value
			local want = (type(selected) == "table" and selected[info.Alert] == true)
			if want then
				S.NotifiedEntities[obj] = true
				local pos = GetObjPos(obj)
				local distStr = pos and (" (" .. math.floor(GetDist(pos)) .. "m)") or ""
				local actionHint = info.Hide and " — HIDE NOW!" or ""
				Notify("⚠ " .. info.Name .. " SPAWNED" .. distStr .. actionHint, 5)
			end
		end

		-- Auto-Hide on Rush/Ambush/Blitz/A-60/A-120/Surge
		if info.Hide and Toggles.AutoHideDanger and Toggles.AutoHideDanger.Value then
			local char = GetChar()
			if char and not char:GetAttribute("Hiding") then
				TriggerQuickHide(obj)
			end
		end

		-- Floor antis: apply the MOMENT the entity spawns (event-driven — zero tick cost)
		if NexusArchivesNames[obj.Name] and Toggles.AntiArchivesEntities and Toggles.AntiArchivesEntities.Value then
			ApplyModelTouch(obj, true)
		end
		if NexusStairwellNames[obj.Name] and Toggles.AntiStairwellEntities and Toggles.AntiStairwellEntities.Value then
			ApplyModelTouch(obj, true)
		end

		-- Apply relevant anti-entity hitbox protections immediately on spawn
		local n = obj.Name
		if n == "Snare" and Toggles.AntiSnare and Toggles.AntiSnare.Value then
			ApplyModelTouch(obj, true)
		elseif n == "GiggleCeiling" and Toggles.AntiGiggle and Toggles.AntiGiggle.Value then
			ApplyModelTouch(obj, true)
		elseif (n == "GloomEgg" or n == "GloomPile") and Toggles.AntiGloomEgg and Toggles.AntiGloomEgg.Value then
			ApplyModelTouch(obj, true)
		elseif (n == "GrumbleRig" or n == "QueenGrumble") and Toggles.AntiGrumble and Toggles.AntiGrumble.Value then
			ApplyModelTouch(obj, true)
		elseif (n == "Groundskeeper" or n == "Monument" or n == "MonumentEntity" or n == "Bramble")
			and Toggles.AntiOutdoorsHitbox and Toggles.AntiOutdoorsHitbox.Value then
			ApplyModelTouch(obj, true)
		elseif NexusArchivesNames[n]
			and Toggles.AntiArchivesEntities and Toggles.AntiArchivesEntities.Value then
			ApplyModelTouch(obj, true)
		elseif NexusStairwellNames[n]
			and Toggles.AntiStairwellEntities and Toggles.AntiStairwellEntities.Value then
			ApplyModelTouch(obj, true)
		elseif n == "JeffTheKiller" and Toggles.AntiJeff and Toggles.AntiJeff.Value then
			task.spawn(function()
				local t0 = os.clock()
				while obj.Parent and (os.clock() - t0) < 3 do
					ApplyModelTouch(obj, true)
					local hum = obj:FindFirstChildOfClass("Humanoid")
					if hum and obj.PrimaryPart and (not Cap.IsNetOwner or Cap.IsNetOwner(obj.PrimaryPart)) then
						pcall(function() hum.Health = 0 end)
						break
					end
					task.wait(0.1)
				end
			end)
		end
	end

