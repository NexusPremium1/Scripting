register("aimbot", "combat", "Soft aim at nearest <smooth>", function(args)
    if isBound("aimbot") then unbind("aimbot"); logOk("Aimbot OFF") return end
    local smooth = tonumber(args[1]) or 6
    bind("aimbot", RunService.RenderStepped:Connect(function()
        local mouse = UserInputService:GetMouseLocation()
        local best, bestDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = getHum(p.Character)
                local head = p.Character:FindFirstChild("Head")
                if h and h.Health > 0 and head then
                    local vp, on = Camera:WorldToViewportPoint(head.Position)
                    if on then
                        local d = (Vector2.new(vp.X, vp.Y) - mouse).Magnitude
                        if d < bestDist then bestDist = d; best = head end
                    end
                end
            end
        end
        if best then
            if mousemoverel then
                local pos2, _2 = Camera:WorldToViewportPoint(best.Position)
                local cur = UserInputService:GetMouseLocation()
                local d2 = (Vector2.new(pos2.X, pos2.Y) - cur) / smooth
                mousemoverel(d2.X, d2.Y)
            end
        end
    end))
    logOk("Aimbot ON · smooth " .. smooth)
end)
register("unaimbot", "combat", "Stop aimbot", function()
    unbind("aimbot"); logOk("Aimbot OFF")
end)

register("silentaim", "combat", "Silent aim (camera snap)", function()
    if isBound("silent") then unbind("silent"); logOk("SilentAim OFF") return end
    bind("silent", RunService.RenderStepped:Connect(function()
        local best, bestDist = nil, math.huge
        local mouse = UserInputService:GetMouseLocation()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local head = p.Character:FindFirstChild("Head")
                local h = getHum(p.Character)
                if head and h and h.Health > 0 then
                    local vp, on = Camera:WorldToViewportPoint(head.Position)
                    if on then
                        local d = (Vector2.new(vp.X, vp.Y) - mouse).Magnitude
