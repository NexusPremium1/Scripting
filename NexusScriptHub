RunService.Heartbeat:Connect(function()
	if triggerBotEnabled then
		pcall(function()
			local mouseRay = Camera:ViewportPointToRay(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = {k.Character}
			local result = Workspace:Raycast(mouseRay.Origin, mouseRay.Direction * 1000, params)
			if result and result.Instance and result.Instance.Parent then
				local hitPlr = Players:GetPlayerFromCharacter(result.Instance.Parent)
				-- v3.4: the burst loop owns the trigger while Rage Bot is on
				if hitPlr and hitPlr ~= k and isPlayerAlive(hitPlr)
					and not rageModeEnabled then
					if mouse1click then mouse1click() end
				end
			end
		end)
	end

	-- v3.4: the burst loop owns the trigger while Rage Bot is on
	if autoShootEnabled and isAimingKeyHeld and (os.clock() - lastAutoShotAt) >= 0.12
		and not rageModeEnabled then
		lastAutoShotAt = os.clock()
		pcall(function()
			if mouse1click then mouse1click() end
		end)
	end

	-- ══════════════════════════════════════════════════════════════════════
	-- LOOP GOTO  (fixed distance - the old sin/cos wobble loop was removed)
	-- Stays at a fixed distance right next to the target, velocity is zeroed, no falling.
	-- ══════════════════════════════════════════════════════════════════════
	-- v6.2: when God-Dodge is active during Rage Mode, NEVER let 2-stud LoopGoto drag us into Knife/Katana range!
	-- ══════════════════════════════════════════════════════════════════════
	-- GOD-TIER LOOP GOTO (Behind-the-Back Stalker · Zero Death · Flawless)
	-- ══════════════════════════════════════════════════════════════════════
	if loopGotoEnabled or rageModeEnabled then
		if not loopGotoTarget or not loopGotoTarget.Character or not isPlayerAliveRaw(loopGotoTarget) or (teamCheckEnabled and isTeammate(loopGotoTarget)) then
			loopGotoTarget = nil
			local myRoot = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
			local bestDistance = math.huge
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= k and isPlayerAliveRaw(p) and (not teamCheckEnabled or not isTeammate(p)) then
					local targetRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
					if targetRoot and myRoot then
						local distance = (targetRoot.Position - myRoot.Position).Magnitude
						if distance < bestDistance then
							bestDistance = distance
							loopGotoTarget = p
						end
					end
				end
			end
		end

		local targetHRP = loopGotoTarget and loopGotoTarget.Character and loopGotoTarget.Character:FindFirstChild("HumanoidRootPart")
		local myHRP = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
		local hum = k.Character and k.Character:FindFirstChildOfClass("Humanoid")
		if targetHRP and myHRP and hum and hum.Health > 0 then
			hum.PlatformStand = false
			rageLockTarget = loopGotoTarget
			local dist = (loopGotoDistance or 3.5)
			local look = targetHRP.CFrame.LookVector
			local mode = (Legit and Legit.rageAttackMode) or "Behind Back"

			if mode == "Orbit" then
				local orbitSpeed = (Legit and Legit.rageOrbitSpeed) or 5.5
				local angle = (tick() * orbitSpeed) % (2 * math.pi)
				local orbitPos = Vector3.new(
					targetHRP.Position.X + math.cos(angle) * dist,
					targetHRP.Position.Y + 0.5,
					targetHRP.Position.Z + math.sin(angle) * dist
				)
				myHRP.CFrame = CFrame.new(orbitPos, targetHRP.Position)
			elseif mode == "Air Flank" or mode == "Direct Overhead (Air)" or mode == "Direct Overhead" or mode == "Overhead" then
				-- DIRECT OVERHEAD (DİREKT TEPESİNDEN):
				-- Arkasındaki tepeden değil, X ve Z sıfır sapma ile doğrudan hedefin kafasının tam üstünden vurur!
				local airHeight = (Legit and Legit.rageAirHeight) or 5.5
				local airPos = Vector3.new(
					targetHRP.Position.X,
					targetHRP.Position.Y + airHeight,
					targetHRP.Position.Z
				)
				local upVec = (look.Magnitude > 0.1 and look) or Vector3.new(0, 0, -1)
				myHRP.CFrame = CFrame.lookAt(airPos, targetHRP.Position, upVec)
			else
				-- "Behind Back": ASLA onunden vurmaz, daima sirtindan ve zeminde!
				local groundPos = Vector3.new(
					targetHRP.Position.X - look.X * dist,
					targetHRP.Position.Y,
					targetHRP.Position.Z - look.Z * dist
				)
				myHRP.CFrame = CFrame.new(groundPos, targetHRP.Position + look * 10)
			end

			myHRP.AssemblyLinearVelocity = Vector3.zero
			myHRP.AssemblyAngularVelocity = Vector3.zero
		else
			-- HEDEF YOK YA DA HEDEF OLDU (KILL ALINDI):
			-- "kill i aldiktan sonra havaya isinlayip orada sabitleme (uzaya / sky camp)"
			if rageModeEnabled and myHRP and hum and hum.Health > 0 then
				local skyY = 140
				myHRP.CFrame = CFrame.new(myHRP.Position.X, skyY, myHRP.Position.Z)
				myHRP.AssemblyLinearVelocity = Vector3.zero
				myHRP.AssemblyAngularVelocity = Vector3.zero
				hum.PlatformStand = true
			end
			loopGotoTarget = nil
		end
	end
end)

