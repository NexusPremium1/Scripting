    { id = "server",    label = "🌐 Server",    },
    { id = "util",      label = "⚙ Util",       },
}
local activeCat = nil -- nil = all

local function register(name, cat, desc, payload, aliases)
    local entry = { name = name, cat = cat, desc = desc, payload = payload }
    local isNew = (Commands[name] == nil)
    Commands[name] = entry
    if isNew then
        table.insert(CommandOrder, name)
    end
    if aliases then
        for _, a in ipairs(aliases) do
            Commands[a] = entry
        end
    end
    return entry
end

