function Eng.Troll.EquipBrookhavenTool(toolName)
	local char = getChar()
	local hum = getHum()
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if not char or not hum or not bp then return nil end

	local tool = char:FindFirstChild(toolName) or bp:FindFirstChild(toolName)
	if not tool then
		local re = Net.REFolder() and (Net.REFolder():FindFirstChild("1Too1l") or Net.REFolder():FindFirstChild("Tools"))
		if re then
			pcall(function() re:InvokeServer("PickingTools", toolName) end)
		end
		-- Instant fast poll (< 0.45s max instead of lagging 2.2s!)
		local t0 = os.clock()
		while not tool and (os.clock() - t0) < 0.45 do
			if S.Unloaded then return nil end
			tool = char:FindFirstChild(toolName) or bp:FindFirstChild(toolName)
			if tool then break end
			task.wait(0.02)
		end
	end

	if tool then
		if tool.Parent ~= char then
			tool.Parent = char -- Instant direct parent assignment, zero equip animation delay!
		end
		return tool
	end
	return nil
end

-- FIXED & INSTANT COUCH TROLL ENGINE (mode: "kill" | "bring" | "fling")
-- Fixes: Instant tool equip, local Anti-Sit disable (prevents local player sitting on couch),
-- key F trigger, rapid sweep suction, guaranteed instant target seating & 9e8 velocity sky fling!
function Eng.Troll.CouchAction(targetPlr, mode, customReturnCF)
	if not targetPlr or targetPlr == LocalPlayer then
		notify("Couch Engine", "Select a valid target player!", 3)
		return false
	end
	local char = getChar()
	local hum = getHum()
	local root = getRoot()
	local tRoot = getRoot(targetPlr)
	local tHum = getHum(targetPlr)
	if not char or not hum or not root or not tRoot or not tHum then
		notify("Couch Engine", "Target or local character missing.", 3)
		return false
	end

	local origCF = customReturnCF or root.CFrame
	S.TrollActive = true
	local ok, err = pcall(function()
		-- 1. Prevent local player from accidentally sitting on the couch seats!
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
		hum.PlatformStand = false

		-- 2. Equip Couch immediately
		local couch = Eng.Troll.EquipBrookhavenTool("Couch")
		if not couch then
			notify("Couch Engine", "Failed to equip Couch tool.", 3)
			return
		end

		-- Trigger key F to unlatch/expose couch seat
		pcall(function()
			local vim = game:GetService("VirtualInputManager")
			if vim then vim:SendKeyEvent(true, Enum.KeyCode.F, false, game) end
		end)

		local seat = couch:FindFirstChildWhichIsA("Seat", true)
		if seat then
			pcall(function()
				seat.Disabled = false
				seat.CanCollide = true
			end)
		end

		local t0 = os.clock()
		local caught = false
		local angle = 0

		-- 3. Rapid spin / sweep suction onto target (seats target within 0.1 - 0.25s)
		while S.TrollActive and not S.Unloaded and (os.clock() - t0) < 3.5 do
			local tr = getRoot(targetPlr)
			local th = getHum(targetPlr)
			if not tr or not th or th.Health <= 0 then break end
			if th.Sit or (seat and seat.Occupant == th) then
				caught = true
				break
			end

			angle = (angle + 55) % 360
			local velPred = tr.AssemblyLinearVelocity * 0.05
			-- Place couch seat directly inside target's HRP with rapid angular sweep
			root.CFrame = CFrame.new(tr.Position + velPred) * CFrame.Angles(math.rad(angle), math.rad(angle), 0)
			root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			root.AssemblyAngularVelocity = Vector3.new(0, 45, 0)

			-- Pull force to seat target immediately
			if not tr:FindFirstChild("NexusCouchPull") then
				local pull = Instance.new("BodyPosition")
				pull.Name = "NexusCouchPull"
				pull.MaxForce = Vector3.new(1e6, 1e6, 1e6)
				pull.P = 35000
				pull.D = 60
				pull.Position = root.Position
				pull.Parent = tr
				task.delay(0.2, function() pcall(function() pull:Destroy() end) end)
			end

			RunService.Heartbeat:Wait()
		end

		pcall(function()
			local tr = getRoot(targetPlr)
			if tr and tr:FindFirstChild("NexusCouchPull") then tr.NexusCouchPull:Destroy() end
		end)

		if caught then
			if mode == "kill" then
				-- Instant Void Drop: Target dies to void instantly
				root.CFrame = CFrame.new(0, -9999, 0)
				root.AssemblyLinearVelocity = Vector3.zero
				task.wait(0.35)
				pcall(function()
					couch.Parent = LocalPlayer:FindFirstChild("Backpack") or LocalPlayer.Character
				end)
				task.wait(0.1)
			elseif mode == "fling" then
				-- SUPER SKY LAUNCH FLING: 9e8 velocity launch into stratosphere
				pcall(function()
					workspace.FallenPartsDestroyHeight = 0/0
					local bv = Instance.new("BodyVelocity")
					bv.Name = "NexusCouchFling"
					bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
					bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
					bv.P = 1e7
					bv.Parent = root
					task.delay(0.25, function() pcall(function() bv:Destroy() end) end)
				end)
				root.CFrame = CFrame.new(origCF.X, 3500, origCF.Z) * CFrame.Angles(math.rad(math.random(0, 360)), math.rad(math.random(0, 360)), 0)
				root.AssemblyLinearVelocity = Vector3.new(math.random(-50000, 50000), 100000, math.random(-50000, 50000))
				root.AssemblyAngularVelocity = Vector3.new(9e7, 9e7, 9e7)
				task.wait(0.2)
				pcall(function()
					couch.Parent = LocalPlayer:FindFirstChild("Backpack") or LocalPlayer.Character
				end)
				task.wait(0.15)
			elseif mode == "bring" then
				root.CFrame = origCF * CFrame.new(0, 1.5, -4)
				root.AssemblyLinearVelocity = Vector3.zero
				task.wait(0.2)
				pcall(function()
					couch.Parent = LocalPlayer:FindFirstChild("Backpack") or LocalPlayer.Character
				end)
				task.wait(0.15)
			end
		else
			notify("Couch Engine", "Target dodged or has Anti-Sit enabled.", 2.5)
		end
	end)

	-- Guaranteed cleanup & restore
	S.TrollActive = false
	pcall(function()
		local h = getHum()
		local r = getRoot()
		if h then
			if not S.AntiSitOn then
				h:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
			end
			h.PlatformStand = false
		end
		if r then
			safePivot(getChar(), origCF)
			zeroVelocity(r)
		end
	end)
	if not ok then
		warn("[Nexus Brookhaven] CouchAction error:", tostring(err))
	end
	return ok
end

