				end)
				row.button.MouseButton1Click:Connect(function()
					if not row.entry then return end
					local now = os.clock()
					if row.lastClick and now - row.lastClick < 0.35 then
						row.lastClick = nil
						S.Selected = row.entry
						if row.index then play(row.index) end
						return
					end
					row.lastClick = now
					S.Selected = row.entry
					status("selected  " .. row.entry[1] .. "   ·  START or double-click")
					render()
				end)
				rows[slot] = row
			end
			local index = first + slot - 1
			local entry = S.Filtered[index]
			row.entry = entry
			row.index = entry and index or nil
			paintRow(row)
		end
		local pages = math.max(1, math.ceil(#S.Filtered / PER_PAGE))
		if pageLabel then
