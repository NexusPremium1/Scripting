local function updateVisuals()
	-- Lighting
	if S.Fullbright then
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(185, 185, 185)
		Lighting.OutdoorAmbient = Color3.fromRGB(185, 185, 185)
	end
	if S.NoFog then
		Lighting.FogEnd = 1e6
		Lighting.FogStart = 1e6
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then atm.Density = 0 end
	end
	-- Camera FOV & Infinite Zoom
	local cam = Workspace.CurrentCamera
	if cam and S.CameraFOV and cam.FieldOfView ~= S.CameraFOV then
		cam.FieldOfView = S.CameraFOV
	end
	if S.MaxZoomOn then
		LP.CameraMaxZoomDistance = 1000
	end
end

local function isAnyFarmRunning()
	return S.Farming or S.ChestFarm or S.AutoFarmBoss or S.AutoFarmAllBosses or S.AutoSeaEvents or S.AutoRaid
end

local function startBackgroundLoops()
	-- 1. Heartbeat: HoldCF anti-snapback, Submerged-safe Anti-Void, Fly, WaterWalk, Noclip, PvP Aim/Aura
	trackConn(RunService.Heartbeat:Connect(function()
		if S.Unloaded then return end
		local root = getRoot()
		local now = os.clock()

		-- HoldCF anti-snapback lock (exact v1.5 fix!)
		if S.HoldCF then
			if now < (S.HoldUntil or 0) and root then
				root.CFrame = S.HoldCF
				zeroVel(root)
			else
				S.HoldCF = nil
			end
		end

		-- Submerged-safe Anti-Void watchdog
		if isAntiVoidActive() and root and not S.HoldCF then
			local pos = root.Position
			if pos.Y < getVoidFloor(pos) then
				Eng.Travel.RescueFromVoid("fell below Y=" .. tostring(math.floor(getVoidFloor(pos))))
			elseif (now - (S.LastSafeCheck or 0)) >= 0.45 then
				S.LastSafeCheck = now
				Eng.Travel.RecordSafeSpot()
			end
		end

		-- Fly & WaterWalk
		if S.FlyOn then Eng.Player.UpdateFly() end
		Eng.Player.UpdateWaterWalk()

		-- Noclip while farming/flying/manual toggle
		if S.NoclipOn or S.FlyOn or isAnyFarmRunning() then
			local ch = getChar()
			if ch then
				for _, p in ipairs(ch:GetDescendants()) do
					if p:IsA("BasePart") and p.CanCollide then
						p.CanCollide = false
					end
				end
			end
		end

		-- PvP Combat (AimLock + Kill Aura + NoDashCD)
		Eng.PvP.TickCombat()
	end))

	-- 2. Character/Stats/Visuals Maintenance Loop (0.15s)
	trackThread(function()
		while not S.Unloaded do
			if S.PlayerMods then Eng.Player.ApplySpeedLock() end
			if S.InfiniteEnergy then Eng.Player.BindEnergyLock() end
			Eng.PvP.UpdateHitboxes()
			updateVisuals()
			if S.FastAttack and not isAnyFarmRunning() and not S.KillAura then
				-- Standalone Fast Attack for manual fighting
				Net.FastAttackBurst(S.FastAttackRange, true, S.FastAttackPlayers)
			end
			task.wait(0.15)
		end
	end)

	-- 3. Primary Farm / Boss / Sea / Raid / Chest Worker
	trackThread(function()
		while not S.Unloaded do
			if S.Farming then
				pcall(Eng.Farm.FarmTick)
			elseif S.AutoFarmBoss or S.AutoFarmAllBosses then
				pcall(Eng.World.BossFarmTick)
			elseif S.AutoSeaEvents then
				pcall(Eng.World.SeaEventsTick)
			elseif S.AutoRaid then
				pcall(Eng.World.RaidTick)
			elseif S.ChestFarm then
				pcall(Eng.Farm.ChestTick)
			else
				S.FarmStatus = "Idle"
				Eng.Travel.DestroyPlatform()
				task.wait(0.25)
			end
			task.wait(0.08)
		end
	end)

	-- 4. Utility Worker (AutoStats, AutoStore, AutoCollect, Alerts, Sniper, Gacha, Bones, Raid Auto-Chip/Awaken)
	trackThread(function()
		local lastSniper, lastGacha, lastBones, lastAwaken = 0, 0, 0, 0
		while not S.Unloaded do
			local now = os.clock()

			if S.AutoStats then pcall(Eng.Stats.SpendTick) end
			if S.AutoStoreFruit then pcall(Eng.Fruit.StoreAllFruits, true) end

			-- Dropped Fruit Alerts & Auto Collect (Vendor-Safe!)
			if S.FruitAlerts or S.AutoCollectFruits then
				local okF, list = pcall(Eng.Fruit.GetSpawnedFruits)
				if okF and list and #list > 0 then
					for _, f in ipairs(list) do
						if S.FruitAlerts and not S.AlertedFruits[f.Object] then
							S.AlertedFruits[f.Object] = true
							notify("Fruit Spawned!", f.Name .. " detected on map!", 5)
						end
					end
					if S.AutoCollectFruits and not S.TweenBusy then
						local f = list[1]
						if f and f.Part and f.Part.Parent then
							Eng.Travel.TweenTo(f.Part.Position + Vector3.new(0, 2, 0))
							task.wait(0.35)
							if S.AutoStoreFruit then Eng.Fruit.StoreAllFruits(true) end
						end
					end
				end
			end

			-- Live Dealer Fruit Sniper (every 20s)
			if S.FruitSniperOn and (now - lastSniper) >= 20 then
				lastSniper = now
				local okS, stock = pcall(Eng.Fruit.FetchDealerStock)
				if okS and type(stock) == "table" then
					for _, item in ipairs(stock) do
						if type(item) == "table" and item.OnSale and item.Name == S.SniperTargetFruit then
							Net.Comm("PurchaseRawFruit", item.Name, false)
							notify("Fruit Sniper!", "Attempted to buy " .. tostring(item.Name) .. " from Dealer!", 5)
							break
						end
					end
				end
			end

			-- Auto Fruit Gacha (every 35s)
			if S.AutoRandomFruit and (now - lastGacha) >= 35 then
				lastGacha = now
				Net.Comm("Cousin", "Buy")
			end

			-- Auto Random Surprise Bones (every 4s)
			if S.AutoBoneRoll and (now - lastBones) >= 4 then
				lastBones = now
				Net.Comm("Bones", "Buy", 1, 1)
			end

			-- Auto Buy Raid Chip & Auto Awaken
			if S.AutoBuyChip then
				local bp = LP:FindFirstChild("Backpack")
				local ch = getChar()
				local hasChip = (bp and bp:FindFirstChild("Special Microchip")) or (ch and ch:FindFirstChild("Special Microchip"))
				if not hasChip then
					Net.Comm("RaidsNpc", "Select", S.SelectedRaidChip)
				end
			end
			if S.AutoAwaken and (now - lastAwaken) >= 2.2 then
				lastAwaken = now
				Net.Comm("Awakener", "Check")
				Net.Comm("Awakener", "Awaken")
			end

			-- Special World Event Alerts (Mirage / Kitsune / Prehistoric / Full Moon)
			if S.AutoAlertSpecialEvents then
				local map = Workspace:FindFirstChild("Map")
				local checks = {
					{ Key = "Mirage", Obj = map and map:FindFirstChild("MysticIsland"), Msg = "Mirage Island has spawned!" },
					{ Key = "Kitsune", Obj = map and map:FindFirstChild("KitsuneIsland"), Msg = "Kitsune Island has spawned!" },
					{ Key = "Prehistoric", Obj = map and map:FindFirstChild("PrehistoricIsland"), Msg = "Prehistoric Island has spawned!" },
					{ Key = "Frozen", Obj = map and map:FindFirstChild("FrozenDimension"), Msg = "Frozen Dimension has spawned!" },
				}
				for _, ck in ipairs(checks) do
					if ck.Obj and not S.AlertedEvents[ck.Key] then
						S.AlertedEvents[ck.Key] = true
						notify("World Event!", ck.Msg, 6)
					elseif not ck.Obj then
						S.AlertedEvents[ck.Key] = nil
					end
				end
			end

			task.wait(0.75)
		end
	end)

	-- 5. ESP Worker (0.35s)
	trackThread(function()
		while not S.Unloaded do
			pcall(Eng.Player.UpdateESP)
			task.wait(0.35)
		end
	end)

	-- 6. Infinite Jump
	trackConn(UserInputService.JumpRequest:Connect(function()
		if S.Unloaded or not S.InfJumpOn then return end
		local hum = getHum()
		if hum then
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
		end
	end))

	-- 7. Anti-AFK
	trackConn(LP.Idled:Connect(function()
		if S.Unloaded or not S.AntiAFK then return end
		pcall(function()
			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.zero)
		end)
	end))

	-- 8. Respawn Hooks (Reapply SpeedLock, EnergyLock, Reset stale Emote)
	trackConn(LP.CharacterAdded:Connect(function()
		if S.Unloaded then return end
		Eng.Player.StopEmote()
		SpeedLock.Char = nil
		EnergyLock.Objs = {}
		task.wait(0.6)
		if S.Unloaded then return end
		if S.PlayerMods then Eng.Player.ApplySpeedLock() end
		if S.InfiniteEnergy then Eng.Player.BindEnergyLock() end
		if S.AutoBuso then Net.Comm("Buso") end
	end))
end

-- Zero-Leak Complete Unload (Fixes v1.6 SpeedLock/EnergyLock leak!)
local function UnloadAll()
	if S.Unloaded then return end
	S.Unloaded = true
	S.Farming = false
	S.ChestFarm = false
	S.AutoFarmBoss = false
	S.AutoFarmAllBosses = false
	S.AutoSeaEvents = false
	S.AutoRaid = false
	S.KillAura = false
	S.AimLockPlayer = false
	S.FlyOn = false
	S.WaterWalk = false
	S.HoldCF = nil

	Eng.Travel.CancelTween()
	Eng.Travel.DestroyPlatform()
	Eng.Player.StopFly()
	Eng.Player.StopEmote()
	Eng.Player.ReleaseSpeedLock()
	Eng.Player.ReleaseEnergyLock()
	Eng.Player.ClearAllESP()
	Eng.PvP.RestoreHitboxes()
	Eng.PvP.SetSpectate(nil)

	if S.FPSBoost then pcall(Eng.Player.SetFPSBoost, false) end
	if S.WaterPart then pcall(function() S.WaterPart:Destroy() end); S.WaterPart = nil end
	if S.Disable3DRender then pcall(function() RunService:Set3dRenderingEnabled(true) end) end

	-- Restore Lighting & Camera
	if S.OrigLighting then
		pcall(function()
			Lighting.Brightness = S.OrigLighting.Brightness
			Lighting.ClockTime = S.OrigLighting.ClockTime
			Lighting.FogEnd = S.OrigLighting.FogEnd
			Lighting.FogStart = S.OrigLighting.FogStart
			Lighting.GlobalShadows = S.OrigLighting.GlobalShadows
			Lighting.Ambient = S.OrigLighting.Ambient
			Lighting.OutdoorAmbient = S.OrigLighting.OutdoorAmbient
		end)
	end
	pcall(function()
		local cam = Workspace.CurrentCamera
		if cam then cam.FieldOfView = S.OrigFOV or 70 end
		LP.CameraMaxZoomDistance = S.OrigZoom or 400
	end)

	-- Disconnect all tracked connections, cancel threads, destroy instances
	for _, c in ipairs(S.Conns) do pcall(function() c:Disconnect() end) end
	S.Conns = {}
	for _, th in ipairs(S.Threads) do pcall(function() task.cancel(th) end) end
	S.Threads = {}
	for _, inst in ipairs(S.Instances) do pcall(function() inst:Destroy() end) end
	S.Instances = {}

	-- Close NexusUI Window cleanly
	pcall(function()
		if Window and Window.Destroy then Window:Destroy() end
	end)
	env.NexusBF = nil
	env.NexusBloxFruitsUnload = nil
end

