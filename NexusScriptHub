-- Interactive Click Tool Generator (Click TP / Click Couch Kill / Click Fling / Click Copy Avatar)
function Eng.Troll.GiveClickTool(kind)
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if not bp then return end
	local names = {
		tp = "Nexus Click TP",
		couch = "Nexus Click Couch Kill",
		couchfling = "Nexus Click Couch Fling",
		fling = "Nexus Click Fling",
		copy = "Nexus Click Copy Avatar",
	}
	local toolName = names[kind] or "Nexus Click Tool"
	if bp:FindFirstChild(toolName) or (getChar() and getChar():FindFirstChild(toolName)) then
		notify("Click Tool", toolName .. " is already in your inventory!", 2.5)
		return
	end
	local tool = Instance.new("Tool")
	tool.Name = toolName
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "Click anywhere / any player to trigger " .. toolName

	local mouse = LocalPlayer:GetMouse()
	trackConn(tool.Activated:Connect(function()
		if S.Unloaded then return end
		if kind == "tp" then
			local hit = mouse.Hit
			if hit then
				safePivot(getChar(), CFrame.new(hit.Position + Vector3.new(0, 3.5, 0)))
			end
		else
			local hitPart = mouse.Target
			local model = hitPart and hitPart:FindFirstAncestorOfClass("Model")
			local targetPlr = model and Players:GetPlayerFromCharacter(model)
			if not targetPlr or targetPlr == LocalPlayer then
				notify(toolName, "Click directly on another player!", 2)
				return
			end
			if kind == "couch" then
				trackThread(function() Eng.Troll.CouchAction(targetPlr, "kill") end)
			elseif kind == "couchfling" then
				trackThread(function() Eng.Troll.CouchAction(targetPlr, "fling") end)
			elseif kind == "fling" then
				Eng.Troll.PhysicsFling(targetPlr)
			elseif kind == "copy" then
				Eng.Avatar.CopyPlayer(targetPlr, false)
			end
		end
	end))
	tool.Parent = bp
	trackInstance(tool)
	notify("Click Tool", "Added " .. toolName .. " to your Backpack!", 3)
end

