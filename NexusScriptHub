    bind("wallwalk", RunService.Stepped:Connect(function()
        local h = lpHum()
        if h then h.AutoRotate = false end
        local root = lpRoot()
        if not root then return end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { lpChar() }
        local right = root.CFrame.RightVector
        local hit = Workspace:Raycast(root.Position, right * 2.5, params)
            or Workspace:Raycast(root.Position, -right * 2.5, params)
        if hit and math.abs(hit.Normal.Y) < 0.3 then
            local up = hit.Normal
            local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
            if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
            root.CFrame = CFrame.lookAt(root.Position, root.Position + look, up)
            root.CFrame = root.CFrame + up * -0.4
        end
    end))
    logOk("WallWalk ON")
end)

