-- Kill Aura 2 Engine (Zero Self-TP Instant Kill All while standing still!)
do
	local pDataCache, pDataAt = nil, 0
	local function getMatchPlayerData()
		local now = os.clock()
		if now - pDataAt < 0.8 and pDataCache then return pDataCache end
		pDataAt = now
		local ok, res = pcall(function()
			local rem = ReplicatedStorage:FindFirstChild("Remotes")
			local gp = rem and rem:FindFirstChild("Gameplay")
			local fn = gp and gp:FindFirstChild("GetPlayerData")
			if fn and fn:IsA("RemoteFunction") then
				return fn:InvokeServer()
			end
			return nil
		end)
		if ok and type(res) == "table" then pDataCache = res end
		return pDataCache
	end

	local function getAliveTargets()
		local targets = {}
		local pdata = getMatchPlayerData()
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
				local ff = plr.Character:FindFirstChildOfClass("ForceField")
				if hum and hum.Health > 0 and hrp and not ff then
					local skipDead = false
					if type(pdata) == "table" and type(pdata[plr.Name]) == "table" then
						if pdata[plr.Name].Dead == true or pdata[plr.Name].Killed == true then
							skipDead = true
						end
					end
					if not skipDead then
						targets[#targets + 1] = {Player = plr, Char = plr.Character, Root = hrp}
					end
				end
			end
		end
		return targets
	end

	local function pulseStrike(knife, handle, targets)
		if not RootPart or not knife then return 0 end
		local stabRemote = knife:FindFirstChild("Stab")
		local strikeCF = (handle and handle.CFrame) or (RootPart.CFrame * CFrame.new(0, 0, -1.8))
		local hasFTI = (typeof(firetouchinterest) == "function")
		pcall(function() knife:Activate() end)
		if stabRemote and stabRemote:IsA("RemoteEvent") then
			pcall(function() stabRemote:FireServer("Down") end)
			pcall(function() stabRemote:FireServer("Slash") end)
		end
		local hitCount = 0
		for _, entry in ipairs(targets) do
			local tRoot = entry.Root
			local tChar = entry.Char
			if tRoot and tRoot.Parent then
				hitCount = hitCount + 1
				if State.KillAura2Pull ~= false then
					pcall(function()
						tRoot.CanCollide = false
						tRoot.CFrame = strikeCF
						tRoot.AssemblyLinearVelocity = Vector3.zero
					end)
				end
				if hasFTI and handle then
					pcall(function()
						firetouchinterest(tRoot, handle, 0)
						firetouchinterest(tRoot, handle, 1)
						local torso = tChar and (tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("Head"))
						if torso then
							firetouchinterest(torso, handle, 0)
							firetouchinterest(torso, handle, 1)
						end
					end)
				end
			end
		end
		return hitCount
	end

	function V25.RunKillAura2(singleBurst)
		if State.Unloaded or not RootPart or not Humanoid or Humanoid.Health <= 0 then
			return false, 0
		end
		local knife = FindToolByRole(LocalPlayer, "Murderer", true)
		if not knife then
			if State.KillAura2RequireHeld and not singleBurst then
				return false, 0
			end
			local bpKnife = FindToolByRole(LocalPlayer, "Murderer", false)
			if not bpKnife then
				return false, 0
			end
			EquipTool(bpKnife)
			if bpKnife.Parent ~= Character and Character then
				pcall(function() bpKnife.Parent = Character end)
			end
			knife = bpKnife
		end
		local handle = knife:FindFirstChild("Handle") or knife:FindFirstChildWhichIsA("BasePart", true)
		local targets = getAliveTargets()
		if #targets == 0 then return true, 0 end
		if singleBurst then
			local total = 0
			for _ = 1, 4 do
				if State.Unloaded or not knife or not knife.Parent then break end
				total = pulseStrike(knife, handle, getAliveTargets())
				task.wait(0.06)
			end
			return true, total
		else
			local hits = pulseStrike(knife, handle, targets)
			return true, hits
		end
	end
end

