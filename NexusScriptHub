		notify("Server Hop", preferLow and "Finding low-player server..." or "Finding new server...", 3)
		local order = preferLow and "Asc" or "Desc"
		local ok, raw = pcall(function()
			return game:HttpGet("https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=" .. order .. "&limit=50")
