-- Universal Fly Engine for MM2 (BodyVelocity + BodyGyro)
function FlyStop(silent)
	Fly.Active = false
	if Fly.Velocity then pcall(function() Fly.Velocity:Destroy() end); Fly.Velocity = nil end
	if Fly.Align then pcall(function() Fly.Align:Destroy() end); Fly.Align = nil end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then pcall(function() hum.PlatformStand = false end) end
	if not silent then
		pcall(function() Notify("Fly off", 1.5) end)
	end
end

function FlyStart()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
	if not (root and hum and hum.Health > 0) then
		pcall(function() Notify("Fly: character not ready", 2.5) end)
		return false
	end

	FlyStop(true)
	pcall(function() hum.PlatformStand = true end)

	local bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "NexusFlyVelocity"
	bodyVelocity.Velocity = Vector3.new(0, 0, 0)
	bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bodyVelocity.Parent = root
	Fly.Velocity = bodyVelocity

	local bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "NexusFlyGyro"
	bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	bodyGyro.P = 10000
	bodyGyro.D = 500
	bodyGyro.CFrame = root.CFrame
	bodyGyro.Parent = root
	Fly.Align = bodyGyro

	Fly.Active = true

	task.spawn(function()
		while Fly.Active and Fly.Velocity and Fly.Align and root and root.Parent do
			local camera = workspace.CurrentCamera
			local direction = Vector3.new(0, 0, 0)

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction - camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction - camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction = direction + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direction = direction + Vector3.new(0, -1, 0) end

			local spd = tonumber(State.FlySpeed) or 50
			if direction.Magnitude > 0 then
				direction = direction.Unit * spd
			end

			if Fly.Velocity and Fly.Velocity.Parent then Fly.Velocity.Velocity = direction end
			if Fly.Align and Fly.Align.Parent then Fly.Align.CFrame = CFrame.new(root.Position, root.Position + camera.CFrame.LookVector) end

			task.wait()
		end
	end)
	return true
end

