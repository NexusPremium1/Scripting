	local drag = false
	local function apply(x)
		local rel = math.clamp((x - spamTrack.AbsolutePosition.X) / math.max(1, spamTrack.AbsoluteSize.X), 0, 1)
		CONFIG.spamDelay = math.floor((0.4 + rel * 4.6) * 10 + 0.5) / 10
		paintSpamDelay()
	end
	ApexBind(spamTrack.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			drag = true
			apply(input.Position.X)
		end
	end)
	ApexBind(UserInputService.InputChanged, function(input)
		if drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			apply(input.Position.X)
		end
	end)
