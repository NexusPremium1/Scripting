		CoinTagHighlight.FillTransparency = 0.35
		CoinTagHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	end
	CoinTagHighlight.Adornee = coin
	CoinTagHighlight.Parent = coin
	CoinTagHighlight.Enabled = true
	if not CoinTagBillboard or not CoinTagBillboard.Parent then
		CoinTagBillboard = Instance.new("BillboardGui")
