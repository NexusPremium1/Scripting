				obj:Destroy()
			end)
		end
		table.clear(BloodObjects)
		local sky = Instance.new("Sky")
		sky.Name = "NexusDramaticSky"
		sky.SkyboxBk = "rbxassetid://644488433"
		sky.SkyboxDn = "rbxassetid://644488433"
