	-- FIXED Auto Breaker Minigame (deduplicated + tracked connection!)
	local function HookBreaker(breaker)
		if not breaker or S.HookedBreakers[breaker] then return end
		S.HookedBreakers[breaker] = true
		task.spawn(function()
			local sg = breaker:WaitForChild("SurfaceGui", 6)
			local frame = sg and sg:WaitForChild("Frame", 6)
			local codeLabel = frame and frame:WaitForChild("Code", 6)
			if not codeLabel then return end
			local function step()
				task.wait(0.05)
				if S.Unloaded or not (Toggles.AutoBreaker and Toggles.AutoBreaker.Value) then return end
				local target = tonumber(codeLabel.Text)
				if not target then return end
				local box = codeLabel:FindFirstChild("Frame")
				local trans = box and box.BackgroundTransparency or nil
				for _, sw in ipairs(breaker:GetChildren()) do
					if sw.Name == "BreakerSwitch" and sw:GetAttribute("ID") == target then
						local pc = sw:FindFirstChild("PrismaticConstraint")
						local light = sw:FindFirstChild("Light")
						local sound = sw:FindFirstChild("Sound")
						if trans == 0 and not sw:GetAttribute("Enabled") then
							sw:SetAttribute("Enabled", true)
							if pc then pc.TargetPosition = -0.2 end
							if light then
								light.Material = Enum.Material.Neon
								local spark = light:FindFirstChild("Spark", true)
								if spark and spark.Emit then spark:Emit(1) end
							end
							if sound then pcall(sound.Play, sound) end
						elseif trans == 1 and sw:GetAttribute("Enabled") then
							sw:SetAttribute("Enabled", false)
							if pc then pc.TargetPosition = 0.2 end
							if light then light.Material = Enum.Material.Glass end
							if sound then pcall(sound.Play, sound) end
						end
						break
					end
				end
			end
			TrackConn(codeLabel:GetPropertyChangedSignal("Text"):Connect(step))
			step()
		end)
	end

