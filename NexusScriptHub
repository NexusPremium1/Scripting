	local ApexCfgLib = Library
	local ApexCfgSM = SaveManager
	if not ApexCfgLib then
		pcall(function() ApexCfgLib = getgenv().Nexus or getgenv().Library end)
	end
	if not ApexCfgSM and ApexCfgLib then
		pcall(function() ApexCfgSM = ApexCfgLib.SaveManager end)
	end
	if ApexCfgLib and ApexCfgSM and not ApexCfgSM.__ApexAutoConfigV1 and type(writefile) == "function" and type(isfile) == "function" then
		ApexCfgSM.__ApexAutoConfigV1 = true
		local function ApexCfgNotify(text)
			pcall(function() ApexCfgLib:Notify(tostring(text), 3) end)
		end
		local function ApexCfgPath()
			return tostring(ApexCfgSM.Folder) .. "/settings/" .. ApexCfgName .. ".json"
		end
		local function ApexCfgSave()
			local ok = pcall(function() return ApexCfgSM:Save(ApexCfgName) end)
			return ok
		end
		local function ApexCfgLoad()
			local ok = pcall(function() return ApexCfgSM:Load(ApexCfgName) end)
			return ok
		end
		local function ApexCfgDelete()
			local ok = pcall(function() return ApexCfgSM:Delete(ApexCfgName) end)
			return ok
		end
		local function ApexCfgValueText(value)
			local valueType = typeof(value)
			if valueType == "Color3" then
				local ok, hex = pcall(function() return value:ToHex() end)
				if ok then return hex end
			end
			if valueType == "table" then
				local parts = {}
				for k, v in pairs(value) do
					if v == true then
						parts[#parts + 1] = tostring(k)
					elseif type(k) == "number" then
						parts[#parts + 1] = tostring(v)
					else
						parts[#parts + 1] = tostring(k) .. "=" .. tostring(v)
					end
				end
				table.sort(parts)
				return "{" .. table.concat(parts, ",") .. "}"
			end
			return tostring(value)
		end
		local function ApexCfgFingerprint()
			local parts = {}
			local function scan(prefix, bag)
				if type(bag) ~= "table" then return end
				local keys = {}
				for k in pairs(bag) do
					keys[#keys + 1] = tostring(k)
				end
				table.sort(keys)
				for _, key in ipairs(keys) do
					if not (ApexCfgSM.Ignore and ApexCfgSM.Ignore[key]) then
						local object = bag[key]
						if type(object) == "table" and object.Value ~= nil then
							parts[#parts + 1] = prefix .. ":" .. key .. "=" .. ApexCfgValueText(object.Value) .. "|" .. ApexCfgValueText(object.Transparency) .. "|" .. ApexCfgValueText(object.Mode) .. "|" .. ApexCfgValueText(object.Modifiers)
						end
					end
				end
			end
			scan("T", ApexCfgLib.Toggles)
			scan("O", ApexCfgLib.Options)
			return table.concat(parts, ";")
		end
		local function ApexCfgAddGui()
			local group = nil
			pcall(function() group = SettingsRight end)
			if not group then
				pcall(function()
					if Tabs and Tabs.Settings then
						group = Tabs.Settings:AddRightGroupbox("Apex Config")
					end
				end)
			end
			if not group then return end
			pcall(function() group:AddLabel("Apex auto config: ON", true) end)
			pcall(function() group:AddLabel("File: " .. ApexCfgPath(), true) end)
			pcall(function()
				group:AddButton({Text = "Save Apex config now", Func = function()
					if ApexCfgSave() then ApexCfgNotify("Apex config saved") end
				end})
			end)
			pcall(function()
				group:AddButton({Text = "Load Apex autosave", Func = function()
					if ApexCfgLoad() then ApexCfgNotify("Apex config loaded") end
				end})
			end)
			pcall(function()
				group:AddButton({Text = "Reset Apex autosave", DoubleClick = true, Func = function()
					if ApexCfgDelete() then ApexCfgNotify("Apex autosave deleted") end
				end})
			end)
		end
		task.spawn(function()
			task.wait(0.35)
			pcall(function() ApexCfgSM:CheckFolderTree() end)
			local hasAutosave = false
			pcall(function() hasAutosave = isfile(ApexCfgPath()) end)
			if hasAutosave then
				ApexCfgLoad()
			else
				ApexCfgSave()
			end
			pcall(function() ApexCfgSM:SaveAutoloadConfig(ApexCfgName) end)
			pcall(function()
				if ApexCfgSM.AutoloadConfigLabel then
					ApexCfgSM.AutoloadConfigLabel:SetText("Current autoload config: " .. ApexCfgName)
				end
			end)
			ApexCfgAddGui()
			local alive = true
			pcall(function()
				ApexCfgLib:OnUnload(function()
					alive = false
					ApexCfgSave()
				end)
			end)
			task.wait(1)
			local lastFingerprint = ApexCfgFingerprint()
			while alive and not ApexCfgLib.Unloaded do
				task.wait(2)
				local fingerprint = ApexCfgFingerprint()
				if fingerprint ~= lastFingerprint then
					lastFingerprint = fingerprint
					ApexCfgSave()
				end
			end
		end)
	end
end

