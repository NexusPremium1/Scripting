-- ░░ normal aimbot core (Apex "aimbot" · not the WRD one) ░░
-- Picks the target closest to the CURSOR inside the FOV circle; speed
-- divisor:  delta = (target - cursor) / max(1, smooth / 10)
local function pickByMouse(fovPx, partName, visibleOnly, maxRange)
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local mouse = UIS:GetMouseLocation()
	local best, bestDist = nil, math.huge
	local myRoot = rootOf(LocalPlayer.Character)
	local myPos = myRoot and myRoot.Position or cam.CFrame.Position

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and not teammateBlocked(plr) then
			local head = targetPosition(plr, partName, 0)
			if head then
				local screenPos, onScreen = cam:WorldToViewportPoint(head)
				if onScreen and screenPos.Z > 0 then
					local distance = (Vector2.new(screenPos.X, screenPos.Y) - mouse).Magnitude
					local inRange = (myPos - head).Magnitude <= (maxRange or 900)
					if inRange and distance < fovPx and distance < bestDist then
						local visibleOk = true
						if visibleOnly then
							local part = resolvePart(plr, partName)
							visibleOk = part ~= nil and visibleFromCamera(part)
						end
						if visibleOk then
							bestDist = distance
							best = plr
						end
					end
			end
		end
	end
	end
	return best
end

local function moveMouse(dx, dy)
	if type(mousemoverel) == "function" then
		local ok = pcall(mousemoverel, dx, dy)
		if ok then return true end
	end
	if type(mousemoveabs) == "function" then
		local mouse = UIS:GetMouseLocation()
		local ok = pcall(mousemoveabs, mouse.X + dx, mouse.Y + dy)
		if ok then return true end
	end
	return false
end

-- ░░ v4.3 · scope (right mouse) tracking · the aimbot ONLY runs while the scope is held ░░
local scopeHeld = false
pcall(function()
	UIS.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then scopeHeld = true end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then scopeHeld = false end
	end)
end)

local function isScoped()
	if scopeHeld then return true end
	local ok, pressed = pcall(function()
		return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
	end)
	return (ok and pressed) and true or false
end

-- ░░ v4.3 · NEXUS AIM CORE ░░
-- The aimbot logic exactly as the user supplied it:
--   · the red FOV circle follows the CURSOR (not the centre of the screen)
--   · of the targets inside the circle the one CLOSEST to the cursor is picked
--   · every frame the cursor is pulled by (target - cursor) / max(1, smooth / 10)
--   · if the right mouse (scope) is not held the mouse is never touched
local AIM_DIV_MIN = 1
local function aimStep()
	local active = Cfg.Aimbot and aimWanted()
	if FovCircle then
		if active then
			local mouse = UIS:GetMouseLocation()
			FovCircle.Position = Vector2.new(mouse.X, mouse.Y)
			FovCircle.Radius = math.max(8, Cfg.AimFOV)
			FovCircle.Thickness = 1.5
			FovCircle.Color = Color3.fromRGB(255, 80, 80)
			FovCircle.Transparency = 0.2
			FovCircle.NumSides = 72
		end
		FovCircle.Visible = active and Cfg.ShowFOV or false
	end
	if not active then
		lastTarget = nil
		return
	end
	-- the mouse is pulled only while the scope (right mouse) is held
	if not isScoped() then
		lastTarget = nil
		return
	end
	if UIS:GetFocusedTextBox() then return end

	local cam = workspace.CurrentCamera
	if not cam then return end

	local target = pickByMouse(Cfg.AimFOV, Cfg.AimPart, Cfg.AimVisible, Cfg.AimRange)
	lastTarget = target
	if not target then return end

	local worldPos = targetPosition(target, Cfg.AimPart, Cfg.AimPredict)
	if not worldPos then return end

	local screenPos, onScreen = cam:WorldToViewportPoint(worldPos)
	if not onScreen or screenPos.Z <= 0 then return end

	local goal = Vector2.new(screenPos.X, screenPos.Y)
	local current = UIS:GetMouseLocation()
	-- 1 = instant lock · 100 = slow glide
	local divisor = math.max(AIM_DIV_MIN, (Cfg.AimSmooth or 65) / 10)
	moveMouse((goal.X - current.X) / divisor, (goal.Y - current.Y) / divisor)
end

