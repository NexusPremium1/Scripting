	local function GetLibraryCode()
		local codeLen = (Floor and Floor.Value == "Fools") and 10 or 5
		local slot = table.create(codeLen, "_")
		local paper = nil
		for _, plr in ipairs(Players:GetPlayers()) do
			local c = plr.Character
			local bp = plr:FindFirstChildOfClass("Backpack")
			paper = (c and (c:FindFirstChild("LibraryHintPaper") or c:FindFirstChild("LibraryHintPaperHard")))
				or (bp and (bp:FindFirstChild("LibraryHintPaper") or bp:FindFirstChild("LibraryHintPaperHard")))
			if paper then break end
		end
		if not paper then return nil end
		local ui = paper:FindFirstChild("UI")
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		local main = pg and pg:FindFirstChild("MainUI")
		local permUI = pg and (pg:FindFirstChild("PermUI") or (main and main:FindFirstChild("PermUI")))
		local hintsFolder = permUI and permUI:FindFirstChild("Hints")
		if not ui or not hintsFolder then return table.concat(slot) end
		local hints = hintsFolder:GetChildren()
		for _, icon in ipairs(ui:GetChildren()) do
			if icon:IsA("ImageLabel") and icon.Name ~= "Image" then
				local pos = tonumber(icon.Name)
				if pos and slot[pos] then
					for _, h in ipairs(hints) do
						if h.Name == "Icon" and h.ImageRectOffset == icon.ImageRectOffset then
							local lbl = h:FindFirstChild("TextLabel")
							if lbl and tostring(lbl.Text):match("^%d$") then slot[pos] = lbl.Text end
							break
						end
					end
				end
			end
		end
		return table.concat(slot)
	end

	-- Library helpers: inspect only the Library model, never the whole game.
	local LibraryState = { busy = false, last = 0, code = nil, attempts = 0 }
	local function LibraryRoom()
		local rooms = workspace:FindFirstChild("CurrentRooms")
		return rooms and rooms:FindFirstChild("50")
	end
	local function LibraryLock()
		local room = LibraryRoom()
		if not room then return nil end
		local lock = room:FindFirstChild("Padlock", true)
		if lock then return lock end
		local door = room:FindFirstChild("Door")
		return door and door:FindFirstChild("Lock", true)
	end
	local function RepairLibraryPrompt(showStatus)
		local lock = LibraryLock()
		if not lock then
			if showStatus then Notify("Library padlock not loaded. Walk closer to the exit gate.", 5) end
			return nil
		end
		local prompt
		for _, item in ipairs(lock:GetDescendants()) do
			if item:IsA("ProximityPrompt") then
				if item.Name == "NexusInfPrompt" then
					item:Destroy()
				else
					-- Restore only script-owned clones; do not enable a server-disabled lock.
					if item:GetAttribute("NexusInfActive") then
						item:SetAttribute("NexusInfActive", nil)
						item.Enabled = true
					end
					if item.Enabled then prompt = prompt or item end
				end
			end
			if item:IsA("BasePart") and S.PartCanTouch[item] ~= nil then
				item.CanTouch = S.PartCanTouch[item]
			end
		end
		if showStatus then
			Notify(prompt and "Library prompt restored. Use the normal interaction key at the padlock."
				or "Padlock found, but no enabled prompt. It may already be open or server-disabled.", 5)
		end
		return prompt, lock
	end
	local function SubmitLibraryCode(manual)
		if LibraryState.busy then return end
		local code = GetLibraryCode()
		local length = (Floor and Floor.Value == "Fools") and 10 or 5
		if not code or #code ~= length or not code:match("^%d+$") then
			if manual then Notify("Library code incomplete: " .. tostring(code or "no Hint Paper") .. ". Collect the matching books and paper.", 6) end
			return
		end
		local lock = LibraryLock()
		local hrp = GetHRP()
		local pos = lock and GetObjPos(lock)
		if not hrp or not pos or (hrp.Position - pos).Magnitude > 15 then
			if manual then Notify("Walk within 15 studs of the Library padlock first.", 5) end
			return
		end
		if LibraryState.code ~= code then
			LibraryState.code, LibraryState.attempts = code, 0
		end
		if not manual and (LibraryState.attempts >= 3 or os.clock() - LibraryState.last < 3) then return end
		-- Resolve the remote again: streaming/startup may have made the old cache nil.
		local folder = ReplicatedStorage:FindFirstChild("RemotesFolder")
			or ReplicatedStorage:FindFirstChild("EntityInfo") or ReplicatedStorage:FindFirstChild("Bricks")
		local remote = folder and folder:FindFirstChild("PL")
		if not remote or not remote:IsA("RemoteEvent") then
			if manual then Notify("Library submit remote unavailable. Use the native keypad instead.", 5) end
			return
		end
		LibraryState.busy = true
		LibraryState.last = os.clock()
		LibraryState.attempts = LibraryState.attempts + 1
		task.spawn(function()
			local ok, err = pcall(function() remote:FireServer(code) end)
			LibraryState.busy = false
			if not ok then
				Notify("Library submission error: " .. tostring(err), 6)
			elseif manual or LibraryState.attempts == 1 then
				Notify("Library code sent: " .. code .. ". Submission is not confirmation that the server accepted it.", 6)
			elseif LibraryState.attempts == 3 then
				Notify("Library: automatic retries finished. If still locked, use the native keypad or send again manually.", 6)
			end
		end)
	end

	-- FIXED Mines Door 150 / 50 Anchor Solver (computes AND submits `finalCode`!)
	local function ComputeAnchorCode(anchor, rawCode)
		if not anchor or not rawCode then return rawCode end
		local note = anchor:FindFirstChild("Note")
		local sg = note and note:FindFirstChildOfClass("SurfaceGui")
		local tl = sg and sg:FindFirstChildOfClass("TextLabel")
		local noteText = (tl and tl.Text) or ""
		local mod = tonumber(string.match(noteText, "%d+")) or 0
		if mod == 0 then return tostring(rawCode) end
		local isAdd = string.find(noteText, "+", 1, true) ~= nil
		local isSub = string.find(noteText, "-", 1, true) ~= nil
		local out = {}
		for i = 1, #rawCode do
			local d = tonumber(string.sub(rawCode, i, i))
			if d then
				local res = isAdd and ((d + mod) % 10)
					or (isSub and ((d - mod) % 10) or d)
				if res < 0 then res = res + 10 end
				out[i] = tostring(res)
			else
				out[i] = string.sub(rawCode, i, i)
			end
		end
		return table.concat(out)
	end

	-- Real GetNearestHidingSpot (powers Auto-Hide & Quick-Hide!)
	local function GetNearestHidingSpot(maxRange)
		local hrp = GetHRP()
		if not hrp then return nil end
		local best, bestDist = nil, maxRange or math.huge
		local curRooms = workspace:FindFirstChild("CurrentRooms")
		local function checkCloset(closet)
			if not closet or not closet.Parent then return end
			local prompt = closet:FindFirstChild("HidePrompt")
				or closet:FindFirstChildWhichIsA("ProximityPrompt", true)
			if not prompt or not prompt.Enabled then return end
			if closet:GetAttribute("Occupied") then return end
			local hiddenPlayer = closet:FindFirstChild("HiddenPlayer")
			if hiddenPlayer and hiddenPlayer:IsA("ObjectValue") and hiddenPlayer.Value ~= nil
				and hiddenPlayer.Value ~= LocalPlayer.Character then
				return
			end
			local pos = GetObjPos(closet)
			if not pos then return end
			local d = (hrp.Position - pos).Magnitude
			if d < bestDist then
				bestDist = d
				best = closet
			end
		end
		for i = #S.Closets, 1, -1 do
			local c = S.Closets[i]
			if not c or not c.Parent then
				table.remove(S.Closets, i)
			else
				checkCloset(c)
			end
		end
		-- Fallback scan of current room if cache was empty
		if not best and curRooms and LatestRoom then
			local curNum = tonumber(LocalPlayer:GetAttribute("CurrentRoom")) or tonumber(LatestRoom.Value) or 0
			for offset = 0, -1, -1 do
				local rm = curRooms:FindFirstChild(tostring(curNum + offset))
				if rm then
					for _, desc in ipairs(rm:GetDescendants()) do
						if Catalog.HidingPlaces[desc.Name] then
							if not S.ClosetSet[desc] then
								S.ClosetSet[desc] = true
								S.Closets[#S.Closets + 1] = desc
							end
							checkCloset(desc)
						end
					end
				end
			end
		end
		return best, bestDist
	end

