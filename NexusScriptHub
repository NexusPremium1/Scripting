	local coin = FindNearestCoin()
	if not coin then
		if CoinTagHighlight then
			CoinTagHighlight.Enabled = false
		end
		if CoinTagBillboard then
			CoinTagBillboard.Enabled = false
		end
		return
	end
	if not CoinTagHighlight or not CoinTagHighlight.Parent then
		CoinTagHighlight = Instance.new("Highlight")
