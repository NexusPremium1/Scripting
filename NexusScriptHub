				RunService.Heartbeat:Wait()
			end
			if caught then
				safePivot(myCar, CFrame.new(0, -1400, 0))
				task.wait(0.55)
			end
			hum.Sit = false
			task.wait(0.1)
			Net.DeleteCars()
		end)
		S.TrollActive = false
		pcall(function()
			safePivot(getChar(), origCF)
			zeroVelocity(getRoot())
		end)
	end)
