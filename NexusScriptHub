		if tip and tip.Parent then tw(tip, 0.22, {TextTransparency = State.Settings.Animations and 1 or 0.15}):Play() end
	end)

	-- drag (a drag is not a click)
	local dragging = false
	local dragStart = nil
	local startPos = nil
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			Apex.Runtime.QuickMoved = false
			dragStart = input.Position
			startPos = button.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if Apex.Runtime.QuickMoved then
						task.delay(0.12, function() Apex.Runtime.QuickMoved = false end)
					end
				end
			end)
		end
	end)
	Apex.Runtime.QuickInputConn = UserInputService.InputChanged:Connect(function(input)
		if not button.Parent then
			if Apex.Runtime.QuickInputConn then
				pcall(function() Apex.Runtime.QuickInputConn:Disconnect() end)
				Apex.Runtime.QuickInputConn = nil
			end
			return
		end
		if not dragging or not dragStart or not startPos then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - dragStart
		if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
			Apex.Runtime.QuickMoved = true
		end
		button.Position = UDim2.new(0, math.floor(startPos.X.Offset + delta.X + 0.5), 0, math.floor(startPos.Y.Offset + delta.Y + 0.5))
	end)
	button.MouseButton1Click:Connect(function()
		if Apex.Runtime.QuickMoved then return end
		Apex.ToggleHub()
	end)
	return gui
