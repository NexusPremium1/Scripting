-- Extended tab ticker. This block used to live inside StopDropkick, so walk boost, tracers and
-- auto block only ever ran for one frame after a dropkick ended. It now runs every heartbeat.
local function LegacyTick()
	if State.LegacyWalkBoost and Humanoid and RootPart and Humanoid.MoveDirection.Magnitude > 0 then
		RootPart.CFrame = RootPart.CFrame + (Humanoid.MoveDirection * State.LegacyWalkStep)
	end
	if State.LegacyJumpBoost and Humanoid and Humanoid.Parent then
		Humanoid.UseJumpPower = false
		if Humanoid.JumpHeight ~= State.LegacyJumpHeight then
			Humanoid.JumpHeight = State.LegacyJumpHeight
		end
	end
	if State.LegacyAntiStun and Character then
		-- The old version only looked for 4 fixed child names. TSB keeps the
		-- stun state in an attribute / BoolValue most of the time, which is why
		-- "Anti Stun" looked like it was not working.
		for _, stunName in ipairs({
			"Stun", "Stunned", "StunValue", "StunTime", "StunDuration",
			"IsStunned", "Ragdoll", "Ragdolled", "IsRagdoll",
		}) do
			local stun = Character:FindFirstChild(stunName)
			if stun then pcall(function() stun:Destroy() end) end
			if Character:GetAttribute(stunName) ~= nil then
				pcall(function() Character:SetAttribute(stunName, nil) end)
			end
		end
		if Humanoid and Humanoid.PlatformStand then
			pcall(function()
				Humanoid.PlatformStand = false
				Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
	end
	if State.LegacyTracers then
		local cam = workspace.CurrentCamera
		if cam then
			for player, line in pairs(LegacyTracerLines) do
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if root and hum and hum.Health > 0 then
					local screenPos, visible = cam:WorldToViewportPoint(root.Position)
					line.Visible = visible
					if visible then
						line.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
						line.To = Vector2.new(screenPos.X, screenPos.Y)
					end
				else
					line.Visible = false
				end
			end
		end
	else
		for _, line in pairs(LegacyTracerLines) do
			pcall(function() line.Visible = false end)
		end
	end
	-- Auto Block used to run on a 0.12 s throttle and often missed the first frames of
	-- an attack. It now runs every Heartbeat with a busy guard so calls never stack up.
	if State.LegacyAutoBlock and not LegacyAnimBusy then
		LegacyAnimBusy = true
		task.spawn(function()
			pcall(LegacyCheckAnimations)
			pcall(LegacyCheckM1Catch)
			LegacyAnimBusy = false
		end)
	end
end
