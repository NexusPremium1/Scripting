	local function animEntry(name)
		for _, d in ipairs(DANCES) do
			if d[1] == name then return d end
		end
		return nil
	end

	function Anim.Stop()
		if Anim.Track then
			pcall(function() Anim.Track:Stop(0) end)
			pcall(function() Anim.Track:Destroy() end)
			Anim.Track = nil
		end
		Anim.Name = "OFF"
		pcall(function()
			local char = k and k.Character or LocalPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local animator = hum and hum:FindFirstChildOfClass("Animator")
			if animator then
				for _, trk in ipairs(animator:GetPlayingAnimationTracks()) do
					pcall(function() trk:Stop(0) end)
				end
			end
			if hum then
				for _, trk in ipairs(hum:GetPlayingAnimationTracks()) do
					pcall(function() trk:Stop(0) end)
				end
			end
		end)
	end

	function Anim.Play(name)
		local entry = animEntry(name)
		if not entry then return false, "unknown animation" end
		if Anim.Name == name and Anim.Track then
			local alive = false
			pcall(function() alive = Anim.Track.IsPlaying == true end)
			if alive then return true, "already" end
		end
		Anim.Stop()

		local char = k.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then
			return false, "no character - spawn first"
		end
		if (tonumber(hum.Health) or 0) <= 0 then
			return false, "you are dead - respawn first"
		end

		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then
			pcall(function()
				animator = Instance.new("Animator")
				animator.Parent = hum
			end)
		end

