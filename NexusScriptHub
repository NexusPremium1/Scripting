--[[ ═══════════════════════════════════════════════════════════════════════════
  APEX ENGINE · v10 "PRISM"   (v5.22 · RIVALS ULTRA RAGE)
  ---------------------------------------------------------------------------
  v9 dressed the v8 window up. v10 does not use that window at all: it is a
  second, complete front-end built from scratch on top of the same engine core
  (registry · compile · launch · favorites · telemetry), so nothing can break
  in the launcher while the interface gets a new body.

    rail      icon column with six views, settings + activity at the bottom
    hero      live search, game chip (IN GAME / IDLE), hotkey hints
    results   dense rows: index, title, meta, state chip, favorite, chevron
    inspector right pane: title, tags, source, size, launches, LAUNCH button
    activity  slide-up log drawer that mirrors every Apex.Logger line
    palette   Ctrl+K, fuzzy over modules + views + actions
    motion    one 20 Hz loop that only runs while the window is on screen

  Everything is client-side, hook-free, and the old window is kept alive but
  permanently hidden because the engine still writes its status line.
  ═══════════════════════════════════════════════════════════════════════════ ]]
do
	local TweenService = game:GetService("TweenService")
	local UIS = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local TeleportService = game:GetService("TeleportService")
	local Lighting = game:GetService("Lighting")
	local Players = game:GetService("Players")
	local HttpService = game:GetService("HttpService")
	local StatsService = game:GetService("Stats")
