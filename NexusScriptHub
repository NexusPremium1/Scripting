	--==========================================================================
	-- INITIAL WORKSPACE SEEDING (Single Pass — Zero Redundant Loops!)
	--==========================================================================
	local function ProcessRoomDescendant(obj)
		if S.Unloaded or not obj or not obj.Parent then return end
		local n = obj.Name

		-- Cache hiding spots
		if Catalog.HidingPlaces[n] and not S.ClosetSet[obj] then
			S.ClosetSet[obj] = true
			S.Closets[#S.Closets + 1] = obj
		end

		-- Cache ProximityPrompts & apply reach/instant/LOS
		if obj:IsA("ProximityPrompt") then
			if Toggles.InstaInteract and Toggles.InstaInteract.Value then ApplyPromptDuration(obj, true) end
			if Toggles.PromptReach and Toggles.PromptReach.Value then ApplyPromptRange(obj, true) end
			if Toggles.PromptClip and Toggles.PromptClip.Value then ApplyPromptLOS(obj, true) end
			if not Catalog.PromptIgnore[n] and not S.InteractSet[obj] then
				S.InteractSet[obj] = true
				S.Interactions[#S.Interactions + 1] = obj
			end
			if Toggles.InfItems and Toggles.InfItems.Value and IsInfItemPrompt(obj) and not S.InfItemsSet[obj] then
				S.InfItemsSet[obj] = true
				S.InfItemsStored[#S.InfItemsStored + 1] = obj
			end
		end

		-- Anti-Lag for new parts
		if Toggles.AntiLag and Toggles.AntiLag.Value and obj:IsA("BasePart") then
			ApplyPartAntiLag(obj, true)
		end

		-- Floor & Hazard Handlers (O(1) string checks)
		if n == "DoorFake" and Toggles.AntiDupe and Toggles.AntiDupe.Value then
			local h = obj:FindFirstChild("Hidden")
			if h then ApplyPartTouch(h, true) end
		elseif n == "Snare" and Toggles.AntiSnare and Toggles.AntiSnare.Value then
			ApplyModelTouch(obj, true)
		elseif n == "GiggleCeiling" and Toggles.AntiGiggle and Toggles.AntiGiggle.Value then
			ApplyModelTouch(obj, true)
		elseif (n == "GloomEgg" or n == "GloomPile") and Toggles.AntiGloomEgg and Toggles.AntiGloomEgg.Value then
			ApplyModelTouch(obj, true)
		elseif (n == "Seek_Arm" or n == "ChandelierObstruction") and Toggles.SeekObs and Toggles.SeekObs.Value then
			ApplyModelTouch(obj, true)
		elseif n == "SeekGuidingLight" and Toggles.ShowSeekPath and Toggles.ShowSeekPath.Value then
			ShowSeekPath(obj)
		elseif n == "SeekFloodline" and Toggles.AntiSeekFlood and Toggles.AntiSeekFlood.Value and obj:IsA("BasePart") then
			obj.CanCollide = true
		elseif n == "ElevatorBreaker" and Toggles.AutoBreaker and Toggles.AutoBreaker.Value then
			HookBreaker(obj)
		elseif n == "MinesAnchor" and not S.AnchorSet[obj] then
			S.AnchorSet[obj] = true
			S.Anchors[#S.Anchors + 1] = obj
		elseif n == "DuckBoard" and not S.DuckBoardSet[obj] then
			S.DuckBoardSet[obj] = true
			S.DuckBoards[#S.DuckBoards + 1] = obj
		elseif string.find(n, "MinecartNode", 1, true) and not S.MinecartNodeSet[obj] then
			S.MinecartNodeSet[obj] = true
			S.MinecartNodes[#S.MinecartNodes + 1] = obj
		elseif (n == "FigureRig" or n == "FigureRagdoll") and not S.FigureSet[obj] then
			S.FigureSet[obj] = true
			S.Figures[#S.Figures + 1] = obj
		elseif n == "Bridge" then
			if Toggles.FixBrokenBridge and Toggles.FixBrokenBridge.Value then FixBridge(obj) end
			if Toggles.RealBridge and Toggles.RealBridge.Value and obj:IsA("BasePart") and not obj.CanCollide then
				obj.Transparency = 1
			end
		elseif n == "Lava" and Toggles.AntiLava and Toggles.AntiLava.Value then
			ApplyModelTouch(obj, true)
		elseif n == "ScaryWall" and Toggles.AntiWall and Toggles.AntiWall.Value then
			ApplyModelTouch(obj, true)
		elseif (n == "ElectricWater" or n == "Currents" or n == "ShockWater")
			and Toggles.AntiElectricWater and Toggles.AntiElectricWater.Value then
			ApplyModelTouch(obj, true)
		elseif n == "SideroomSpace" and Toggles.AntiVacuum and Toggles.AntiVacuum.Value then
			local col = obj:FindFirstChild("Collision")
			if col and col:IsA("BasePart") then
				if S.PartCanCollide[col] == nil then S.PartCanCollide[col] = col.CanCollide end
				col.CanCollide = true
			end
		elseif n == "TriggerEventCollision" and Toggles.DeleteSeekFE and Toggles.DeleteSeekFE.Value and Cap.FireTouch then
			task.spawn(function()
				task.wait(0.15)
				local hrp = GetHRP()
				if not hrp then return end
				for _, part in ipairs(obj:GetChildren()) do
					if part.Name == "Collision" and part:IsA("BasePart") then
						pcall(Cap.FireTouch, hrp, part, 0)
						task.wait(0.03)
						pcall(Cap.FireTouch, hrp, part, 1)
					end
				end
			end)
		end

		-- Entity or ESP classification
		if Catalog.Entities[n] then
			OnEntityDetected(obj)
		else
			ClassifyAndApplyESP(obj)
		end
	end

	-- (Re)bind CurrentRooms listeners: the container may be ABSENT at load
	-- (lobby execution) or REPLACED on floor teleports (Archives/Stairwell…).
	-- Without rebinding, ALL spawn-time handling silently dies on that floor:
	-- entity registration, water/seek antis, ESP classification, Archives anti.
	local function BindCurrentRooms()
		local curRooms = workspace:FindFirstChild("CurrentRooms")
		if not curRooms or S.RoomsBound == curRooms then return end
		S.RoomsBound = curRooms
		for _, desc in ipairs(curRooms:GetDescendants()) do
			ProcessRoomDescendant(desc)
		end
		TrackConn(curRooms.DescendantAdded:Connect(function(desc)
			if S.Unloaded then return end
			task.defer(ProcessRoomDescendant, desc)
		end))
		TrackConn(curRooms.DescendantRemoving:Connect(function(desc)
			if S.Unloaded then return end
			if S.ActiveEntities[desc] then S.ActiveEntities[desc] = nil end
			if ESP.Entries[desc] then ESP:Remove(desc) end
		end))
	end
	BindCurrentRooms()

	do

		-- Track top-level workspace entities & BananaPeels
		for _, child in ipairs(workspace:GetChildren()) do
			if Catalog.Entities[child.Name] then
				OnEntityDetected(child)
			end
		end
		TrackConn(workspace.ChildAdded:Connect(function(child)
			if S.Unloaded then return end
			if child.Name == "CurrentRooms" then
				task.defer(BindCurrentRooms)
			elseif Catalog.Entities[child.Name] then
				task.defer(OnEntityDetected, child)
			elseif child.Name == "BananaPeel" and Toggles.AntiBanana and Toggles.AntiBanana.Value then
				ApplyModelTouch(child, true)
			end
		end))
		TrackConn(workspace.ChildRemoved:Connect(function(child)
			if S.ActiveEntities[child] then S.ActiveEntities[child] = nil end
			if ESP.Entries[child] then ESP:Remove(child) end
		end))
	end

