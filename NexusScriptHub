local function getGunEffectObjects(tool, fallbackPart)
	local muzzle, hit = nil, nil
	if tool then
		local gs = tool:FindFirstChild("GunScript_Local", true)
		if gs then
			muzzle = gs:FindFirstChild("MuzzleEffect", true)
			hit = gs:FindFirstChild("HitEffect", true)
		end
		if not muzzle then muzzle = tool:FindFirstChild("MuzzleEffect", true) end
		if not hit then hit = tool:FindFirstChild("HitEffect", true) end
		if not muzzle then
			for _, d in ipairs(tool:GetDescendants()) do
				if d:IsA("ParticleEmitter") then
					muzzle = d
					break
				end
			end
		end
		if not hit then hit = muzzle end
	end
	-- Never pass Workspace (Workspace:Clone() returns nil on receiving clients!)
	return muzzle or fallbackPart, hit or muzzle or fallbackPart
end

local function fmtDiagVal(v, depth)
	depth = depth or 0
	local t = typeof(v)
	if t == "Instance" then
		local okN, nm = pcall(function() return v.Name end)
		local okC, cl = pcall(function() return v.ClassName end)
		local okP, pn = pcall(function() return v.Parent and v.Parent.Name or "nil" end)
		return string.format("%s(%s@%s)", tostring(okC and cl or "Inst"), tostring(okN and nm or "?"), tostring(okP and pn or "?"))
	elseif t == "Vector3" then
		return string.format("V3(%.1f,%.1f,%.1f)", v.X, v.Y, v.Z)
	elseif t == "BrickColor" then
		return "BC(" .. tostring(v.Name) .. ")"
	elseif t == "EnumItem" then
		return tostring(v)
	elseif t == "table" then
		if depth >= 1 then return "{...}" end
		local parts = {}
		local cnt = 0
		for k, val in pairs(v) do
			cnt = cnt + 1
			if cnt > 8 then table.insert(parts, "..."); break end
			table.insert(parts, tostring(k) .. "=" .. fmtDiagVal(val, depth + 1))
		end
		return "{" .. table.concat(parts, ",") .. "}"
	elseif t == "string" then
		return '"' .. tostring(v):sub(1, 32) .. '"'
	end
	return tostring(v)
end

local function deepCopyArgs(tbl)
	local out = {}
	for k, v in pairs(tbl) do
		if type(v) == "table" then
			out[k] = deepCopyArgs(v)
		else
			out[k] = v
		end
	end
	return out
end

local function injectIdIntoVal(orig, numId)
	local t = typeof(orig)
	if t == "number" then
		return numId
	elseif t == "string" then
		if orig:find("rbxassetid://", 1, true) then
			return "rbxassetid://" .. tostring(numId)
		elseif orig:find("http", 1, true) then
			return "rbxassetid://" .. tostring(numId)
		end
		return tostring(numId)
	elseif t == "table" then
		local copy = {}
		local replaced = false
		for k, v in pairs(orig) do
			if type(v) == "number" and v > 10000 then
				copy[k] = numId
				replaced = true
			elseif type(v) == "string" and (v:find("asset", 1, true) or v:match("^%d%d%d%d%d+$")) then
				copy[k] = injectIdIntoVal(v, numId)
				replaced = true
			else
				copy[k] = v
			end
		end
		if not replaced and #copy >= 1 then
			copy[1] = injectIdIntoVal(copy[1], numId)
		end
		return copy
	end
	return numId
end

local function fire1Gu1nFromTemplate(gunRemote, template, targetPlayer, numId)
	if not gunRemote or type(template) ~= "table" or #template < 8 then return false end
	local hrp = targetPlayer and targetPlayer.Character and (targetPlayer.Character:FindFirstChild("HumanoidRootPart") or targetPlayer.Character:FindFirstChild("Head"))
	local pos = hrp and hrp.Position or Vector3.new(0, 10, 0)
	local payload = deepCopyArgs(template)
	local n = #payload
	local injected = false

	-- Replace audio ID slots while preserving exact original types!
	for i = 1, n do
		local v = payload[i]
		local tv = typeof(v)
		if tv == "number" and v >= 100000 then
			payload[i] = numId
			injected = true
		elseif tv == "string" and (v:find("asset", 1, true) or v:match("^%d%d%d%d%d%d+$")) then
			payload[i] = injectIdIntoVal(v, numId)
			injected = true
		elseif tv == "table" then
			for k, sub in pairs(v) do
				if (type(sub) == "number" and sub >= 100000) or (type(sub) == "string" and (sub:find("asset", 1, true) or sub:match("^%d%d%d%d%d%d+$"))) then
					v[k] = injectIdIntoVal(sub, numId)
					injected = true
				end
			end
		end
	end

	-- Fallback: if the real shot had HitSoundID in slot 7 as 0/table/number, inject at slot 7
	if not injected and n >= 7 then
		payload[7] = injectIdIntoVal(payload[7], numId)
	end

	-- Route impact position (arg 4 in Brookhaven 12-arg schema) onto target player so they hear it at 0 studs!
	if n >= 4 and typeof(payload[4]) == "Vector3" then
		payload[4] = pos
	end

	local ok = pcall(function()
		gunRemote:FireServer(table.unpack(payload, 1, n))
	end)
	return ok
end

local function installAudioDiagOnce(gun1Remote, soundRemotes, gunTool, gunHandle, muzzleObj, hitObj)
	if S._AudioDiagInstalled then return end
	S._AudioDiagInstalled = true
	S._RxLogCount1 = 0
	S._RxLogCount2 = 0

	-- Passive RX listener + live 12-arg template capture for RE["1Gu1n"]
	if gun1Remote and gun1Remote:IsA("RemoteEvent") then
		pcall(function()
			trackConn(gun1Remote.OnClientEvent:Connect(function(...)
				local a = { ... }
				local n = #a
				S._RxLogCount1 = (S._RxLogCount1 or 0) + 1
				if S._RxLogCount1 <= 4 then
					local dump = {}
					for i = 1, n do
						table.insert(dump, "[" .. tostring(i) .. "]=" .. fmtDiagVal(a[i], 0))
					end
					print("[NEXUS RX FULL] 1Gu1n (" .. tostring(n) .. "): " .. table.concat(dump, " | "))
				end
				-- Capture authentic server-validated 12-arg template from real gunshots (a[2..n])
				if n >= 10 and typeof(a[1]) == "Instance" and a[1]:IsA("Player") then
					local isNewTemplate = (S.CapturedGun1Template == nil)
					local tpl = {}
					for i = 2, n do
						tpl[i - 1] = a[i]
					end
					-- Do not overwrite template with our own injected sound ID
					local isOwnInjected = false
					if S.PendingGun1Id then
						for _, v in ipairs(tpl) do
							if v == S.PendingGun1Id or (type(v) == "string" and v:find(tostring(S.PendingGun1Id), 1, true)) then
								isOwnInjected = true
								break
							end
						end
					end
					if not isOwnInjected then
						S.CapturedGun1Template = deepCopyArgs(tpl)
						if isNewTemplate then
							print("[NEXUS AUDIO] Captured authentic 1Gu1n template (" .. tostring(#tpl) .. " args)!")
							-- If user already requested a sound ID, immediately replay it using the freshly captured valid template!
							if S.PendingGun1Id and not S.Unloaded then
								local pending = S.PendingGun1Id
								task.defer(function()
									for _, p in ipairs(Players:GetPlayers()) do
										if S.Unloaded then break end
										fire1Gu1nFromTemplate(gun1Remote, S.CapturedGun1Template, p, pending)
										task.wait(0.05)
									end
								end)
							end
						end
					end
				end
			end))
		end)
	end

	-- Passive RX listener for RE["1Gu1nSound1s"]
	for _, r in ipairs(soundRemotes or {}) do
		if r and r:IsA("RemoteEvent") then
			pcall(function()
				trackConn(r.OnClientEvent:Connect(function(...)
					local a = { ... }
					local n = #a
					S._RxLogCount2 = (S._RxLogCount2 or 0) + 1
					if S._RxLogCount2 <= 4 then
						local dump = {}
						for i = 1, n do
							table.insert(dump, "[" .. tostring(i) .. "]=" .. fmtDiagVal(a[i], 0))
						end
						print("[NEXUS RX FULL] " .. r.Name .. " (" .. tostring(n) .. "): " .. table.concat(dump, " | "))
					end
				end))
			end)
		end
	end

	-- One-time concise live diagnostics in F9
	pcall(function()
		local rfe = SoundService and SoundService.RespectFilteringEnabled
		local c1, c2 = "?", "?"
		if type(getconnections) == "function" then
			if gun1Remote then
				local ok1, list1 = pcall(getconnections, gun1Remote.OnClientEvent)
				if ok1 and type(list1) == "table" then c1 = tostring(#list1) end
			end
			if soundRemotes and soundRemotes[1] then
				local ok2, list2 = pcall(getconnections, soundRemotes[1].OnClientEvent)
				if ok2 and type(list2) == "table" then c2 = tostring(#list2) end
			end
		end
		print(string.format("[NEXUS DIAG] RFE=%s | Gun=%s@%s | Handle=%s | Muzzle=%s | Hit=%s | 1Gu1nConns=%s | 1Gu1nSound1sConns=%s",
			tostring(rfe),
			gunTool and gunTool.Name or "nil",
			(gunTool and gunTool.Parent) and gunTool.Parent.Name or "nil",
			gunHandle and gunHandle.Name or "nil",
			muzzleObj and muzzleObj.Name or "nil",
			hitObj and hitObj.Name or "nil",
			c1, c2
		))
	end)
end

local function fire1Gu1nToPlayer(gunRemote, targetPlayer, numId, gunTool, gunHandle, muzzleObj, hitObj)
	if not gunRemote or not targetPlayer or not targetPlayer.Character then return false end
	-- PRIORITY 1: If we captured an authentic server-accepted 12-arg template, use it verbatim with numId injected!
	if type(S.CapturedGun1Template) == "table" and #S.CapturedGun1Template >= 8 then
		return fire1Gu1nFromTemplate(gunRemote, S.CapturedGun1Template, targetPlayer, numId)
	end

	local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart") or targetPlayer.Character:FindFirstChild("Head")
	if not hrp then return false end
	local handleArg = (gunHandle and gunHandle.Parent) and gunHandle or hrp
	local mEff = (muzzleObj and muzzleObj.Parent) and muzzleObj or hrp
	local hEff = (hitObj and hitObj.Parent) and hitObj or mEff
	local pos = hrp.Position

	-- safe defaults (never touches game ModuleScripts)
	local muzzleOffset = Vector3.new(0, 0, 0)
	local bSpeed = 1000
	local bSize = Vector3.new(0.2, 0.2, 0.2)
	local bColor = BrickColor.new(29)
	local bMat = Enum.Material.SmoothPlastic
	local bFade = 0.25
	local hitVol = 1

	-- PRIORITY 2A: Setting-native FE Gun Kit schema (arg8 = Volume/Pitch = 1, arg9 = {false}, arg10 = Setting BulletData)
	local ok1 = pcall(function()
		gunRemote:FireServer(
			handleArg,
			hrp,
			muzzleOffset,
			pos,
			mEff,
			hEff,
			numId,
			hitVol,
			{ false },
			{ bSpeed, bSize, bColor, 1, bMat, bFade },
			true,
			false
		)
	end)

	-- PRIORITY 2B: Classic Brookhaven slahiuh 12-arg schema (hrp, hrp, Vector3, pos, MuzzleEffect, HitEffect, numId, 1, {false}, {...}, true, false)
	local ok2 = pcall(function()
		gunRemote:FireServer(
			hrp,
			hrp,
			Vector3.new(0, 0, 0),
			pos,
			mEff,
			hEff,
			numId,
			1,
			{ false },
			{ 25, Vector3.new(0.2, 0.2, 0.2), BrickColor.new(29), 1, Enum.Material.SmoothPlastic, 0.25 },
			true,
			false
		)
	end)
	return ok1 or ok2
end

function Net.GlobalSound(soundId, opts)
	opts = opts or {}
	local numId = tonumber((tostring(soundId or ""):gsub("%D", "")))
	if not numId or numId <= 0 then
		return false, "Invalid numeric Audio ID"
	end

	local gun1Remote = Net.FindGun1FERemote()
	local remotes = Net.FindGunSoundRemotes(false)
	if #remotes == 0 then
		remotes = Net.FindGunSoundRemotes(true)
	end
	if not gun1Remote and #remotes == 0 then
		return false, "No 1Gu1n / GunSound remote found in ReplicatedStorage"
	end

	local method = opts.method or S.GlobalSoundMethod or "Auto (New + Old Hybrid)"
	local gunName = opts.gun or S.GlobalSoundGun or "GlockBrown"
	local arg3 = math.clamp(tonumber(opts.arg3 or S.GlobalSoundArg3) or 1, 0.1, 10)
	local autoPick = (opts.autoPick ~= nil) and opts.autoPick or (S.GlobalSoundAutoPick == true)

	local sent = false
	local usedTags = {}

	if method == "New: Gun Handle (Backpack - Stealth)" then
		local handle, tool = Net.EnsureGunHandle(gunName, false, autoPick)
		if handle then
			if fireGunSoundRemotes(remotes, handle, numId, arg3) then
				sent = true
				table.insert(usedTags, "New Stealth Handle:" .. (tool and tool.Name or gunName))
			end
		else
			return false, "No gun tool found (enable Auto-Pick or equip GlockBrown/Sniper)"
		end
	elseif method == "New: Gun Handle (Equipped)" then
		local handle, tool = Net.EnsureGunHandle(gunName, true, autoPick)
		if handle then
			if fireGunSoundRemotes(remotes, handle, numId, arg3) then
				sent = true
				table.insert(usedTags, "New Equipped Handle:" .. (tool and tool.Name or gunName))
			end
		else
			return false, "No gun tool found (enable Auto-Pick or equip GlockBrown/Sniper)"
		end
	elseif method == "Old: Workspace Global (Classic)" then
		if fireGunSoundRemotes(remotes, Workspace, numId, arg3) then
			sent = true
			table.insert(usedTags, "Old Workspace")
		end
	elseif method == "Old: Players / Legacy RemoteEvents" then
		if fireGunSoundRemotes(remotes, Players, numId, arg3) then
			sent = true
			table.insert(usedTags, "Legacy Players")
		end
		if fireGunSoundRemotes(remotes, Workspace, numId, arg3) then
			sent = true
			table.insert(usedTags, "Workspace Fallback")
		end
	elseif method == "Target Player 3D (Head/HRP)" then
		local tPlr = opts.targetPlayer or resolvePlayer(S.SelectedPlayer) or LocalPlayer
		local tChar = getChar(tPlr)
		local tPart = tChar and (tChar:FindFirstChild("Head") or tChar:FindFirstChild("HumanoidRootPart") or tChar.PrimaryPart)
		if tPart then
			if fireGunSoundRemotes(remotes, tPart, numId, arg3) then
				sent = true
				table.insert(usedTags, "3D Target:" .. tPlr.Name)
			end
		else
			return false, "Target player character not loaded"
		end
	elseif method == "All Players 3D Broadcast" then
		local hitCount = 0
		for _, p in ipairs(Players:GetPlayers()) do
			if hitCount >= 24 then break end
			local pChar = getChar(p)
			local pPart = pChar and (pChar:FindFirstChild("Head") or pChar:FindFirstChild("HumanoidRootPart"))
			if pPart and fireGunSoundRemotes(remotes, pPart, numId, arg3) then
				sent = true
				hitCount = hitCount + 1
			end
		end
		table.insert(usedTags, "3D All (" .. tostring(hitCount) .. " plrs)")
	else
		-- Equip firearm in Character (Workspace-replicated!) so Handle, MuzzleEffect & HitEffect exist on ALL clients
		local gunHandle, gunTool = Net.EnsureGunHandle(gunName, true, autoPick)
		local muzzleObj, hitObj = getGunEffectObjects(gunTool, gunHandle)
		S.PendingGun1Id = numId
		installAudioDiagOnce(gun1Remote, remotes, gunTool, gunHandle, muzzleObj, hitObj)

		-- If we haven't captured an authentic 12-arg 1Gu1n template yet, briefly activate the equipped gun so the server echoes its exact valid 12-arg schema!
		if gun1Remote and gunTool and not S.CapturedGun1Template then
			pcall(function() gunTool:Activate() end)
			local tWait = os.clock()
			while not S.CapturedGun1Template and (os.clock() - tWait) < 0.35 do
				task.wait(0.03)
			end
		end

		local plrs = Players:GetPlayers()
		local ordered = { LocalPlayer }
		for _, p in ipairs(plrs) do
			if p ~= LocalPlayer then table.insert(ordered, p) end
		end

		-- CHANNEL 1: Authentic FE Gun Kit RE["1Gu1n"] (Captured Template OR Setting-Native Dual Schema)
		if gun1Remote then
			S.Gun1AudioToken = (S.Gun1AudioToken or 0) + 1
			local myToken = S.Gun1AudioToken
			local hitCount = 0
			sent = true
			local modeLabel = S.CapturedGun1Template and "1Gu1n-TPL" or "1Gu1n-SET"
			table.insert(usedTags, modeLabel .. "(" .. tostring(#ordered) .. ")")

			trackThread(function()
				for i, p in ipairs(ordered) do
					if S.Unloaded or S.Gun1AudioToken ~= myToken then break end
					if fire1Gu1nToPlayer(gun1Remote, p, numId, gunTool, gunHandle, muzzleObj, hitObj) then
						hitCount = hitCount + 1
					end
					if i < #ordered then
						task.wait(0.05)
					end
				end
				if not opts.skipLocal then
					print("[NEXUS AUDIO] FE Broadcast (" .. modeLabel .. ") -> " .. tostring(hitCount) .. "/" .. tostring(#ordered) .. " players | ID=" .. tostring(numId) .. " | Gun=" .. (gunTool and gunTool.Name or "none"))
				end
			end)
		end

		-- CHANNEL 2: RE["1Gu1nSound1s"] onto Equipped Character Handle + All Player Heads + Workspace
		if #remotes > 0 then
			if gunHandle and gunHandle.Parent then
				if fireGunSoundRemotes(remotes, gunHandle, numId, 1) then
					sent = true
					table.insert(usedTags, "Handle:" .. (gunTool and gunTool.Name or "Gun"))
				end
			end
			if fireGunSoundRemotes(remotes, Workspace, numId, 1) then
				sent = true
				table.insert(usedTags, "Workspace")
			end
			trackThread(function()
				for _, p in ipairs(ordered) do
					if S.Unloaded then break end
					local pChar = p.Character
					local head = pChar and (pChar:FindFirstChild("Head") or pChar:FindFirstChild("HumanoidRootPart"))
					if head then
						fireGunSoundRemotes(remotes, head, numId, 1)
					end
					task.wait(0.03)
				end
			end)
		end
	end

	local rName = remotes[1] and remotes[1].Name or "Remote"
	return sent, string.format("%s [%s]", rName, table.concat(usedTags, " + "))
end

