			task.wait(0.4)
		end
	end
end

local function ChestPositionKey(pos)
	return string.format("%d_%d_%d", math.floor(pos.X / 10), math.floor(pos.Y / 10), math.floor(pos.Z / 10))
end

function Eng.Farm.ScanChests()
	local now = os.clock()
	if S.ChestCache and (now - (S.ChestCacheTime or 0)) < 3 then
		local alive = {}
		for _, c in ipairs(S.ChestCache) do
			if c.Part and c.Part.Parent then
				table.insert(alive, c)
			end
		end
		return alive
	end

	local found = {}
	local seenKeys = {}

	for _, obj in ipairs(Workspace:GetDescendants()) do
		local anchor = nil
		local name = obj.Name

		if obj:IsA("Model") and (name:find("Chest") or name:find("chest")) then
			if obj.PrimaryPart then
				anchor = obj.PrimaryPart
			else
				local bestVol = -1
				for _, p in ipairs(obj:GetChildren()) do
					if p:IsA("BasePart") then
						local vol = p.Size.X * p.Size.Y * p.Size.Z
						if vol > bestVol then
							bestVol = vol
							anchor = p
						end
					end
				end
			end
		elseif obj:IsA("BasePart") and (name:find("Chest") or name:find("chest")) then
			anchor = obj
		end

		if anchor and anchor.Parent then
			local key = ChestPositionKey(anchor.Position)
			if not seenKeys[key] then
				seenKeys[key] = true
				table.insert(found, { Part = anchor, Model = obj, Name = name, Key = key })
			end
		end
	end

	local root = getRoot()
	if root then
		table.sort(found, function(a, b)
			return (a.Part.Position - root.Position).Magnitude < (b.Part.Position - root.Position).Magnitude
		end)
	end

	S.ChestCache = found
	S.ChestCacheTime = now
	return found
end

function Eng.Farm.ChestTick()
	if not S.ChestFarm or S.Unloaded then return end
	if S.ChestStopOnRare then
		local rare = Eng.Farm.HasRareDrop()
		if rare then
			S.ChestFarm = false
			notify("Rare Drop!", "Paused Chest Farm — you hold " .. rare .. "!", 6)
			return
		end
	end

	local now = os.clock()
	-- Expire visited chests after 90 seconds so respawned chests are collected
	for key, expiry in pairs(S.VisitedChests) do
		if now > expiry then S.VisitedChests[key] = nil end
	end

	local list = Eng.Farm.ScanChests()
	local candidates = {}
	for _, c in ipairs(list) do
		if c.Part and c.Part.Parent and not S.VisitedChests[c.Key] then
			table.insert(candidates, c)
		end
	end

	if #candidates == 0 then
		if #list == 0 then
			if S.ChestHopWhenDone then
				notify("Chest Farm", "All chests cleared — server hopping...", 3)
				Eng.World.ServerHop(false)
				task.wait(4)
			else
				task.wait(2)
			end
		else
			task.wait(1.5)
		end
		return
	end

	local target = candidates[1]
	if target and target.Part and target.Part.Parent then
		Eng.Travel.TweenTo(target.Part.Position + Vector3.new(0, 1.5, 0))
		if not S.ChestFarm or S.Unloaded then return end

		local r = getRoot()
		if r and target.Part and target.Part.Parent then
			r.CFrame = target.Part.CFrame * CFrame.new(0, 1.2, 0)
			zeroVel(r)
			pcall(function()
				if type(firetouchinterest) == "function" then
					firetouchinterest(r, target.Part, 0)
					task.wait(0.04)
					firetouchinterest(r, target.Part, 1)
				end
			end)
			task.wait(0.2)
			if target.Part and target.Part.Parent then
				r.CFrame = target.Part.CFrame * CFrame.new(0, 2.2, 0)
				zeroVel(r)
			end
			task.wait(0.15)
		end

		S.VisitedChests[target.Key] = os.clock() + 90
		S.ChestsCollected = (S.ChestsCollected or 0) + 1
	end
end

