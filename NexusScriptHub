local function FindIncomingKnife()
	if not RootPart then
		return nil
	end
	for _, obj in ipairs(workspace:GetChildren()) do
		if obj:IsA("BasePart") then
			local name = string.lower(tostring(obj.Name))
			if string.find(name, "knife", 1, true) or string.find(name, "dagger", 1, true) then
				local ok, velocity = pcall(function() return obj.AssemblyLinearVelocity end)
				if ok and velocity and velocity.Magnitude > 25 then
