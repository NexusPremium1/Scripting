									pcall(function() root.CFrame = CFrame.new(snapPos) end)
								end
							end
						end
					elseif badState then
						pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
					end
				end)
				if landed then return end
				attempt = attempt + 1
				task.wait(0.18)
			end
		end)
	end
	getgenv().NexusGroundReset = NexusGroundReset
end

-- FLY v2  (rewritten)
--
-- The old fly killed you in TSB in about 3 seconds. Why:
--   1) BodyVelocity + MaxForce = math.huge + a velocity write on every frame
--      -> the humanoid physics and the mover fight each other (jitter / rubber-band).
--   2) with the camera tilted, W/S pushed the character straight into the ground;
--      there was no ground check / Y limit -> you fell off the arena into the void.
--   3) Anti-void ONLY ran inside the Farm Pack tab. With Fly on,
--      that block never ran, so the game killed you the moment you left the map.
--
-- This build: LinearVelocity + AlignOrientation (BodyMover as the fallback),
-- speed smoothing (no jitter), ground snapping, an internal anti-void watchdog.
--------------------------------------------------------------------------
local FlyVelocity, FlyGyro        -- legacy BodyMover parts (fallback only)
local FlyLV, FlyAO, FlyAttachment -- modern movers
local FlySmooth = Vector3.zero
local FlyLastSafe = nil
local FlySaveAt = 0

local FlyRayParams = RaycastParams.new()
do
	local ok = pcall(function()
		FlyRayParams.FilterType = Enum.RaycastFilterType.Exclude
	end)
	if not ok then
		pcall(function()
			FlyRayParams.FilterType = Enum.RaycastFilterType.Blacklist
		end)
	end
	FlyRayParams.IgnoreWater = true
end

local function FlyVoidY()
	return State.VoidY or -70
end

local function DestroyFlyObjects()
	for _, obj in ipairs({ FlyVelocity, FlyGyro, FlyLV, FlyAO }) do
		if obj then
			pcall(function()
				obj:Destroy()
			end)
		end
	end
	if FlyAttachment and FlyAttachment.Parent then
		pcall(function()
			FlyAttachment:Destroy()
		end)
	end
	FlyVelocity, FlyGyro, FlyLV, FlyAO, FlyAttachment = nil, nil, nil, nil, nil
	FlySmooth = Vector3.zero
end

local function FlySaveSafe()
	if not (RootPart and RootPart.Parent and Humanoid) then
		return
	end
	if Humanoid.Health <= 0 then
		return
	end
	if RootPart.Position.Y > FlyVoidY() + 12 and Humanoid.FloorMaterial ~= Enum.Material.Air then
		FlyLastSafe = RootPart.CFrame
	end
end

local function FlyStopSilently()
	DestroyFlyObjects()
	State.Fly = false
	if NexusGroundReset then pcall(NexusGroundReset) end
	if Humanoid then
		pcall(function()
			Humanoid.PlatformStand = false
			Humanoid.AutoRotate = true
			Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end
	if Toggles.Fly and Toggles.Fly.Value then
		pcall(function()
			Toggles.Fly:SetValue(false)
		end)
	end
end

function SetFly(enabled)
	State.Fly = enabled == true
	if not State.Fly then
		if FlyVelocity then pcall(function() FlyVelocity:Destroy() end); FlyVelocity = nil end
		if FlyGyro then pcall(function() FlyGyro:Destroy() end); FlyGyro = nil end
		if Humanoid then
			pcall(function()
				Humanoid.PlatformStand = false
				Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
		return
	end

	if not (RootPart and RootPart.Parent and Humanoid and Humanoid.Health > 0) then
		State.Fly = false
		if Toggles.Fly and Toggles.Fly.Value then
			pcall(function() Toggles.Fly:SetValue(false) end)
		end
		Notify("Character is not ready for Fly", 3)
		return
	end

	if FlyVelocity then pcall(function() FlyVelocity:Destroy() end); FlyVelocity = nil end
	if FlyGyro then pcall(function() FlyGyro:Destroy() end); FlyGyro = nil end
	pcall(function() Humanoid.PlatformStand = true end)

	FlyVelocity = Instance.new("BodyVelocity")
	FlyVelocity.Name = "NexusFlyVelocity"
	FlyVelocity.Velocity = Vector3.new(0, 0, 0)
	FlyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	FlyVelocity.Parent = RootPart

	FlyGyro = Instance.new("BodyGyro")
	FlyGyro.Name = "NexusFlyGyro"
	FlyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	FlyGyro.P = 10000
	FlyGyro.D = 500
	FlyGyro.CFrame = RootPart.CFrame
	FlyGyro.Parent = RootPart

	task.spawn(function()
		while State.Fly and FlyVelocity and FlyGyro and RootPart and RootPart.Parent do
			local camera = workspace.CurrentCamera
			local direction = Vector3.new(0, 0, 0)

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction - camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction - camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction = direction + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direction = direction + Vector3.new(0, -1, 0) end

			local spd = tonumber(State.FlySpeed) or 50
			if direction.Magnitude > 0 then
				direction = direction.Unit * spd
			end

			if FlyVelocity and FlyVelocity.Parent then FlyVelocity.Velocity = direction end
			if FlyGyro and FlyGyro.Parent then FlyGyro.CFrame = CFrame.new(RootPart.Position, RootPart.Position + camera.CFrame.LookVector) end

			task.wait()
		end
	end)
end

function FlyUpdate(dt)
	-- Handled smoothly in SetFly spawn loop

	if Humanoid.Health <= 0 then
		FlyStopSilently()
		Notify("Fly stopped: character died", 2)
		return
	end
	if not (FlyLV or FlyVelocity) then
		SetFly(true)
		return
	end

	local camLook = Camera.CFrame.LookVector
	local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
	if flatLook.Magnitude > 0.01 then
		flatLook = flatLook.Unit
	else
		flatLook = Vector3.zero
	end
	local camRight = Camera.CFrame.RightVector
	local flatRight = Vector3.new(camRight.X, 0, camRight.Z)
	if flatRight.Magnitude > 0.01 then
		flatRight = flatRight.Unit
	else
		flatRight = Vector3.zero
	end

	local wish = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		wish += flatLook
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		wish -= flatLook
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		wish += flatRight
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		wish -= flatRight
	end
	if wish.Magnitude < 0.01 then
		local move = Humanoid.MoveDirection
		if move.Magnitude > 0.05 then
			wish = Vector3.new(move.X, 0, move.Z)
		end
	end
	if wish.Magnitude > 0.01 then
		wish = wish.Unit
	end

	local vertical = 0
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		vertical += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		vertical -= 1
	end

	local target = wish * State.FlySpeed + Vector3.new(0, vertical * State.FlySpeed * 0.85, 0)

	-- smoothing: this is what kills the old "instant velocity" jitter
	local alpha = math.clamp(dt * 14, 0.08, 1)
	FlySmooth = FlySmooth:Lerp(target, alpha)
	if FlySmooth.Magnitude < 0.08 and target.Magnitude < 0.08 then
		FlySmooth = Vector3.zero
	end

	-- ground guard: never allow a downward push
	if FlySmooth.Y < 0 then
		local hit = workspace:Raycast(RootPart.Position, Vector3.new(0, -7, 0), FlyRayParams)
		if hit then
			FlySmooth = Vector3.new(FlySmooth.X, 0, FlySmooth.Z)
		end
	end

	if FlyLV and FlyLV.Parent then
		FlyLV.VectorVelocity = FlySmooth
	elseif FlyVelocity and FlyVelocity.Parent then
		FlyVelocity.Velocity = FlySmooth
	end

	if FlySmooth.Magnitude > 1.5 then
		local face = Vector3.new(FlySmooth.X, 0, FlySmooth.Z)
		if face.Magnitude > 0.5 then
			local goal = CFrame.lookAt(RootPart.Position, RootPart.Position + face.Unit)
			if FlyAO and FlyAO.Parent then
				FlyAO.CFrame = goal
			elseif FlyGyro and FlyGyro.Parent then
				FlyGyro.CFrame = goal
			end
		end
	end

	-- anti-void watchdog (always runs while fly is on)
	if RootPart.Position.Y < FlyVoidY() then
		local back = FlyLastSafe
		if not back then
			local spawn = workspace:FindFirstChildOfClass("SpawnLocation")
			back = spawn and (spawn.CFrame + Vector3.new(0, 10, 0)) or CFrame.new(0, 80, 0)
		end
		pcall(function()
			RootPart.CFrame = back + Vector3.new(0, 4, 0)
			RootPart.AssemblyLinearVelocity = Vector3.zero
			RootPart.AssemblyAngularVelocity = Vector3.zero
		end)
		FlySmooth = Vector3.zero
		Notify("Anti-void: you were pulled back", 2)
	end

	if (os.clock() - FlySaveAt) > 0.5 then
		FlySaveAt = os.clock()
		FlySaveSafe()
	end
end
