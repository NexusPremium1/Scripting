Eng.Avatar = {}

function Eng.Avatar.CaptureSelfSnapshot()
	local hum = getHum()
	if not hum then return nil end
	local ok, desc = pcall(function() return hum:GetAppliedDescription() end)
	if not ok or not desc then return nil end
	local accIds = {}
	pcall(function()
		for _, a in ipairs(desc:GetAccessories(true)) do
			if a and a.AssetId and a.AssetId > 0 then
				table.insert(accIds, a.AssetId)
			end
		end
	end)
	local skinName = "Light orange"
	pcall(function()
		local bc = getChar() and getChar():FindFirstChildOfClass("BodyColors")
		if bc and bc.HeadColor then skinName = bc.HeadColor.Name end
	end)
	return {
		Body = { desc.Torso, desc.RightArm, desc.LeftArm, desc.RightLeg, desc.LeftLeg, desc.Head },
		Shirt = desc.Shirt,
		Pants = desc.Pants,
		Face = desc.Face,
		IdleAnimation = desc.IdleAnimation,
		Accessories = accIds,
		SkinTone = skinName,
	}
end

function Eng.Avatar.ApplyPreset(presetName)
	local parts = DATA.BodyPresets[presetName]
	if not parts then
		notify("Avatar", "Unknown body preset: " .. tostring(presetName), 3)
		return
	end
	local ok = Net.ChangeBody(parts)
	if ok then
		notify("Avatar Applied", presetName .. " applied (FE)!", 3)
	else
		notify("Avatar", "Body remote unavailable on this server.", 3)
	end
end

function Eng.Avatar.CopyPlayer(targetPlr, includeRP)
	if not targetPlr then
		notify("Avatar Copy", "Select a target player first!", 3)
		return
	end
	local tChar = getChar(targetPlr)
	local tHum = getHum(targetPlr)
	if not tChar or not tHum then
		notify("Avatar Copy", targetPlr.Name .. " has no active character.", 3)
		return
	end
	local okDesc, desc = pcall(function() return tHum:GetAppliedDescription() end)
	if not okDesc or not desc then
		notify("Avatar Copy", "Failed to read HumanoidDescription.", 3)
		return
	end

	notify("Avatar Copy", "Cloning " .. targetPlr.DisplayName .. "'s avatar (FE)...", 3)
	trackThread(function()
		-- 1. Reset first so old items don't overlap
		Net.ResetAvatar()
		task.wait(0.35)

		-- 2. Body bundle parts
		local bodyParts = {
			desc.Torso or 0,
			desc.RightArm or 0,
			desc.LeftArm or 0,
			desc.RightLeg or 0,
			desc.LeftLeg or 0,
			desc.Head or 0,
		}
		Net.ChangeBody(bodyParts)
		task.wait(0.25)

		-- 3. Skin tone
		local bc = tChar:FindFirstChildOfClass("BodyColors")
		if bc and bc.HeadColor then
			Net.SkinColor(bc.HeadColor.Name)
			task.wait(0.1)
		end

		-- 4. Shirt, Pants, Face, Idle Animation
		if desc.Shirt and desc.Shirt > 0 then Net.Wear(desc.Shirt); task.wait(0.12) end
		if desc.Pants and desc.Pants > 0 then Net.Wear(desc.Pants); task.wait(0.12) end
		if desc.Face and desc.Face > 0 then Net.Wear(desc.Face); task.wait(0.12) end
		if desc.IdleAnimation and desc.IdleAnimation > 0 then Net.Wear(desc.IdleAnimation); task.wait(0.12) end

		-- 5. Accessories
		local okAcc, accs = pcall(function() return desc:GetAccessories(true) end)
		if okAcc and type(accs) == "table" then
			local worn = 0
			for _, a in ipairs(accs) do
				if S.Unloaded then return end
				if a and a.AssetId and a.AssetId > 0 then
					Net.Wear(a.AssetId)
					worn = worn + 1
					if worn >= 14 then break end
					task.wait(0.12)
				end
			end
		end

		-- 6. Optional RP Name & Bio copy
		if includeRP then
			Eng.Avatar.CopyRPIdentity(targetPlr)
		end

		notify("Avatar Copy", "Cloned " .. targetPlr.DisplayName .. " successfully!", 3.5)
	end)
end

function Eng.Avatar.CopyRPIdentity(targetPlr)
	if not targetPlr then return end
	local bag = targetPlr:FindFirstChild("PlayersBag")
	local copied = false
	if bag then
		local rn = bag:FindFirstChild("RPName")
		local rb = bag:FindFirstChild("RPBio")
		local rnc = bag:FindFirstChild("RPNameColor")
		local rbc = bag:FindFirstChild("RPBioColor")
		if rn and rn.Value and tostring(rn.Value) ~= "" then
			Net.SetRPName(tostring(rn.Value))
			copied = true
		end
		if rb and rb.Value and tostring(rb.Value) ~= "" then
			Net.SetRPBio(tostring(rb.Value))
			copied = true
		end
		if rnc and typeof(rnc.Value) == "Color3" then
			Net.SetRPNameColor(rnc.Value)
		end
		if rbc and typeof(rbc.Value) == "Color3" then
			Net.SetRPBioColor(rbc.Value)
		end
	end
	if not copied then
		-- Fallback: read head billboard text
		pcall(function()
			local head = getChar(targetPlr) and getChar(targetPlr):FindFirstChild("Head")
			if head then
				for _, d in ipairs(head:GetDescendants()) do
					if d:IsA("TextLabel") and d.Text and #d.Text > 0 then
						local low = string.lower(d.Name)
						if low:find("name") then
							Net.SetRPName(d.Text)
							copied = true
						elseif low:find("bio") then
							Net.SetRPBio(d.Text)
							copied = true
						end
					end
				end
			end
		end)
	end
	if copied then
		notify("RP Identity", "Copied RP Name/Bio from " .. targetPlr.DisplayName, 3)
	else
		notify("RP Identity", targetPlr.DisplayName .. " has no custom RP Name/Bio.", 3)
	end
end

