	play = function(index)
		local entry = S.Filtered[index]
		if not entry then return end
		local name, id = entry[1], entry[2]
		if S.Failed[id] then
			status(name .. "  ·  this one does not load here")
			return
		end
		local now = os.clock()
		if now - (S.LastPlay or 0) < 0.2 then return end
		S.LastPlay = now
		local animator, humanoid = getAnimator()
		if not animator then
			status("character not loaded yet")
			return
		end
		stopAll()
		S.Gen += 1
		local gen = S.Gen
		local okTrack, track = pcall(function()
			local animation = Instance.new("Animation")
			animation.AnimationId = "rbxassetid://" .. tostring(id)
			animation.Name = name
			return animator:LoadAnimation(animation)
		end)
		if okTrack and track then
			local okPlay = pcall(function()
				track.Priority = Enum.AnimationPriority.Action
				track.Looped = S.Loop
				track:Play(0.12)
			end)
			if okPlay then
				local length = 0
				for _ = 1, 13 do
					if gen ~= S.Gen then break end
					pcall(function() length = track.Length end)
					if length and length > 0 then break end
					task.wait(0.05)
				end
				if gen ~= S.Gen then
					pcall(function() track:Stop(0) end)
					return
				end
				if length and length > 0 then
					S.Track = track
					table.insert(S.Mine, track)
					if #S.Mine > 40 then
						local oldest = table.remove(S.Mine, 1)
						pcall(function() oldest:Stop(0) end)
					end
					S.Current = name
					status("playing  " .. name)
					render()
					return
				end
			end
			pcall(function() track:Stop(0) end)
		end
		if gen ~= S.Gen then return end
		S.Failed[id] = true
		if humanoid then
			local okEmote = pcall(function() humanoid:PlayEmote(name) end)
			if okEmote then
				S.Current = name
				status(name .. "  ·  played from the avatar emote list")
				render()
				return
			end
		end
		status(name .. "  ·  could not play")
		render()
	end

	startSelected = function()
		local target = S.Selected
		if not target then
