	-- -------------------------------------------------------------- runtime
	local nxClock = 0

	RunService.Heartbeat:Connect(function(dt)
		local char, hum, root = nxChar()

		-- under-map feet farm ------------------------------------------------
		if NX.UnderFarm then
			if not root then
				nxSay("waiting for character")
			else
				if NX.Platform and not hum.PlatformStand then
					pcall(function() hum.PlatformStand = true end)
				end
				nxApplyHover(root)
				local target = nxPickTarget(root.Position)
				if not target then
					nxSay("no player in range")
				else
					local feet = nxFeetPosition(target.char, target.hum, target.root)
					if feet then
						local aim = feet + Vector3.new(0, NX.AimOffset, 0)
						local place
						local effectiveDepth = math.max(1, (NX.Depth or 9) + (NX.HeightFine or 0))
						if NX.Mode == "Above · head" then
							place = Vector3.new(aim.X, aim.Y + effectiveDepth, aim.Z)
						elseif NX.Mode == "Behind · back" then
							local back = target.root.CFrame.LookVector * effectiveDepth
							place = target.root.Position - back + Vector3.new(0, 1, 0)
						else
							place = Vector3.new(aim.X, aim.Y - effectiveDepth, aim.Z)
						end
						if NX.KeepUnder then
							place = Vector3.new(place.X, math.min(place.Y, aim.Y - 2), place.Z)
						end
						if NX.Jitter then
							place = place + Vector3.new(
								(math.random() - 0.5) * 0.9,
								(math.random() - 0.5) * 0.4,
								(math.random() - 0.5) * 0.9
							)
						end
						if (root.Position - place).Magnitude > 0.6 then
							pcall(function()
								root.CFrame = CFrame.lookAt(place, aim)
								root.AssemblyLinearVelocity = Vector3.zero
							end)
						end
						if NX.CamUnder and workspace.CurrentCamera then
							pcall(function()
								workspace.CurrentCamera.CFrame = CFrame.lookAt(place, aim)
							end)
						end
						if (os.clock() - NX.LastM1) >= NX.M1Delay then
							NX.LastM1 = os.clock()
							nxM1()
						end
						if NX.SkillSpam and (os.clock() - NX.LastSkill) >= NX.SkillDelay then
							NX.LastSkill = os.clock()
							local key = Enum.KeyCode[NX.SkillKey]
							if key then nxPressKey(key, 0.1) end
						end
						-- v5 · combo / random skill (slot 1-4)
						if (NX.Combo or NX.RandomSkill) and (os.clock() - (NX.LastCombo or 0)) >= (NX.ComboDelay or 0.35) then
							NX.LastCombo = os.clock()
							local slots = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }
							local slot
							if NX.Combo then
								NX.ComboIndex = ((NX.ComboIndex or 0) % 4) + 1
								slot = slots[NX.ComboIndex]
							else
								slot = slots[math.random(1, 4)]
							end
							if slot then nxPressKey(slot, 0.08) end
						end
						nxSay("farming " .. target.plr.Name .. " · feet from below")
					end
				end
			end
		end

		-- v5 · combo / random skill also work with the farm off
		if not NX.UnderFarm and (NX.Combo or NX.RandomSkill) and root
			and (os.clock() - (NX.LastCombo or 0)) >= (NX.ComboDelay or 0.35) then
			NX.LastCombo = os.clock()
			local slots = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four }
			local slot
			if NX.Combo then
				NX.ComboIndex = ((NX.ComboIndex or 0) % 4) + 1
				slot = slots[NX.ComboIndex]
			else
				slot = slots[math.random(1, 4)]
			end
			if slot then nxPressKey(slot, 0.08) end
		end

		-- standalone auto m1 ------------------------------------------------
		if NX.AutoM1 and not NX.UnderFarm then
			if (os.clock() - NX.LastM1) >= NX.AutoM1Delay then
				NX.LastM1 = os.clock()
				nxM1()
			end
		end

		-- anti fling ---------------------------------------------------------
		if NX.AntiFling and root then
			local linear, angular = 0, 0
			pcall(function()
				linear = root.AssemblyLinearVelocity.Magnitude
				angular = root.AssemblyAngularVelocity.Magnitude
			end)
			if linear > 180 or angular > 30 then
				pcall(function()
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
				end)
				if hum then pcall(function() hum.PlatformStand = false end) end
			end
		end

		-- anti void ----------------------------------------------------------
		if NX.AntiVoid and root and root.Position.Y < NX.VoidY then
			local spawn = workspace:FindFirstChildOfClass("SpawnLocation")
			pcall(function()
				if spawn then
					root.CFrame = spawn.CFrame + Vector3.new(0, 6, 0)
				else
					root.CFrame = CFrame.new(0, 60, 0)
				end
				root.AssemblyLinearVelocity = Vector3.zero
			end)
		end

		-- instant respawn ----------------------------------------------------
		if NX.AutoRespawn and char and hum and hum.Health <= 0 then
			pcall(function()
				local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
				if pg then
					for _, gui in ipairs(pg:GetDescendants()) do
						if gui:IsA("TextButton") and string.find(string.lower(gui.Text), "respawn", 1, true) then
							if firesignal then firesignal(gui.MouseButton1Click) end
							break
						end
					end
				end
			end)
		end

		-- walk on air --------------------------------------------------------
		if NX.WalkOnAir and root then
			if not (airPart and airPart.Parent) then
				airPart = Instance.new("Part")
				airPart.Name = "NexusAirPlatform"
				airPart.Size = Vector3.new(10, 1, 10)
				airPart.Anchored = true
				airPart.CanCollide = true
				airPart.Transparency = 1
				airPart.Parent = workspace
			end
			pcall(function()
				airPart.CFrame = CFrame.new(root.Position - Vector3.new(0, 3.2, 0))
			end)
		elseif airPart and not NX.WalkOnAir then
			pcall(function() airPart:Destroy() end)
			airPart = nil
		end

		-- light housekeeping 4x per second -----------------------------------
		nxClock = nxClock + dt
		if nxClock >= 0.25 then
			nxClock = 0
			if not root and NX.UnderFarm then
				nxSay("waiting for character")
			end
		end
	end)

	Notify("Farm pack ready · Farm tab → under-map feet farm", 5)
end

