-- v5.0 · SILENT AIM v2 ---------------------------------------------------
-- what changed against v3.5:
--   * FOV is measured from the CURSOR, not the screen centre
--   * wall check (raycast) so it never locks through a building
--   * velocity prediction scaled by distance (bows / projectiles)
--   * sticky target: the same enemy is kept for 0.25 s, no crosshair
--     ping-pong between two targets
--   * head first, torso fallback, dead / behind-camera players skipped
--   * one click fired per frame is far too spammy; the burst limiter
--     keeps 60 fps even with 10+ enemies on screen
local silentV2 = {
	sticky = nil, stickyAt = 0, stickyHold = 0.25,
	visible = true, predict = true, lead = 0.12, range = 1500,
	bones = { "Head", "HumanoidRootPart", "Torso", "UpperTorso" },
	ray = nil,
}

local function silentRay()
	if not silentV2.ray then
		local ok, params = pcall(function() return RaycastParams.new() end)
		if not ok or not params then return nil end
		pcall(function()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.IgnoreWater = true
		end)
		silentV2.ray = params
	end
	return silentV2.ray
end

local function silentClear(part)
	local params = silentRay()
	if not params or not part then return true end
	local cam = workspace.CurrentCamera
	if not cam then return true end
	local ignore = { cam }
	if k and k.Character then table.insert(ignore, k.Character) end
	pcall(function() params.FilterDescendantsInstances = ignore end)
	local origin = cam.CFrame.Position
	local ok, hit = pcall(function() return workspace:Raycast(origin, part.Position - origin, params) end)
	if not ok then return true end
	if not hit then return true end
	local inst = hit.Instance
	if inst == part then return true end
	if inst and inst:IsDescendantOf(part.Parent) then return true end
	return false
end

local function silentBone(plr)
	local char = plr and plr.Character
	if not char then return nil end
	for _, name in ipairs(silentV2.bones) do
		local part = char:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			if not silentV2.visible or silentClear(part) then
				return part
			end
		end
	end
	return nil
end

local function getClosestSilentTarget()
	local viewport = Camera.ViewportSize
	if not viewport or viewport.Magnitude < 1 then return nil end
	local okMouse, mouse = pcall(function() return UserInputService:GetMouseLocation() end)
	if not okMouse or not mouse then
		mouse = Vector2.new(viewport.X / 2, viewport.Y / 2)
	end
	local mine = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
	local myPos = mine and mine.Position or Camera.CFrame.Position

	-- keep the previous target for a moment so the aim does not flicker
	local sticky = silentV2.sticky
	if sticky and tick() - silentV2.stickyAt < silentV2.stickyHold then
		if sticky ~= k and isPlayerAlive(sticky) then
			local part = silentBone(sticky)
			if part then
				local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
				local inFov = onScreen and sp.Z > 0 and (Vector2.new(sp.X, sp.Y) - mouse).Magnitude < silentMaxFOV
				local inRange = (myPos - part.Position).Magnitude <= silentV2.range
				if inFov and inRange then
					return sticky, part
				end
			end
		end
	end

	local bestPlayer, bestPart, bestScore = nil, nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= k and isPlayerAlive(plr) then
			local part = silentBone(plr)
			if part then
				local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
				if onScreen and sp.Z > 0 then
					local px = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
					local world = (myPos - part.Position).Magnitude
					if px < silentMaxFOV and world <= silentV2.range then
						-- closest to the cursor wins, distance only breaks ties
						local score = px + world * 0.02
						if score < bestScore then
							bestScore = score
							bestPlayer = plr
							bestPart = part
						end
					end
				end
			end
		end
	end
	if bestPlayer then
		silentV2.sticky = bestPlayer
		silentV2.stickyAt = tick()
	end
	return bestPlayer, bestPart
end

local function fireSilentAim()
	local okAll, errAll = pcall(function()
		local target, part = getClosestSilentTarget()
		if not target then return end
		part = part or getTargetPart(target.Character, aimbonePart)
		if not part then return end

		local aimAt = part.Position
		if silentV2.predict then
			local vel = part.AssemblyLinearVelocity or part.Velocity
			if vel then
				local camPos = Camera.CFrame.Position
				local dist = (aimAt - camPos).Magnitude
				local lead = math.clamp(silentV2.lead * (dist / 300), 0, 0.35)
				aimAt = aimAt + vel * lead
			end
		end

		local saved = Camera.CFrame
		Camera.CFrame = CFrame.new(saved.Position, aimAt)
		task.delay(silentAimDelay, function()
			local cam = Camera or workspace.CurrentCamera
			if cam then
				pcall(function() cam.CFrame = saved end)
			end
		end)
	end)
	if not okAll and type(warn) == "function" then
		warn("[Nexus silent v2] " .. tostring(errAll))
	end
end
_G.SilentAim = {
	SetPart = function(part)
		if part == "Head" or part == "Torso" then
			aimbonePart = part
		end
	end,
	SetFOV = function(px)
		silentMaxFOV = px or math.huge
	end,
	SetDelay = function(sec)
		silentAimDelay = sec or 0.02
	end,
	SetVisible = function(v)
		silentV2.visible = v and true or false
	end,
	SetPredict = function(v)
		silentV2.predict = v and true or false
	end,
	SetRange = function(v)
		silentV2.range = tonumber(v) or 1500
	end,
	SetBone = function(name)
		if type(name) == "string" and name ~= "" then
			silentV2.bones = { name, "Head", "HumanoidRootPart", "Torso", "UpperTorso" }
		end
	end,
	Configure = function(cfg)
		if type(cfg) ~= "table" then return end
		if cfg.SilentFOV then silentMaxFOV = cfg.SilentFOV end
		if cfg.SilentRange then silentV2.range = cfg.SilentRange end
		if cfg.SilentPredict ~= nil then silentV2.predict = cfg.SilentPredict and true or false end
		if cfg.SilentVisible ~= nil then silentV2.visible = cfg.SilentVisible and true or false end
		if cfg.SilentLead then silentV2.lead = cfg.SilentLead end
	end,
	Fire = fireSilentAim,
	Toggle = function(state)
		if state ~= nil then silentEnabled = state else silentEnabled = not silentEnabled end
		return silentEnabled
	end
}




