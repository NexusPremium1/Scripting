Eng.Combat = {}

function Eng.Combat.BaseMobName(name)
	local s = tostring(name or "")
	s = s:gsub("%s*%[Lv%.%s*%d+%]%s*", ""):gsub("%s*%[Boss%]%s*", ""):gsub("%s*%[Raid Boss%]%s*", "")
	return s:gsub("^%s+", ""):gsub("%s+$", "")
end

function Eng.Combat.MobMatches(modelName, wanted, altWanted)
	local base = string.lower(Eng.Combat.BaseMobName(modelName))
	local w1 = string.lower(tostring(wanted or ""))
	if w1 ~= "" and (base == w1 or base:find(w1, 1, true)) then return true end
	if altWanted and altWanted ~= "" then
		local w2 = string.lower(tostring(altWanted))
		if base == w2 or base:find(w2, 1, true) then return true end
	end
	return false
end

function Eng.Combat.MobAlive(mob)
	if not mob or not mob.Parent then return false end
	local hum = mob:FindFirstChildOfClass("Humanoid")
	local r = mob:FindFirstChild("HumanoidRootPart")
	return hum ~= nil and r ~= nil and hum.Health > 0
end

function Eng.Combat.GetEnemies()
	local out = {}
	local folder = Workspace:FindFirstChild("Enemies")
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			if Eng.Combat.MobAlive(m) then table.insert(out, m) end
		end
	end
	return out
end

function Eng.Combat.ListLoadedMobNames()
	local seen, out = {}, {}
	for _, m in ipairs(Eng.Combat.GetEnemies()) do
		local b = Eng.Combat.BaseMobName(m.Name)
		if b ~= "" and not seen[b] then
			seen[b] = true
			table.insert(out, b)
		end
	end
	table.sort(out)
	if #out == 0 then out = { "(No mobs loaded nearby)" } end
	return out
end

function Eng.Combat.FindMobByName(wanted, altWanted)
	local root = getRoot()
	local best, bestDist = nil, math.huge
	for _, m in ipairs(Eng.Combat.GetEnemies()) do
		if Eng.Combat.MobMatches(m.Name, wanted, altWanted) then
			local mr = m:FindFirstChild("HumanoidRootPart")
			local d = (root and mr) and (mr.Position - root.Position).Magnitude or 0
			if d < bestDist then bestDist = d; best = m end
		end
	end
	return best
end

function Eng.Combat.FindNearestMob(maxDist)
	local root = getRoot()
	if not root then return nil end
	local best, bestDist = nil, maxDist or 4000
	for _, m in ipairs(Eng.Combat.GetEnemies()) do
		local mr = m:FindFirstChild("HumanoidRootPart")
		if mr then
			local d = (mr.Position - root.Position).Magnitude
			if d < bestDist then bestDist = d; best = m end
		end
	end
	return best
end

function Eng.Combat.FindStrongestMob()
	local best, bestHp = nil, 0
	for _, m in ipairs(Eng.Combat.GetEnemies()) do
		local h = m:FindFirstChildOfClass("Humanoid")
		if h and h.MaxHealth > bestHp then
			bestHp = h.MaxHealth
			best = m
		end
	end
	return best
end

function Eng.Combat.GetQuestForLevel(level)
	level = tonumber(level) or getLevel()
	local sea = getSeaName()
	local best = nil
	for _, q in ipairs(DATA.Quests) do
		local qSea = (q[1] >= 1500) and "Sea 3" or ((q[1] >= 700) and "Sea 2" or "Sea 1")
		if qSea == sea and level >= q[1] then
			best = q
		end
	end
	if not best then
		-- Fallback: pick first quest of current sea
		for _, q in ipairs(DATA.Quests) do
			local qSea = (q[1] >= 1500) and "Sea 3" or ((q[1] >= 700) and "Sea 2" or "Sea 1")
			if qSea == sea then return q end
		end
	end
	return best or DATA.Quests[1]
end

function Eng.Combat.HasQuest(expectedMob)
	local ok, visible, titleText = pcall(function()
		local pg = LP:FindFirstChild("PlayerGui")
		local main = pg and pg:FindFirstChild("Main")
		local qGui = main and main:FindFirstChild("Quest")
		if not qGui or not qGui.Visible then return false, "" end
		local container = qGui:FindFirstChild("Container")
		local title = container and container:FindFirstChild("QuestTitle")
		local lbl = title and title:FindFirstChild("Title")
		return true, (lbl and lbl.Text) or ""
	end)
	if not ok or not visible then return false end
	if expectedMob and expectedMob ~= "" and titleText ~= "" then
		local low = string.lower(titleText)
		if not low:find(string.lower(expectedMob), 1, true) then
			return false
		end
	end
	return true
end

function Eng.Combat.GetToolList()
	local out, seen = { "Auto (By Category)" }, {}
	local function addFrom(container)
		if not container then return end
		for _, t in ipairs(container:GetChildren()) do
			if t:IsA("Tool") and not seen[t.Name] then
				seen[t.Name] = true
				table.insert(out, t.Name)
			end
		end
	end
	addFrom(LP:FindFirstChild("Backpack"))
	addFrom(getChar())
	return out
end

function Eng.Combat.EquipWeapon(overrideCategory)
	local char = getChar()
	local hum = getHum()
	local bp = LP:FindFirstChild("Backpack")
	if not char or not hum or not bp then return nil end

	-- 1. If specific weapon selected & no mastery override
	if not overrideCategory and S.SpecificWeapon and S.SpecificWeapon ~= "" and S.SpecificWeapon ~= "Auto (By Category)" then
		local equipped = char:FindFirstChild(S.SpecificWeapon)
		if equipped and equipped:IsA("Tool") then return equipped end
		local inBp = bp:FindFirstChild(S.SpecificWeapon)
		if inBp and inBp:IsA("Tool") then
			pcall(function() hum:EquipTool(inBp) end)
			return inBp
		end
	end

	-- 2. Match Blox Fruits ToolTip ("Melee", "Sword", "Blox Fruit", "Gun")
	local wantedCat = overrideCategory or S.WeaponCategory or "Melee"
	local current = char:FindFirstChildOfClass("Tool")
	if current and tostring(current.ToolTip) == wantedCat then
		return current
	end
	for _, t in ipairs(bp:GetChildren()) do
		if t:IsA("Tool") and tostring(t.ToolTip) == wantedCat then
			pcall(function() hum:EquipTool(t) end)
			return t
		end
	end

	-- 3. Fallback: equip first non-fruit/non-chip weapon tool
	if current then return current end
	for _, t in ipairs(bp:GetChildren()) do
		if t:IsA("Tool") and not t.Name:find("Fruit") and not t.Name:find("Microchip") then
			pcall(function() hum:EquipTool(t) end)
			return t
		end
	end
	return nil
end

function Eng.Combat.EnsureBuffs()
	local now = os.clock()
	local char = getChar()
	if not char then return end
	if S.AutoBuso and (now - S.LastBuso) >= 1.5 then
		S.LastBuso = now
		if not char:FindFirstChild("HasBuso") then
			Net.Comm("Buso")
		end
	end
	if S.AutoKen then
		pcall(function()
			if LP:FindFirstChild("PlayerGui") and not char:FindFirstChild("KenActive") then
				Net.Comm("Ken", true)
			end
		end)
	end
	if S.AutoRaceV3 then
		Net.Comm("Agility")
	end
	if S.AutoRaceV4 then
		local re = char:FindFirstChild("RaceEnergy")
		local rt = char:FindFirstChild("RaceTransformed")
		if re and re.Value >= 1 and (not rt or not rt.Value) then
			Net.SendKey("Y")
		end
	end
end

function Eng.Combat.CastSkills()
	local now = os.clock()
	if (now - S.LastSkill) < 0.45 then return end
	S.LastSkill = now
	if S.SkillZ then Net.SendKey("Z") end
	if S.SkillX then Net.SendKey("X") end
