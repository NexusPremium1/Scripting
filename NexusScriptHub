local currentView = {}

function rebuildEmotes()
	if not EMOTE_COUNT or EMOTE_COUNT == 0 then return end
	local q = string.lower(searchBox.Text or "")
	local out, n = {}, 0
	local idQuery = q:match("^%d+$")

	for i = 1, EMOTE_COUNT do
		local keep = true
		if q ~= "" then
			if idQuery then
				keep = string.find(tostring(IDS[i]), q, 1, true) ~= nil
			else
				keep = string.find(string.lower(NAMES[i]), q, 1, true) ~= nil
			end
		end
		if keep and activeCat ~= "All" then
			if activeCat == "Dances" then
				keep = (tagOf(i) == "Dance")
			elseif activeCat == "Official" then
				keep = (IDS[i] < 10000000000)
			elseif activeCat == "Favorites" then
				keep = false
				for _, fav in ipairs(CONFIG.favorites) do
					if fav == IDS[i] then keep = true break end
				end
			elseif activeCat == "Recent" then
				keep = false
				for _, rec in ipairs(CONFIG.recent) do
					if rec == IDS[i] then keep = true break end
				end
			end
		end
		if keep then
			n = n + 1
			out[n] = { id = IDS[i], name = NAMES[i], cat = tagOf(i), idx = i }
		end
	end

	if sortMode == 2 then
		local rev = {}
		for i = #out, 1, -1 do rev[#rev + 1] = out[i] end
		out = rev
	elseif sortMode == 3 then
		table.sort(out, function(a, b) return a.id < b.id end)
	end

	currentView = out
	emoteList.SetData(out)
	totalLbl.Text = ("%d / %d emotes"):format(#out, EMOTE_COUNT)
end

local searchDebounce = 0
ApexBind(searchBox:GetPropertyChangedSignal("Text"), function()
	searchDebounce = searchDebounce + 1
	local mine = searchDebounce
	task.delay(0.16, function()
		if mine == searchDebounce then rebuildEmotes() end
	end)
end)

function pushRecent(id)
	for i, v in ipairs(CONFIG.recent) do
		if v == id then
			table.remove(CONFIG.recent, i)
			break
		end
	end
	table.insert(CONFIG.recent, 1, id)
	while #CONFIG.recent > 24 do
		table.remove(CONFIG.recent)
	end
	saveConfig()
end

