------------------------------------------------------------------------------
local function CreateList(parent, rowHeight, config)
	local view = New("Frame", {
		Size = UDim2.new(1, -10, 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 3,
	}, parent)
	local bar = New("Frame", {
		Size = UDim2.new(0, 4, 1, -8),
		Position = UDim2.new(1, -2, 0, 4),
		BackgroundColor3 = T.card2,
		ZIndex = 3,
	}, parent)
	Round(bar, 2)
	local thumb = New("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = T.mute, ZIndex = 4 }, bar)
	Round(thumb, 2)

	local data = {}
	local pool = {}
	local offset, target = 0, 0
	local list = { data = data }

	local function maxOffset()
		return math.max(0, (#data * rowHeight) - view.AbsoluteSize.Y)
	end

	local function paint()
		if offset > maxOffset() then offset = maxOffset() end
		if target > maxOffset() then target = maxOffset() end
		local first = math.floor(offset / rowHeight)
		local visible = math.ceil(view.AbsoluteSize.Y / rowHeight) + 1
		while #pool < visible + 1 do
			local row = config.createRow(view, #pool + 1)
			pool[#pool + 1] = row
			local slot = #pool
			ApexBind(row.MouseButton1Click, function()
				local item = list.data[list._first + slot]
				if item ~= nil and config.onClick then config.onClick(item) end
			end)
		end
		for i = 1, #pool do
			local row = pool[i]
			local idx = first + i
			local item = data[idx]
			if item ~= nil then
				row.Visible = true
				row.Position = UDim2.new(0, 0, 0, (i - 1) * rowHeight - (offset % rowHeight))
				config.render(row, item, idx)
			else
				row.Visible = false
			end
		end
		list._first = first
		local total = #data * rowHeight
		if total <= view.AbsoluteSize.Y then
			thumb.Size = UDim2.new(1, 0, 1, 0)
			thumb.Position = UDim2.new(0, 0, 0, 0)
		else
			local frac = math.max(0.06, view.AbsoluteSize.Y / total)
			thumb.Size = UDim2.new(1, 0, frac, 0)
			thumb.Position = UDim2.new(0, 0, (offset / maxOffset()) * (1 - frac), 0)
		end
	end

	function list.SetData(d)
		data = d or {}
		list.data = data
		list._first = 0
		offset, target = 0, 0
		paint()
	end

	function list.Refresh() paint() end
	function list.ScrollBy(px) target = math.clamp(target + px, 0, maxOffset()) end

	-- smooth scroll
	ApexBind(RunService.RenderStepped, function(dt)
		if math.abs(target - offset) > 0.4 then
			offset = offset + (target - offset) * math.min(1, dt * 14)
			paint()
		end
	end)

	-- mouse wheel
	ApexBind(UserInputService.InputChanged, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
		local m = UserInputService:GetMouseLocation() - Vector2.new(0, GuiService:GetGuiInset().Y)
		local p, s = view.AbsolutePosition, view.AbsoluteSize
		if m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y then
			target = math.clamp(target - input.Position.Z * rowHeight * 2.5, 0, maxOffset())
		end
	end)

	-- scrollbar drag
	local dragging = false
	ApexBind(thumb.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
		end
	end)
	ApexBind(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local rel = math.clamp((input.Position.Y - bar.AbsolutePosition.Y) / math.max(1, bar.AbsoluteSize.Y), 0, 1)
			target = rel * maxOffset()
			offset = target
			paint()
		end
	end)
	ApexBind(UserInputService.InputEnded, function()
		if dragging then dragging = false end
	end)

	ApexBind(view:GetPropertyChangedSignal("AbsoluteSize"), paint)
	return list
end

