	local MP3_DIR = "NexusSounds"
	local MP3_MAP = {
		["oof"] = { file = "oof.mp3", url = "" },
		["hitmarker"] = { file = "rust_hs.mp3", url = "" },
		["rust"] = { file = "rust_hs.mp3", url = "" },
		["rust hs"] = { file = "rust_hs.mp3", url = "" },
		["neverlose"] = { file = "neverlose.mp3", url = "" },
		["bonk"] = { file = "bonk.mp3", url = "" },
		["bruh"] = { file = "bruh.mp3", url = "" },
		["minecraft"] = { file = "minecraft.mp3", url = "" },
		["minecraft experience"] = { file = "minecraft.mp3", url = "" },
		["osu"] = { file = "osu.mp3", url = "" },
		["stars"] = { file = "stars.mp3", url = "" },
		["fart"] = { file = "fart.mp3", url = "" },
		["vine"] = { file = "vine.mp3", url = "" },
		["fatality"] = { file = "vine.mp3", url = "" },
		["headshot"] = { file = "rust_hs.mp3", url = "" },
		["csgo"] = { file = "rust_hs.mp3", url = "" },
		["skeet"] = { file = "neverlose.mp3", url = "" },
		["tf2"] = { file = "osu.mp3", url = "" },
		["tf2 hitsound"] = { file = "osu.mp3", url = "" },
	}
	local mp3AssetCache = {}
	local customAssetFn = (type(getcustomasset) == "function" and getcustomasset)
		or (type(getsynasset) == "function" and getsynasset) or nil

	local function ensureMp3Asset(entry)
		if not (entry and customAssetFn and type(writefile) == "function" and type(isfile) == "function") then
			return nil
		end
		if mp3AssetCache[entry.file] then return mp3AssetCache[entry.file] end
		local ok, asset = pcall(function()
			if type(isfolder) == "function" and not isfolder(MP3_DIR) and type(makefolder) == "function" then
				makefolder(MP3_DIR)
			end
			local fullPath = MP3_DIR .. "/" .. entry.file
			if not isfile(fullPath) then
				local body = nil -- network disabled (rbxassetid fallback)
				if type(body) == "string" and #body > 500 then
					writefile(fullPath, body)
				end
			end
			if isfile(fullPath) then
				return customAssetFn(fullPath)
			end
			return nil
		end)
		if ok and type(asset) == "string" and #asset > 0 then
			mp3AssetCache[entry.file] = asset
			return asset
		end
		return nil
	end

	-- Pre-download default kill (oof) & hit (rust_hs) MP3s asynchronously on load
	task.spawn(function()
		pcall(ensureMp3Asset, MP3_MAP["oof"])
		pcall(ensureMp3Asset, MP3_MAP["hitmarker"])
		pcall(ensureMp3Asset, MP3_MAP["neverlose"])
	end)

	-- Strict real-audio check: TimeLength MUST be > 0.01 (never trust IsLoaded alone!)
	local function audible(snd)
		local ok, valid = pcall(function()
			return (tonumber(snd.TimeLength) or 0) > 0.01
		end)
		return ok and valid == true
	end

	Pack.Audit = {}

	function Pack.PlaySound(name, volume, life, role)
		role = role or "other"
		local lowName = string.lower(tostring(name or ""))
		local id = nil
		local usedCustomMp3 = false

		-- 1. First prefer local cached MP3 (100% bypasses Roblox Audio Privacy!)
		local mp3Entry = MP3_MAP[lowName]
		if mp3Entry then
			local cached = mp3AssetCache[mp3Entry.file]
			if not cached then
				-- Try instant cache read if already downloaded on disk
				if customAssetFn and type(isfile) == "function" then
					local fullPath = MP3_DIR .. "/" .. mp3Entry.file
					local okF, ex = pcall(isfile, fullPath)
					if okF and ex then
						local okA, a = pcall(customAssetFn, fullPath)
						if okA and type(a) == "string" and #a > 0 then
							mp3AssetCache[mp3Entry.file] = a
							cached = a
						end
					else
						task.spawn(function() pcall(ensureMp3Asset, mp3Entry) end)
					end
				end
			end
			if cached then
				id = cached
				usedCustomMp3 = true
			end
		end

		-- 2. Otherwise resolve from SFX table or raw numeric/rbxassetid string
		if not id then
			local entry = findSound(name)
			id = entry and entry.id
		end
		if not id then
			local rawStr = tostring(name or "")
			local digits = rawStr:match("^(%d+)$") or rawStr:match("rbxassetid://(%d+)")
			if digits then
				id = "rbxassetid://" .. digits
			else
				id = builtinList(role)[1]
			end
		end

		local snd = Instance.new("Sound")
		snd.Name = "NexusSFX"
		snd.SoundId = id
		snd.Volume = math.clamp(tonumber(volume) or Pack.Volume or 1.5, 0.1, 10)
		snd.PlaybackSpeed = Pack.Pitch or 1
		snd.Looped = false
		pcall(function() snd.SoundGroup = nil end)
		-- Parent directly to workspace (2D global audio, matches working 2026 RIVALS scripts!)
		local parented = pcall(function() snd.Parent = workspace end)
		if not parented or not snd.Parent then
			pcall(function() snd.Parent = SoundService end)
		end
		local played = pcall(function() snd:Play() end)
		Pack.Debug.lastPlayed = tick()
		Pack.Debug.lastRole = role
		Pack.Debug.lastError = played and "" or "Play() failed"

		-- 3. Strict fallback ONLY if Roblox blocked the asset (TimeLength == 0 after 0.35s)
		task.delay(0.35, function()
			if not snd or not snd.Parent then return end
			if audible(snd) then
				Pack.Debug.lastAudible = tick()
				Pack.Audit[role] = usedCustomMp3 and "mp3 ok" or "asset ok"
				return
			end
			-- Blocked/private Roblox ID -> play cached Oof/Hit MP3 or guaranteed client builtin!
			Pack.Debug.deadIds = (Pack.Debug.deadIds or 0) + 1
			Pack.Debug.builtinUsed = (Pack.Debug.builtinUsed or 0) + 1
			local fallbackId = nil
			if role == "kill" and mp3AssetCache["oof.mp3"] then
				fallbackId = mp3AssetCache["oof.mp3"]
			elseif role == "hit" and mp3AssetCache["rust_hs.mp3"] then
				fallbackId = mp3AssetCache["rust_hs.mp3"]
			else
				fallbackId = builtinList(role)[1]
			end
			pcall(function()
				snd.SoundId = fallbackId
				snd.TimePosition = 0
				snd:Play()
			end)
			Pack.Audit[role] = "fallback"
		end)

		task.delay(life or 6, function() pcall(function() snd:Destroy() end) end)
		return true
	end

	-- reads back what the chain found, for the GUI status line
	function Pack.SoundReport()
		local parts = {}
		for _, role in ipairs({ "kill", "hit", "fire" }) do
			parts[#parts + 1] = role .. " " .. tostring(Pack.Audit[role] or "?")
		end
		return table.concat(parts, " · ")
	end

	-- plays all three and reports which ones actually make noise
	function Pack.CheckSounds()
		Pack.Audit = {}
		Pack.PlaySound(Pack.KillName or "Oof", Pack.Volume, 4, "kill")
		task.delay(0.5, function() pcall(function()
			Pack.PlaySound(Pack.HitName or "Hitmarker", Pack.HitVol, 4, "hit")
		end) end)
		task.delay(1.0, function() pcall(function()
			Pack.PlaySound(Pack.FireName or "AR2 Head", Pack.FireVol, 4, "fire")
		end) end)
		task.delay(2.0, function()
			pcall(function()
				nexusNotify("sound check · " .. Pack.SoundReport())
			end)
			pcall(function() print("[Nexus] sound check · " .. Pack.SoundReport()) end)
		end)
	end

	-- kill + hit sound --------------------------------------------------------
	-- v6.4 GUARANTEED 6-CHANNEL RIVALS KILL & HIT SOUND ENGINE (0 require, 0 hook!)
	--   Ch 1: Humanoid HealthChanged (>0 -> <=0) / Died / StateChanged(Dead) + 20Hz Poll
	--   Ch 2: RIVALS DamageNumber BillboardGui (instant Hit Sound + Lethal Kill check!)
	--   Ch 3: RIVALS CharacterRemoving / HRP removal in-match (for instant ragdoll-despawn kills!)
	--   Ch 4: Passive ReplicatedStorage.Remotes OnClientEvent listener (0 require, 0 hook!)
	--   Ch 5: PlayerGui Elimination / Killfeed Text Watcher (strict anti-self-death & anti-equip filter)
	--   Ch 6: Independent leaderstats / CustomLeaderstats / Attribute Kill Counter (+1..+2)
	--   FIXES:
	--     * Fixed TeamID == 0 / NexusTeam false-teammate bug that was skipping ALL enemies!
	--     * Default Pack.OnlyMyKills = false so ANY enemy death in RIVALS rings Kill Sound!
	--     * ZERO weapon-equip false triggers (no "finish"/"dead" Sound scanner, no finisher asset trigger!)
	local watched = {}          -- humanoid -> { plr, last, dead, lastHurt, self, lastOurs }
	local ourHitTargets = {}    -- [Player] = tick()
	local lastEnemyHp = {}      -- [Player] = { hp, prev, at }
	local charSpawnedAt = {}    -- [Player] = tick() (prevents fresh spawn/lobby flicker false kills)
	local lastKill, lastHit = -1, -1
	local lastKillByPlayer = {} -- [Player] = tick() dedup

	Pack.MyKillRange = tonumber(Pack.MyKillRange) or 2500
	Pack.AttackWindow = tonumber(Pack.AttackWindow) or 2.5

	Pack.Debug = {
		humanoids = 0, drops = 0, kills = 0, hits = 0,
		lastHitAt = -1, lastKillAt = -1, lastDamageAt = -1,
		lastSource = "none", teammatesSkipped = 0, deathsIgnored = 0,
	}

	-- Fixed team check: NEVER treats everyone as teammates when TeamID is 0/nil/shared!
	local function isMate(plr)
		if not plr or plr == k then return false end
		local myTid = k:GetAttribute("TeamID")
		local thTid = plr:GetAttribute("TeamID")
		if myTid ~= nil and thTid ~= nil and myTid ~= 0 and myTid ~= "" and myTid ~= "None" then
			if myTid == thTid then
				-- Verify there is actually another player with a DIFFERENT TeamID (otherwise shared lobby/FFA ID!)
				local hasDiff = false
				for _, other in ipairs(Players:GetPlayers()) do
					if other ~= k then
						local ot = other:GetAttribute("TeamID")
						if ot ~= nil and ot ~= myTid then
							hasDiff = true
							break
						end
					end
				end
				if hasDiff then return true end
			else
				return false
			end
		end
		-- Only consult external NexusTeam if user actually turned Team Check ON!
		if teamCheckEnabled then
			local ok, res = pcall(function()
				local fn = getgenv().isTeammate
				return type(fn) == "function" and fn(plr) or false
			end)
			if ok and res == true then return true end
		end
		return false
	end

	local function inLobbyNow()
		-- In match subplaces (non-lobby), we are ALWAYS in a live match!
		if game.PlaceId ~= 17625359962 and (game.GameId == 6035872082 or Apex and Apex.GameId == 6035872082) then
			return false
		end
		local ch = k and k.Character
		if not ch then return true end
		if ch:FindFirstChildOfClass("ForceField") then return true end
		local vm = workspace:FindFirstChild("ViewModels")
		local fp = vm and vm:FindFirstChild("FirstPerson")
		local hasTool = ch:FindFirstChildOfClass("Tool") ~= nil
		local hasVM = fp and (#fp:GetChildren() > 0)
		if vm and not hasVM and not hasTool then
			return true
		end
		return false
	end

	function Pack.RecordOurHit(plr)
		if not plr or plr == k or isMate(plr) then return end
		local now = tick()
		ourHitTargets[plr] = now
		local ch = plr.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if hum and watched[hum] then
			watched[hum].lastOurs = now
		end
	end

	function Pack.AttackFresh(win)
		local now = tick()
		if Pack.Holding then
			Pack.LastFire = now
			return true
		end
		win = tonumber(win) or Pack.AttackWindow or 2.5
		if now - (Pack.LastFire or -999) <= win then return true end
		if now - (Pack.LastMelee or -999) <= win + 0.5 then return true end
		if now - (Pack.LastSwing or -999) <= win + 0.5 then return true end
		return false
	end

	function Pack.DistanceTo(plr)
		local myChar = k and k.Character
		local theirChar = plr and plr.Character
		if not (myChar and theirChar) then return nil end
		local a = myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart
		local b = theirChar:FindFirstChild("HumanoidRootPart") or theirChar.PrimaryPart
		if not (a and b) then return nil end
		local ok, d = pcall(function() return (a.Position - b.Position).Magnitude end)
		if ok then return d end
		return nil
	end

	local function aimingNearPlayer(plr)
		local cam = workspace.CurrentCamera
		local ch = plr and plr.Character
		local hrp = ch and (ch:FindFirstChild("HitboxHead") or ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart"))
		if not (cam and hrp) then return false end
		local dir = hrp.Position - cam.CFrame.Position
		if dir.Magnitude < 2 then return true end
		return cam.CFrame.LookVector:Dot(dir.Unit) >= 0.70
	end

	local function nearestEnemyToPoint(worldPos, maxRadius)
		if not worldPos then return nil end
		local best, bestD = nil, maxRadius or 20
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= k and not isMate(plr) and plr.Character then
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
				if hrp then
					local d = (hrp.Position - worldPos).Magnitude
					if d < bestD then
						bestD = d
						best = plr
					end
				end
			end
		end
		return best
	end

	function Pack.IsMine(st, now, win)
		if not st or not st.plr or st.plr == k then return false end
		if isMate(st.plr) then return false end
		-- When OnlyMyKills is OFF (default), EVERY valid enemy death rings the kill sound!
		if not Pack.OnlyMyKills then
			return true
		end
		now = now or tick()
		local hitAt = math.max(st.lastOurs or -999, ourHitTargets[st.plr] or -999)
		if (now - hitAt) <= 6.5 then return true end
		if Pack.AttackFresh(win or 2.8) then
			local d = Pack.DistanceTo(st.plr)
			local range = tonumber(Pack.MyKillRange) or 2500
			if d and range > 0 and d > range then return false end
			if (d and d <= 40) or aimingNearPlayer(st.plr) then return true end
		end
		local dodgeTbl = getgenv and getgenv().NexusDodge
		if type(dodgeTbl) == "table" and dodgeTbl.Active and dodgeTbl.TargetPlayer == st.plr then
			return true
		end
		return false
	end

	local function fireKill(src, victimPlr, forceManual)
		if not (Pack.KillOn and Pack.KillName) then return end
		local now = tick()
		if not forceManual then
			if victimPlr then
				if victimPlr == k or isMate(victimPlr) then return end
				-- Attribution check: we must have damaged this enemy recently!
				local hitAt = math.max(ourHitTargets[victimPlr] or -999, (watched[victimPlr] and watched[victimPlr].lastOurs) or -999)
				if Pack.OnlyMyKills and (now - hitAt > 3.0) and not Pack.AttackFresh(2.0) then
					return
				end
				if now - (lastKillByPlayer[victimPlr] or -999) < 1.0 then return end
				lastKillByPlayer[victimPlr] = now
			else
				if Pack.OnlyMyKills and not Pack.AttackFresh(2.0) then return end
			end
			if now - lastKill < 0.38 then return end
		end
		lastKill = now
		Pack.Debug.kills = Pack.Debug.kills + 1
		Pack.Debug.lastKillAt = now
		Pack.Debug.lastSource = tostring(src or "kill")
		Pack.PlaySound(Pack.KillName, Pack.Volume, 6, "kill")
	end

	local function fireHit(src, force, plr)
		if not (Pack.HitOn and Pack.HitName) then return end
		local now = tick()
		if Pack.HitOnlyMine and not force then
			if plr then
				if plr == k or isMate(plr) then return end
				local hitAt = ourHitTargets[plr] or -999
				local fresh = (now - hitAt <= 1.2) or Pack.AttackFresh(1.0)
				if not fresh then return end
			else
				if not Pack.AttackFresh(1.0) then return end
			end
		end
		if now - lastHit < (Pack.HitRate or 0.04) then return end
		lastHit = now
		Pack.Debug.hits = Pack.Debug.hits + 1
		Pack.Debug.lastHitAt = now
		Pack.Debug.lastSource = tostring(src or "hit")
		Pack.PlaySound(Pack.HitName, Pack.HitVol, 3, "hit")
	end

	function Pack.ForceHit() fireHit("manual", true) end
	function Pack.ForceKill() fireKill("manual", nil, true) end

	local function applyHealth(st, hp, src)
		hp = tonumber(hp)
		if not hp then return end
		if st.self or st.plr == k then
			st.last = hp
			if hp > 0 then st.dead = false end
			return
		end
		if isMate(st.plr) then
			st.last = hp
			if hp > 0 then st.dead = false end
			Pack.Debug.teammatesSkipped = Pack.Debug.teammatesSkipped + 1
			return
		end
		local prev = st.last
		st.last = hp
		local now = tick()
		if st.plr then
			lastEnemyHp[st.plr] = { hp = hp, prev = prev, at = now }
		end
		if hp > prev then
			if hp > 0 then st.dead = false end
			return
		end
		if hp >= prev then return end

		Pack.Debug.drops = Pack.Debug.drops + 1
		Pack.Debug.lastDamageAt = now
		if Pack.AttackFresh(2.5) or (ourHitTargets[st.plr] and now - ourHitTargets[st.plr] <= 3.0) then
			st.lastOurs = now
			ourHitTargets[st.plr] = now
		end

		-- CHANNEL 1: Real death (HP crossed >0 -> <=0)
		if hp <= 0 then
			if st.dead then return end
			st.dead = true
			if prev > 0 and Pack.IsMine(st, now, 2.8) then
				fireKill(src, st.plr, false)
			else
				Pack.Debug.deathsIgnored = (Pack.Debug.deathsIgnored or 0) + 1
			end
			return
		end

		if st.dead then return end
		st.lastHurt = now
		fireHit(src, false, st.plr)
	end

	local function watchHumanoid(hum, plr)
		if not hum then return end
		local st = watched[hum]
		if st then
			if plr then st.plr = plr end
			return st
		end
		local hp = tonumber(hum.Health) or 100
		local isSelf = (plr == k)
		if not isSelf and k and k.Character then
			local myHum = k.Character:FindFirstChildOfClass("Humanoid")
			isSelf = (myHum ~= nil and myHum == hum)
		end
		st = { plr = plr, last = hp, dead = (hp <= 0), lastHurt = -999, self = isSelf, lastOurs = -999 }
		watched[hum] = st
		if plr and not isSelf then
			lastEnemyHp[plr] = { hp = hp, prev = hp, at = tick() }
		end
		Pack.Debug.humanoids = Pack.Debug.humanoids + 1

		pcall(function()
			table.insert(Pack.Conns, hum.HealthChanged:Connect(function(v)
				applyHealth(st, v, "HealthChanged")
			end))
		end)
		pcall(function()
			table.insert(Pack.Conns, hum.Died:Connect(function()
				local wasAlive = (not st.dead) and ((st.last or 0) > 0)
				st.last = 0
				if st.dead then return end
				st.dead = true
				if st.self or st.plr == k or isMate(st.plr) then return end
				if (wasAlive or (not Pack.OnlyMyKills)) and Pack.IsMine(st, tick(), 2.8) then
					fireKill("Died", st.plr, false)
				else
					Pack.Debug.deathsIgnored = (Pack.Debug.deathsIgnored or 0) + 1
				end
			end))
		end)
		pcall(function()
			table.insert(Pack.Conns, hum.StateChanged:Connect(function(_, newState)
				if newState == Enum.HumanoidStateType.Dead then
					if st.dead or st.self or st.plr == k or isMate(st.plr) then return end
					st.dead = true
					st.last = 0
					if Pack.IsMine(st, tick(), 2.8) then
						fireKill("DeadState", st.plr, false)
					end
				end
			end))
		end)
		return st
	end

	local function pollCharacter(char, plr)
		if not char or plr == k then return end
		local hum = nil
		pcall(function() hum = char:FindFirstChildOfClass("Humanoid") end)
		if hum then
			local st = watchHumanoid(hum, plr)
			if st then applyHealth(st, hum.Health, "poll") end
		end
	end

	function Pack.WatchAll()
		local list = {}
		pcall(function() list = Players:GetPlayers() end)
		local count = 0
		for _, plr in ipairs(list) do
			if plr ~= k then
				count = count + 1
				pollCharacter(plr.Character, plr)
			end
		end
		Pack.Debug.players = count
		return count
	end

	local function watchPlayer(plr)
		if plr == k then return end
		local function bind(char)
			if not char then return end
			charSpawnedAt[plr] = tick()
			pollCharacter(char, plr)
			for i = 1, 3 do
				task.delay(0.15 * i, function()
					if __nexusRivalsUnloaded then return end
					pcall(function() pollCharacter(plr.Character or char, plr) end)
				end)
			end
			pcall(function()
				table.insert(Pack.Conns, char.ChildAdded:Connect(function(c)
					if c:IsA("Humanoid") then
						local st = watchHumanoid(c, plr)
						if st then applyHealth(st, c.Health, "ChildAdded") end
					end
				end))
			end)
		end
		if plr.Character then bind(plr.Character) end
		pcall(function()
			table.insert(Pack.Conns, plr.CharacterAdded:Connect(function(char)
				task.wait(0.1)
				bind(char or plr.Character)
			end))
		end)
		-- CHANNEL 3: RIVALS CharacterRemoving (catches instant ragdoll/despawn deaths where Health doesn't replicate 0!)
		pcall(function()
			table.insert(Pack.Conns, plr.CharacterRemoving:Connect(function(char)
				if plr == k or isMate(plr) then return end
				if inLobbyNow() then return end
				local now = tick()
				local aliveDur = now - (charSpawnedAt[plr] or now)
				if aliveDur < 1.5 then return end -- ignore initial spawn swap
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local hp = hum and tonumber(hum.Health) or (lastEnemyHp[plr] and lastEnemyHp[plr].hp) or 100
				local recentlyHit = (now - (ourHitTargets[plr] or -999)) <= 4.0
				if hp <= 0 or recentlyHit or ((not Pack.OnlyMyKills) and hp < 99) then
					fireKill("char-despawn", plr, false)
				end
			end))
		end)
	end

	Pack.WatchAll()
	for _, plr in ipairs(Players:GetPlayers()) do watchPlayer(plr) end
	pcall(function()
		table.insert(Pack.Conns, Players.PlayerAdded:Connect(function(pr)
			watchPlayer(pr)
			task.wait(0.4)
			Pack.WatchAll()
		end))
	end)

	-- 20Hz live Health/Death poller so fast one-shots never slip between frames!
	task.spawn(function()
		while not __nexusRivalsUnloaded do
			task.wait(0.05)
			pcall(Pack.WatchAll)
		end
	end)

	function Pack.KillHook(on, name)
		Pack.KillOn = on == true
