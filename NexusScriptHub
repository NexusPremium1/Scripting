	TrackConn(RunService.RenderStepped:Connect(function(dt)
		if S.Unloaded then return end
		dt = math.min(dt or 0.016, 0.1)

		-- Refresh camera ref
		if S.Camera ~= workspace.CurrentCamera then
			S.Camera = workspace.CurrentCamera
		end

		-- Step ESP Engine (rate-limited inside ESP:Step)
		ESP:Step(dt)

		-- Advance throttled timers
		for k in pairs(timers) do timers[k] = timers[k] + dt end

		-- Auto-Revive if dead
		if LocalPlayer:GetAttribute("Alive") == false then
			if Toggles.InfRevive and Toggles.InfRevive.Value and RemotesFolder and RemotesFolder:FindFirstChild("Revive") then
				if timers.Library > 0.75 then
					timers.Library = 0
					pcall(function() RemotesFolder.Revive:FireServer() end)
				end
			end
			return
		end

		local char = GetChar()
		local hrp  = GetHRP()
		local hum  = GetHum()
		local cam  = S.Camera

		-- 1. WalkSpeed & ClimbSpeed
		if char and hum then
			local climbing = char:GetAttribute("Climbing") == true
			if not climbing and Toggles.EnableMovementSpeed and Toggles.EnableMovementSpeed.Value then
				local spd = (Options.MovementSpeed and Options.MovementSpeed.Value) or 22
				if hum.WalkSpeed ~= spd then hum.WalkSpeed = spd end
			elseif climbing and Toggles.EnableClimbingSpeed and Toggles.EnableClimbingSpeed.Value then
				local spd = (Options.ClimbingSpeed and Options.ClimbingSpeed.Value) or 24
				if hum.WalkSpeed ~= spd then hum.WalkSpeed = spd end
			end
			if Toggles.EnableJump and Toggles.EnableJump.Value and not char:GetAttribute("CanJump") then
				char:SetAttribute("CanJump", true)
			end
		end

		-- 1b. Throttled Monster Anti (10Hz auto godmode & notouch on Rush/Ambush/Figure/Seek)
		if timers.MonsterAnti >= 0.1 then
			timers.MonsterAnti = 0
			if workspace:FindFirstChild("CurrentRooms") ~= S.RoomsBound then
				pcall(BindCurrentRooms)
			end
			if workspace.CurrentCamera ~= S.ScreechCamBound then
				pcall(BindScreechCamera)
			end
			if Toggles.AntiScreech and Toggles.AntiScreech.Value then
				local camNow = workspace.CurrentCamera
				if camNow then
					for _, ch in ipairs(camNow:GetChildren()) do
						if ch.Name == "Screech" or ch.Name == "SCJVEREECH" or ch.Name == "ScreechRetro" then
							LookAtScreech(ch)
						end
					end
				end
			end
			pcall(NexusUpdateMonsterAnti)
		end

		-- 2. Throttled Speed Bypass & Fallback Crouch (8Hz instead of 60Hz!)
		if timers.SpeedByp >= 0.12 then
			timers.SpeedByp = 0
			local crouchRemote = RemotesFolder and RemotesFolder:FindFirstChild("Crouch")
			if crouchRemote then
				if Toggles.SpeedBypass and Toggles.SpeedBypass.Value then
					pcall(function() crouchRemote:FireServer(true, true) end)
				elseif Toggles.FigureHearing and Toggles.FigureHearing.Value then
					pcall(function() crouchRemote:FireServer(true) end)
				end
			end
		end

		-- 3. CollisionClone (needed for smooth DOORS Noclip/Speed)
		if char and not char:FindFirstChild("CollisionClone") then
			local cp = char:FindFirstChild("CollisionPart")
			if cp then
				local ok, cl = pcall(cp.Clone, cp)
				if ok and cl then
					cl.Name = "CollisionClone"
					cl.RootPriority = 127
					cl.Anchored = false
					cl.CanCollide = false
					local cc = cl:FindFirstChild("CollisionCrouch")
					if cc then cc:Destroy() end
					cl.Parent = char
					S.CollisionClone = cl
				end
			end
		end

		-- 4. Noclip (only modifies collisions while ON — zero interference when OFF!)
		if char and Toggles.NoClip and Toggles.NoClip.Value then
			for _, part in ipairs(char:GetChildren()) do
				if part:IsA("BasePart") and part.Name ~= "CollisionClone" then
					if S.CharCanCollide[part] == nil then S.CharCanCollide[part] = part.CanCollide end
					if part.CanCollide then part.CanCollide = false end
				end
			end
			local col = char:FindFirstChild("Collision")
			if col then
				col.CanCollide = false
				local cc = col:FindFirstChild("CollisionCrouch")
				if cc then cc.CanCollide = false end
			end
		end

		-- 5. Modern LinearVelocity Flight (zero legacy BodyVelocity!)
		if hrp and hum and cam and Toggles.Flight and Toggles.Flight.Value then
			if not S.FlightAttach or not S.FlightAttach.Parent then
				S.FlightAttach = Instance.new("Attachment")
				S.FlightAttach.Name = "NexusFlightAtt"
				S.FlightAttach.Parent = hrp
			end
			if not S.FlightVel or not S.FlightVel.Parent then
				S.FlightVel = Instance.new("LinearVelocity")
				S.FlightVel.Name = "NexusFlightLV"
				S.FlightVel.Attachment0 = S.FlightAttach
				S.FlightVel.MaxForce = 1e7
				S.FlightVel.RelativeTo = Enum.ActuatorRelativeTo.World
				S.FlightVel.Parent = hrp
			end
			local speed = (Options.FlightSpeed and Options.FlightSpeed.Value) or 21
			local moveDir = hum.MoveDirection
			local vel = Vector3.zero
			if moveDir.Magnitude > 0.01 then
				local flatLook = cam.CFrame.LookVector * Vector3.new(1, 0, 1)
				if flatLook.Magnitude < 0.001 then flatLook = Vector3.new(0, 0, -1) end
				local flatCam = CFrame.lookAt(Vector3.zero, flatLook)
				local localIn = flatCam:VectorToObjectSpace(moveDir)
				vel = cam.CFrame:VectorToWorldSpace(localIn) * speed
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				vel = vel + Vector3.new(0, speed * 0.85, 0)
			elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
				vel = vel - Vector3.new(0, speed * 0.85, 0)
			end
			S.FlightVel.VectorVelocity = vel
		end

		-- 6. Anti-Cheat Manipulator (Modern LinearVelocity / CFrame)
		if hrp and char and Toggles.AntiCheatMani and Toggles.AntiCheatMani.Value then
			local method = (Options.AntiCheatManiMethod and Options.AntiCheatManiMethod.Value) or "Velocity"
			if method == "Velocity" then
				if Toggles.NoClip and not Toggles.NoClip.Value then Toggles.NoClip:SetValue(true) end
				if not S.ManiAttach or not S.ManiAttach.Parent then
					S.ManiAttach = Instance.new("Attachment")
					S.ManiAttach.Name = "NexusManiAtt"
					S.ManiAttach.Parent = hrp
				end
				if not S.ManiVel or not S.ManiVel.Parent then
					S.ManiVel = Instance.new("LinearVelocity")
					S.ManiVel.Name = "NexusManiLV"
					S.ManiVel.Attachment0 = S.ManiAttach
					S.ManiVel.MaxForce = 1e7
					S.ManiVel.RelativeTo = Enum.ActuatorRelativeTo.World
					S.ManiVel.Parent = hrp
				end
				S.ManiVel.VectorVelocity = hrp.CFrame.LookVector * 2.5
			else
				pcall(function() char:PivotTo(char:GetPivot() * CFrame.new(0, 0, 10000)) end)
			end
		end

		-- 7. Godmode (nil-safe across R15 / R6 / all floors)
		if char and hum and Toggles.Godmode and Toggles.Godmode.Value then
			if RemotesFolder and RemotesFolder.Name == "RemotesFolder" then
				local lt = char:FindFirstChild("LowerTorso")
				local rt = lt and lt:FindFirstChild("Root")
				if rt then
					pcall(function()
						if rt.C1 ~= CFrame.new(0, -2.3, 0) then
							rt.C1 = CFrame.new(0, -2.3, 0)
						end
					end)
				end
				if hum.HipHeight ~= 0.22 then hum.HipHeight = 0.22 end
				local col = char:FindFirstChild("Collision")
				if col then
					if col.Size ~= Vector3.new(1, 1, 4) then col.Size = Vector3.new(1, 1, 4) end
					local cc = col:FindFirstChild("CollisionCrouch")
					if cc and cc.Size ~= Vector3.new(1, 1, 4) then cc.Size = Vector3.new(1, 1, 4) end
				end
			end
			if ((Floor and Floor.Value == "Fools") or (RemotesFolder and RemotesFolder.Name == "Bricks"))
				and Toggles.NoClip and not Toggles.NoClip.Value then
				Toggles.NoClip:SetValue(true)
			end
		end

		-- 8. Camera: Single FOV + Third Person + Smooth Freecam + NoCamShake
		if cam then
			if Toggles.EnableFOV and Toggles.EnableFOV.Value and Options.FOV then
				cam.FieldOfView = Options.FOV.Value
			end
			if Toggles.ThirdPerson and Toggles.ThirdPerson.Value then
				local ox = (Options.ThirdPersonX and Options.ThirdPersonX.Value) or 1.5
				local oy = (Options.ThirdPersonY and Options.ThirdPersonY.Value) or 0.5
				local oz = (Options.ThirdPersonZ and Options.ThirdPersonZ.Value) or 5.0
				local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("FakeHead"))
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local originPos = (head and head.Position) or (root and root.Position + Vector3.new(0, 1.5, 0))

				if originPos then
					local look = cam.CFrame.LookVector
					local right = cam.CFrame.RightVector
					local desiredPos = originPos + (right * ox) + Vector3.new(0, oy, 0) - (look * oz)

					local params = RaycastParams.new()
					params.FilterType = Enum.RaycastFilterType.Exclude
					params.FilterDescendantsInstances = {char, cam}
					local hit = workspace:Raycast(originPos, (desiredPos - originPos), params)
					if hit then
						desiredPos = hit.Position - (look * 0.4)
					end
					cam.CFrame = CFrame.new(desiredPos, desiredPos + look * 20)
				else
					cam.CFrame = cam.CFrame * CFrame.new(ox, oy, oz)
				end

				if char then
					for _, part in ipairs(char:GetDescendants()) do
						if part:IsA("BasePart") then
							part.LocalTransparencyModifier = 0
						end
					end
				end
			end

			if Toggles.Freecam and Toggles.Freecam.Value then
				if cam.CameraType ~= Enum.CameraType.Scriptable then
					cam.CameraType = Enum.CameraType.Scriptable
				end
				if hrp and not hrp.Anchored then hrp.Anchored = true end
				if not S.FreecamPart or not S.FreecamPart.Parent then
					local part = Instance.new("Part")
					part.Name = "NexusFreecamPart"
					part.Size = Vector3.new(0.1, 0.1, 0.1)
					part.Transparency = 1
					part.CanCollide = false
					part.Anchored = true
					part.CFrame = cam.CFrame
					part.Parent = workspace
					S.FreecamPart = part
					LocalPlayer.CameraMinZoomDistance = 0
					LocalPlayer.CameraMaxZoomDistance = 0
					local rx, ry = cam.CFrame:ToOrientation()
					S.FreecamPitch = math.deg(rx)
					S.FreecamYaw   = math.deg(ry)
				end
				local delta = UserInputService:GetMouseDelta()
				local sens = UserInputService.KeyboardEnabled and 0.28 or 0.55
				S.FreecamPitch = math.clamp(S.FreecamPitch - delta.Y * sens, -85, 85)
				S.FreecamYaw   = S.FreecamYaw - delta.X * sens
				S.FreecamPart.CFrame = CFrame.new(S.FreecamPart.Position)
					* CFrame.fromOrientation(math.rad(S.FreecamPitch), math.rad(S.FreecamYaw), 0)
				local fSpeed = (Options.FreecamSpeed and Options.FreecamSpeed.Value) or 55
				local move = Vector3.zero
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + S.FreecamPart.CFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - S.FreecamPart.CFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + S.FreecamPart.CFrame.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - S.FreecamPart.CFrame.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then
					move = move + Vector3.new(0, 1, 0)
				end
				if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
					move = move - Vector3.new(0, 1, 0)
				end
				if move.Magnitude > 0 then
					S.FreecamPart.Position = S.FreecamPart.Position + move.Unit * fSpeed * dt
				end
				cam.CFrame = S.FreecamPart.CFrame
				cam.Focus  = cam.CFrame * CFrame.new(0, 0, -10)
			end
		end
		if Toggles.NoCamShake and Toggles.NoCamShake.Value and S.GameRefs.RequiredMainGame then
			pcall(function() S.GameRefs.RequiredMainGame.csgo = CFrame.new() end)
		end

		-- 9. Lighting (Fullbright + NoFog)
		if Toggles.FullBright and Toggles.FullBright.Value then
			if Lighting.Ambient ~= Color3.new(1, 1, 1) then Lighting.Ambient = Color3.new(1, 1, 1) end
			if Lighting.GlobalShadows then Lighting.GlobalShadows = false end
			local curRooms = workspace:FindFirstChild("CurrentRooms")
			if curRooms then
				local rmNum = tonumber(LocalPlayer:GetAttribute("CurrentRoom")) or (LatestRoom and tonumber(LatestRoom.Value)) or 0
				for offset = 0, 1 do
					local rm = curRooms:FindFirstChild(tostring(rmNum + offset))
					if rm then
						if S.RoomAmbient[rm] == nil then S.RoomAmbient[rm] = rm:GetAttribute("Ambient") end
						if rm:GetAttribute("Ambient") ~= Color3.new(1, 1, 1) then
							rm:SetAttribute("Ambient", Color3.new(1, 1, 1))
						end
					end
				end
			end
		end
		if Toggles.NoFog and Toggles.NoFog.Value then
			if Lighting.FogEnd < 100000 then Lighting.FogEnd = 100000 end
			for _, child in ipairs(Lighting:GetChildren()) do
				if child:IsA("Atmosphere") then
					if S.AtmosphereDensity[child] == nil then S.AtmosphereDensity[child] = child.Density end
					if child.Density > 0 then child.Density = 0 end
				end
			end
		end

		-- 11. FIXED Auto Minecart Steer & Duck (both Left -1 and Right +1!)
		if Toggles.AutoMinecart and Toggles.AutoMinecart.Value and cam and cam:FindFirstChild("MinecartRig") and hrp then
			local latestVal = LatestRoom and tonumber(LatestRoom.Value) or 0
			if latestVal < 49 then
				if not LocalPlayer:GetAttribute("NexusMinecartNotified") then
					LocalPlayer:SetAttribute("NexusMinecartNotified", true)
					Notify("[Auto Minecart] Active — hands off steering!", 4)
				end
				local closestDuck = math.huge
				for i = #S.DuckBoards, 1, -1 do
					local db = S.DuckBoards[i]
					if not db or not db.Parent then
						table.remove(S.DuckBoards, i)
					else
						local p = GetObjPos(db)
						if p then
							local d = (hrp.Position - p).Magnitude
							if d < closestDuck then closestDuck = d end
						end
					end
				end
				if S.GameRefs.RequiredMainGame then
					pcall(function()
						local wantDuck = (closestDuck < 32)
						if S.GameRefs.RequiredMainGame.crouching ~= wantDuck then
							S.GameRefs.RequiredMainGame.crouching = wantDuck
						end
					end)
				end
				local curNode, minDist = nil, math.huge
				for i = #S.MinecartNodes, 1, -1 do
					local node = S.MinecartNodes[i]
					if not node or not node.Parent then
						table.remove(S.MinecartNodes, i)
					elseif node:GetAttribute("ForceConnect") then
						local d = (hrp.Position - node.Position).Magnitude
						if d < minDist then minDist = d; curNode = node end
					end
				end
				if curNode then
					local curNum = tonumber(string.match(curNode.Name, "%d+"))
					local nextNode = nil
					if curNum then
						local wantName = "MinecartNode" .. tostring(curNum + 3)
						for _, nd in ipairs(S.MinecartNodes) do
							if nd.Name == wantName then nextNode = nd; break end
						end
					end
					if nextNode then
						local distToCur = (hrp.Position - curNode.Position).Magnitude
						local steerVec = Vector3.new(0, 0, -1)
						if distToCur <= 32 then
							local dir = (nextNode.Position - curNode.Position).Unit
							local dot = dir:Dot(curNode.CFrame.RightVector)
							-- FIXED BUG: legacy code returned (+1,0,0) for BOTH left and right!
							if dot > 0.15 then
								steerVec = Vector3.new(1, 0, 0)
							elseif dot < -0.15 then
								steerVec = Vector3.new(-1, 0, 0)
							end
						end
						-- Native cart steering is intentionally left to the player.
					end
				end
			else
				if LocalPlayer:GetAttribute("NexusMinecartNotified") then
					LocalPlayer:SetAttribute("NexusMinecartNotified", false)
					Notify("[Auto Minecart] Finished — control restored!", 4)
				end
				Toggles.AutoMinecart:SetValue(false)
			end
		end

		-- 12. FIXED Auto Anchor Solver (Works on Door 50 AND Door 150, submits FINAL code!)
		if timers.Anchor >= 0.45 and hrp
			and ((Toggles.AutoAnchorSolver and Toggles.AutoAnchorSolver.Value)
				or (Toggles.NotifyAnchorCode and Toggles.NotifyAnchorCode.Value)) then
			timers.Anchor = 0
			local mui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
				and LocalPlayer.PlayerGui:FindFirstChild("MainUI")
			local hint = mui and mui:FindFirstChild("AnchorHintFrame")
			if hint and hint.Visible then
				local idLbl   = hint:FindFirstChild("AnchorCode")
				local codeLbl = hint:FindFirstChild("Code")
				local targetID = idLbl and idLbl.Text
				local rawCode  = codeLbl and codeLbl.Text
				if targetID and rawCode then
					for i = #S.Anchors, 1, -1 do
						local anc = S.Anchors[i]
						if not anc or not anc.Parent then
							table.remove(S.Anchors, i)
						else
							local sign = anc:FindFirstChild("Sign")
							local slbl = sign and sign:FindFirstChild("TextLabel")
							if slbl and slbl.Text == targetID then
								local finalCode = ComputeAnchorCode(anc, rawCode)
								local key = targetID .. ":" .. tostring(finalCode)
								if Toggles.NotifyAnchorCode and Toggles.NotifyAnchorCode.Value and S.LastAnchorNotif ~= key then
									S.LastAnchorNotif = key
									Notify("Anchor [" .. targetID .. "] Solved Code: " .. tostring(finalCode), 6)
								end
								if Toggles.AutoAnchorSolver and Toggles.AutoAnchorSolver.Value then
									local pos = GetObjPos(anc)
									if pos and (hrp.Position - pos).Magnitude < 22 then
										local rf = anc:FindFirstChildOfClass("RemoteFunction")
										if rf then
											-- FIXED BUG: Legacy code invoked raw `Code` instead of `finalCode`!
											pcall(function() rf:InvokeServer(tostring(finalCode)) end)
										end
									end
								end
								break
							end
						end
					end
				end
			end
		end

		-- Library: no guessed digits; proximity + bounded retries.
		if timers.Library >= 0.6 and LatestRoom and tonumber(LatestRoom.Value) == 50 then
			timers.Library = 0
			local code = GetLibraryCode()
			if code and Toggles.NotifyLibraryCode and Toggles.NotifyLibraryCode.Value and code ~= S.LastLibCode then
				S.LastLibCode = code
				Notify("Library Code: " .. code, 6)
			end
			if Toggles.AutoLibraryCode and Toggles.AutoLibraryCode.Value then
				SubmitLibraryCode(false)
			end
		end

		-- 14. Auto Interact (Single dt, Smart Filtering, Zero Leaks!)
		local interactDelay = (Options.AutoInteractDelay and Options.AutoInteractDelay.Value) or 0.06
		if Toggles.AutoInteract and Toggles.AutoInteract.Value and timers.Interact >= interactDelay and hrp then
			timers.Interact = 0
			local maxRange = (Options.AutoInteractRange and Options.AutoInteractRange.Value) or 12
			local ignoreGold   = Toggles.AutoInteractIgnoreGold and Toggles.AutoInteractIgnoreGold.Value
			local ignoreChests = Toggles.AutoInteractIgnoreChests and Toggles.AutoInteractIgnoreChests.Value
			for i = #S.Interactions, 1, -1 do
				local pr = S.Interactions[i]
				if not pr or not pr.Parent then
					table.remove(S.Interactions, i)
				else
					local parent = pr.Parent
					local pName = parent.Name
					local skip = (pName == "Padlock" or pName == "KeyObtainFake" or pName == "Mandrake"
						or pName == "MandrakeLive" or parent:GetAttribute("JeffShop"))
						or (pName == "GoldPile" and (ignoreGold or (Floor and Floor.Value == "Fools")))
						or (ignoreChests and (pName == "ChestBoxLocked" or pName == "Toolbox_Locked"))
						or (pr:GetAttribute("NexusInfActive") and pr.Name ~= "NexusInfPrompt")
						or (pr:GetAttribute("Interactions") and pr:GetAttribute("Interactions") > 0)
					if not skip then
						local pos = GetObjPos(parent)
						if pos and (hrp.Position - pos).Magnitude <= maxRange then
							if not pr.Enabled then pr.Enabled = true end
							FirePromptSafe(pr)
						end
					end
				end
			end
		end

		-- 15. Door Reach (throttled 0.2s)
		if Toggles.DoorReach and Toggles.DoorReach.Value and timers.DoorReach >= 0.2 and hrp then
			timers.DoorReach = 0
			local curRooms = workspace:FindFirstChild("CurrentRooms")
			local rm = curRooms and LatestRoom and curRooms:FindFirstChild(tostring(tonumber(LatestRoom.Value) or 0))
			local door = rm and rm:FindFirstChild("Door")
			local doorPart = door and door:FindFirstChild("Door")
			local co = door and door:FindFirstChild("ClientOpen")
			local maxD = (Options.DoorReachDist and Options.DoorReachDist.Value) or 25
			if co and doorPart and rm.Name ~= "101" and (hrp.Position - doorPart.Position).Magnitude <= maxD then
				pcall(function() co:FireServer() end)
			end
		end

		-- 16. Subfloor Quick-Assists (Backdoor TimeLevers, Outdoors VineLevers, Mines Pumps)
		if timers.SubAssist >= 0.25 and hrp then
			timers.SubAssist = 0
			local wantTimer = Toggles.AutoTimeLevers and Toggles.AutoTimeLevers.Value
			local wantVine  = Toggles.AutoVineLevers and Toggles.AutoVineLevers.Value
			local wantPump  = Toggles.AutoPumpsButtons and Toggles.AutoPumpsButtons.Value
			if wantTimer or wantVine or wantPump then
				for _, pr in ipairs(S.Interactions) do
					if pr and pr.Parent then
						local anc = pr.Parent
						local gp = anc.Parent
						local nm = anc.Name
						local gnm = gp and gp.Name or ""
						local match = (wantTimer and (nm == "TimerLever" or gnm == "TimerLever"))
							or (wantVine and (nm == "VineGuillotine" or gnm == "VineGuillotine"))
							or (wantPump and (nm == "WaterPump" or gnm == "WaterPump" or nm == "MinesGateButton" or nm == "LeverForGate" or gnm == "LeverForGate"))
						if match then
							local pos = GetObjPos(anc)
							if pos and (hrp.Position - pos).Magnitude <= 14 then
								FirePromptSafe(pr)
							end
						end
					end
				end
			end
			-- Backdoor Low-Time Warning
			if Toggles.BackdoorLowTime and Toggles.BackdoorLowTime.Value and Floor and Floor.Value == "Backdoor" then
				local timerVal = ReplicatedStorage:FindFirstChild("FloorReplicated")
					and ReplicatedStorage.FloorReplicated:FindFirstChild("DigitalTimer")
				local tNum = timerVal and tonumber(timerVal.Value)
				if tNum then
					if tNum > 0 and tNum <= 15 and not S.LowTimeWarned then
