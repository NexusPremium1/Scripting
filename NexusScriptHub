		local v = getter()
		local pct = math.clamp((v - min) / math.max(max - min, 0.0001), 0, 1)
		fill.Size = UDim2.fromScale(pct, 1)
		local w = track.AbsoluteSize.X
		if w > 0 then
			knob.Position = UDim2.fromOffset(10 + pct * w, 30.5)
		end
		value.Text = tostring(round1(v)) .. (suffix or "")
	end

	track:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh)

	local function setFromX(px)
		local w = track.AbsoluteSize.X
		if w <= 0 then return end
		local pct = math.clamp(px / w, 0, 1)
		setter(min + (max - min) * pct)
		refresh()
	end

	local dragging = false
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			setFromX(input.Position.X - track.AbsolutePosition.X)
		end
