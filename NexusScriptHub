--===========================================================================
local FlyState = {Active = false, Velocity = nil, Align = nil, Attachment = nil, Smooth = Vector3.new(0, 0, 0)}
local FlyRayParams = RaycastParams.new()
pcall(function() FlyRayParams.FilterType = Enum.RaycastFilterType.Exclude end)

local function FlyKeyDown(key)
	local ok, value = pcall(function() return UserInputService:IsKeyDown(key) end)
	return ok and value == true
end

local function FlyCleanup()
	if FlyState.Velocity then pcall(function() FlyState.Velocity:Destroy() end) end
	if FlyState.Align then pcall(function() FlyState.Align:Destroy() end) end
	if FlyState.Attachment then pcall(function() FlyState.Attachment:Destroy() end) end
	FlyState.Velocity, FlyState.Align, FlyState.Attachment = nil, nil, nil
	FlyState.Smooth = Vector3.new(0, 0, 0)
	local hum = (k.Character and k.Character:FindFirstChildOfClass("Humanoid")) or Humanoid
	if hum then
		pcall(function()
			hum.PlatformStand = false
			hum.AutoRotate = true
		end)
	end
end

local FlyStopping = false

function FlyStop(silent)
	FlyState.Active = false
	FlyCleanup()
	if NexusGroundReset then pcall(NexusGroundReset) end
	-- recursion guard: the SetValue(false) callback calls FlyStop again
	if FlyStopping or not _G.NexusUltraFlyToggle then
		return
	end
	if _G.NexusUltraFlyToggle.Value == false then
		return
	end
	FlyStopping = true
	pcall(function() _G.NexusUltraFlyToggle:SetValue(false) end)
	FlyStopping = false
end

function FlyStart()
	local char = k.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root and hum.Health > 0) then
		return false
	end
	FlyCleanup()
	local attachment = Instance.new("Attachment")
	attachment.Name = "NexusUltraFlyAttachment"
	attachment.Parent = root
	FlyState.Attachment = attachment
	local modernOk = pcall(function()
		local velocity = Instance.new("LinearVelocity")
		velocity.Name = "NexusUltraFlyVelocity"
		velocity.Attachment0 = attachment
		velocity.RelativeTo = Enum.ActuatorRelativeTo.World
		velocity.MaxForce = 1e6
		velocity.VectorVelocity = Vector3.new(0, 0, 0)
		velocity.Parent = root
		FlyState.Velocity = velocity
		local align = Instance.new("AlignOrientation")
		align.Name = "NexusUltraFlyAlign"
		align.Attachment0 = attachment
		align.Mode = Enum.OrientationAlignmentMode.OneAttachment
		align.MaxTorque = 1e6
		align.Responsiveness = 25
		align.CFrame = root.CFrame
		align.Parent = root
		FlyState.Align = align
	end)
	if not modernOk or not (FlyState.Velocity and FlyState.Velocity.Parent) then
		if FlyState.Velocity then pcall(function() FlyState.Velocity:Destroy() end) FlyState.Velocity = nil end
		if FlyState.Align then pcall(function() FlyState.Align:Destroy() end) FlyState.Align = nil end
		local bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.Name = "NexusUltraFlyVelocity"
		bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		bodyVelocity.P = 2000
		bodyVelocity.Velocity = Vector3.new(0, 0, 0)
		bodyVelocity.Parent = root
		FlyState.Velocity = bodyVelocity
		local bodyGyro = Instance.new("BodyGyro")
		bodyGyro.Name = "NexusUltraFlyGyro"
		bodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
		bodyGyro.P = 8000
		bodyGyro.D = 600
		bodyGyro.CFrame = root.CFrame
		bodyGyro.Parent = root
		FlyState.Align = bodyGyro
	end
	pcall(function()
		hum.PlatformStand = true
		hum.AutoRotate = false
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	end)
	FlyState.Active = true
	return true
end

function FlyStep(dt)
	if not FlyState.Active then
		return
	end
	local char = k.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root and hum.Health > 0) then
		FlyStop(true)
		return
	end
	if not (FlyState.Velocity and FlyState.Velocity.Parent) then
		FlyState.Active = false
		FlyStart()
		return
	end
	local cam = Workspace.CurrentCamera or Camera
	local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.01 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end
	local flatRight = Vector3.new(-flatLook.Z, 0, flatLook.X)
	local wish = Vector3.new(0, 0, 0)
	if FlyKeyDown(Enum.KeyCode.W) then wish = wish + flatLook end
	if FlyKeyDown(Enum.KeyCode.S) then wish = wish - flatLook end
	if FlyKeyDown(Enum.KeyCode.D) then wish = wish + flatRight end
	if FlyKeyDown(Enum.KeyCode.A) then wish = wish - flatRight end
	if wish.Magnitude > 0.01 then
		wish = wish.Unit
	end
	local vertical = 0
	if FlyKeyDown(Enum.KeyCode.Space) then vertical = vertical + 1 end
	if FlyKeyDown(Enum.KeyCode.LeftControl) then vertical = vertical - 1 end
	local speed = tonumber(_G.NexusUltraFlySpeed) or 100
	local target = wish * speed + Vector3.new(0, vertical * speed * 0.85, 0)
	local alpha = math.clamp(dt * 14, 0.08, 1)
	FlyState.Smooth = FlyState.Smooth:Lerp(target, alpha)
	if FlyState.Smooth.Magnitude < 0.3 and target.Magnitude < 0.3 then
		FlyState.Smooth = Vector3.new(0, 0, 0)
	end
	if FlyState.Smooth.Y < 0 then
		local ok, hit = pcall(function()
			FlyRayParams.FilterDescendantsInstances = {char}
			return Workspace:Raycast(root.Position, Vector3.new(0, -7, 0), FlyRayParams)
		end)
		if ok and hit then
			FlyState.Smooth = Vector3.new(FlyState.Smooth.X, 0, FlyState.Smooth.Z)
		end
	end
	pcall(function()
		if FlyState.Velocity:IsA("LinearVelocity") then
			FlyState.Velocity.VectorVelocity = FlyState.Smooth
		else
			FlyState.Velocity.Velocity = FlyState.Smooth
		end
		if FlyState.Align then
			FlyState.Align.CFrame = (cam and cam.CFrame) or root.CFrame
		end
	end)
end

