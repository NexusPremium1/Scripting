Eng.Fruit = {}

local VENDOR_WORDS = { "dealer", "seller", "vendor", "gacha", "shop", "blacksmith", "teacher", "editor", "captain", "remove", "manager", "scientist", "nerd", "hunter", "quest", "worker", "master" }

function Eng.Fruit.IsVendorName(name)
	local low = string.lower(tostring(name or ""))
	for _, w in ipairs(VENDOR_WORDS) do
		if low:find(w, 1, true) then return true end
	end
	return false
end

function Eng.Fruit.HasHumanoid(model)
	local ok, h = pcall(function() return model:FindFirstChildWhichIsA("Humanoid", true) end)
	return ok and h ~= nil
end

function Eng.Fruit.GetVendors()
	local list, seen = {}, {}
	local function add(model)
		if not model or seen[model] or not model:IsA("Model") then return end
		if not Eng.Fruit.IsVendorName(model.Name) or not Eng.Fruit.HasHumanoid(model) then return end
		local part = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model:FindFirstChildWhichIsA("BasePart", true)
		if not part then return end
		seen[model] = true
		table.insert(list, { Name = model.Name, Model = model, Part = part })
	end
	local npcs = Workspace:FindFirstChild("NPCs")
	if npcs then
		for _, m in ipairs(npcs:GetChildren()) do add(m) end
	end
	table.sort(list, function(a, b) return a.Name < b.Name end)
	return list
end

function Eng.Fruit.FindVendor(query)
	local q = string.lower(tostring(query or ""))
	if q == "" then return nil end
	for _, v in ipairs(Eng.Fruit.GetVendors()) do
		if string.lower(v.Name) == q or string.lower(v.Name):find(q, 1, true) then
			return v
		end
	end
	return nil
end

function Eng.Fruit.NearestVendor()
	local root = getRoot()
	if not root then return nil end
	local best, bestD = nil, math.huge
	for _, v in ipairs(Eng.Fruit.GetVendors()) do
		local d = (v.Part.Position - root.Position).Magnitude
		if d < bestD then bestD = d; best = v end
	end
	return best
end

function Eng.Fruit.GoToVendor(vendor)
	if not vendor or not vendor.Part then
		notify("Vendors", "Vendor NPC not found in current Sea.", 2.5)
		return false
	end
	S.Farming = false
	S.ChestFarm = false
	Eng.Travel.TweenTo(vendor.Part.Position + Vector3.new(0, 3, 4))
	notify("Vendors", "Arrived at " .. vendor.Name, 2.5)
	return true
end

-- Exact v1.6 Vendor-Filtered Dropped Fruit Scanner!
function Eng.Fruit.GetSpawnedFruits()
	local out = {}
	for _, obj in ipairs(Workspace:GetChildren()) do
		if (obj:IsA("Tool") or obj:IsA("Model")) and obj.Name:find("Fruit") then
			if not Eng.Fruit.IsVendorName(obj.Name) and not Eng.Fruit.HasHumanoid(obj) then
				local handle = obj:FindFirstChild("Handle", true) or obj:FindFirstChildWhichIsA("BasePart", true)
				if handle then
					table.insert(out, { Object = obj, Part = handle, Name = obj.Name })
				end
			end
		end
	end
	return out
end

-- FIXED 2025/2026 Fruit Storage using GetAttribute("OriginalName")!
function Eng.Fruit.ResolveStoreId(tool)
	if not tool then return nil end
	local attr = nil
	pcall(function() attr = tool:GetAttribute("OriginalName") end)
	if type(attr) == "string" and #attr > 0 then return attr end
	local base = tool.Name:gsub("%s*Fruit%s*$", ""):gsub("^%s+", ""):gsub("%s+$", "")
	if DATA.SpecialFruitNames[base] then return DATA.SpecialFruitNames[base] end
	if base:find("-") then return base end
	return base .. "-" .. base
end

function Eng.Fruit.StoreAllFruits(silent)
	local stored = 0
	local function scan(container)
		if not container then return end
		for _, t in ipairs(container:GetChildren()) do
			if t:IsA("Tool") and (t.Name:find("Fruit") or t:FindFirstChild("Fruit")) then
				local id = Eng.Fruit.ResolveStoreId(t)
				if id then
					local ok = Net.Comm("StoreFruit", id, t)
					if ok then stored = stored + 1 end
					task.wait(0.12)
				end
			end
		end
	end
	scan(getChar())
	scan(LP:FindFirstChild("Backpack"))
	if not silent then
		notify("Fruit Storage", stored > 0 and ("Stored " .. tostring(stored) .. " fruit(s)!") or "No storable fruits in Backpack/Hand.", 2.5)
	end
	return stored
end

function Eng.Fruit.FetchDealerStock()
	local ok, data = Net.Comm("GetFruits")
	if not ok or type(data) ~= "table" then
		S.LastStockText = "Could not fetch Blox Fruit Dealer stock."
		return {}
	end
	local onSale = {}
	for _, item in ipairs(data) do
		if type(item) == "table" and item.OnSale then
			table.insert(onSale, string.format("%s ($%s)", tostring(item.Name), tostring(item.Price or "?")))
		end
	end
	if #onSale == 0 then
		S.LastStockText = "No fruits currently reported on sale."
	else
		S.LastStockText = "In Stock Now (" .. tostring(#onSale) .. "):\n" .. table.concat(onSale, " | ")
	end
	return data
end

