function Apex.RecordUse(item)
	local st = State.Stats[item.Id]
	if type(st) ~= "table" then st = {Count = 0, Last = 0} end
	st.Count = (tonumber(st.Count) or 0) + 1
	st.Last = os.time()
	State.Stats[item.Id] = st
	for i = #State.Recent, 1, -1 do
		if State.Recent[i] == item.Id then table.remove(State.Recent, i) end
	end
	table.insert(State.Recent, 1, item.Id)
	while #State.Recent > 12 do
		table.remove(State.Recent)
	end
	Apex.SaveState()
end
