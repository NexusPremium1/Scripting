-- 5F. LOCALPLAYER MOVEMENT, VISUALS & CLEAN ESP ENGINE
--============================================================================--
Eng.Player = {}

function Eng.Player.StopFly()
	for _, obj in ipairs(S.FlyObjs) do
		pcall(function() obj:Destroy() end)
	end
	S.FlyObjs = {}
	local hum = getHum()
	if hum then
		pcall(function() hum.PlatformStand = false end)
	end
end

function Eng.Player.UpdateFly()
	if not S.FlyOn then return end
	local hum = getHum()
	local root = getRoot()
	if not hum or not root then return end
	if hum.SeatPart then
		Eng.Player.StopFly()
		return
	end
	hum.PlatformStand = true
	local att = root:FindFirstChild("NexusFlyAtt")
	local lv = root:FindFirstChild("NexusFlyLV")
	local ao = root:FindFirstChild("NexusFlyAO")
	if not att then
		att = Instance.new("Attachment")
		att.Name = "NexusFlyAtt"
		att.Parent = root
		table.insert(S.FlyObjs, att)
	end
	if not lv then
		lv = Instance.new("LinearVelocity")
		lv.Name = "NexusFlyLV"
		lv.Attachment0 = att
		lv.MaxForce = math.huge
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.Parent = root
		table.insert(S.FlyObjs, lv)
	end
	if not ao then
		ao = Instance.new("AlignOrientation")
		ao.Name = "NexusFlyAO"
		ao.Attachment0 = att
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.MaxTorque = math.huge
		ao.Responsiveness = 50
		ao.Parent = root
		table.insert(S.FlyObjs, ao)
	end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local dir = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
	local spd = S.FlySpeed
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then spd = spd * 1.75 end
	lv.VectorVelocity = (dir.Magnitude > 0.01) and (dir.Unit * spd) or Vector3.zero
	ao.CFrame = CFrame.lookAt(root.Position, root.Position + cam.CFrame.LookVector)
end

function Eng.Player.ClearESPFor(plr)
	local rec = S.ESPStore[plr]
	if not rec then return end
	pcall(function() if rec.HL then rec.HL:Destroy() end end)
	pcall(function() if rec.BB then rec.BB:Destroy() end end)
	S.ESPStore[plr] = nil
end

function Eng.Player.ClearAllESP()
	for plr in pairs(S.ESPStore) do
		Eng.Player.ClearESPFor(plr)
	end
	S.ESPStore = {}
end

function Eng.Player.GetESPColor()
	if S.ESPColorName == "RGB Rainbow" then
		return Color3.fromHSV((os.clock() * 0.25) % 1, 0.9, 1)
	elseif S.ESPColorName == "Custom Picker" then
		return S.ESPCustomColor or Color3.fromRGB(0, 230, 255)
	end
	return DATA.Colors[S.ESPColorName] or Color3.fromRGB(0, 230, 255)
end

function Eng.Player.UpdateESP()
	if not S.ESPEnabled then
		if next(S.ESPStore) then Eng.Player.ClearAllESP() end
		return
	end
	local myRoot = getRoot()
	local col = Eng.Player.GetESPColor()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = getChar(plr)
			local head = char and char:FindFirstChild("Head")
			local tRoot = getRoot(plr)
			local hum = getHum(plr)
			if char and head and tRoot and hum and hum.Health > 0 then
				local dist = myRoot and math.floor((myRoot.Position - tRoot.Position).Magnitude) or 0
				if dist <= S.ESPMaxDist then
					local rec = S.ESPStore[plr]
					if not rec or rec.Char ~= char then
						Eng.Player.ClearESPFor(plr)
						rec = { Char = char }
						local hl = Instance.new("Highlight")
						hl.Name = "NexusBH_HL"
						hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.FillTransparency = 0.65
						hl.OutlineTransparency = 0.08
						hl.Adornee = char
						hl.Parent = char
						rec.HL = hl

						local bb = Instance.new("BillboardGui")
						bb.Name = "NexusBH_BB"
						bb.Adornee = head
						bb.Size = UDim2.fromOffset(180, 44)
						bb.StudsOffset = Vector3.new(0, 2.8, 0)
						bb.AlwaysOnTop = true
						bb.Parent = head
						local lbl = Instance.new("TextLabel")
						lbl.Size = UDim2.fromScale(1, 1)
						lbl.BackgroundTransparency = 1
						lbl.Font = Enum.Font.GothamBold
						lbl.TextSize = 12
						lbl.TextStrokeTransparency = 0.25
						lbl.TextColor3 = col
						lbl.Parent = bb
						rec.BB = bb
						rec.Label = lbl
						S.ESPStore[plr] = rec
					end
					if rec.HL then
						rec.HL.Enabled = S.ESPChams
						rec.HL.FillColor = col
						rec.HL.OutlineColor = col
					end
					if rec.BB and rec.Label then
						rec.BB.Enabled = S.ESPLabels
						rec.Label.TextColor3 = col
						local extra = S.ESPShowAge and (" | " .. tostring(plr.AccountAge) .. "d") or ""
						local vehTag = (hum.SeatPart ~= nil) and " [CAR]" or ""
						rec.Label.Text = string.format("%s%s\n%dm%s", plr.DisplayName, vehTag, dist, extra)
					end
				else
					Eng.Player.ClearESPFor(plr)
				end
			else
				Eng.Player.ClearESPFor(plr)
			end
		end
	end
end

--============================================================================--
-- 5G. NON-LEAKING PROTECTIONS ENGINE (Zero cloning crashes!)
--============================================================================--
Eng.Protect = {}

function Eng.Protect.DisablePartCollision(part)
	if not part or not part:IsA("BasePart") then return end
	if S.TouchedColliders[part] == nil then
		S.TouchedColliders[part] = { CanCollide = part.CanCollide, CanTouch = part.CanTouch }
	end
	if part.CanCollide then part.CanCollide = false end
	if part.CanTouch then part.CanTouch = false end
end

function Eng.Protect.RestoreAllColliders()
	for part, orig in pairs(S.TouchedColliders) do
		if part and part.Parent then
			pcall(function()
				part.CanCollide = orig.CanCollide
				part.CanTouch = orig.CanTouch
			end)
		end
	end
	S.TouchedColliders = {}
	S.ProcessedFlingModels = setmetatable({}, { __mode = "k" })
end

function Eng.Protect.IsMyVehicle(model)
	if not model then return false end
	if model.Name == (LocalPlayer.Name .. "Car") then return true end
	local myChar = getChar()
	if not myChar then return false end
	for _, s in ipairs(model:GetDescendants()) do
		if (s:IsA("VehicleSeat") or s:IsA("Seat")) and s.Occupant and s.Occupant.Parent == myChar then
			return true
		end
	end
	return false
end

function Eng.Protect.TickProtections()
	local myChar = getChar()
	local myRoot = getRoot()
	local myHum = getHum()

	-- Anti-Sit
	if S.AntiSitOn and myHum then
		pcall(function()
			myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
			if myHum.Sit or myHum:GetState() == Enum.HumanoidStateType.Seated then
				myHum.Sit = false
				myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	end

	-- Anti-Ragdoll
	if S.AntiRagdollOn and myHum then
		pcall(function()
			myHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			myHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
			if myHum.PlatformStand and not S.FlyOn then
				myHum.PlatformStand = false
			end
		end)
	end

	-- Anti-Void Rescue
	if S.AntiVoidOn and myRoot then
		if myRoot.Position.Y > 2 and myRoot.AssemblyLinearVelocity.Magnitude < 120 then
			S.LastSafeCF = myRoot.CFrame
		elseif myRoot.Position.Y < -55 then
			local rescue = S.LastSafeCF or CFrame.new(-26, 6, -14)
			safePivot(myChar, rescue)
			zeroVelocity(myRoot)
		end
	end

	-- Master Anti-Fling (Clamp abnormal fling speeds + disable other player collision — direct limb parts only!)
	if S.AntiFlingOn then
		if myRoot and not S.FlyOn and not S.CarFlyOn and not S.TrollActive then
			if myRoot.AssemblyLinearVelocity.Magnitude > 180 or myRoot.AssemblyAngularVelocity.Magnitude > 80 then
				zeroVelocity(myRoot)
				if S.LastSafeCF then safePivot(myChar, S.LastSafeCF) end
			end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				for _, part in ipairs(p.Character:GetChildren()) do
					if part:IsA("BasePart") and part.CanCollide then
						part.CanCollide = false
					end
				end
			end
		end
	end

	-- Anti Vehicle / Canoe / Air / Ball Fling (Cached per model — zero 12Hz GetDescendants lag!)
	local function disableModelOnce(model, skipVehicleSeats)
		if not model or S.ProcessedFlingModels[model] then return end
		S.ProcessedFlingModels[model] = true
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and (not skipVehicleSeats or not p:IsA("VehicleSeat")) then
				Eng.Protect.DisablePartCollision(p)
			end
		end
	end

	if S.AntiVehFlingOn then
		local vf = Eng.Vehicle.GetFolder()
		if vf then
			for _, car in ipairs(vf:GetChildren()) do
				if not S.ProcessedFlingModels[car] and not Eng.Protect.IsMyVehicle(car) then
					disableModelOnce(car, true)
				end
			end
		end
	end

	local wcom = Workspace:FindFirstChild("WorkspaceCom")
	if wcom then
		if S.AntiCanoeFlingOn then
			local cf = wcom:FindFirstChild("001_CanoeStorage")
			if cf then
				for _, item in ipairs(cf:GetChildren()) do
					if not S.ProcessedFlingModels[item] then
						local own = item:FindFirstChild("Owner")
						if not (own and own.Value == LocalPlayer) then
							disableModelOnce(item, false)
						end
					end
				end
			end
		end
		if S.AntiBallFlingOn then
			local bf = wcom:FindFirstChild("001_SoccerBalls")
			if bf then
				for _, ball in ipairs(bf:GetChildren()) do
					if ball:IsA("BasePart") then
						Eng.Protect.DisablePartCollision(ball)
					else
						disableModelOnce(ball, false)
					end
				end
			end
		end
		if S.AntiAirFlingOn then
			local heli = wcom:FindFirstChild("001_HeliStorage")
			if heli then
				for _, item in ipairs(heli:GetChildren()) do
					disableModelOnce(item, false)
				end
			end
			local airport = wcom:FindFirstChild("001_Airport")
			local jet = airport and airport:FindFirstChild("AirportHanger")
			if jet then
				disableModelOnce(jet, false)
			end
		end
	end
end

function Eng.Protect.SetAntiLag(state)
	S.AntiLagOn = state == true
	local target = S.AntiLagOn
	notify("Anti-Lag", target and "Suppressing lag particles & explosions..." or "Restoring visual effects...", 2.5)
	trackThread(function()
		local n = 0
		for _, d in ipairs(Workspace:GetDescendants()) do
			n = n + 1
			if n % 600 == 0 then
				task.wait()
				if S.Unloaded or S.AntiLagOn ~= target then return end
			end
			if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
				pcall(function() d.Enabled = not target end)
			elseif d:IsA("Explosion") and target then
				pcall(function() d.Visible = false end)
			end
		end
	end)
end

local function isExternalSpamSound(snd)
	if not snd or not snd:IsA("Sound") then return false end
	if snd.Name == "NexusGunMirror" then return false end
	if snd.Parent == Workspace then return true end
	-- Also catch New 2025/2026 Gun Handle sound spam attached to other players' characters/tools
	local myChar = getChar()
	if myChar and snd:IsDescendantOf(myChar) then return false end
	local p = snd.Parent
	if p and p.Name == "Handle" and p.Parent and p.Parent:IsA("Tool") then
		return true
	end
	return false
end

function Eng.Protect.SetAntiSoundSpam(state)
	S.AntiSoundSpamOn = state == true
	if S.AntiSoundSpamOn then
		for _, s in ipairs(Workspace:GetChildren()) do
			if isExternalSpamSound(s) then
				if S.MutedSounds[s] == nil then S.MutedSounds[s] = s.Volume end
				s.Volume = 0
			end
		end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				for _, d in ipairs(plr.Character:GetDescendants()) do
					if isExternalSpamSound(d) then
						if S.MutedSounds[d] == nil then S.MutedSounds[d] = d.Volume end
						d.Volume = 0
					end
				end
			end
		end
		notify("Anti-Sound Spam", "Old Workspace + New Gun Handle spam muted!", 2.5)
	else
		for s, vol in pairs(S.MutedSounds) do
			if s and s.Parent then
				pcall(function() s.Volume = vol end)
			end
		end
		S.MutedSounds = {}
	end
end


