function SkinSys.ContentId(id)
	if id == nil then return nil end
	local s = tostring(id)
	if s == "" or s == "0" or s == "rbxassetid://0" then return nil end
	if string.find(s, "rbxassetid://", 1, true) or string.find(s, "http", 1, true) or string.find(s, "rbxgameasset://", 1, true) then
		return s
	end
	local digits = string.match(s, "%d+")
	if not digits or digits == "0" then return nil end
	return "rbxassetid://" .. digits
end

function SkinSys.ExtractDigits(v)
	if v == nil then return nil end
	local d = string.match(tostring(v), "%d+")
	if d and d ~= "0" then return d end
	return nil
end

function SkinSys.ParseVec3(v)
	if typeof(v) == "Vector3" then return v end
	if type(v) == "table" then
		local x = tonumber(v.X or v.x or v[1])
		local y = tonumber(v.Y or v.y or v[2])
		local z = tonumber(v.Z or v.z or v[3])
		if x and y and z then return Vector3.new(x, y, z) end
	end
	if type(v) == "number" and v > 0 then return Vector3.new(v, v, v) end
	return nil
end

function SkinSys.PartHasMesh(part)
	if not part or not part:IsA("BasePart") or part.Name == "NexusRealSkinPart" then return false end
	local ok = false
	pcall(function()
		if part:IsA("MeshPart") and part.MeshId ~= "" and part.MeshId ~= "rbxassetid://0" then ok = true end
	end)
	if ok then return true end
	local sm = part:FindFirstChildOfClass("SpecialMesh")
	if sm then
		pcall(function()
			if sm.MeshId ~= "" and sm.MeshId ~= "rbxassetid://0" then ok = true end
		end)
	end
	return ok
end

function SkinSys.CollectVisualParts(tool)
	local parts = {}
	if not tool then return parts end
	local handle = tool:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") and SkinSys.PartHasMesh(handle) then
		parts[1] = handle
		return parts
	end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") and SkinSys.PartHasMesh(d) then
			parts[#parts + 1] = d
		end
	end
	if #parts == 0 and handle and handle:IsA("BasePart") then parts[1] = handle end
	return parts
end

function SkinSys.ReadHandle(handle)
	if not handle then return nil, nil, nil end
	local meshId, textureId, scale = nil, nil, nil
	local overlay = handle.Parent and handle.Parent:FindFirstChild("NexusRealSkinPart")
	local targetPart = overlay or handle
	local sm = targetPart:FindFirstChildOfClass("SpecialMesh")
	if sm then
		pcall(function()
			meshId = SkinSys.ExtractDigits(sm.MeshId)
			textureId = SkinSys.ExtractDigits(sm.TextureId)
			scale = sm.Scale
		end)
	end
	if not meshId then
		pcall(function()
			if targetPart:IsA("MeshPart") then
				meshId = SkinSys.ExtractDigits(targetPart.MeshId)
				textureId = textureId or SkinSys.ExtractDigits(targetPart.TextureID)
			end
		end)
	end
	return meshId, textureId, scale
end

local function ReadToolSkin(tool)
	if not tool then return nil, nil, nil end
	for _, part in ipairs(SkinSys.CollectVisualParts(tool)) do
		local m, t, sc = SkinSys.ReadHandle(part)
		if m then return m, t, sc end
	end
	return nil, nil, nil
end

function SkinSys.ScanDatabase()
	local knifeMap, gunMap, templateByKey = {}, {}, {}

	pcall(function()
		-- Scan ALL of ReplicatedStorage: MM2 moves weapon models around between
		-- updates, the4 fixed folders missed most of them.
		for _, inst in ipairs(ReplicatedStorage:GetDescendants()) do
			if inst:IsA("Model") or inst:IsA("Tool") or inst:IsA("MeshPart") then
				local key = string.lower(inst.Name)
				if not templateByKey[key] then templateByKey[key] = inst end
			end
		end
	end)

	local function registerEntry(entry)
		if not entry or not entry.Name or entry.Name == "" then return end
		if not entry.Mesh and not entry.Template and not entry.AssetId then return end
		local targetMap = (entry.Role == "Gun") and gunMap or knifeMap
		local existing = targetMap[entry.Name]
		if not existing or (existing.Source == "BuiltIn" and entry.Source ~= "BuiltIn") or (not existing.Template and entry.Template) then
			targetMap[entry.Name] = entry
		end
	end

	for _, item in ipairs(SkinSys.BuiltInKnives) do registerEntry(item) end
	for _, item in ipairs(SkinSys.BuiltInGuns) do registerEntry(item) end

	local dbSources = {}
	local function addDbTable(tbl)
		if type(tbl) == "table" then dbSources[#dbSources + 1] = tbl end
	end

	-- Official MM2 ReplicatedStorage.Database.Sync.Item & Weapons modules
	pcall(function()
		local dbFolder = ReplicatedStorage:FindFirstChild("Database")
		if dbFolder then
			local sync = dbFolder:FindFirstChild("Sync")
			if sync then
				for _, childName in ipairs({"Item", "Weapons", "Items"}) do
					local mod = sync:FindFirstChild(childName)
					if mod and mod:IsA("ModuleScript") then
						local ok, res = pcall(require, mod)
						if ok and type(res) == "table" then
							addDbTable(res)
							if childName == "Item" then SkinSys.RawDBItems = res end
						end
					end
				end
			end
			for _, child in ipairs(dbFolder:GetDescendants()) do
				if child:IsA("ModuleScript") then
					local ln = string.lower(child.Name)
					if ln == "item" or ln == "items" or ln == "weapons" or ln == "weapon" then
						local ok, res = pcall(require, child)
						if ok and type(res) == "table" then
							addDbTable(res)
							if not SkinSys.RawDBItems then SkinSys.RawDBItems = res end
						end
					end
				end
			end
		end
	end)

	-- Classic runtime getrenv()._G.Database table
	pcall(function()
		local renv = (typeof(getrenv) == "function" and getrenv()) or nil
		local db = (renv and renv._G and renv._G.Database) or (genv and genv.Database) or nil
		if type(db) == "table" then
			if type(db.Item) == "table" then
				addDbTable(db.Item)
				if not SkinSys.RawDBItems then SkinSys.RawDBItems = db.Item end
			end
			if type(db.Weapons) == "table" then addDbTable(db.Weapons) end
			if type(db.Items) == "table" then addDbTable(db.Items) end
		end
	end)

	local dbDiscovered = 0
	local function readItemData(data, out, depth)
		if depth > 4 then return end
		for k, v in pairs(data) do
			local lk = string.lower(tostring(k))
			if (lk == "mesh" or lk == "meshid") and (type(v) == "string" or type(v) == "number") then
				out.Mesh = out.Mesh or SkinSys.ExtractDigits(v)
			elseif (lk == "texture" or lk == "textureid") and (type(v) == "string" or type(v) == "number") then
				out.Texture = out.Texture or SkinSys.ExtractDigits(v)
			elseif (lk == "image" or lk == "icon") and (type(v) == "string" or type(v) == "number") then
				out.Image = out.Image or SkinSys.ExtractDigits(v)
			elseif (lk == "itemid" or lk == "assetid" or lk == "modelid") and (type(v) == "string" or type(v) == "number") then
				out.AssetId = out.AssetId or SkinSys.ExtractDigits(v)
			elseif (lk == "itemtype" or lk == "type" or lk == "typename") and type(v) == "string" then
				out.ItemType = out.ItemType or v
			elseif (lk == "itemname" or lk == "displayname" or lk == "name") and type(v) == "string" then
				out.ItemName = out.ItemName or v
			elseif lk == "rarity" and type(v) == "string" then
				out.Rarity = out.Rarity or v
			elseif lk == "chroma" and type(v) == "boolean" then
				out.Chroma = v
			elseif lk == "scale" or lk == "meshscale" then
				out.Scale = out.Scale or SkinSys.ParseVec3(v)
			elseif lk == "angles" or lk == "rotation" then
				out.Angles = out.Angles or SkinSys.ParseVec3(v)
			elseif lk == "offset" or lk == "position" then
				out.Offset = out.Offset or SkinSys.ParseVec3(v)
			elseif type(v) == "table" and lk ~= "sounds" and lk ~= "animations" then
				readItemData(v, out, depth + 1)
			end
		end
	end

	for _, tbl in ipairs(dbSources) do
		for itemKey, data in pairs(tbl) do
			if type(data) == "table" then
				local parsed = {}
				readItemData(data, parsed, 0)
				local itype = string.lower(tostring(parsed.ItemType or ""))
				local role = nil
				if string.find(itype, "knife", 1, true) then
					role = "Knife"
				elseif string.find(itype, "gun", 1, true) then
					role = "Gun"
				end
				if role then
					local dispName = tostring(parsed.ItemName or itemKey)
					local tpl = templateByKey[string.lower(tostring(itemKey))] or templateByKey[string.lower(dispName)]
					if parsed.Mesh or tpl or parsed.AssetId then
						local rarity = tostring(parsed.Rarity or "Common")
						local isChroma = parsed.Chroma == true or string.find(string.lower(dispName), "chroma", 1, true) ~= nil or string.find(string.lower(rarity), "chroma", 1, true) ~= nil
						if isChroma and rarity ~= "Ancient" then rarity = "Chroma" end
						registerEntry({
							Name = dispName,
							Key = tostring(itemKey),
							Role = role,
							Rarity = rarity,
							Mesh = parsed.Mesh,
							Texture = parsed.Texture,
							Image = parsed.Image,
							AssetId = parsed.AssetId,
							Scale = parsed.Scale,
							Angles = parsed.Angles,
							Offset = parsed.Offset,
							Chroma = isChroma,
							Template = tpl,
							Source = "GameDB",
						})
						dbDiscovered = dbDiscovered + 1
					end
				end
			end
		end
	end

	for lowName, inst in pairs(templateByKey) do
		local m, t, sc = nil, nil, nil
		if inst:IsA("BasePart") then m, t, sc = SkinSys.ReadHandle(inst) else m, t, sc = ReadToolSkin(inst) end
		if m then
			local ex = knifeMap[inst.Name] or gunMap[inst.Name]
			local isGun = (string.find(lowName, "gun", 1, true) or string.find(lowName, "luger", 1, true) or string.find(lowName, "revolver", 1, true) or string.find(lowName, "blaster", 1, true) or string.find(lowName, "laser", 1, true) or string.find(lowName, "harvester", 1, true) or string.find(lowName, "icepiercer", 1, true)) and true or false
			local isKnife = (string.find(lowName, "knife", 1, true) or string.find(lowName, "blade", 1, true) or string.find(lowName, "dagger", 1, true) or string.find(lowName, "sword", 1, true) or string.find(lowName, "scythe", 1, true) or string.find(lowName, "karambit", 1, true) or string.find(lowName, "machete", 1, true) or string.find(lowName, "cleaver", 1, true)) and true or false
			-- Upgrade an existing entry missing its Template, or register a new model
			-- only when its name clearly looks like a weapon (full-RS scan must not
			-- flood the dropdown with junk).
			if (ex and not ex.Template) or ((not ex) and (isGun or isKnife)) then
				registerEntry({
					Name = inst.Name, Key = inst.Name,
					Role = ex and ex.Role or (isGun and "Gun" or "Knife"),
					Rarity = ex and ex.Rarity or "Rare",
					Mesh = m, Texture = t, Scale = sc, Template = inst, Source = "Model",
				})
			end
		end
	end

	local function sortList(map)
		local list = {{Name = "Default (restore)", Mesh = nil, Texture = nil, Rarity = "Custom"}}
		local items = {}
		for _, v in pairs(map) do items[#items + 1] = v end
		table.sort(items, function(a, b)
			local ra = SkinSys.RarityOrder[a.Rarity] or 50
			local rb = SkinSys.RarityOrder[b.Rarity] or 50
			if ra ~= rb then return ra < rb end
			return string.lower(tostring(a.Name)) < string.lower(tostring(b.Name))
		end)
		for _, v in ipairs(items) do list[#list + 1] = v end
		return list
	end

	SkinSys.KnifeByName = knifeMap
	SkinSys.GunByName = gunMap
	SkinSys.Knives = sortList(knifeMap)
	table.insert(SkinSys.Knives, 2, SkinSys.CopiedKnife)
	SkinSys.Guns = sortList(gunMap)
	table.insert(SkinSys.Guns, 2, SkinSys.CopiedGun)
	SkinSys.ScannedCount = (#SkinSys.Knives - 2) + (#SkinSys.Guns - 2)
	return SkinSys.ScannedCount, dbDiscovered
end

function SkinSys.FilteredNames(list, rarityFilter, searchText)
	local names = {"Default (restore)", "Copied from player"}
	local wantRarity = (rarityFilter and rarityFilter ~= "" and rarityFilter ~= "All") and string.lower(rarityFilter) or nil
	local query = (searchText and searchText ~= "") and string.lower(searchText) or nil
	for i = 3, #list do
		local item = list[i]
		local okRarity = (not wantRarity) or (string.lower(tostring(item.Rarity or "")) == wantRarity)
		local okSearch = (not query) or (string.find(string.lower(tostring(item.Name)), query, 1, true) ~= nil)
		if okRarity and okSearch then names[#names + 1] = item.Name end
	end
	return names
end

function SkinSys.RefreshDropdowns()
	local kNames = SkinSys.FilteredNames(SkinSys.Knives, State.SkinRarityFilter, State.SkinSearch)
	local gNames = SkinSys.FilteredNames(SkinSys.Guns, State.SkinRarityFilter, State.SkinSearch)
	pcall(function() if Options.KnifeSkinPreset and Options.KnifeSkinPreset.SetValues then Options.KnifeSkinPreset:SetValues(kNames) end end)
	pcall(function() if Options.GunSkinPreset and Options.GunSkinPreset.SetValues then Options.GunSkinPreset:SetValues(gNames) end end)
end

function SkinSys.FindPreset(list, name)
	if not name then return nil end
	for _, p in ipairs(list) do
		if p.Name == name then return p end
	end
	return nil
end

function SkinSys.FindCoatTextureId(name)
	for _, p in ipairs(SkinSys.TextureCoats) do
		if p.Name == name then return p.Id end
	end
	return nil
end

function SkinSys.RestoreOne(container)
	if not container then return end
	local info = SkinBackups[container]
	if info then
		pcall(function()
			if info.Overlay and info.Overlay.Parent then info.Overlay:Destroy() end
			if info.ClonedParts then
				for _, p in ipairs(info.ClonedParts) do
					if p and p.Parent then p:Destroy() end
				end
			end
			if info.ToolTexture ~= nil and container:IsA("Tool") then container.TextureId = info.ToolTexture end
			if info.Parts then
				for part, st in pairs(info.Parts) do
					if part and part.Parent then
						part.Transparency = st.Transparency
						part.Color = st.Color
						part.Material = st.Material
						if st.MeshId ~= nil and part:IsA("MeshPart") then pcall(function() part.MeshId = st.MeshId end) end
						if st.TextureID ~= nil and part:IsA("MeshPart") then pcall(function() part.TextureID = st.TextureID end) end
						if st.SpecialMesh and st.SpecialMesh.Parent then
							st.SpecialMesh.MeshId = st.SpecialMeshId
							st.SpecialMesh.TextureId = st.SpecialTextureId
							st.SpecialMesh.Scale = st.SpecialScale
							st.SpecialMesh.VertexColor = st.SpecialVertexColor
						end
						if st.SurfaceAppearance then pcall(function() st.SurfaceAppearance.Parent = part end) end
					end
				end
			end
			if info.Decals then
				for dec, oldT in pairs(info.Decals) do
					if dec and dec.Parent then dec.Transparency = oldT end
				end
			end
		end)
		SkinBackups[container] = nil
	end
	pcall(function()
		local s1 = container:FindFirstChild("NexusRealSkinPart")
		if s1 then s1:Destroy() end
		local s2 = container:FindFirstChild("NexusRealSkinModel")
		if s2 then s2:Destroy() end
	end)
	SkinApplied[container] = nil
end

local function RestoreAllSkins()
	local toRestore = {}
	for container in pairs(SkinBackups) do toRestore[#toRestore + 1] = container end
	for _, container in ipairs(toRestore) do SkinSys.RestoreOne(container) end
end

function SkinSys.Backup(container)
	if SkinBackups[container] then return SkinBackups[container] end
	local info = {Parts = {}, Decals = {}, Overlay = nil, ClonedParts = {}, Signature = ""}
	if container:IsA("Tool") then pcall(function() info.ToolTexture = container.TextureId end) end
	for _, d in ipairs(container:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "NexusRealSkinPart" then
			local st = {Transparency = d.Transparency, Color = d.Color, Material = d.Material}
			pcall(function()
				if d:IsA("MeshPart") then st.MeshId = d.MeshId st.TextureID = d.TextureID end
			end)
			local sm = d:FindFirstChildOfClass("SpecialMesh")
			if sm then
				st.SpecialMesh = sm
				st.SpecialMeshId = sm.MeshId
				st.SpecialTextureId = sm.TextureId
				st.SpecialScale = sm.Scale
				st.SpecialVertexColor = sm.VertexColor
			end
			local sa = d:FindFirstChildOfClass("SurfaceAppearance")
			if sa then st.SurfaceAppearance = sa end
			info.Parts[d] = st
		elseif d:IsA("Decal") or d:IsA("Texture") then
			info.Decals[d] = d.Transparency
		end
	end
	SkinBackups[container] = info
	return info
end

function SkinSys.ApplyCoatingToPart(part, coatMat, coatColor, chroma, chromaColor, origState)
	if not part or not part.Parent then return end
	pcall(function()
		if coatMat then
			part.Material = coatMat
		elseif origState and origState.Material then
			part.Material = origState.Material
		else
			part.Material = Enum.Material.SmoothPlastic
		end
		local finalColor = (chroma and chromaColor) or coatColor
		local sm = part:FindFirstChildOfClass("SpecialMesh")
		if finalColor then
			part.Color = finalColor
			if sm then sm.VertexColor = Vector3.new(finalColor.R * 1.15, finalColor.G * 1.15, finalColor.B * 1.15) end
		else
			if origState and origState.Color then part.Color = origState.Color end
			if sm then sm.VertexColor = Vector3.new(1, 1, 1) end
		end
	end)
end

-- Supports BOTH ApplySkinToTool(tool, presetTable, coatCfg) AND legacy ApplySkinToTool(tool, meshIdStr, textureIdStr, chromaBool)
local function ApplySkinToTool(container, presetOrMesh, coatOrTex, legacyChroma)
	if not container or not container.Parent then return false end
	local preset, coatCfg = nil, nil
	if type(presetOrMesh) == "table" then
		preset = presetOrMesh
		coatCfg = coatOrTex
	elseif presetOrMesh ~= nil or coatOrTex ~= nil then
		preset = {Name = "Direct", Mesh = SkinSys.ExtractDigits(presetOrMesh), Texture = SkinSys.ExtractDigits(coatOrTex), Chroma = legacyChroma == true}
		coatCfg = {Enabled = false, Chroma = legacyChroma == true}
	else
		coatCfg = type(coatOrTex) == "table" and coatOrTex or nil
	end

	local handle = container:FindFirstChild("Handle")
		or (container:IsA("BasePart") and container)
		or container:FindFirstChildWhichIsA("MeshPart", true)
		or container:FindFirstChildWhichIsA("BasePart", true)
	if not handle or not handle:IsA("BasePart") then return false end

	local info = SkinSys.Backup(container)
	local hasRealSkin = (preset ~= nil and (preset.Mesh ~= nil or preset.Template ~= nil or preset.AssetId ~= nil))
	local coatEnabled = coatCfg and coatCfg.Enabled == true
	local coatMat = coatEnabled and SkinSys.CoatMaterials[coatCfg.Material or "Original"] or nil
	local coatColor = coatEnabled and SkinSys.CoatColors[coatCfg.Color or "Original"] or nil
	local coatTexId = coatEnabled and coatCfg.TextureId or nil
	local chroma = (coatCfg and coatCfg.Chroma == true) or (preset and preset.Chroma == true)
	local scaleMult = tonumber(State.SkinScaleMult) or 1

	local meshContent = preset and SkinSys.ContentId(preset.Mesh) or nil
	local texContent = SkinSys.ContentId(coatTexId or (preset and preset.Texture))
	local imgContent = preset and SkinSys.ContentId(preset.Image) or nil

	local sig = table.concat({
		hasRealSkin and tostring(preset.Name or "?") or "NONE",
		tostring(meshContent or ""),
		tostring(texContent or ""),
		tostring(scaleMult),
		tostring(coatEnabled and coatCfg.Material or ""),
		tostring(coatEnabled and coatCfg.Color or ""),
		tostring(chroma),
	}, "|")

	if info.Signature ~= sig then
		if info.Overlay and info.Overlay.Parent then
			pcall(function() info.Overlay:Destroy() end)
			info.Overlay = nil
		end
		if info.ClonedParts then
			for _, p in ipairs(info.ClonedParts) do
				if p and p.Parent then pcall(function() p:Destroy() end) end
			end
			info.ClonedParts = {}
		end

		local built = false
		local directSwap = false
		if hasRealSkin then
			-- Resolve optional AssetId via game:GetObjects if no Mesh or Template exists
			local tplSource = preset.Template
			if not tplSource and not meshContent and preset.AssetId then
				if SkinSys.ObjectCache[preset.AssetId] == nil then
					local okObj, objs = pcall(function()
						return game:GetObjects("rbxassetid://" .. tostring(preset.AssetId))
					end)
					SkinSys.ObjectCache[preset.AssetId] = (okObj and type(objs) == "table" and objs[1]) or false
				end
				if SkinSys.ObjectCache[preset.AssetId] then tplSource = SkinSys.ObjectCache[preset.AssetId] end
			end

			-- Path 0: classic Part+SpecialMesh handle — swap MeshId/TextureId on the
			-- ORIGINAL SpecialMesh (exactly what the game itself does when it equips a
			-- skin): perfect size AND orientation by construction, no overlay, no
			-- hidden handle. Fixes "horizontal + huge" on classic handles.
			local origSM = handle:FindFirstChildOfClass("SpecialMesh")
			if origSM and meshContent then
				pcall(function()
					origSM.MeshId = meshContent
					if texContent then origSM.TextureId = texContent end
					directSwap = true
					built = true
				end)
			end
			
			-- Path A: Clone actual 3D model/MeshPart template from game/asset
			if tplSource then
				pcall(function()
					local clone = tplSource:Clone()
					local wrapper = Instance.new("Model")
					wrapper.Name = "NexusRealSkinModel"
					local parts = {}
					if clone:IsA("BasePart") then
						parts[1] = clone
					else
						for _, d in ipairs(clone:GetDescendants()) do
							if d:IsA("BasePart") then
								parts[#parts + 1] = d
							elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") or d:IsA("TouchTransmitter") then
								d:Destroy()
							end
						end
					end
					local refPart = nil
					if clone:IsA("BasePart") then
						refPart = clone
					else
						-- Deterministic grip anchor: Handle → PrimaryPart → grip-like name →
						-- closest part to the model bounding-box centre. (parts[1] was tree-order
						-- arbitrary — wrong anchor made most skins render crooked.)
						refPart = clone:FindFirstChild("Handle")
						if not refPart and clone:IsA("Model") and clone.PrimaryPart then refPart = clone.PrimaryPart end
						if not refPart then
							for _, d in ipairs(clone:GetDescendants()) do
								if d:IsA("BasePart") then
									local dn = string.lower(d.Name)
									if dn == "handle" or dn == "grip" or dn == "knifehandle" or dn == "bladegrip" then
										refPart = d
										break
									end
								end
							end
						end
						if not refPart then
							-- closest grip guess: part whose size matches the original handle
							local bestS, bestP = nil, nil
							for _, p in ipairs(parts) do
								local d2 = (p.Size - handle.Size).Magnitude
								if not bestS or d2 < bestS then bestS, bestP = d2, p end
							end
							refPart = bestP
						end
						if not refPart and clone:IsA("Model") then
							local okB, bcf = pcall(function() return clone:GetBoundingBox() end)
							if okB and bcf then
								local bestD, bestP = nil, nil
								for _, p in ipairs(parts) do
									local d2 = (p.Position - bcf.Position).Magnitude
									if not bestD or d2 < bestD then bestD, bestP = d2, p end
								end
								refPart = bestP
							end
						end
						if not refPart then refPart = parts[1] end
					end
					if refPart and #parts > 0 then
						-- Orientation from the MODEL pivot (always model-aligned), position from the
						-- grip part. Mapping a randomly-rotated part's own axes onto the handle
						-- turned most template skins 90° (horizontal).
						local pivot = clone:GetPivot()
						local gripCF = CFrame.new(refPart.Position) * pivot.Rotation
						local gripInv = gripCF:Inverse()
						for _, p in ipairs(parts) do
							p.Anchored = false
							p.CanCollide = false
							p.CanTouch = false
							p.CanQuery = false
							p.Massless = true
							p.CFrame = handle.CFrame * (gripInv * p.CFrame)
							local w = Instance.new("WeldConstraint")
							w.Part0 = handle
							w.Part1 = p
							w.Parent = p
							p.Parent = wrapper
							info.ClonedParts[#info.ClonedParts + 1] = p
							if coatTexId and p:IsA("MeshPart") then
								pcall(function() p.TextureID = SkinSys.ContentId(coatTexId) or p.TextureID end)
							end
						end
						wrapper.Parent = container
						info.Overlay = wrapper
						built = true
					end
					if clone.Parent == nil then clone:Destroy() end
				end)
			end

			-- Path B: Universal 3D SpecialMesh welded overlay (bypasses MeshPart.MeshId read-only lock!)
			if not built and meshContent then
				pcall(function()
					local vis = Instance.new("Part")
					vis.Name = "NexusRealSkinPart"
					vis.Size = handle.Size
					vis.Color = coatColor or Color3.fromRGB(255, 255, 255)
					vis.Material = coatMat or Enum.Material.SmoothPlastic
					vis.Transparency = 0
					vis.Anchored = false
					vis.CanCollide = false
					vis.CanTouch = false
					vis.CanQuery = false
					vis.Massless = true
					vis.CastShadow = false

					local offsetCF = CFrame.new()
					if preset.Offset then offsetCF = offsetCF * CFrame.new(preset.Offset) end
					if preset.Angles then
						offsetCF = offsetCF * CFrame.Angles(math.rad(preset.Angles.X), math.rad(preset.Angles.Y), math.rad(preset.Angles.Z))
					end
					vis.CFrame = handle.CFrame * offsetCF

					local sm = Instance.new("SpecialMesh")
					sm.Name = "NexusRealMesh"
					sm.MeshType = Enum.MeshType.FileMesh
					sm.MeshId = meshContent
					if texContent then sm.TextureId = texContent end
					local baseScale = preset.Scale or Vector3.new(1, 1, 1)
					sm.Scale = baseScale * scaleMult
					sm.Parent = vis

					local weld = Instance.new("WeldConstraint")
					weld.Part0 = handle
					weld.Part1 = vis
					weld.Parent = vis

					vis.Parent = container
					info.Overlay = vis
					built = true
				end)
			end

			if container:IsA("Tool") and imgContent then
				pcall(function() container.TextureId = imgContent end)
			end
		if built and not directSwap then
			-- Hide original visuals ONLY after a replacement exists — never leave an
			-- invisible weapon in the hand when the mesh/template fails to build.
			for part, st in pairs(info.Parts) do
				if part and part.Parent then
					pcall(function()
						part.Transparency = 1
						if st.SurfaceAppearance and st.SurfaceAppearance.Parent then st.SurfaceAppearance.Parent = nil end
					end)
				end
			end
			for dec in pairs(info.Decals) do
				if dec and dec.Parent then pcall(function() dec.Transparency = 1 end) end
			end
		else
			-- Build failed: show the originals again (a previous skin may have hidden
			-- them) so the weapon always stays visible in the hand.
			for part, st in pairs(info.Parts) do
				if part and part.Parent then
					pcall(function()
						part.Transparency = st.Transparency
						if st.SurfaceAppearance and not st.SurfaceAppearance.Parent then st.SurfaceAppearance.Parent = part end
					end)
				end
			end
			for dec, oldT in pairs(info.Decals) do
				if dec and dec.Parent then pcall(function() dec.Transparency = oldT end) end
			end
			if container:IsA("Tool") and info.ToolTexture ~= nil then
				pcall(function() container.TextureId = info.ToolTexture end)
			end
		end
		else			for part, st in pairs(info.Parts) do
				if part and part.Parent then
					pcall(function()
						part.Transparency = st.Transparency
						if coatTexId then
							local ct = SkinSys.ContentId(coatTexId)
							if ct then
								if part:IsA("MeshPart") then part.TextureID = ct end
								if st.SpecialMesh then st.SpecialMesh.TextureId = ct end
								if st.SurfaceAppearance and st.SurfaceAppearance.Parent then st.SurfaceAppearance.Parent = nil end
							end
						else
							if st.TextureID ~= nil and part:IsA("MeshPart") then part.TextureID = st.TextureID end
							if st.SpecialMesh then st.SpecialMesh.TextureId = st.SpecialTextureId end
							if st.SurfaceAppearance then st.SurfaceAppearance.Parent = part end
						end
					end)
				end
			end
			for dec, oldT in pairs(info.Decals) do
				if dec and dec.Parent then pcall(function() dec.Transparency = oldT end) end
			end
			if container:IsA("Tool") and info.ToolTexture ~= nil then
				pcall(function() container.TextureId = info.ToolTexture end)
			end
		end
		if built or not hasRealSkin then
		info.Signature = sig
		end
	end

	local chromaColor = nil
	if chroma then
		local speed = math.max(1, tonumber(State.SkinChromaSpeed) or 3)
		chromaColor = Color3.fromHSV(((os.clock() * speed * 0.18) % 1), 0.9, 1)
	end

	if info.Overlay and info.Overlay.Parent then
		if info.Overlay:IsA("BasePart") then
			SkinSys.ApplyCoatingToPart(info.Overlay, coatMat, coatColor, chroma, chromaColor, nil)
		else
			for _, p in ipairs(info.ClonedParts or {}) do
				SkinSys.ApplyCoatingToPart(p, coatMat, coatColor, chroma, chromaColor, nil)
			end
		end
	else
		for part, st in pairs(info.Parts) do
			SkinSys.ApplyCoatingToPart(part, coatMat, coatColor, chroma, chromaColor, st)
		end
	end

	SkinApplied[container] = true
	return true
end

function SkinSys.ResolveKnife()
	local cm = SkinSys.ExtractDigits(State.KnifeSkinCustomMesh)
	local ct = SkinSys.ExtractDigits(State.KnifeSkinCustomTexture)
	if cm then return {Name = "Custom Knife", Role = "Knife", Mesh = cm, Texture = ct, Chroma = State.SkinChroma} end
	local preset = SkinSys.FindPreset(SkinSys.Knives, State.KnifeSkinPreset)
	if preset and (preset.Mesh or preset.Template or preset.AssetId) then return preset end
	return nil
end

function SkinSys.ResolveGun()
	local cm = SkinSys.ExtractDigits(State.GunSkinCustomMesh)
	local ct = SkinSys.ExtractDigits(State.GunSkinCustomTexture)
	if cm then return {Name = "Custom Gun", Role = "Gun", Mesh = cm, Texture = ct, Chroma = State.SkinChroma} end
	local preset = SkinSys.FindPreset(SkinSys.Guns, State.GunSkinPreset)
	if preset and (preset.Mesh or preset.Template or preset.AssetId) then return preset end
	return nil
end

local function CollectSkinTargets()
	local list, seen = {}, {}
	local function addItem(inst, role, owner)
		if inst and not seen[inst] then
			seen[inst] = true
			list[#list + 1] = {Tool = inst, Role = role, Owner = owner}
		end
	end
	local function addContainer(container, owner)
		if not container then return end
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") then
				local role = ToolRole(item)
				if role then addItem(item, role, owner) end
			elseif State.SkinBackDisplay ~= false then
				local ln = string.lower(item.Name)
				if ln == "knifedisplay" or ln == "knife_display" then
					addItem(item, "Murderer", owner)
				elseif ln == "gundisplay" or ln == "gun_display" then
					addItem(item, "Sheriff", owner)
				end
			end
		end
	end
	addContainer(LocalPlayer.Character, LocalPlayer)
	addContainer(LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer)
	if State.SkinTarget ~= "Only my weapons" then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				addContainer(plr.Character, plr)
				addContainer(plr:FindFirstChildOfClass("Backpack"), plr)
			end
		end
		local items = workspace:FindFirstChild("Items")
		if items then addContainer(items, nil) end
		addContainer(workspace, nil)
	end
	return list
end

function SkinSys.StatusText(applied, knives, guns)
	return string.format("real skins: %d knife · %d gun | active: %d (%dK/%dG)", #SkinSys.Knives - 2, #SkinSys.Guns - 2, applied, knives, guns)
end

local function UpdateSkinChanger()
	local anyActive = State.KnifeSkinEnabled or State.GunSkinEnabled or State.CoatingEnabled or State.SkinChroma
	if not anyActive then return end
	local now = os.clock()
	local interval = State.SkinChroma and 0.05 or 0.25
	if now - SkinSys.LastTick < interval then return end
	SkinSys.LastTick = now

	local knifePreset = State.KnifeSkinEnabled and SkinSys.ResolveKnife() or nil
	local gunPreset = State.GunSkinEnabled and SkinSys.ResolveGun() or nil
	local coatCfg = {
		Enabled = State.CoatingEnabled == true,
		Material = State.CoatingMaterial or "Original",
		Color = State.CoatingColor or "Original",
		TextureId = SkinSys.FindCoatTextureId(State.KnifeSkinTexture),
		Chroma = State.SkinChroma == true,
	}

	local targets = CollectSkinTargets()
	local knives, guns, appliedCount = 0, 0, 0
	for _, entry in ipairs(targets) do
		if entry.Role == "Murderer" then
			knives = knives + 1
			if knifePreset or State.CoatingEnabled or State.SkinChroma then
				if ApplySkinToTool(entry.Tool, knifePreset, coatCfg) then appliedCount = appliedCount + 1 end
			else
				SkinSys.RestoreOne(entry.Tool)
			end
		elseif entry.Role == "Sheriff" then
			guns = guns + 1
			if gunPreset or State.CoatingEnabled or State.SkinChroma then
				if ApplySkinToTool(entry.Tool, gunPreset, coatCfg) then appliedCount = appliedCount + 1 end
			else
				SkinSys.RestoreOne(entry.Tool)
			end
		end
	end

	local status = SkinSys.StatusText(appliedCount, knives, guns)
	if status ~= V25.LastSkinStatus then
		V25.LastSkinStatus = status
		if V25.SkinStatusLabel then pcall(function() V25.SkinStatusLabel:SetText(status) end) end
	end
end

function SkinSys.UnlockVisualInventory()
	local ok, count = pcall(function()
		local renv = (typeof(getrenv) == "function" and getrenv()) or nil
		local pdata = renv and renv._G and renv._G.PlayerData
		local db = (renv and renv._G and renv._G.Database and renv._G.Database.Item) or SkinSys.RawDBItems
		if type(pdata) ~= "table" or type(pdata.Weapons) ~= "table" or type(db) ~= "table" then return 0 end
		local owned = {}
		local n = 0
		for itemKey in pairs(db) do
			owned[itemKey] = 1
			n = n + 1
		end
		pdata.Weapons.Owned = owned
		if not SkinSys.InventoryConn then
			SkinSys.InventoryConn = Connect(RunService.Heartbeat:Connect(function()
				if State.Unloaded or not SkinSys.InventoryUnlocked then return end
				pcall(function() if pdata and pdata.Weapons then pdata.Weapons.Owned = owned end end)
			end))
		end
		SkinSys.InventoryUnlocked = true
		return n
	end)
	if ok and count and count > 0 then
		Notify("Visual Inventory unlocked (" .. tostring(count) .. " items)", 4)
	else
		Notify("MM2 PlayerData not exposed on this executor — use Real Skin dropdowns above!", 4)
	end
end

