-- TAB 7: AUDIO & FX (4-Way Audio Sync, Global Soundboard, Skybox & Tornado)
--============================================================================--
do
	local Tab = Window:Tab({ Title = "Audio & FX", Icon = "music" })

	Tab:Section({ Title = "FE Sound (5410086218)" })

	local soundTextBox = nil
	local soundInputEl = Tab:Input({
		Title = "Sound ID",
		Placeholder = "5410086218",
		Value = DATA.WorkingSound.Id,
		Callback = function(txt)
			local clean = tostring(txt or ""):gsub("%D", "")
			if #clean > 0 then
				S.AudioId = clean
				S.GlobalSoundId = clean
			else
				S.AudioId = DATA.WorkingSound.Id
				S.GlobalSoundId = DATA.WorkingSound.Id
			end
		end,
	})

	-- Live-hook underlying TextBox so typing an ID works IMMEDIATELY without pressing Enter
	pcall(function()
		local holder = soundInputEl and soundInputEl.InputFrame and soundInputEl.InputFrame.UIElements and soundInputEl.InputFrame.UIElements.Main
		if holder then
			soundTextBox = holder:FindFirstChildWhichIsA("TextBox", true)
			if soundTextBox then
				trackConn(soundTextBox:GetPropertyChangedSignal("Text"):Connect(function()
					local clean = tostring(soundTextBox.Text or ""):gsub("%D", "")
					if #clean > 0 then
						S.AudioId = clean
						S.GlobalSoundId = clean
					end
				end))
			end
		end
	end)

	local function getActiveSoundId()
		if soundTextBox and soundTextBox.Parent then
			local liveClean = tostring(soundTextBox.Text or ""):gsub("%D", "")
			if #liveClean > 0 then
				S.AudioId = liveClean
				S.GlobalSoundId = liveClean
				return liveClean
			end
		end
		local clean = tostring(S.GlobalSoundId or ""):gsub("%D", "")
		return (#clean > 0) and clean or DATA.WorkingSound.Id
	end

	Tab:Button({
		Title = "Play Sound",
		Callback = function()
			local id = getActiveSoundId()
			S.AudioId = id
			S.GlobalSoundId = id
			trackThread(function()
				local ok, info = Net.GlobalSound(id)
				Net.BoostMainAudioVolume(100)
				Net.PlayAudio(id, S.AudioTarget)
				notify("FE Sound", "ID " .. id .. (ok and (" · " .. tostring(info)) or ""), 2.2)
			end)
		end,
	})

	Tab:Toggle({
		Title = "Loop Sound",
		Value = false,
		Callback = function(v)
			local id = getActiveSoundId()
			S.AudioId = id
			S.GlobalSoundId = id
			S.GlobalSoundLoop = v
			if v then
				S._AudioLoopToken = (S._AudioLoopToken or 0) + 1
				local loopTok = S._AudioLoopToken
				trackThread(function()
					Net.PlayAudio(id, S.AudioTarget)
					while S.GlobalSoundLoop and not S.Unloaded and S._AudioLoopToken == loopTok do
						local curId = getActiveSoundId()
						Net.GlobalSound(curId, { skipLocal = true })
						task.wait(2.5)
					end
				end)
			else
				S._AudioLoopToken = (S._AudioLoopToken or 0) + 1
				Eng.Audio.StopAll()
				Net.StopAudio("All 6 (2026 Sync)")
			end
		end,
	})

	Tab:Button({
		Title = "Stop Sound",
		Callback = function()
			Eng.Audio.StopAll()
			Net.StopAudio("All 6 (2026 Sync)")
			notify("Sound", "Stopped.", 1.8)
		end,
	})

