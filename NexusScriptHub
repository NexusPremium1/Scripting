	local function IsInfItemPrompt(v)
		if not v or not v:IsA("ProximityPrompt") or not v.Parent then return false end
		local ancestor = v.Parent
		for _ = 1, 5 do
			if not ancestor then break end
			local name = string.lower(ancestor.Name)
			if name:find("padlock", 1, true) then return false end
			ancestor = ancestor.Parent
		end
		local pName = v.Parent.Name
		if v.Name == "ModulePrompt" and (pName == "Flashlight" or pName == "Lighter" or pName == "Vitamins"
			or pName == "Lockpick" or pName == "Crucifix" or pName == "Candle" or pName == "Bulklight"
			or pName == "Straplight" or pName == "LaserPointer" or pName == "Shears" or pName == "Battery"
			or pName == "Bandage" or pName == "StarVial" or pName == "StarBottle" or pName == "StarJug"
			or pName == "Smoothie" or pName == "Lantern" or pName == "AlarmClock" or pName == "Glowsticks") then
			return true
		end
		return v.Name == "LootPrompt" or (v.Parent:GetAttribute("Pickup") == true)
