-- Dropkick, ported 1:1 from the Nexus 8 hub build ("20-20-20 Dropkick").
-- It plays the dropkick animation and carries the character forward only while that
-- animation is still playing, then releases PlatformStand by itself. That is why it can
-- not get stuck any more and why it never spins you 360 degrees: the CFrame only moves,
-- it is never rebuilt with lookAt, and no velocity mover is left behind.
function StopDropkick()
	if DropkickMoveConn then
		pcall(function()
			DropkickMoveConn:Disconnect()
		end)
		DropkickMoveConn = nil
	end
	if DropkickTrack then
		pcall(function()
			DropkickTrack:Stop()
		end)
		DropkickTrack = nil
	end
	if DropkickAnim then
		pcall(function()
			DropkickAnim:Destroy()
		end)
		DropkickAnim = nil
	end
	if DropkickSound then
		pcall(function()
			DropkickSound:Destroy()
		end)
		DropkickSound = nil
	end
	if Humanoid and Humanoid.Parent then
		pcall(function()
			Humanoid.PlatformStand = false
		end)
	end
end
function PlayDropkick()
	if State.Unloaded then
		return
	end
	if not RootPart or not RootPart.Parent or not Humanoid or not Humanoid.Parent then
		RefreshCharacter()
	end
	local character = Character
	if not character or not Humanoid or not RootPart or Humanoid.Health <= 0 then
		return
	end
	local hrp = RootPart
	local hum = Humanoid
	StopDropkick()
	hum.PlatformStand = true
	hrp.Anchored = false
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end
	DropkickAnim = Instance.new("Animation")
	DropkickAnim.AnimationId = DROPKICK_ANIM_ID
	local loadOk, track = pcall(function()
		return animator:LoadAnimation(DropkickAnim)
	end)
	if not loadOk or not track then
		StopDropkick()
		return
	end
	DropkickTrack = track
	track.Looped = false
	track:AdjustSpeed(3)
	track:Play()
	DropkickSound = Instance.new("Sound")
	DropkickSound.SoundId = DROPKICK_SOUND_ID
	DropkickSound.Volume = 1
	DropkickSound.Parent = hrp
	DropkickSound:Play()
	local myTrack = track
	task.delay(math.max(tonumber(State.DropkickDelay) or 0.4, 0), function()
		if State.Unloaded or DropkickTrack ~= myTrack or not myTrack.IsPlaying or not hrp.Parent then
			return
		end
		DropkickSpeedLines(character)
		DropkickCameraShake(2, 0.4)
		local lastTick = os.clock()
		DropkickMoveConn = Connect(RunService.RenderStepped:Connect(function()
			if State.Unloaded or DropkickTrack ~= myTrack or not myTrack.IsPlaying or not hrp.Parent then
				if DropkickMoveConn then
					DropkickMoveConn:Disconnect()
					DropkickMoveConn = nil
				end
				if hum and hum.Parent then
					pcall(function()
						hum.PlatformStand = false
					end)
				end
				return
			end
			local cam = workspace.CurrentCamera
			if not cam then
				return
			end
			local now = os.clock()
			local dt = math.clamp(now - lastTick, 0, 0.1)
			lastTick = now
			local look = cam.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude < 0.01 then
				local hrpLook = hrp.CFrame.LookVector
				flat = Vector3.new(hrpLook.X, 0, hrpLook.Z)
			end
			if flat.Magnitude > 0.01 then
				hrp.CFrame = hrp.CFrame + flat.Unit * (State.DropkickSpeed or 300) * dt
			end
		end))
	end)
	track.Stopped:Connect(function()
		if DropkickTrack == myTrack then
			DropkickTrack = nil
		end
		if DropkickMoveConn then
			pcall(function()
				DropkickMoveConn:Disconnect()
			end)
			DropkickMoveConn = nil
		end
		if hum and hum.Parent then
			pcall(function()
				hum.PlatformStand = false
			end)
		end
	end)
end
