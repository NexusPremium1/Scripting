						pcall(function()
							jerkTrack.Priority = Enum.AnimationPriority.Action4
							jerkTrack.Looped = true
						end)
					end
				end
				if jerkTrack then
					if not jerkTrack.IsPlaying then
						pcall(function()
							jerkTrack:Play()
							jerkTrack:AdjustSpeed(r15 and 2.6 or 2.4)
						end)
					end
					-- Seek toward middle of the clip (slightly past midpoint)
					pcall(function()
						local len = jerkTrack.Length
						if len and len > 0 then
							-- ~45% into the animation = more centered loop feel
							local mid = len * 0.45
							if jerkTrack.TimePosition < mid - 0.08 or jerkTrack.TimePosition > mid + 0.35 then
								jerkTrack.TimePosition = mid
							end
						else
							jerkTrack.TimePosition = 0.42
						end
					end)
				end
				task.wait(0.05)
			end
			if jerkTrack then
				jerkTrack:Stop()
				jerkTrack = nil
			end
		end)
	else
		if jerkTrack then
			jerkTrack:Stop()
			jerkTrack = nil
		end
	end
end)

