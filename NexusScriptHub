	end

	-- 3. Spinbot
	if hrp and Legit.spinbotEnabled then
		hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Legit.spinbotSpeed or 35), 0)
	end

	-- 4. ALWAYS RAINBOW ARMS (1st Person Viewmodels + 3rd Person Character)
	if Legit.rainbowArmsEnabled ~= false then
		local armHue = (t * 0.65) % 1
		local armColor = Color3.fromHSV(armHue, 1, 1)

		-- Character Arms (Third Person & Local Player)
		if char then
			local armParts = {
				"Left Arm", "Right Arm",
				"LeftUpperArm", "LeftLowerArm", "LeftHand",
				"RightUpperArm", "RightLowerArm", "RightHand"
			}
			for _, armName in ipairs(armParts) do
				local p = char:FindFirstChild(armName)
				if p and p:IsA("BasePart") then
					p.Color = armColor
					p.Material = Enum.Material.Neon
					p.LocalTransparencyModifier = 0
				end
			end
		end

		-- Viewmodel Arms (First Person)
		local vmRoots = {
			workspace:FindFirstChild("ViewModels"),
			Camera:FindFirstChild("ViewModels"),
			Camera
		}
		for _, vmRoot in ipairs(vmRoots) do
			if vmRoot then
				for _, obj in ipairs(vmRoot:GetDescendants()) do
					if obj:IsA("BasePart") then
						local low = obj.Name:lower()
						if low:find("arm") or low:find("hand") or low:find("sleeve") or low:find("glove") or low:find("wrist") then
							obj.Color = armColor
							obj.Material = Enum.Material.Neon
						end
					end
				end
			end
		end
	end
end)

-- UNIVERSAL 3RD PERSON ENGINE (Overrides Rivals 1st-Person Camera Lock)
-- ══════════════════════════════════════════════════════════════════════

-- ══════════════════════════════════════════════════════════════════════
-- UNIVERSAL FLY ENGINE (BodyVelocity + BodyGyro)
-- ══════════════════════════════════════════════════════════════════════
local nexusFlying = false
local nexusFlyBV = nil
local nexusFlyBG = nil
local nexusFlySpeed = 50

local function disableNexusFly()
	if not nexusFlying then return end
	nexusFlying = false
	if nexusFlyBV then pcall(function() nexusFlyBV:Destroy() end); nexusFlyBV = nil end
	if nexusFlyBG then pcall(function() nexusFlyBG:Destroy() end); nexusFlyBG = nil end
	local char = k.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then pcall(function() hum.PlatformStand = false end) end
end

local function enableNexusFly()
	if nexusFlying then return end
	local char = k.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (root and hum and hum.Health > 0) then return end

	disableNexusFly()
	nexusFlying = true
	pcall(function() hum.PlatformStand = true end)

	nexusFlyBV = Instance.new("BodyVelocity")
	nexusFlyBV.Name = "NexusFlyVelocity"
	nexusFlyBV.Velocity = Vector3.new(0, 0, 0)
	nexusFlyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	nexusFlyBV.Parent = root

	nexusFlyBG = Instance.new("BodyGyro")
	nexusFlyBG.Name = "NexusFlyGyro"
	nexusFlyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	nexusFlyBG.P = 10000
	nexusFlyBG.D = 500
	nexusFlyBG.CFrame = root.CFrame
	nexusFlyBG.Parent = root

	task.spawn(function()
		while nexusFlying and nexusFlyBV and nexusFlyBG and root and root.Parent do
			local camera = workspace.CurrentCamera
			local direction = Vector3.new(0, 0, 0)

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction - camera.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction - camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + camera.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then direction = direction + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then direction = direction + Vector3.new(0, -1, 0) end

			local spd = tonumber(nexusFlySpeed) or 50
			if direction.Magnitude > 0 then
				direction = direction.Unit * spd
			end

			if nexusFlyBV and nexusFlyBV.Parent then nexusFlyBV.Velocity = direction end
			if nexusFlyBG and nexusFlyBG.Parent then nexusFlyBG.CFrame = CFrame.new(root.Position, root.Position + camera.CFrame.LookVector) end

			task.wait()
		end
	end)
end

RunService:BindToRenderStep("NexusUniversalThirdPerson", Enum.RenderPriority.Camera.Value + 2, function()
	local active = (Legit and Legit.rageThirdPerson and rageModeEnabled) or (Legit and Legit.legitThirdPerson)
	if not active then return end

	local char = k.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")
	if not hrp or not head then return end

	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Name ~= "NexusGroundRing" then
			part.LocalTransparencyModifier = 0
		end
	end

	local dist = (Legit and Legit.rageThirdDist) or 9.0
	local camCF = Camera.CFrame
	local look = camCF.LookVector
	local right = camCF.RightVector
	local targetHeadPos = head.Position + Vector3.new(0, 1.2, 0)
	local offset = (right * 1.5) + Vector3.new(0, 1.3, 0)
	local desiredCamPos = targetHeadPos + offset - (look * dist)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {char, Camera}
	local hit = workspace:Raycast(targetHeadPos, (desiredCamPos - targetHeadPos), params)
	if hit then
		desiredCamPos = hit.Position - (look * 0.4)
	end

	Camera.CFrame = CFrame.new(desiredCamPos, desiredCamPos + look * 20)
end)

