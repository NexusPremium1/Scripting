-- TAB 3: BOSS & SEA EVENTS
local function buildTabBossSea()
	local T = Window:Tab({ Title = "Boss & Sea", Icon = "skull" })

	T:Section({ Title = "Boss Hunter (All 3 Seas incl. Tyrant of the Skies & Hydra Leader)" })
	UIRefs.BossPara = T:Paragraph({
		Title = "Spawned Bosses in Current Sea",
		Desc = "Scanning bosses...",
	})

	local function getBossNames()
		local out = {}
		for _, b in ipairs(Eng.World.GetSeaBosses()) do
			table.insert(out, b.Name)
		end
		if #out == 0 then out = { "(No bosses in this Sea)" } end
		return out
	end
	local initBosses = getBossNames()
	S.SelectedBoss = initBosses[1]

	local bossDD = T:Dropdown({
		Title = "Select Boss",
		Values = initBosses,
		Value = initBosses[1],
		Callback = function(v) S.SelectedBoss = v end,
	})
	T:Button({
		Title = "Refresh Boss List & Check Spawns",
		Callback = function()
			local list = getBossNames()
			pcall(function() bossDD:Refresh(list) end)
			notify("Boss Radar", "Refreshed " .. tostring(#list) .. " bosses for " .. getSeaName(), 2.5)
		end,
	})
	T:Toggle({
		Title = "Auto Farm Selected Boss",
		Value = S.AutoFarmBoss,
		Callback = function(v)
			S.AutoFarmBoss = v
			if not v then Eng.Travel.CancelTween() end
		end,
	})
	T:Toggle({
		Title = "Auto Farm ALL Spawned Bosses",
		Value = S.AutoFarmAllBosses,
		Callback = function(v)
			S.AutoFarmAllBosses = v
			if not v then Eng.Travel.CancelTween() end
		end,
	})
	T:Toggle({
		Title = "Auto Accept Boss Quest",
		Value = S.BossAutoQuest,
		Callback = function(v) S.BossAutoQuest = v end,
	})
	T:Button({
		Title = "Teleport to Selected Boss Spawn",
		Callback = function()
			local b = Eng.World.FindBossEntry(S.SelectedBoss)
			if b and b.Pos then
				Eng.Travel.TweenTo(b.Pos + Vector3.new(0, 12, 0))
			else
				notify("Boss TP", "No spawn coordinates for selected boss.", 2.5)
			end
		end,
	})

	T:Section({ Title = "Sea Events, Mirage, Kitsune & Prehistoric (2025/2026)" })
	T:Toggle({
		Title = "Auto Fight Sea Beasts / Terrorsharks / Sea Mobs",
		Value = S.AutoSeaEvents,
		Callback = function(v)
			S.AutoSeaEvents = v
			if not v then Eng.Travel.CancelTween() end
		end,
	})
	T:Toggle({
		Title = "Notify on Mirage / Kitsune / Prehistoric / Frozen Spawn",
		Value = S.AutoAlertSpecialEvents,
		Callback = function(v) S.AutoAlertSpecialEvents = v end,
	})

	local function tpSpecial(modelName, niceName)
		local map = Workspace:FindFirstChild("Map")
		local obj = map and map:FindFirstChild(modelName)
		if not obj then
			notify("Special Island", niceName .. " is not spawned in this server.", 3)
			return
		end
		local p = obj:FindFirstChildWhichIsA("BasePart", true)
		if p then
			Eng.Travel.TweenTo(p.Position + Vector3.new(0, 80, 0))
			notify("Special Island", "Flying to " .. niceName .. "!", 3)
		end
	end

	T:Button({
		Title = "Fly to Mirage Island (If Spawned)",
		Callback = function() tpSpecial("MysticIsland", "Mirage Island") end,
	})
	T:Button({
		Title = "Fly to Kitsune Island (If Spawned)",
		Callback = function() tpSpecial("KitsuneIsland", "Kitsune Island") end,
	})
	T:Button({
		Title = "Fly to Prehistoric Island (If Spawned)",
		Callback = function() tpSpecial("PrehistoricIsland", "Prehistoric Island") end,
	})
	T:Button({
		Title = "Fly to Frozen Dimension (If Spawned)",
		Callback = function() tpSpecial("FrozenDimension", "Frozen Dimension") end,
	})
end

