	-- CHANNEL 4: Passive ReplicatedStorage.Remotes OnClientEvent Listener (0 require, 0 hook, Nexus 100% safe!)
	-- Watches RIVALS replication remotes for elimination/death packets without modifying any module or metatable.
	pcall(function()
		local rs = game:GetService("ReplicatedStorage")
		local remotesFolder = rs:FindFirstChild("Remotes")
		if remotesFolder then
			local function tryBindRemote(rem)
				if not (rem and rem:IsA("RemoteEvent")) then return end
				local rn = low(rem.Name)
				-- Only bind explicit kill / elimination / death replication events (NEVER equip / sound / analytics!)
				if rn:find("eliminat", 1, true) or rn:find("kill", 1, true) or rn:find("died", 1, true)
					or rn:find("death", 1, true) or rn:find("ragdoll", 1, true) or rn:find("defeat", 1, true) then
					if rn:find("sound", 1, true) or rn:find("skin", 1, true) or rn:find("equip", 1, true)
						or rn:find("finish", 1, true) or rn:find("analytics", 1, true) then
						return
					end
					table.insert(Pack.Conns, rem.OnClientEvent:Connect(function(...)
						if __nexusRivalsUnloaded or inLobbyNow() then return end
						local args = { ... }
						-- Reject if WE are the victim (if LocalPlayer appears as victim, skip)
						local victimPlr = nil
						local killerIsMe = false
						for idx, a in ipairs(args) do
							if typeof(a) == "Instance" and a:IsA("Player") then
								if a == k then
									if idx == 1 and #args >= 2 then killerIsMe = true
									else return end
								else
									victimPlr = a
								end
							elseif type(a) == "table" then
								local v = a.Victim or a.victim or a.Dead or a.Target
								local kl = a.Killer or a.killer or a.Attacker
								if v == k or v == k.Name then return end
								if kl == k or kl == k.Name then killerIsMe = true end
								if typeof(v) == "Instance" and v:IsA("Player") then victimPlr = v end
							end
						end
						if victimPlr and isMate(victimPlr) then return end
						if (not Pack.OnlyMyKills) or killerIsMe or (victimPlr and (tick() - (ourHitTargets[victimPlr] or -999) <= 5.0)) or Pack.AttackFresh(3.0) then
							Detect.remoteKills = (Detect.remoteKills or 0) + 1
							fireKill("remote:" .. rem.Name, victimPlr, false)
						end
					end))
				end
			end
			for _, desc in ipairs(remotesFolder:GetDescendants()) do
				pcall(tryBindRemote, desc)
			end
			table.insert(Pack.Conns, remotesFolder.DescendantAdded:Connect(function(desc)
				pcall(tryBindRemote, desc)
			end))
		end
	end)

	-- CHANNEL 5: PlayerGui Elimination / Killfeed Text Watcher
	local function killTextIsMine(txt)
		if type(txt) ~= "string" or #txt < 4 or #txt > 160 then return false end
		local t = string.lower(txt)
		if t:find("eliminated you", 1, true) or t:find("killed you", 1, true) or t:find("defeated you", 1, true)
			or t:find("you died", 1, true) or t:find("you were", 1, true) or t:find("you got killed", 1, true)
			or t:find("you got eliminated", 1, true) or t:find("defeat", 1, true) or t:find("equip", 1, true)
			or t:find("finisher", 1, true) or t:find("skin", 1, true) or t:find("kill sound", 1, true)
			or t:find("play on every", 1, true) or t:find("only my kills", 1, true) then
			return false
		end
		if inLobbyNow() then return false end
		if t:find("you eliminated", 1, true) or t:find("you killed", 1, true)
			or t:find("eliminated!", 1, true) or t:find("elimination!", 1, true)
			or t == "elimination" or t == "eliminated" or t:find("+1 elimination", 1, true) then
			return true
		end
		local myName = low(k.Name)
		local myDisplay = low(k.DisplayName)
		for _, nm in ipairs({ myName, myDisplay }) do
			if nm ~= "" and #nm >= 2 then
				if t:find(nm .. " eliminated ", 1, true) or t:find(nm .. " killed ", 1, true)
					or t:find(nm .. " knocked ", 1, true) or t:find(nm .. " finished ", 1, true) then
					return true
				end
			end
		end
		-- Never trigger for other players kills
		return false
	end

	local function watchKillText(obj)
		if Detect.known[obj] then return end
		Detect.known[obj] = true
		task.defer(function()
			if not obj or not obj.Parent then return end
			local ok, txt = pcall(function() return obj.Text end)
			if ok and killTextIsMine(txt) then
				Detect.killUi = Detect.killUi + 1
				fireKill("elim-spawn-ui", nil, false)
			end
		end)
		pcall(function()
			table.insert(Pack.Conns, obj:GetPropertyChangedSignal("Text"):Connect(function()
				local ok, txt = pcall(function() return obj.Text end)
				if ok and killTextIsMine(txt) then
					Detect.killUi = Detect.killUi + 1
					fireKill("elim-text-ui", nil, false)
				end
			end))
		end)
	end

	local function watchHitmarkerGui(obj)
