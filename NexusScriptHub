--  ANTI-FALL DAMAGE  - ported from the Apex NDS build (v1.1)
--  Zeroes the falling velocity every frame, then hands it back one frame later, so the
--  humanoid never builds up the speed NDS turns into fall damage.
-- =====================================================================
local function setAntiFall(on)
    Nexus.Toggles.AntiFall = on
    if Nexus.Connections.AntiFall then
        pcall(function() Nexus.Connections.AntiFall:Disconnect() end)
        Nexus.Connections.AntiFall = nil
    end
    if not on then
        notify("Nexus", "Anti-Fall OFF", 1.5)
        return
    end
    Nexus.Connections.AntiFall = RunService.Heartbeat:Connect(function()
        if not Nexus.Toggles.AntiFall then return end
        local r = getRealHRP()
        if not (r and r.Parent) then return end
        local v = r.AssemblyLinearVelocity
        r.AssemblyLinearVelocity = Vector3.zero
        RunService.RenderStepped:Wait()
        if r.Parent and Nexus.Toggles.AntiFall then
            r.AssemblyLinearVelocity = v
        end
    end)
    notify("Nexus", "Anti-Fall ON", 1.5)
end

