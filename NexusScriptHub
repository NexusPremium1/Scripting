	function Pack.Bang(tool)
		Pack.Debug.shots = (Pack.Debug.shots or 0) + 1
		if tool and looksMelee(tool) then
			Pack.Debug.meleeSwings = (Pack.Debug.meleeSwings or 0) + 1
			Pack.LastMelee = tick()
			return
		end
		if typing() then return end
		if tick() - (Pack.LastFire or -1) < 0.05 then return end
		Pack.LastFire = tick()
		if Pack.HitOnShot and Pack.HitOn then
			pcall(function() fireHit("shot", true) end)
		end
		if not Pack.FireOn then return end
		if Pack.FireName == "" then return end
		Pack.PlaySound(Pack.FireName, Pack.FireVol, 3, "fire")
	end

	local function clearFireBinds()
		for _, c in ipairs(Pack.FireConns) do pcall(function() c:Disconnect() end) end
		Pack.FireConns = {}
	end

	local function bindTool(tool)
		if not tool or not tool:IsA("Tool") then return end
		table.insert(Pack.FireConns, tool.Activated:Connect(function()
			Pack.Bang(tool)
		end))
	end

	function Pack.BindFire()
		clearFireBinds()
		local function bindChar(char)
			if not char then return end
			for _, child in ipairs(char:GetChildren()) do
				bindTool(child)
			end
			table.insert(Pack.FireConns, char.ChildAdded:Connect(bindTool))
		end
		if k.Character then bindChar(k.Character) end
		table.insert(Pack.FireConns, k.CharacterAdded:Connect(bindChar))
		task.spawn(function()
			while not __nexusRivalsUnloaded do
				task.wait(0.04)
				if Pack.Holding then Pack.LastFire = tick() end
				if Pack.FireOn and Pack.FireHold and Pack.Holding then
					local char = k.Character
					local tool = char and char:FindFirstChildOfClass("Tool")
					if tool and tick() - (Pack.LastFire or -1) >= (Pack.FireRate or 0.12) then
						Pack.Bang(tool)
					end
				end
			end
		end)
	end

	table.insert(Pack.FireConns, UIS.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			Pack.Holding = true
			Pack.LastFire = tick()
			local char = k.Character
			local tool = char and char:FindFirstChildOfClass("Tool")
			if tool then
				Pack.Bang(tool)
			else
				Pack.Debug.shots = (Pack.Debug.shots or 0) + 1
				if Pack.FireOn and Pack.FireName ~= "" and not typing() then
					Pack.PlaySound(Pack.FireName, Pack.FireVol, 3, "fire")
				end
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			Pack.LastFire = tick()
			Pack.LastMelee = tick()
		end
	end))
	table.insert(Pack.FireConns, UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			Pack.Holding = false
		end
	end))

	Pack.BindFire()
	Pack.KillHook(Pack.KillOn, Pack.KillName)

