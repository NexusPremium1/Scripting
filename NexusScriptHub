	------------------------------------------------------------------ config

	local function folderReady()
		if type(isfolder) ~= "function" then return false end
		local ok, has = pcall(isfolder, CFG_FOLDER)
		if not ok then return false end
		if not has and type(makefolder) == "function" then
			pcall(makefolder, CFG_FOLDER)
		end
		return true
	end

	local function packData()
		return {
			Skybox = Pack.SkyName or "",
			KillName = Pack.KillName,
			KillOn = Pack.KillOn,
			Volume = Pack.Volume,
			HitName = Pack.HitName,
			HitOn = Pack.HitOn,
			HitVol = Pack.HitVol,
			HitOnlyMine = Pack.HitOnlyMine,
			AutoDetect = Pack.AutoDetect,
			HitWindow = Pack.HitWindow,
			FireName = Pack.FireName,
			FireOn = Pack.FireOn,
			FireVol = Pack.FireVol,
			FireHold = Pack.FireHold,
			FireRate = Pack.FireRate,
			WarnSkin = Pack.WarnSkin,
			MyKillRange = Pack.MyKillRange,
			HitOnShot = Pack.HitOnShot,
			OnlyMyKills = Pack.OnlyMyKills,
			V526 = true,
			V64 = true,
		}
	end

	local function saveNow()
		if type(writefile) ~= "function" then return false end
		if not folderReady() then return false end
		local ok = pcall(function()
			writefile(CFG_FILE, HttpService:JSONEncode(packData()))
		end)
		if ok then
			Pack.Dirty = 0
			pcall(function() nexusNotify("Sky & Sound config saved") end)
		end
		return ok
	end

	function Pack.QueueSave()
		Pack.Dirty = tick()
		task.delay(0.7, function()
			if Pack.Dirty ~= 0 and tick() - Pack.Dirty >= 0.6 then
				saveNow()
			end
		end)
	end

	local function applyLoaded(data)
		if type(data) ~= "table" then return end
		local migrateV64 = not data.V64
		if type(data.KillName) == "string" then Pack.KillName = data.KillName end
		if type(data.HitOnShot) == "boolean" then Pack.HitOnShot = migrateV64 and false or data.HitOnShot end
		if type(data.MyKillRange) == "number" then
			Pack.MyKillRange = migrateV64 and 2500 or math.max(50, data.MyKillRange)
		end
		Pack.KillOn = migrateV64 and true or (data.KillOn ~= false)
		Pack.OnlyMyKills = (data.OnlyMyKills ~= false)
		if type(data.Volume) == "number" then Pack.Volume = math.clamp(data.Volume, 0.1, 5) end
		if type(data.HitName) == "string" then Pack.HitName = data.HitName end
		Pack.HitOn = migrateV64 and true or (data.HitOn ~= false)
		if type(data.HitVol) == "number" then Pack.HitVol = math.clamp(data.HitVol, 0.1, 5) end
		Pack.HitOnlyMine = (data.HitOnlyMine ~= false)
		Pack.AutoDetect = data.AutoDetect ~= false
		if type(data.HitWindow) == "number" then Pack.HitWindow = math.clamp(data.HitWindow, 0.1, 3) end
		if type(data.FireName) == "string" then Pack.FireName = data.FireName end
		Pack.FireOn = data.FireOn == true
		if type(data.FireVol) == "number" then Pack.FireVol = math.clamp(data.FireVol, 0.1, 5) end
		Pack.FireHold = data.FireHold ~= false
		if type(data.FireRate) == "number" then Pack.FireRate = math.clamp(data.FireRate, 0.03, 1) end
		Pack.WarnSkin = data.WarnSkin ~= false
		if type(data.Skybox) == "string" and data.Skybox ~= "" then
			Pack.SkyName = data.Skybox
			Pack.Apply(data.Skybox)
		end
		Pack.Loaded = true
	end

	function Pack.LoadConfig(silent)
		if type(isfile) ~= "function" or type(readfile) ~= "function" then return false end
		local okFile, exists = pcall(isfile, CFG_FILE)
		if not okFile or not exists then return false end
		local ok = pcall(function()
			local raw = readfile(CFG_FILE)
			local data = HttpService:JSONDecode(raw)
			applyLoaded(data)
		end)
		if ok and not silent then
			pcall(function() nexusNotify("Sky & Sound config loaded") end)
		end
		return ok
	end

	------------------------------------------------------------------ skybox

	local originalSky, skyCreated = nil, false

	local function findSky()
		return Lighting:FindFirstChildOfClass("Sky")
	end

	local function rememberSky()
		if originalSky then return end
		local sky = findSky()
		if not sky then
			originalSky = { missing = true }
			return
		end
		local saved = {}
		for _, key in ipairs({ "SkyboxUp", "SkyboxBk", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxDn",
			"StarCount", "SunTextureId", "SunAngularSize", "MoonTextureId", "MoonAngularSize", "Name" }) do
			local ok, v = pcall(function() return sky[key] end)
			saved[key] = ok and v or nil
		end
		originalSky = saved
	end

	function Pack.Apply(name)
		local preset
		for _, box in ipairs(BOXES) do
			if box.n == name then preset = box break end
		end
		if not preset then return false end
		rememberSky()
		local sky = findSky()
		if not sky then
			sky = Instance.new("Sky")
			sky.Name = "Sky"
			sky.Parent = Lighting
			skyCreated = true
		end
		pcall(function() sky.SkyboxUp = preset.u end)
		pcall(function() sky.SkyboxBk = preset.b end)
		pcall(function() sky.SkyboxFt = preset.f end)
		pcall(function() sky.SkyboxLf = preset.l end)
		pcall(function() sky.SkyboxRt = preset.r end)
		pcall(function() sky.SkyboxDn = preset.d end)
		if preset.s then pcall(function() sky.StarCount = preset.s end) end
		Pack.SkyName = preset.n
		return true
	end

	function Pack.Restore()
		local saved = originalSky
		local sky = findSky()
		if saved and saved.missing then
			if sky and skyCreated then pcall(function() sky:Destroy() end) end
			skyCreated = false
			Pack.SkyName = nil
			return true
		end
		if not saved then return false end
		if not sky then
			sky = Instance.new("Sky")
			sky.Parent = Lighting
		end
		for key, value in pairs(saved) do
			if key ~= "missing" and value ~= nil then
				pcall(function() sky[key] = value end)
			end
		end
		Pack.SkyName = nil
		return true
	end

	------------------------------------------------------------------ sounds

	local function findSound(name)
		for _, s in ipairs(SFX) do
			if s.n == name or s.id == name then return s end
		end
		return nil
	end

	-- v5.12 · If a Roblox audio id is private / removed / refused by the game,
	-- Play() succeeds but nothing is heard: that is the "kill sound does not
	-- work" report. These ids are shipped INSIDE the client, so they always
	-- play. They are the last link of the chain, never the first.
	local BUILTIN = {
		kill = { "rbxasset://sounds/uuhhh.mp3", "rbxasset://sounds/electronicpingshort.wav" },
		hit  = { "rbxasset://sounds/hit.wav", "rbxasset://sounds/electronicpingshort.wav" },
		fire = { "rbxasset://sounds/snap.mp3", "rbxasset://sounds/swordslash.wav" },
		other = { "rbxasset://sounds/electronicpingshort.wav" },
	}

	local function builtinList(role)
		return BUILTIN[role or "other"] or BUILTIN.other
	end

