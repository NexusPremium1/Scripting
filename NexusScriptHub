-- ══════════════════════════════════════════════════════════════════════
RunService:BindToRenderStep("NexusHardHeadLock", Enum.RenderPriority.Camera.Value + 1, function()
	if not rageModeEnabled then return end
	local target = loopGotoTarget or rageLockTarget
	if not target or not target.Character or not isPlayerAliveRaw(target) then
		local myRoot = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
		if myRoot then
			local best, bestDist = nil, math.huge
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= k and isPlayerAliveRaw(p) and (not teamCheckEnabled or not isTeammate(p)) then
					local tRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
					if tRoot then
						local d = (tRoot.Position - myRoot.Position).Magnitude
						if d < bestDist then bestDist = d; best = p end
					end
				end
			end
			target = best
		end
	end

	if target and target.Character then
		local head = target.Character:FindFirstChild("HitboxHead") or target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
		if head then
			local headPos = head.Position
			local hrp = target.Character:FindFirstChild("HumanoidRootPart") or head
			local vel = hrp.AssemblyLinearVelocity or Vector3.zero
			if vel.Magnitude > 0.05 then
				headPos = headPos + (vel * 0.11)
			end

			local myHRP = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
			if Legit and Legit.rageThirdPerson and myHRP then
				k.CameraMode = Enum.CameraMode.Classic
				k.CameraMinZoomDistance = 6.0
				k.CameraMaxZoomDistance = 14.0

				local dirToTarget = (headPos - myHRP.Position)
				local flatDir = Vector3.new(dirToTarget.X, 0, dirToTarget.Z).Unit
				local rightVec = Vector3.new(-flatDir.Z, 0, flatDir.X)
				local distCam = (Legit and Legit.rageThirdDist) or 8.5
				local camPos = myHRP.Position + Vector3.new(0, 2.6, 0) - (flatDir * distCam) + (rightVec * 1.3)
				Camera.CFrame = CFrame.new(camPos, headPos)
			else
				local camPos = Camera.CFrame.Position
				Camera.CFrame = CFrame.new(camPos, headPos)
			end
		end
	end
end)


