function Eng.Farm.EngageMob(mob, keepConditionFn)
	if not Eng.Combat.MobAlive(mob) then return end
	local startT = os.clock()
	local hum0 = getHum()
	if hum0 then hum0.AutoRotate = false end
	S.CurrentTarget = mob

	while not S.Unloaded and Eng.Combat.MobAlive(mob) do
		if keepConditionFn and not keepConditionFn() then break end
		local root, hum = getRoot(), getHum()
		if not root or not hum or hum.Health <= 0 then break end
		local mr = mob:FindFirstChild("HumanoidRootPart")
		local mhum = mob:FindFirstChildOfClass("Humanoid")
		if not mr or not mhum then break end

		-- Mastery Mode: switch to Fruit/Gun when mob HP drops below threshold!
		local hpPct = (mhum.MaxHealth > 0) and ((mhum.Health / mhum.MaxHealth) * 100) or 100
		if S.MasteryMode and hpPct <= (S.MasteryHPPercent or 25) then
			Eng.Combat.EquipWeapon(S.MasteryWeapon)
			Eng.Combat.CastSkills()
		else
			Eng.Combat.EquipWeapon(nil)
			if S.AutoSkills then Eng.Combat.CastSkills() end
		end
		Eng.Combat.EnsureBuffs()

		local desired = mr.Position + Vector3.new(0, S.FarmHeight or 14, 0)
		local safeDesired = sanitizeDest(desired, 0)
		local dist = safeDesired and (safeDesired - root.Position).Magnitude or math.huge

		if not safeDesired then
			RunService.Heartbeat:Wait()
		elseif dist > 95 then
			Eng.Travel.TweenTo(safeDesired)
		else
			local dt = RunService.Heartbeat:Wait()
			local newPos = root.Position:Lerp(safeDesired, math.clamp(dt * 14, 0, 1))
			root.CFrame = CFrame.new(newPos, mr.Position)
			zeroVel(root)
			local plat = Eng.Travel.EnsurePlatform()
			plat.CFrame = CFrame.new(newPos - Vector3.new(0, 3.6, 0))
		end

		Eng.Combat.BringMobsTo(mob)

		if S.FastAttack then
			Net.FastAttackBurst(S.FastAttackRange, true, S.FastAttackPlayers)
		elseif S.ClickFallback then
			Net.ClickAttackFallback()
		end

		if (os.clock() - startT) > 90 then break end
	end

	if S.CurrentTarget == mob then S.CurrentTarget = nil end
	local hum1 = getHum()
	if hum1 then hum1.AutoRotate = true end
end

function Eng.Farm.FarmTick()
	if not S.Farming then return end
	local root, hum = getRoot(), getHum()
	if not root or not hum or hum.Health <= 0 then
		S.FarmStatus = "Waiting for respawn..."
		return
	end

	local mode = S.FarmMode
	if mode == "Level (Quest)" then
		local lv = getLevel()
		local q = Eng.Combat.GetQuestForLevel(lv)
		local onQuest = Eng.Combat.HasQuest(q[4])
		if S.WasOnQuest and not onQuest then
			S.QuestCooldownUntil = 0
			S.LastQuestTry = 0
		end
		S.WasOnQuest = onQuest

		-- Accept Quest by traveling to Quest Giver first (fixes Blox Fruits proximity check!)
		if S.AutoQuest and not onQuest and (os.clock() - S.LastQuestTry) > 1.5 and os.clock() > S.QuestCooldownUntil then
			S.LastQuestTry = os.clock()
			S.FarmStatus = string.format("Quest -> %s (%s #%d)", q[4], q[2], q[3])
			if (root.Position - q[5]).Magnitude > 22 then
				Eng.Travel.TweenTo(q[5] + Vector3.new(0, 3, 0), nil, q[7])
			end
			if not S.Farming or S.Unloaded then return end
			Net.Comm("StartQuest", q[2], q[3])
			task.wait(0.45)
			if not Eng.Combat.HasQuest(nil) then
				S.QuestCooldownUntil = os.clock() + 4
			end
		end

		local mob = Eng.Combat.FindMobByName(q[4], q[8])
		if mob then
			S.FarmStatus = string.format("Fighting %s (Lv %d)", q[4], lv)
			Eng.Farm.EngageMob(mob, function() return S.Farming and S.FarmMode == "Level (Quest)" end)
		else
			S.FarmStatus = "Traveling to " .. q[4] .. " spawn..."
			if (root.Position - q[6]).Magnitude > 30 then
				Eng.Travel.TweenTo(q[6] + Vector3.new(0, S.FarmHeight, 0), nil, q[7])
			else
				S.FarmStatus = "Waiting for " .. q[4] .. " respawn..."
				task.wait(0.25)
			end
		end

	elseif mode == "Nearest Mob" then
		local mob = Eng.Combat.FindNearestMob(4000)
		if mob then
			S.FarmStatus = "Fighting " .. Eng.Combat.BaseMobName(mob.Name)
			Eng.Farm.EngageMob(mob, function() return S.Farming and S.FarmMode == "Nearest Mob" end)
		else
			S.FarmStatus = "No mobs nearby."
			task.wait(0.3)
		end

	elseif mode == "Selected Mob" then
		if not S.SelectedMob or S.SelectedMob == "" or S.SelectedMob == "(No mobs loaded nearby)" then
			S.FarmStatus = "Select a mob in dropdown first."
			task.wait(0.4)
