-- v5 · INVISIBLE (local): hides body parts, accessories and faces
local InvisibleState = { On = false, Saved = {} }

local function NexusCollectTargets(character)
	local list = {}
	if not character then return list end
	for _, d in ipairs(character:GetDescendants()) do
		if d:IsA("BasePart") then
			list[#list + 1] = { obj = d, prop = "Transparency", value = d.Transparency }
		elseif d:IsA("Decal") or d:IsA("Texture") then
			list[#list + 1] = { obj = d, prop = "Transparency", value = d.Transparency }
		end
	end
	return list
end

local function NexusApplyInvisible(on)
	local character = LocalPlayer.Character
	if not character then return end
	if on then
		if next(InvisibleState.Saved) == nil then
			for _, entry in ipairs(NexusCollectTargets(character)) do
				InvisibleState.Saved[entry.obj] = entry.value
			end
		end
		for _, d in ipairs(character:GetDescendants()) do
			if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
				pcall(function()
					d.Transparency = 1
					if d:IsA("BasePart") then
						d.LocalTransparencyModifier = 1
						d.CanCollide = false
						d.Massless = true
					end
				end)
			end
		end
		-- hide instantly if a new accessory/part is added
		if not InvisibleState.Conn then
			InvisibleState.Conn = Connect(character.DescendantAdded:Connect(function(d)
				if not InvisibleState.On then return end
				if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
					task.defer(function()
						pcall(function()
							d.Transparency = 1
							if d:IsA("BasePart") then
								d.LocalTransparencyModifier = 1
								d.CanCollide = false
								d.Massless = true
							end
						end)
					end)
				end
			end))
		end
	else
		for obj, value in pairs(InvisibleState.Saved) do
			pcall(function()
				obj.Transparency = value
				if obj:IsA("BasePart") then
					obj.LocalTransparencyModifier = 0
					obj.CanCollide = true
					obj.Massless = false
				end
			end)
		end
		InvisibleState.Saved = {}
		if InvisibleState.Conn then
			pcall(function() InvisibleState.Conn:Disconnect() end)
			InvisibleState.Conn = nil
		end
	end
end

