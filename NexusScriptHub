	-- v5.9 · named configs: type a name, save it, pick it from the list, load it
	local CFG_DIR = CFG_FOLDER .. "/configs"

	local function cfgDirReady()
		if type(isfolder) ~= "function" then return false end
		pcall(function()
			if not isfolder(CFG_FOLDER) and type(makefolder) == "function" then makefolder(CFG_FOLDER) end
			if not isfolder(CFG_DIR) and type(makefolder) == "function" then makefolder(CFG_DIR) end
		end)
		local ok, has = pcall(isfolder, CFG_DIR)
		return ok and has
	end

	local function cfgIndexPath() return CFG_DIR .. "/index.json" end

	local function readIndex()
		local out = {}
		pcall(function()
			if type(isfile) == "function" and type(readfile) == "function" and isfile(cfgIndexPath()) then
				local data = HttpService:JSONDecode(readfile(cfgIndexPath()))
				if type(data) == "table" then
					for _, name in ipairs(data) do
						if type(name) == "string" then table.insert(out, name) end
					end
				end
			end
		end)
		return out
	end

	local function writeIndex(list)
		pcall(function()
			if type(writefile) == "function" then
				writefile(cfgIndexPath(), HttpService:JSONEncode(list))
			end
		end)
	end

	local function listConfigs()
		local found, seen = {}, {}
		pcall(function()
			if type(listfiles) == "function" and cfgDirReady() then
				for _, path in ipairs(listfiles(CFG_DIR)) do
					local base = tostring(path):gsub("^.*[/\\]", "")
					base = base:gsub("%.json$", "")
					local name = base
					if name and name ~= "index" and not seen[name] then
						seen[name] = true
						table.insert(found, name)
					end
				end
			end
		end)
		for _, name in ipairs(readIndex()) do
			if name ~= "index" and not seen[name] then
				seen[name] = true
				table.insert(found, name)
			end
		end
		table.sort(found)
		return found
	end

	local function saveNamed(rawName)
		local name = tostring(rawName or ""):gsub("[^%w%_%-%s]", ""):gsub("^%s+", ""):gsub("%s+$", "")
		if name == "" then
			pcall(function() nexusNotify("type a config name first") end)
			return false
		end
		if type(writefile) ~= "function" or not cfgDirReady() then
			pcall(function() nexusNotify("executor has no file access") end)
			return false
		end
		local ok = pcall(function()
			writefile(CFG_DIR .. "/" .. name .. ".json", HttpService:JSONEncode(packData()))
		end)
		if ok then
			local list = readIndex()
			local exists = false
			for _, item in ipairs(list) do if item == name then exists = true end end
			if not exists then table.insert(list, name) end
			writeIndex(list)
			pcall(function() nexusNotify("config saved: " .. name) end)
		else
			pcall(function() nexusNotify("could not save config") end)
		end
		return ok
	end

	local function loadNamed(name)
		if type(name) ~= "string" or name == "" then return false end
		local ok, data = pcall(function()
			if type(readfile) ~= "function" or not cfgDirReady() then return nil end
			if not isfile(CFG_DIR .. "/" .. name .. ".json") then return nil end
			return HttpService:JSONDecode(readfile(CFG_DIR .. "/" .. name .. ".json"))
		end)
		if not ok or type(data) ~= "table" then
			pcall(function() nexusNotify("config not found: " .. tostring(name)) end)
			return false
		end
		applyLoaded(data)
		pcall(function() Pack.SyncUI() end)
		pcall(function() nexusNotify("config loaded: " .. name) end)
		return true
	end

