-- Exact v1.6 PropertyChanged WalkSpeed/JumpPower Lock (now leak-free on Unload!)
function Eng.Player.ApplySpeedLock()
	local char, hum = getChar(), getHum()
	if not char or not hum then return end
	if SpeedLock.Char ~= char then
		if SpeedLock.Conn then pcall(function() SpeedLock.Conn:Disconnect() end) end
		if SpeedLock.JumpConn then pcall(function() SpeedLock.JumpConn:Disconnect() end) end
		SpeedLock.Char = char
		SpeedLock.Conn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if S.Unloaded or not S.PlayerMods then return end
			if hum.WalkSpeed ~= S.WalkSpeed then
				pcall(function() hum.WalkSpeed = S.WalkSpeed end)
			end
		end)
		SpeedLock.JumpConn = hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
			if S.Unloaded or not S.PlayerMods then return end
			if hum.JumpPower ~= S.JumpPower then
				pcall(function() hum.JumpPower = S.JumpPower end)
			end
		end)
	end
	pcall(function()
		hum.UseJumpPower = true
		hum.WalkSpeed = S.WalkSpeed
		hum.JumpPower = S.JumpPower
	end)
end

function Eng.Player.ReleaseSpeedLock()
	if SpeedLock.Conn then pcall(function() SpeedLock.Conn:Disconnect() end) end
	if SpeedLock.JumpConn then pcall(function() SpeedLock.JumpConn:Disconnect() end) end
	SpeedLock.Conn, SpeedLock.JumpConn, SpeedLock.Char = nil, nil, nil
	local hum = getHum()
	if hum then
		pcall(function()
			hum.WalkSpeed = S.OrigWalkSpeed
			hum.JumpPower = S.OrigJumpPower
		end)
	end
end

-- Exact v1.6 Energy + RaceEnergy Lock (now leak-free on Unload!)
function Eng.Player.ReleaseEnergyLock()
	for _, c in ipairs(EnergyLock.Conns) do
		pcall(function() c:Disconnect() end)
	end
	EnergyLock.Conns = {}
	EnergyLock.Objs = {}
end

function Eng.Player.BindEnergyLock()
	local char = getChar()
	local sources = {}
	if char then
		local e = char:FindFirstChild("Energy")
		if e and (e:IsA("NumberValue") or e:IsA("IntValue") or e:IsA("StringValue")) then table.insert(sources, e) end
		local re = char:FindFirstChild("RaceEnergy")
		if re and (re:IsA("NumberValue") or re:IsA("IntValue")) then table.insert(sources, re) end
	end
	local pe = LP:FindFirstChild("Energy")
	if pe and (pe:IsA("NumberValue") or pe:IsA("IntValue")) then table.insert(sources, pe) end

	local function pin(obj)
		if not obj or not S.InfiniteEnergy or S.Unloaded then return end
		if obj:IsA("StringValue") then
			if obj.Value ~= "100" then pcall(function() obj.Value = "100" end) end
		else
			local tgt = S.EnergyValue or 1000000
			if obj.Value ~= tgt then pcall(function() obj.Value = tgt end) end
		end
	end

	for _, obj in ipairs(sources) do
		if not EnergyLock.Objs[obj] then
			EnergyLock.Objs[obj] = true
			local c = obj.Changed:Connect(function() pin(obj) end)
			table.insert(EnergyLock.Conns, c)
		end
		pin(obj)
	end
	return #sources
end

-- Modern LinearVelocity + AlignOrientation Fly
function Eng.Player.StopFly()
	for _, o in ipairs(S.FlyObjs) do pcall(function() o:Destroy() end) end
	S.FlyObjs = {}
	local h = getHum()
	if h then pcall(function() h.PlatformStand = false end) end
end

function Eng.Player.UpdateFly()
	if not S.FlyOn then return end
	local hum, root = getHum(), getRoot()
	if not hum or not root then return end
	hum.PlatformStand = true
	local att = root:FindFirstChild("NexusBFFlyAtt")
	local lv = root:FindFirstChild("NexusBFFlyLV")
	local ao = root:FindFirstChild("NexusBFFlyAO")
	if not att then
		att = Instance.new("Attachment"); att.Name = "NexusBFFlyAtt"; att.Parent = root
		table.insert(S.FlyObjs, att)
	end
	if not lv then
		lv = Instance.new("LinearVelocity"); lv.Name = "NexusBFFlyLV"; lv.Attachment0 = att
		lv.MaxForce = math.huge; lv.RelativeTo = Enum.ActuatorRelativeTo.World; lv.Parent = root
		table.insert(S.FlyObjs, lv)
	end
	if not ao then
		ao = Instance.new("AlignOrientation"); ao.Name = "NexusBFFlyAO"; ao.Attachment0 = att
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment; ao.MaxTorque = math.huge; ao.Responsiveness = 50; ao.Parent = root
		table.insert(S.FlyObjs, ao)
	end
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local dir = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
	local spd = S.FlySpeed
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then spd = spd * 1.75 end
	lv.VectorVelocity = (dir.Magnitude > 0.01) and (dir.Unit * spd) or Vector3.zero
	ao.CFrame = CFrame.lookAt(root.Position, root.Position + cam.CFrame.LookVector)
end

-- Water Walk (Solid invisible surface at Y = -2 under feet for Devil Fruit users!)
