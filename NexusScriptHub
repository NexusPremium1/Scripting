		else
			S.FarmStatus = "Waiting for " .. S.SelectedMob .. "..."
			task.wait(0.35)
		end

	elseif mode == "Bones (Haunted Castle)" then
		local boneMobs = { "Reborn Skeleton", "Living Zombie", "Demonic Soul", "Posessed Mummy" }
		local target = nil
		for _, n in ipairs(boneMobs) do
			target = Eng.Combat.FindMobByName(n)
			if target then break end
		end
		if target then
			S.FarmStatus = "Bone Farm: " .. Eng.Combat.BaseMobName(target.Name)
			Eng.Farm.EngageMob(target, function() return S.Farming and S.FarmMode == "Bones (Haunted Castle)" end)
		else
			S.FarmStatus = "Flying to Haunted Castle..."
			Eng.Travel.TweenTo(Vector3.new(-9506, 175, 6159))
		end

	elseif mode == "Cake Prince / Dough King" then
		local cakeMobs = { "Cake Prince", "Dough King", "Cookie Crafter", "Cake Guard", "Baking Staff", "Head Baker" }
		local target = nil
		for _, n in ipairs(cakeMobs) do
			target = Eng.Combat.FindMobByName(n)
			if target then break end
		end
		if target then
			S.FarmStatus = "Cake Farm: " .. Eng.Combat.BaseMobName(target.Name)
			Eng.Farm.EngageMob(target, function() return S.Farming and S.FarmMode == "Cake Prince / Dough King" end)
		else
			S.FarmStatus = "Flying to Cake Land..."
			Eng.Travel.TweenTo(Vector3.new(-2021, 55, -12028))
		end

	elseif mode == "Ectoplasm (Cursed Ship)" then
		local shipMobs = { "Ship Deckhand", "Ship Engineer", "Ship Steward", "Ship Officer" }
		local target = nil
		for _, n in ipairs(shipMobs) do
			target = Eng.Combat.FindMobByName(n)
			if target then break end
		end
		if target then
			S.FarmStatus = "Ectoplasm: " .. Eng.Combat.BaseMobName(target.Name)
			Eng.Farm.EngageMob(target, function() return S.Farming and S.FarmMode == "Ectoplasm (Cursed Ship)" end)
		else
			S.FarmStatus = "Portal to Cursed Ship..."
			Eng.Travel.TweenTo(Vector3.new(923, 132, 32853), nil, Vector3.new(923.21, 126.98, 32852.83))
		end

	elseif mode == "Elite Hunter (Sea 3)" then
		local elites = { "Diablo", "Deandre", "Urban" }
		local target = nil
		for _, n in ipairs(elites) do
			target = Eng.Combat.FindMobByName(n)
			if target then break end
		end
		if not target then
			Net.Comm("EliteHunter")
			-- Also check ReplicatedStorage for spawned elite
			for _, n in ipairs(elites) do
