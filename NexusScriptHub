function Eng.Vehicle.GetSeatedVehicle()
	local hum = getHum()
	if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
		local model = hum.SeatPart:FindFirstAncestorOfClass("Model")
		if model then return model, hum.SeatPart end
	end
	local folder = Eng.Vehicle.GetFolder()
	if folder then
		local myCar = folder:FindFirstChild(LocalPlayer.Name .. "Car")
		if myCar then
			return myCar, Eng.Vehicle.GetSeat(myCar)
		end
	end
	return nil, nil
end

function Eng.Vehicle.ListServerCars()
	local folder = Eng.Vehicle.GetFolder()
	local out = {}
	if folder then
		for _, v in ipairs(folder:GetChildren()) do
			if v:IsA("Model") and Eng.Vehicle.GetSeat(v) then
				table.insert(out, v.Name)
			end
		end
	end
	table.sort(out)
	if #out == 0 then
		out = { "(No vehicles active)" }
	end
	return out
end

function Eng.Vehicle.ApplyTuning(speedVal, turboStage, driftVal)
	local car, seat = Eng.Vehicle.GetSeatedVehicle()
	if not car or not seat then
		return false
	end
	local spd = math.clamp(tonumber(speedVal) or S.CarSpeedVal, 25, 500)
	local trb = math.clamp(tonumber(turboStage) or S.CarTurboStage, 0, 5)
	pcall(function()
		seat.MaxSpeed = spd
		seat.Torque = math.max(seat.Torque, spd * 18)
		local topSpeedObj = seat:FindFirstChild("TopSpeed")
		if topSpeedObj and (topSpeedObj:IsA("NumberValue") or topSpeedObj:IsA("IntValue")) then
			topSpeedObj.Value = spd
		end
		local turboObj = seat:FindFirstChild("Turbo")
		if turboObj and (turboObj:IsA("NumberValue") or turboObj:IsA("IntValue")) then
			turboObj.Value = trb
		end
	end)
	if driftVal then
		pcall(function()
			Net.CarEvent("DriftingNumber", math.clamp(tonumber(driftVal) or 1, 0.1, 3.0))
		end)
	end
	return true
end

function Eng.Vehicle.StopCarFly()
	for _, obj in ipairs(S.CarFlyObjs) do
		pcall(function() obj:Destroy() end)
	end
	S.CarFlyObjs = {}
end

function Eng.Vehicle.UpdateCarFly(dt)
	if not S.CarFlyOn then return end
	local hum = getHum()
	if not hum or not hum.SeatPart or not hum.SeatPart:IsA("VehicleSeat") then
		Eng.Vehicle.StopCarFly()
		return
	end
	local seat = hum.SeatPart
	local lv = seat:FindFirstChild("NexusCarFlyLV")
	local ao = seat:FindFirstChild("NexusCarFlyAO")
	local att = seat:FindFirstChild("NexusCarFlyAtt")
	if not att then
		att = Instance.new("Attachment")
		att.Name = "NexusCarFlyAtt"
		att.Parent = seat
		table.insert(S.CarFlyObjs, att)
	end
	if not lv then
		lv = Instance.new("LinearVelocity")
		lv.Name = "NexusCarFlyLV"
		lv.Attachment0 = att
		lv.MaxForce = math.huge
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.VectorVelocity = Vector3.zero
		lv.Parent = seat
		table.insert(S.CarFlyObjs, lv)
	end
	if not ao then
		ao = Instance.new("AlignOrientation")
		ao.Name = "NexusCarFlyAO"
		ao.Attachment0 = att
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.MaxTorque = math.huge
		ao.Responsiveness = 45
		ao.CFrame = Camera.CFrame
		ao.Parent = seat
		table.insert(S.CarFlyObjs, ao)
	end

	local cam = Workspace.CurrentCamera
	if not cam then return end
	local move = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
		move = move + Vector3.new(0, 1, 0)
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
		move = move - Vector3.new(0, 1, 0)
	end
	local spd = S.CarFlySpeed
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then spd = spd * 1.8 end
	if move.Magnitude > 0.01 then
		lv.VectorVelocity = move.Unit * spd
	else
		lv.VectorVelocity = Vector3.zero
	end
	ao.CFrame = CFrame.lookAt(seat.Position, seat.Position + cam.CFrame.LookVector)
end

function Eng.Vehicle.ClaimSeatAndMove(vehicle, destCF, returnCF)
	local hum = getHum()
	local root = getRoot()
	local seat = Eng.Vehicle.GetSeat(vehicle)
	if not hum or not root or not seat then return false, "Seat or character missing" end
	if seat.Occupant and seat.Occupant ~= hum then
		return false, "Driver seat is occupied"
	end

	local savedCF = returnCF or root.CFrame
	local wasSeatedEnabled = true
	pcall(function()
		wasSeatedEnabled = hum:GetStateEnabled(Enum.HumanoidStateType.Seated)
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	end)

	hum.Sit = false
	task.wait(0.06)
	root.CFrame = seat.CFrame + Vector3.new(0, 2.5, 0)
	zeroVelocity(root)
	task.wait(0.06)
	pcall(function() seat:Sit(hum) end)

	local t0 = os.clock()
	while hum.SeatPart ~= seat and (os.clock() - t0) < 1.2 do
		if S.Unloaded then break end
		root.CFrame = seat.CFrame + Vector3.new(0, 1.5, 0)
		pcall(function() seat:Sit(hum) end)
		task.wait(0.08)
	end

	local seated = (hum.SeatPart == seat)
	if seated then
		safePivot(vehicle, destCF)
		task.wait(0.32)
		hum.Sit = false
		task.wait(0.08)
	end

	-- Guaranteed safe return & state restoration
	pcall(function()
		safePivot(getChar(), savedCF)
		zeroVelocity(root)
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
		if S.AntiSitOn then
			hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
		else
			hum:SetStateEnabled(Enum.HumanoidStateType.Seated, wasSeatedEnabled)
		end
	end)
	return seated, seated and "Success" or "Could not enter seat"
end

function Eng.Vehicle.BringOrVoidSelected(voidMode)
	local name = S.SelectedServerCar
	if not name or name == "" or name == "(No vehicles active)" then
		notify("Vehicles", "Select a server vehicle first!", 3)
		return
	end
	local folder = Eng.Vehicle.GetFolder()
	local car = folder and folder:FindFirstChild(name)
	if not car then
		notify("Vehicles", "Vehicle no longer exists.", 3)
		return
	end
	local root = getRoot()
	if not root then return end
	local origCF = root.CFrame
	local destCF = voidMode and CFrame.new(0, -1500, 0) or (origCF * CFrame.new(0, 2, -12))
	trackThread(function()
		local ok, msg = Eng.Vehicle.ClaimSeatAndMove(car, destCF, origCF)
		if ok then
			notify("Vehicles", (voidMode and "Voided " or "Brought ") .. name .. "!", 3)
		else
			notify("Vehicles", "Failed (" .. name .. "): " .. tostring(msg), 3)
		end
	end)
end

function Eng.Vehicle.ProcessAllEmptyCars(voidMode)
	if S.CarMassAction then
		S.CarMassAction = false
		notify("Vehicles", "Stopped batch vehicle operation.", 2.5)
		return
	end
	local folder = Eng.Vehicle.GetFolder()
	local root = getRoot()
	if not folder or not root then return end
	S.CarMassAction = true
	local origCF = root.CFrame
	notify("Vehicles", (voidMode and "Voiding" or "Bringing") .. " all unoccupied vehicles...", 3)
	trackThread(function()
		local count = 0
		for _, car in ipairs(folder:GetChildren()) do
			if not S.CarMassAction or S.Unloaded then break end
			local seat = Eng.Vehicle.GetSeat(car)
			if seat and seat.Occupant == nil then
				local destCF = voidMode and CFrame.new(0, -1500, 0) or (origCF * CFrame.new(math.random(-14, 14), 3, math.random(-14, 14)))
				local ok = Eng.Vehicle.ClaimSeatAndMove(car, destCF, origCF)
				if ok then count = count + 1 end
				task.wait(0.12)
			end
		end
		S.CarMassAction = false
		notify("Vehicles", string.format("Done! %s %d vehicles.", voidMode and "Voided" or "Brought", count), 3.5)
	end)
end

