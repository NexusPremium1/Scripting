local function parseData()
	local n = 0
	for line in EMOTE_RAW:gmatch("[^\n]+") do
		local id, name = line:match("^(%d+)|(.+)$")
		if id then
			n = n + 1
			IDS[n] = tonumber(id)
			NAMES[n] = name
			NAME_BY_ID[IDS[n]] = name
		end
	end
	EMOTE_COUNT = n

	for line in PACK_RAW:gmatch("[^\n]+") do
		local name, body = line:match("^(.+)|(.+)$")
		if name and body then
			local slots, count = {}, 0
			for k, id in body:gmatch("([a-z]%d?)=(%d+)") do
				slots[k] = id
				count = count + 1
			end
			if count >= 5 then
				PACKS[#PACKS + 1] = { name = name, slots = slots, count = count }
			end
		end
	end
end

