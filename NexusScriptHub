do
	-- ════════════════════════════════════════════════════════════════════
	--  v6 · SKIN ENGINE  (why skins "did not load" before)
	--  The stock engine only accepts an EXACT model name that already sits in
	--  PlayerScripts/Assets/ViewModels. Three things broke it in real games:
	--    1. the model is named "AUG ", "AssaultRifle" or "GingerbreadAUG"
	--       -> exact string compare never matched (AUG never loaded)
	--    2. the model streams in a moment AFTER you click -> failed silently
	--    3. the weapon model lives under the camera / backpack, not ViewModels
	--  This layer fixes all three: fuzzy names, more roots, short retry queue.
	-- ════════════════════════════════════════════════════════════════════

	local function norm(name)
		return (string.lower(tostring(name or "")):gsub("[%s%p]", ""))
	end

	local function score(obj, want, wantNorm)
		local got = tostring(obj.Name or "")
		local base = 0
		if got == want then
			base = 100
		else
			local n = norm(got)
			if n == wantNorm then
				base = 90
			elseif #wantNorm >= 3 and n ~= "" and
				(string.find(n, wantNorm, 1, true) or string.find(wantNorm, n, 1, true)) then
				-- "Candy Cane AUG" must never be served by the plain "AUG" model:
				-- a partial hit only counts when both names are of similar size
				local short = math.min(#n, #wantNorm)
				local long = math.max(#n, #wantNorm)
				if long > 0 and (short / long) >= 0.4 then
					base = 55
				end
			end
		end
		if base == 0 then return 0 end
		if obj:IsA("Model") then base = base + 8 end
		if obj:IsA("Tool") then base = base - 30 end
		return base
	end

	local function roots(forSkin)
		local out = {}
		-- 1. Rivals keeps every weapon / skin MODEL in a template folder; this
		-- is the folder the game itself streams into (the hub listens to it too)
		pcall(function()
			local rs = game:GetService("ReplicatedStorage")
			if not rs then return end
			local assets = rs:FindFirstChild("Assets")
			if assets then
				local temp = assets:FindFirstChild("Temp")
				local vms = temp and temp:FindFirstChild("ViewModels")
				if vms then table.insert(out, { root = vms, budget = 6000, template = true }) end
				table.insert(out, { root = assets, budget = 6000, template = true })
			end
			table.insert(out, { root = rs, budget = 6000, template = true })
		end)
		-- 2. the equipped viewmodel (kept, but ranked below a template match
		--    when we search for a skin - otherwise the equipped gun would be
		--    offered as its own skin and "nothing happens")
		do
			local vm = al
			pcall(function()
				if not vm then
					local ps = k:FindFirstChild("PlayerScripts")
					local assets = ps and ps:FindFirstChild("Assets")
					vm = assets and assets:FindFirstChild("ViewModels")
					if vm then al = vm end
				end
			end)
			if vm then table.insert(out, { root = vm, budget = 4000, view = true }) end
		end
		-- 3. the last resorts
		pcall(function()
			local cam = workspace.CurrentCamera
			if cam then table.insert(out, { root = cam, budget = 1200 }) end
		end)
		pcall(function()
			local pack = k:FindFirstChild("Backpack")
			if pack then table.insert(out, { root = pack, budget = 400 }) end
		end)
		return out
	end

	local function findModel(wanted, forSkin, exclude)
		if wanted == nil then return nil end
		local want = tostring(wanted)
		local wantNorm = norm(want)
		if wantNorm == "" then return nil end
		local best, bestScore = nil, 0
		for _, entry in ipairs(roots(forSkin)) do
			local ok, list = pcall(function() return entry.root:GetDescendants() end)
			if ok and type(list) == "table" then
				local n = 0
				for _, obj in ipairs(list) do
					n = n + 1
					if n > entry.budget then break end
					if exclude == nil or obj ~= exclude then
						local sc = score(obj, want, wantNorm)
						if sc > 0 then
							if entry.template then sc = sc + 6 end
							if entry.view and forSkin then sc = sc - 4 end
						end
						if sc > bestScore then best, bestScore = obj, sc end
					end
				end
			end
		end
		if bestScore < 40 then return nil end
		return best
	end

	local function isSoftWeapon(weapon)
		local name = tostring(weapon or "")
		if NEXUS_UNSAFE_REPLACE[name] then return true end
		local low = string.lower(name)
		if string.find(low, "bow", 1, true) then return true end
		if string.find(low, "crossbow", 1, true) then return true end
		return false
	end

	local function paintModel(weapon, weaponModel, skinModel)
		local ok = pcall(function()
			if isSoftWeapon(weapon) then
				nexusSoftSkin(weaponModel, skinModel)
			else
				-- hard swap first (full model), then a mesh-only pass: AUG and a
				-- few other rifle skins ship as a rig that a full replace refuses
				local swapped = pcall(bl, weaponModel, skinModel)
				if not swapped then
					nexusSoftSkin(weaponModel, skinModel)
				end
			end
			nexusFixPrimary(weaponModel)
			nexusHideBlockParts(weaponModel)
		end)
		-- the world copy (dropped weapon) uses the same skin
		pcall(function()
			local world = workspace:FindFirstChild(weapon)
			if world then
				if isSoftWeapon(weapon) then
					nexusSoftSkin(world, skinModel)
				else
					local pivot = world:GetPivot()
					bl(world, skinModel)
					pcall(function() world:PivotTo(pivot) end)
				end
				nexusFixPrimary(world)
				nexusHideBlockParts(world)
			end
		end)
		return ok
	end

	local core = bj
	local fails = {}
	local okCount = 0

	NexusSkinEngine = {
		Version = "6.0",
		LastError = "",
		Failures = fails,
		Find = function(name, forSkin) return findModel(name, forSkin) end,
		Apply = function(weapon, skin) return bj(weapon, skin, skin ~= nil) end,
		Applied = function() return okCount end,
		Status = function()
			local last = ""
			for weapon, why in pairs(fails) do last = tostring(weapon) .. ": " .. tostring(why) end
			return "engine 6.0 · " .. tostring(okCount) .. " applied" .. (last ~= "" and (" · last fail " .. last) or "")
		end,
	}

	pcall(function() getgenv().NexusSkinEngine = NexusSkinEngine end)

	local function rememberFail(weapon, why)
		fails[weapon] = why
		NexusSkinEngine.LastError = tostring(weapon) .. ": " .. tostring(why)
	end

	bj = function(it, gx, cy)
		if not it then return false end

		-- 1. the stock engine, untouched
		local ok, res = pcall(core, it, gx, cy)
		if ok and res then
			fails[it] = nil
			okCount = okCount + 1
			NexusSkinEngine.LastError = ""
			return true
		end

		-- 2. our pass: fuzzy model names + extra roots
		local weaponModel = findModel(it, false)
		if not weaponModel then
			rememberFail(it, "weapon model not loaded")
			return false
		end

		if cy and gx then
			local skinModel = findModel(gx, true, weaponModel)
			if not skinModel then
				rememberFail(it, "skin model not loaded")
				return false
			end
			if not paintModel(it, weaponModel, skinModel) then
				rememberFail(it, "model swap failed")
				return false
			end
			ai.ActiveSkins[it] = gx
			pcall(function() hy(it, gx) end)
			pcall(function() hz(it, gx) end)
			pcall(function() hw(it, gx) end)
			pcall(function() hx(it, gx) end)
			pcall(function() go() end)
			fails[it] = nil
			okCount = okCount + 1
			NexusSkinEngine.LastError = ""
			return true
		end

		-- reset to the default skin (the backup folder the engine keeps)
		pcall(function()
			local pivot = nil
			pcall(function() pivot = weaponModel:GetPivot() end)
			gb(weaponModel, it, pivot)
		end)
		ai.ActiveSkins[it] = nil
		pcall(function() hy(it, it) end)
		pcall(function() go() end)
		fails[it] = nil
		return ai.ActiveSkins[it] == nil
	end

	-- apply with patience: skins stream in ~0.5-2 s after joining a match
	function NexusSkinEngine.ApplyWait(weapon, skin, tries)
		if weapon == nil then return false end
		tries = tonumber(tries) or 5
		local function attempt(left)
			if bj(weapon, skin, skin ~= nil) then return true end
			if left <= 1 then return false end
			task.delay(0.7, function()
				pcall(attempt, left - 1)
			end)
			return false
