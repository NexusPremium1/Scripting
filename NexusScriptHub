-- v3.6 · NEXUS TEAM CORE
-- Rivals does not expose Teams-service teams in most modes, so the old
-- "myTeam == theirTeam" check was always false. The core resolves the team
-- from Roblox Team/TeamColor, player and character attributes, Team/Squad
-- value objects and a manual list, and is shared by every combat feature.
-- ═══════════════════════════════════════════════════════════════════════════
-- ══════════════════════════════════════════════════════════════════════════
-- NEXUS TEAM CORE · team resolver (Auto / Roblox / Friends / Manual)
-- Why: Player.Team is nil in most Rivals modes, so the old Team Check
-- (Team == Team comparison only) never matched anything and did nothing.
-- This core resolves a team key from six sources:
--   1) Teams service + Player.Team          4) character attributes
--   2) Teams service + Player.TeamColor     5) Team/Squad value objects
--   3) Player attributes                    6) manually marked players
-- When every source is empty the mode Friends or Manual still works.
-- ══════════════════════════════════════════════════════════════════════════
local NexusTeam = (function()
	local Players = game:GetService("Players")
	local Teams = game:GetService("Teams")
	local k = Players.LocalPlayer

	local T = {
		Mode = "Auto",          -- Auto | Roblox | Friends
		LastSource = "none",    -- diagnostics
		Manual = {},            -- [playerName] = true
	}

	local ATTR_KEYS = {
		"Team", "team", "TeamName", "teamName", "TeamId", "teamId", "TeamID",
		"TeamColor", "teamColor", "Squad", "squad", "Party", "party",
		"Side", "side", "Faction", "faction", "TeamIndex", "teamIndex",
	}
	local VALUE_HINTS = { "team", "squad", "party", "side", "faction" }

	local function safeGetAttribute(obj, key)
		if not obj then return nil end
		local ok, v = pcall(function() return obj:GetAttribute(key) end)
		if ok and v ~= nil and tostring(v) ~= "" then return tostring(v) end
		return nil
	end

	-- 3/4) attribute based team (Player and Character)
	local function attributeKey(plr)
		local sources = { plr, plr.Character }
		for _, obj in ipairs(sources) do
			if obj then
				for _, key in ipairs(ATTR_KEYS) do
					local v = safeGetAttribute(obj, key)
					if v then return "attr:" .. key .. "=" .. v end
				end
			end
		end
		return nil
	end

	-- 5) Team/Squad/Party value objects under Player or Character
	local function childValueKey(plr)
		local sources = { plr, plr.Character }
		for _, obj in ipairs(sources) do
			if obj then
				local ok, children = pcall(function() return obj:GetChildren() end)
				if ok then
					for _, child in ipairs(children) do
						if child:IsA("ValueBase") then
							local lower = string.lower(child.Name)
							for _, hint in ipairs(VALUE_HINTS) do
								if string.find(lower, hint, 1, true) then
									local okVal, value = pcall(function() return child.Value end)
									if okVal and value ~= nil and tostring(value) ~= "" then
										return "value:" .. child.Name .. "=" .. tostring(value)
									end
								end
							end
						end
					end
				end
			end
		end
		return nil
	end

	-- 1) Teams service: Player.Team
	local function robloxTeamKey(plr)
		local ok, team = pcall(function() return plr.Team end)
		if ok and team ~= nil then
			local name = "?"
			pcall(function() name = team.Name end)
			return "team:" .. tostring(name)
		end
		return nil
	end

	-- 2) only when the game really uses the Teams service
	local function teamColorKey(plr)
		local count = 0
		pcall(function() count = #Teams:GetTeams() end)
		if count <= 0 then return nil end
		local ok, color = pcall(function() return plr.TeamColor end)
		if ok and color ~= nil then
			local name = "?"
			pcall(function() name = color.Name end)
			return "color:" .. tostring(name)
		end
		return nil
	end

	function T.Key(plr)
		if not plr then return nil end
		if T.Mode == "Roblox" then
			local key = robloxTeamKey(plr) or teamColorKey(plr)
			T.LastSource = key and "Roblox Team" or "Roblox Team (empty)"
			return key
		end
		local key = robloxTeamKey(plr) or teamColorKey(plr) or attributeKey(plr) or childValueKey(plr)
		if key then
			if string.sub(key, 1, 5) == "team:" or string.sub(key, 1, 6) == "color:" then
				T.LastSource = "Roblox Team"
			elseif string.sub(key, 1, 5) == "attr:" then
				T.LastSource = "Player attribute"
			else
				T.LastSource = "Object value"
			end
		end
		return key
	end

	function T.SetMode(mode)
		T.Mode = (mode == "Roblox" or mode == "Friends") and mode or "Auto"
		return T.Mode
	end

	function T.AddManual(plr)
		if not plr then return false end
		local ok, name = pcall(function() return plr.Name end)
		if not ok or type(name) ~= "string" or name == "" then return false end
		T.Manual[name] = true
		return true
	end

	function T.RemoveManual(name)
		if name and T.Manual[name] then
			T.Manual[name] = nil
			return true
		end
		return false
	end

	function T.ClearManual()
		local n = 0
		for _ in pairs(T.Manual) do n = n + 1 end
		T.Manual = {}
		return n
	end

	function T.ManualCount()
		local n = 0
		for _ in pairs(T.Manual) do n = n + 1 end
		return n
	end

	function T.ManualNames()
		local list = {}
		for name in pairs(T.Manual) do list[#list + 1] = name end
		table.sort(list)
		return list
	end

	-- single comparison point used by aimbot, silent aim, triggerbot and ESP
	function T.IsTeammate(plr)
		if plr == nil or plr == k then return false end
		local okName, name = pcall(function() return plr.Name end)
		if okName and name and T.Manual[name] then return true end

		if T.Mode == "Friends" then
			local ok, isFriend = pcall(function() return plr:IsFriendsWith(k.UserId) end)
			if ok and isFriend then
				T.LastSource = "Friends list"
				return true
			end
			return false
		end

		local myKey = T.Key(k)
		local theirKey = T.Key(plr)
		if myKey and theirKey then return myKey == theirKey end
		return false
	end

	-- one line status string for the panel
	function T.Info()
		local mode = T.Mode
		local mates = T.ManualCount()
		if mode == "Friends" then
			return "Mode: Friends · friends are never targeted"
		end
		local myKey = T.Key(k)
		if not myKey then
			if mates > 0 then
				return "Mode: " .. mode .. " · no team data (FFA) · " .. mates .. " manual teammate(s)"
			end
			return "Mode: " .. mode .. " · no team data (FFA) · use Friends or mark teammates"
		end
		local count = 0
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= k and T.IsTeammate(plr) then count = count + 1 end
		end
		return "Mode: " .. mode .. " · " .. tostring(T.LastSource) .. " · you: " .. myKey:gsub("^[^=]*=", "") .. " · " .. count .. " teammate(s)"
	end

	function T.Source()
		return T.LastSource
	end

	pcall(function()
		if type(getgenv) == "function" then getgenv().NexusTeam = T end
		_G.NexusTeam = T
	end)

	return T
end)()




