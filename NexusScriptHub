nexusHarvestSkinSounds = function(it, gx, iu, hc)
	if not it or not gx or not iu or not hc then return end
	pcall(function()
		local function relPath(root, inst)
			local names = {}
			local cur = inst
			while cur and cur ~= root do
				table.insert(names, 1, cur.Name)
				cur = cur.Parent
			end
			return table.concat(names, "/")
		end
		local function leafName(path)
			return string.match(path, "([^/]+)$") or path
		end
		local function collect(root, className, prop)
			local map = {}
			if not root then return map end
			for _, d in ipairs(root:GetDescendants()) do
				if d.ClassName == className and d[prop] ~= "" then
					map[relPath(root, d)] = d[prop]
				end
			end
			return map
		end
		local function pairUp(baseMap, skinMap, apply)
			for path, skinId in pairs(skinMap) do
				local baseId = baseMap[path]
				if baseId and skinId and baseId ~= skinId then apply(baseId, skinId) end
			end
			local baseByName, skinByName = {}, {}
			for path, id in pairs(baseMap) do
				local n = leafName(path)
				if not baseByName[n] then baseByName[n] = id end
			end
			for path, id in pairs(skinMap) do
				local n = leafName(path)
				if not skinByName[n] then skinByName[n] = id end
			end
			for name, skinId in pairs(skinByName) do
				local baseId = baseByName[name]
				if baseId and skinId and baseId ~= skinId then apply(baseId, skinId) end
			end
		end
		local baseRoot = iu
		if q then
			local bo = q:FindFirstChild(it)
			if bo then baseRoot = bo end
		end
		pairUp(collect(baseRoot, "Sound", "SoundId"), collect(hc, "Sound", "SoundId"), function(baseId, skinId)
			if not ag[gx] then ag[gx] = {} end
			if ag[gx][baseId] == nil then ag[gx][baseId] = skinId end
		end)
		pairUp(collect(baseRoot, "Animation", "AnimationId"), collect(hc, "Animation", "AnimationId"), function(baseId, skinId)
			nexusHarvestedAnims[it .. "|" .. gx .. "|" .. baseId] = skinId
		end)
	end)
end

