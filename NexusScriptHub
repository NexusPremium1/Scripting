function Legit.getTarget()
	local camPos = Camera.CFrame.Position
	local center = Camera.ViewportSize * 0.5
	local bestPlr, bestDist = nil, Legit.fov

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= k and isPlayerAliveRaw(p) and (not teamCheckEnabled or not isTeammate(p)) and p.Character then
			local part = p.Character:FindFirstChild(Legit.part) or p.Character:FindFirstChild("Head")
			if part then
				local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
				if onScreen and screenPos.Z > 0 then
					local distPx = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
					if distPx <= bestDist then
						local isVis = true
						if Legit.visOnly then
							local params = RaycastParams.new()
							params.FilterType = Enum.RaycastFilterType.Exclude
							params.FilterDescendantsInstances = {k.Character, Camera}
							local ray = workspace:Raycast(camPos, (part.Position - camPos), params)
							if ray and ray.Instance and not ray.Instance:IsDescendantOf(p.Character) then
								isVis = false
							end
						end
						if isVis then
							bestDist = distPx
							bestPlr = p
						end
					end
				end
			end
		end
	end
	return bestPlr
end

