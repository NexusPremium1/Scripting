local DropTags = {}
local LastPickupAt = 0
local LastKnifeWarnAt = 0
local KnifeWarnCount = 0
local HUDGui, HUDLabel

local function FindDroppedItems()
	local out, seen = {}, {}
	local function scan(container)
		if not container then
			return
		end
		for _, obj in ipairs(container:GetChildren()) do
			if obj:IsA("Tool") and not seen[obj] then
				local role = ToolRole(obj)
				if role then
					seen[obj] = true
					out[#out + 1] = {Tool = obj, Role = role}
				end
			end
		end
	end
	scan(workspace)
	scan(workspace:FindFirstChild("Items"))
	return out
end

local function DropHandle(tool)
	return tool and (tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart", true))
end

local function ClearDropTags()
	for tool, gui in pairs(DropTags) do
		pcall(function() gui:Destroy() end)
		DropTags[tool] = nil
	end
end

local function UpdateDropESP()
	if not State.ItemDropESP then
		if next(DropTags) ~= nil then
			ClearDropTags()
		end
		return
	end
	local seen = {}
	for _, entry in ipairs(FindDroppedItems()) do
		local handle = DropHandle(entry.Tool)
		if handle then
			seen[entry.Tool] = true
			local gui = DropTags[entry.Tool]
			if not gui or not gui.Parent then
				gui = Instance.new("BillboardGui")
				gui.Name = "NexusDropTag"
				gui.AlwaysOnTop = true
				gui.Size = UDim2.fromOffset(170, 34)
				gui.StudsOffset = Vector3.new(0, 2.4, 0)
				local label = Instance.new("TextLabel", gui)
				label.Name = "Label"
				label.Size = UDim2.fromScale(1, 1)
				label.BackgroundTransparency = 1
				label.Font = Enum.Font.GothamBold
				label.TextSize = 13
				label.TextStrokeTransparency = 0.3
				gui.Adornee = handle
				gui.Parent = handle
				DropTags[entry.Tool] = gui
			end
			local label = gui:FindFirstChild("Label")
			if label then
				local isKnife = entry.Role == "Murderer"
				label.TextColor3 = isKnife and Color3.fromRGB(255, 90, 110) or Color3.fromRGB(90, 190, 255)
				local dist = ""
				if RootPart then
					dist = "  \u{2022}  " .. tostring(math.floor((handle.Position - RootPart.Position).Magnitude)) .. "m"
				end
				label.Text = (isKnife and "KNIFE DROP" or "GUN DROP") .. dist
			end
		end
	end
	for tool, gui in pairs(DropTags) do
		if not seen[tool] or not tool.Parent then
			pcall(function() gui:Destroy() end)
			DropTags[tool] = nil
		end
	end
end

local function UpdateAutoPickup()
	if not State.AutoPickupDrops then
		return
	end
	if not RootPart or not Humanoid or Humanoid.Health <= 0 then
		return
	end
	if os.clock() - LastPickupAt < 0.4 then
		return
	end
	local bestHandle, bestDist = nil, math.huge
	for _, entry in ipairs(FindDroppedItems()) do
		local handle = DropHandle(entry.Tool)
		if handle then
			local d = (handle.Position - RootPart.Position).Magnitude
			if d < bestDist then
				bestDist, bestHandle = d, handle
			end
		end
	end
	if not bestHandle then
		return
	end
	if bestDist <= (tonumber(State.PickupRange) or 120) then
		LastPickupAt = os.clock()
		pcall(function() Humanoid:MoveTo(bestHandle.Position) end)
	end
end

local function UpdateKnifeWarning()
	if not State.KnifeWarn then
		return
	end
	local now = os.clock()
	if now - LastKnifeWarnAt < 1.5 then
		return
	end
	if not RootPart then
		return
	end
	for _, obj in ipairs(workspace:GetChildren()) do
		local name = string.lower(tostring(obj.Name))
		if string.find(name, "knife", 1, true) or string.find(name, "dagger", 1, true) then
			local isTool = obj:IsA("Tool")
			local part = obj:IsA("BasePart") and obj or (isTool and DropHandle(obj)) or nil
			if part and part.Position then
				local speed = 0
				pcall(function() speed = part.AssemblyLinearVelocity.Magnitude end)
				local dist = (part.Position - RootPart.Position).Magnitude
				if speed > 25 and dist <= (tonumber(State.KnifeWarnRange) or 90) then
					LastKnifeWarnAt = now
					KnifeWarnCount = KnifeWarnCount + 1
					Notify("KNIFE INCOMING · " .. tostring(math.floor(dist)) .. "m", 2)
					return
				end
			end
		end
	end
end

