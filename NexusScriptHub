			rt.FlyLV = nil
		end
		if rt.FlyAO then
			pcall(function() rt.FlyAO:Destroy() end)
			rt.FlyAO = nil
		end
		if humanoid then
			pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		end
		Apex.Toast("Fly disabled", C.Cyan)
		return
	end
	if not (root and humanoid) then
		Apex.Toast("Character not ready", C.Red)
		return
	end
	rt.FlySpeed = rt.FlySpeed or 70
	local attachment = root:FindFirstChild("RootAttachment")
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "ApexFlyAttachment"
		attachment.Parent = root
	end
	local ok = pcall(function()
		rt.FlyLV = Instance.new("LinearVelocity")
		rt.FlyLV.Attachment0 = attachment
		rt.FlyLV.RelativeTo = Enum.ActuatorRelativeTo.World
		rt.FlyLV.MaxForce = math.huge
		rt.FlyLV.Parent = root
		rt.FlyAO = Instance.new("AlignOrientation")
		rt.FlyAO.Attachment0 = attachment
		rt.FlyAO.Mode = Enum.OrientationAlignmentMode.OneAttachment
		rt.FlyAO.MaxTorque = math.huge
		rt.FlyAO.Responsiveness = 60
		rt.FlyAO.Parent = root
	end)
	if not ok then
		Apex.Toast("Fly is not supported here", C.Red)
		return
	end
	rt.FlyOn = true
	pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Physics) end)
	if rt.FlyConn then pcall(function() rt.FlyConn:Disconnect() end) end
	rt.FlyConn = RunService.RenderStepped:Connect(function()
		if not rt.FlyOn then return end
		local current = LocalPlayer.Character
		local hum = current and current:FindFirstChildOfClass("Humanoid")
		local cam = workspace.CurrentCamera
		if not hum or not cam or not (rt.FlyLV and rt.FlyLV.Parent) then return end
		local move = hum.MoveDirection
		local horizontal = cam.CFrame.LookVector * (-move.Z) + cam.CFrame.RightVector * move.X
