	--    yutuluyordu -> artik yalnizca GERCEK yazma odagi varken atlaniyor.
	--  * Iki dinleyici (kutuphane + modul) cakisip paneli aninda geri
	--    aciyordu -> kutuphanenin kendi ToggleKey'i kapatiliyor.
	--  * Keybind widget'i degisince eski tus dinlenmeye devam ediyordu.
	local currentToggleKey = Enum.KeyCode.RightShift

	local function isTypingInTextBox()
		local ok, focused = pcall(function()
			return UserInputService:GetFocusedTextBox()
		end)
		return ok and focused ~= nil
	end

	local function togglePanel()
		if not Window then return end
		-- Window.Closed dogru kaynak: kutuphane Close/Open'da bunu set ediyor
		local closed = Window.Closed
		if closed then
			if Window.Open then Window:Open() end
		else
			if Window.Close then Window:Close() end
		end
		-- emniyet: iki dinleyici ust uste binerse durumu duzelt
		task.defer(function()
			if Window and Window.Closed == closed then
				if Window.Toggle then pcall(Window.Toggle, Window) end
			end
		end)
	end

	-- kutuphanenin kendi RightShift dinleyicisini devre disi birak (cift toggle olmasin)
	pcall(function()
		if Window and Window.SetToggleKey then
			Window:SetToggleKey(nil)
		end
	end)

	trackConn(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if S.Unloaded then return end
		if input.KeyCode ~= currentToggleKey then return end
		-- gameProcessed yalnizca gercek bir TextBox yaziyorsa onemli;
		-- CoreScript'in tukettigi tuslar paneli kilitlememeli.
		if isTypingInTextBox() then return end
		togglePanel()
	end))

	T:Keybind({
		Title = "Toggle GUI Keybind",
		Value = "RightShift",
		Callback = function(key)
			pcall(function()
				-- Keybind widget'i bazen KeyCode, bazen "RightShift" gibi string verir
				local kc = key
				if type(kc) == "string" then
					kc = Enum.KeyCode[kc:gsub("%s", "")]
				end
				if typeof(kc) == "EnumItem" and kc.EnumType == Enum.KeyCode then
					currentToggleKey = kc
				end
			end)
		end,
	})
	T:Button({
		Title = "Unload Nexus Blox Fruits Completely",
		Callback = function()
			UnloadAll()
		end,
	})
end

