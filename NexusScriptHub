ApexBind(UserInputService.InputBegan, function(input, processed)
	if processed then return end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if UserInputService:GetFocusedTextBox() then return end
	local key = input.KeyCode and input.KeyCode.Name or ""
	if not root.Visible and key ~= CONFIG.toggleKey then return end

	if key == CONFIG.toggleKey then
		setOpen(not root.Visible)
	elseif key == CONFIG.randomKey then
		if EMOTE_COUNT > 0 then
			local i = math.random(1, EMOTE_COUNT)
			Engine.play(IDS[i], NAMES[i])
		end
	elseif key == CONFIG.stopKey then
		Engine.stop()
		activeId, activeName = nil, nil
		refreshNowPlaying()
	end
end)

