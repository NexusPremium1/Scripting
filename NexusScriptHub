	-- Quick Hide / Auto-Hide Helper (safely hides in nearest free closet)
	local function TriggerQuickHide(autoReleaseEntity)
		if S.AutoHideBusy then return end
		local char = GetChar()
		local hrp = GetHRP()
		if not char or not hrp then return end

		-- If already hiding and user tapped Quick Hide manually, exit cleanly
		if not autoReleaseEntity and char:GetAttribute("Hiding") then
			if RemotesFolder and RemotesFolder:FindFirstChild("CamLock") then
				pcall(function() RemotesFolder.CamLock:FireServer() end)
			end
			char:SetAttribute("Hiding", false)
			return
		end

		local closet = GetNearestHidingSpot(85)
		if not closet then
			Notify("No nearby free hiding spot found!", 2.5)
			return
		end
		local prompt = closet:FindFirstChild("HidePrompt")
			or closet:FindFirstChildWhichIsA("ProximityPrompt", true)
		local pos = GetObjPos(closet)
		if not prompt or not pos then return end

		S.AutoHideBusy = true
		task.spawn(function()
			local oldCF = hrp.CFrame
			local dist = (hrp.Position - pos).Magnitude
			if dist > (prompt.MaxActivationDistance - 1) then
				pcall(function() hrp.CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)) end)
				task.wait(0.08)
			end
			FirePromptSafe(prompt)
			Notify("Hiding in " .. (Catalog.HidingPlaces[closet.Name] or "Closet") .. "!", 2)

			if autoReleaseEntity then
				local t0 = os.clock()
				while not S.Unloaded and autoReleaseEntity.Parent and (os.clock() - t0) < 16 do
					task.wait(0.25)
				end
				task.wait(0.35)
				local c2 = GetChar()
				if c2 and c2:GetAttribute("Hiding") then
					if RemotesFolder and RemotesFolder:FindFirstChild("CamLock") then
						pcall(function() RemotesFolder.CamLock:FireServer() end)
					end
					pcall(function() c2:SetAttribute("Hiding", false) end)
				end
				if dist > 20 and hrp and hrp.Parent then
					pcall(function() hrp.CFrame = oldCF end)
				end
			end
			S.AutoHideBusy = false
		end)
	end

