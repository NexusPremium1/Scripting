		task.spawn(function()
			local char = player.Character
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			local animtr = humanoid and humanoid:FindFirstChildOfClass("Animator")
			if not animtr then return end

			while isJorking and char and humanoid and humanoid.Health > 0 do
				local r15 = isR15(player)
				if not jerkTrack then
					local anim = Instance.new("Animation")
					anim.AnimationId = not r15 and "rbxassetid://72042024" or "rbxassetid://698251653"
