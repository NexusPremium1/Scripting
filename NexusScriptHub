	local function isOurs(obj)
		local node = obj
		for _ = 1, 10 do
			if node == nil then return false end
			local ok, name = pcall(function() return node.Name end)
			if ok and type(name) == "string" then
				local ln = string.lower(name)
				if ln:find("nexus", 1, true) or ln:find("apex", 1, true) or ln:find("linoria", 1, true) then
					return true
				end
			end
			local ok2, parent = pcall(function() return node.Parent end)
			if not ok2 then return false end
			node = parent
		end
		return false
	end

	local function classifyHud(obj)
		if obj == nil or Detect.known[obj] or isOurs(obj) then return end
		local ok, name = pcall(function() return obj.Name end)
		if not ok or not name then return end
		local lowName = low(name)
		if lowName:find("hitmarker", 1, true) or lowName:find("hit_marker", 1, true) or lowName:find("hitconfirm", 1, true) then
			Detect.known[obj] = true
			watchHitmarkerGui(obj)
			return
		end
		local isText = false
		pcall(function() isText = obj:IsA("TextLabel") end)
		if isText then
			watchKillText(obj)
		end
	end

	-- CHANNEL 6: Strict Per-Stat Kill Counter
	local watchedStats = {}
	local statLast, statNames, watchedList = {}, {}, {}
	local attrLast = {}

	local function statNumber(value)
		return tonumber(value)
	end

	local function isStrictKillStat(name)
		local ln = low(name)
		if ln == "" then return false end
		if ln:find("score", 1, true) or ln:find("xp", 1, true) or ln:find("damage", 1, true)
			or ln:find("dmg", 1, true) or ln:find("death", 1, true) or ln:find("assist", 1, true)
			or ln:find("streak", 1, true) or ln:find("win", 1, true) or ln:find("level", 1, true)
			or ln:find("sound", 1, true) or ln:find("skin", 1, true) or ln:find("finish", 1, true) then
			return false
		end
		return ln == "kills" or ln == "kill" or ln == "eliminations" or ln == "elims" or ln == "elim" or ln == "frags" or ln == "ko" or ln == "kos"
	end

	local function checkStat(obj, name)
		local ok, value = pcall(function() return obj.Value end)
		if not ok then return end
		local nowVal = statNumber(value)
		if not nowVal then return end
		local was = statLast[obj]
		statLast[obj] = nowVal
		if was ~= nil and nowVal > was and (nowVal - was) <= 2 then
			if (not inLobbyNow()) or Pack.AttackFresh(6.0) then
				Detect.statKills = (Detect.statKills or 0) + 1
				fireKill("stat " .. tostring(name), nil, false)
			end
		end
	end

	local function watchStat(obj, name)
		if watchedStats[obj] or not isStrictKillStat(name) then return end
		watchedStats[obj] = true
		statNames[obj] = name
		table.insert(watchedList, obj)
		statLast[obj] = statNumber(obj.Value)
		pcall(function()
			table.insert(Pack.Conns, obj:GetPropertyChangedSignal("Value"):Connect(function()
				pcall(checkStat, obj, name)
			end))
		end)
	end

	local function pollStats()
		for _, obj in ipairs(watchedList) do
			pcall(checkStat, obj, statNames[obj])
		end
	end
	Pack.PollStats = pollStats

	local function scanMyStats()
		pcall(function()
			for _, child in ipairs(k:GetChildren()) do
				if child:IsA("ValueBase") and isStrictKillStat(child.Name) then
					watchStat(child, child.Name)
				elseif child.Name == "leaderstats" or child.Name == "CustomLeaderstats" or child.Name == "Stats" then
					for _, sub in ipairs(child:GetChildren()) do
						if sub:IsA("ValueBase") then watchStat(sub, sub.Name) end
					end
				end
			end
		end)
	end
	scanMyStats()

	pcall(function()
		for kAttr, vAttr in pairs(k:GetAttributes()) do
			if isStrictKillStat(kAttr) then attrLast[kAttr] = statNumber(vAttr) end
		end
		table.insert(Pack.Conns, k.AttributeChanged:Connect(function(attr)
			if not isStrictKillStat(attr) then return end
			local v = statNumber(k:GetAttribute(attr))
			if not v then return end
			local was = attrLast[attr]
			attrLast[attr] = v
			if was ~= nil and v > was and (v - was) <= 2 then
				if (not inLobbyNow()) or Pack.AttackFresh(6.0) then
					Detect.statKills = (Detect.statKills or 0) + 1
					fireKill("attr " .. tostring(attr), nil, false)
				end
			end
		end))
	end)

	function Pack.ScanNow(force)
		if not Pack.AutoDetect and not force then return end
		local now = tick()
		if not force and now - Detect.lastScan < 5 then return end
		Detect.lastScan = now
		Detect.scans = Detect.scans + 1
		pcall(scanMyStats)
		local pg = k:FindFirstChild("PlayerGui")
		if pg then
			pcall(function()
				local list = pg:GetDescendants()
				local n = 0
				for _, obj in ipairs(list) do
					n = n + 1
					if n > (force and 2800 or 1000) then break end
					pcall(classifyHud, obj)
				end
			end)
		end
	end

	local function pollGuiHits()
		for obj, st in pairs(Detect.gui) do
			if not obj or not obj.Parent then
				Detect.gui[obj] = nil
			else
				local ok, vis, tr = pcall(function()
					local v = obj.Visible == true
					local t = nil
					pcall(function() t = tonumber(obj.ImageTransparency) end)
					return v, t
				end)
				if ok then
					local shown = false
					if vis == true and st.vis ~= true then shown = true end
					if tr ~= nil and st.tr ~= nil and tr < 0.4 and st.tr >= 0.4 then shown = true end
					if shown then
						Detect.hitGui = Detect.hitGui + 1
						fireHit("hitmarker", true)
					end
					st.vis = vis
					if tr ~= nil then st.tr = tr end
				end
			end
		end
	end

