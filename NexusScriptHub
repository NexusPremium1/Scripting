Eng.Travel = {}

function Eng.Travel.EnsurePlatform()
	if S.Platform and S.Platform.Parent then return S.Platform end
	local p = Instance.new("Part")
	p.Name = "NexusBF_Platform"
	p.Anchored = true
	p.CanCollide = true
	p.Transparency = 0.85
	p.Material = Enum.Material.SmoothPlastic
	p.Color = Color3.fromRGB(0, 220, 255)
	p.Size = Vector3.new(10, 1, 10)
	p.Parent = Workspace
	S.Platform = p
	return p
end

function Eng.Travel.DestroyPlatform()
	if S.Platform then
		pcall(function() S.Platform:Destroy() end)
		S.Platform = nil
	end
end

function Eng.Travel.CancelTween()
	S.TweenId = S.TweenId + 1
	S.TweenBusy = false
	S.TravelActive = false
end

function Eng.Travel.RecordSafeSpot()
	if S.HoldCF or S.TravelActive then return end
	local root, hum = getRoot(), getHum()
	if not root or not hum or hum.Health <= 0 then return end
	local pos = root.Position
	S.LastPos = pos
	if pos.Y < getVoidFloor(pos) then return end
	local grounded = false
	pcall(function() grounded = hum.FloorMaterial ~= Enum.Material.Air end)
	if not grounded then return end
	S.LastGoodCF = root.CFrame
	S.LastGoodY = pos.Y
	if not S.LowestGroundY or pos.Y < S.LowestGroundY then
		S.LowestGroundY = pos.Y
	end
end

function Eng.Travel.RescuePoint()
	if S.LastGoodCF then return S.LastGoodCF end
	if S.LastPos and S.LastPos.Y > getVoidFloor(S.LastPos) then
		return CFrame.new(S.LastPos + Vector3.new(0, 6, 0))
	end
	local sp = Workspace:FindFirstChildOfClass("SpawnLocation")
	if sp then return CFrame.new(sp.Position + Vector3.new(0, 8, 0)) end
	return CFrame.new(0, 120, 0)
end

function Eng.Travel.RescueFromVoid(reason)
	if os.clock() - (S.LastRescueAt or 0) < 1.5 then return false end
	local root = getRoot()
	local target = Eng.Travel.RescuePoint()
	if not root or not target then return false end
	S.LastRescueAt = os.clock()
	S.VoidRescues = (S.VoidRescues or 0) + 1
	S.HoldCF = nil
	Eng.Travel.CancelTween()
	pcall(function()
		root.CFrame = target + Vector3.new(0, 4, 0)
		zeroVel(root)
		local h = getHum()
		if h then h.PlatformStand = false end
	end)
	notify("Anti-Void", "Rescued from void (" .. tostring(reason or "under map") .. ")", 2.5)
	return true
end

function Eng.Travel.ArriveAt(pos, holdSec)
	local root = getRoot()
	if not root or not isVector3(pos) then return false end
	local hum = getHum()
	if hum then
		pcall(function() hum.Sit = false end)
		pcall(function() hum.PlatformStand = false end)
	end
	S.TravelTarget = pos
	S.TravelFloorY = pos.Y
	S.TravelFloorUntil = os.clock() + 120
	S.HoldCF = CFrame.new(pos)
	S.HoldUntil = os.clock() + (holdSec or S.ArriveHold or 1.0)
	root.CFrame = CFrame.new(pos)
	zeroVel(root)
	trackThread(function()
		for _ = 1, 2 do
			task.wait(0.06)
			if S.Unloaded then return end
			local r = getRoot()
			if not r then return end
			r.CFrame = CFrame.new(pos)
			zeroVel(r)
		end
	end)
	return true
end

function Eng.Travel.InstantTeleport(pos)
	local root = getRoot()
	local safePos, why = sanitizeDest(pos)
	if not root then return false end
	if not safePos then
		if os.clock() - S.LastBlockedAt > 2 then
			S.LastBlockedAt = os.clock()
			notify("Travel Guard", "Blocked unsafe teleport: " .. tostring(why), 2.5)
		end
		return false
	end
	Eng.Travel.CancelTween()
	return Eng.Travel.ArriveAt(safePos)
end

function Eng.Travel.RequestPortal(portalPos)
	if not isVector3(portalPos) then return false end
	local ok = Net.Comm("requestEntrance", portalPos)
	if ok then
		task.wait(0.35)
	end
	return ok
end

function Eng.Travel.TweenTo(targetPos, speed, portalPos)
	local safeTarget, why = sanitizeDest(targetPos)
	if not safeTarget then
		if os.clock() - S.LastBlockedAt > 2 then
			S.LastBlockedAt = os.clock()
			notify("Travel Guard", "Travel cancelled: " .. tostring(why), 2.5)
		end
		return false
	end
	targetPos = safeTarget
	local root = getRoot()
	if not root then return false end

	-- Smart Portal Jump if target has an official entrance portal & we are far away (> 2800 studs)
	if portalPos and isVector3(portalPos) and (root.Position - targetPos).Magnitude > 2800 then
		if (portalPos - targetPos).Magnitude < (root.Position - targetPos).Magnitude then
			Eng.Travel.RequestPortal(portalPos)
			root = getRoot()
			if not root then return false end
		end
	end

	if S.TPMethod == "Instant" then
		return Eng.Travel.InstantTeleport(targetPos)
	end

	local hum = getHum()
	if hum and hum.Sit then
		pcall(function() hum.Sit = false end)
		task.wait(0.08)
	end

	S.TweenId = S.TweenId + 1
	local myId = S.TweenId
	S.TweenBusy = true
	S.TravelActive = true
	S.TravelTarget = targetPos
	speed = tonumber(speed) or S.TweenSpeed or 240

	while not S.Unloaded and S.TweenId == myId do
		root = getRoot()
		if not root then break end
		local pos = root.Position
		local diff = targetPos - pos
		local dist = diff.Magnitude
		if dist < 5 then break end
		local dt = RunService.Heartbeat:Wait()
		local dir = diff.Unit
		local step = math.min(dist, speed * dt)
		local newPos = pos + dir * step
		if isAntiVoidActive() and not isInSubmergedZone(targetPos) and newPos.Y < getVoidFloor(newPos) then
			Eng.Travel.RescueFromVoid("fell during tween")
			break
		end
		root.CFrame = CFrame.new(newPos, newPos + dir)
		zeroVel(root)
	end

	if S.TweenId == myId then
		S.TweenBusy = false
		S.TravelActive = false
		Eng.Travel.ArriveAt(targetPos)
		return true
	end
	return false
end

