-- Master Apex Auto-Config Integration (preserved & cleanly wrapped)
local function InitApexAutoConfig(settingsTab)
	local sm = SaveManager
	local lib = Library
	if not lib or not sm or sm.__ApexAutoConfigV1 then return end
	if type(writefile) ~= "function" or type(isfile) ~= "function" then return end
	sm.__ApexAutoConfigV1 = true

	local cfgName = "autosave"
	local function cfgPath()
		return tostring(sm.Folder) .. "/settings/" .. cfgName .. ".json"
	end
	local function cfgSave()
		return pcall(function() sm:Save(cfgName) end)
	end
	local function cfgLoad()
		return pcall(function() sm:Load(cfgName) end)
	end
	local function cfgDelete()
		return pcall(function() sm:Delete(cfgName) end)
	end
	local function valText(v)
		local vt = typeof(v)
		if vt == "Color3" then
			local ok, h = pcall(v.ToHex, v)
			if ok then return h end
		elseif vt == "table" then
			local out = {}
			for k, x in pairs(v) do
				out[#out + 1] = (x == true) and tostring(k) or (tostring(k) .. "=" .. tostring(x))
			end
			table.sort(out)
			return "{" .. table.concat(out, ",") .. "}"
		end
		return tostring(v)
	end
	local function fingerprint()
		local out = {}
		local function scan(prefix, bag)
			if type(bag) ~= "table" then return end
			local keys = {}
			for k in pairs(bag) do keys[#keys + 1] = tostring(k) end
			table.sort(keys)
			for _, k in ipairs(keys) do
				if not (sm.Ignore and sm.Ignore[k]) then
					local o = bag[k]
					if type(o) == "table" and o.Value ~= nil then
						out[#out + 1] = prefix .. ":" .. k .. "=" .. valText(o.Value)
					end
				end
			end
		end
		scan("T", lib.Toggles)
		scan("O", lib.Options)
		return table.concat(out, ";")
	end

	task.spawn(function()
		task.wait(0.4)
		if S.Unloaded then return end
		pcall(function() sm:CheckFolderTree() end)
		local exists = false
		pcall(function() exists = isfile(cfgPath()) end)
		if exists then cfgLoad() else cfgSave() end
		pcall(function() sm:SaveAutoloadConfig(cfgName) end)
		pcall(function()
			if sm.AutoloadConfigLabel then
				sm.AutoloadConfigLabel:SetText("Current autoload config: " .. cfgName)
			end
		end)

		local group
		pcall(function()
			if settingsTab then group = settingsTab:AddRightGroupbox("Apex Auto-Config") end
		end)
		if group then
			pcall(function() group:AddLabel("Auto-Config: ACTIVE", true) end)
			pcall(function() group:AddLabel("Path: " .. cfgPath(), true) end)
			pcall(function()
				group:AddButton({
					Text = "Save Config Now",
					Func = function() if cfgSave() then Notify("Apex config saved!", 2) end end,
				})
			end)
			pcall(function()
				group:AddButton({
					Text = "Load Autosave",
					Func = function() if cfgLoad() then Notify("Apex config loaded!", 2) end end,
				})
			end)
			pcall(function()
				group:AddButton({
					Text = "Reset Autosave",
					DoubleClick = true,
					Func = function() if cfgDelete() then Notify("Apex autosave deleted!", 2) end end,
				})
			end)
		end

		local alive = true
		pcall(function()
			lib:OnUnload(function()
				alive = false
				cfgSave()
			end)
		end)
		task.wait(1)
		local lastFP = fingerprint()
		while alive and not S.Unloaded and not lib.Unloaded do
			task.wait(2.5)
			if S.Unloaded or lib.Unloaded then break end
			local fp = fingerprint()
			if fp ~= lastFP then
				lastFP = fp
				cfgSave()
			end
		end
	end)
end

