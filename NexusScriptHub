function Library:MakeDraggable(Instance, Cutoff, IsMainWindow)
    Instance.Active = true

    if Library.IsMobile == false then
        -- ═══ v5.25 · drag fix ═══════════════════════════════════════════════
        -- 1) InputBegan bubbles up from every child, so a click on a tab or a
        --    button inside the top strip started the drag loop.
        -- 2) the loop wrote UDim2.new(0, ...) which throws the anchor's scale
        --    away, so the window jumped somewhere else on the very first click.
        -- 3) Mouse.X / Mouse.Y are offset by the top bar inset while
        --    AbsolutePosition is not: another 36 px of drift.
        -- Now a click that does not move can never move the window: 4 px of
        -- real movement are required, the delta comes from the input itself and
        -- the scale half of the position survives.
        local dragOn, dragStart, dragPos = false, nil, nil
        local function GUI_INSET_Y()
            local ok, topLeft = pcall(function()
                return game:GetService("GuiService"):GetGuiInset()
            end)
            if ok and topLeft and tonumber(topLeft.Y) and topLeft.Y > 0 then
                return topLeft.Y
            end
            -- v5.26 · some executors refuse GuiService; 36 is the usual inset
            -- and the strip test tolerates it either way
            return 36
        end
        Instance.InputBegan:Connect(function(Input)
            if Input.UserInputType ~= Enum.UserInputType.MouseButton1
                and Input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            if IsMainWindow == true and Library.CantDragForced == true then
                return
            end
            -- v5.26 · Input.Position and AbsolutePosition do not always live in the
            -- same space (executors add the top bar inset to only one of them), so a
            -- real click on the title bar could land at y = -36 and be thrown away.
            -- Accept the strip under both conventions instead of guessing.
            local cut = Cutoff or 40
            local raw = Input.Position.Y - Instance.AbsolutePosition.Y
            local inset = GUI_INSET_Y()
            local inStrip = (raw >= -6 and raw <= cut + 4)
                or (raw - inset >= -6 and raw - inset <= cut + 4)
                or (raw + inset >= -6 and raw + inset <= cut + 4)
                or (raw >= -6 and inset > 0 and raw <= cut + inset + 4)
            if not inStrip then
                return
            end
            dragOn, dragStart, dragPos = true, Input.Position, Instance.Position
        end)
        InputService.InputChanged:Connect(function(Input)
            if not dragOn or not dragStart or not dragPos then
                return
            end
            if Input.UserInputType ~= Enum.UserInputType.MouseMovement
                and Input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local move = Input.Position - dragStart
            if math.abs(move.X) < 4 and math.abs(move.Y) < 4 then
                return
            end
            Instance.Position = UDim2.new(
                dragPos.X.Scale, dragPos.X.Offset + move.X,
                dragPos.Y.Scale, dragPos.Y.Offset + move.Y
            )
        end)
        InputService.InputEnded:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1
                or Input.UserInputType == Enum.UserInputType.Touch then
                dragOn, dragStart, dragPos = false, nil, nil
                -- v5.26 · a grabber that never saw its release used to leave this flag
                -- up, and the window could not be dragged again for the whole session
                if Library.CantDragForced then Library.CantDragForced = false end
            end
        end)
    else
        local Dragging, DraggingInput, DraggingStart, StartPosition

        InputService.TouchStarted:Connect(function(Input)
            if IsMainWindow == true and Library.CantDragForced == true then
                Dragging = false
                return
            end

            if not Dragging and Library:MouseIsOverFrame(Instance, Input) and (IsMainWindow == true and (Library.CanDrag == true and Library.Window.Holder.Visible == true) or true) then
                DraggingInput = Input
                DraggingStart = Input.Position
                StartPosition = Instance.Position

                local OffsetPos = Input.Position - DraggingStart
                if OffsetPos.Y > (Cutoff or 40) then
                    Dragging = false
                    return
                end

                Dragging = true
            end
        end)
        InputService.TouchMoved:Connect(function(Input)
            if IsMainWindow == true and Library.CantDragForced == true then
                Dragging = false
                return
            end

            if Input == DraggingInput and Dragging and (IsMainWindow == true and (Library.CanDrag == true and Library.Window.Holder.Visible == true) or true) then
                local OffsetPos = Input.Position - DraggingStart

                Instance.Position = UDim2.new(
                    StartPosition.X.Scale,
                    StartPosition.X.Offset + OffsetPos.X,
                    StartPosition.Y.Scale,
                    StartPosition.Y.Offset + OffsetPos.Y
                )
            end
        end)
        InputService.TouchEnded:Connect(function(Input)
            if Input == DraggingInput then 
                Dragging = false
            end
        end)
    end
end

