local function unexecuteScript()
	if __nexusRivalsUnloaded then return end
	__nexusRivalsUnloaded = true
	pcall(function()
		for i = #__nexusRivalsExtraConns, 1, -1 do
			local c = __nexusRivalsExtraConns[i]
			__nexusRivalsExtraConns[i] = nil
			pcall(function() c:Disconnect() end)
		end
		local g = (typeof(getgenv) == "function" and getgenv()) or _G
		g.NexusSkinChangerLoaded = nil
		if g.NexusRivalsUnload == unexecuteScript then g.NexusRivalsUnload = nil end
		if g.NexusUnload == unexecuteScript then g.NexusUnload = nil end
	end)
	pcall(function()
		pcall(function()
			getgenv().NexusDanceWatch = nil
			getgenv().NexusArsenalStarted = nil
			local ar = getgenv().NexusArsenal
			if type(ar) == "table" and type(ar.Stop) == "function" then ar.Stop() end
			getgenv().NexusBHStarted = nil
			local bh = getgenv().NexusBrookhaven
			if type(bh) == "table" and type(bh.Destroy) == "function" then bh.Destroy() end
			local fx = getgenv().NexusFX
			if type(fx) == "table" and type(fx.Destroy) == "function" then fx.Destroy() end
			if playDance then playDance("OFF") end
		end)
		pcall(function()
			local d = getgenv and getgenv().NexusDodge
			if type(d) == "table" and type(d.Stop) == "function" then d.Stop() end
		end)
		pcall(function()
			local om = getgenv and getgenv().NexusRivalsOmega
			if type(om) == "table" and type(om.Destroy) == "function" then om.Destroy() end
		end)
		FlyStop(true)
