	local function ToggleFly()
		QuickHacks.Fly = not QuickHacks.Fly
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not QuickHacks.Fly then
			if QuickHacks.FlyConn then QuickHacks.FlyConn:Disconnect() QuickHacks.FlyConn = nil end
			if hrp then
				local bv = hrp:FindFirstChild("ApexFlyBV")
				local bg = hrp:FindFirstChild("ApexFlyBG")
				if bv then bv:Destroy() end
				if bg then bg:Destroy() end
			end
			if hum then hum.PlatformStand = false end
			Apex.Toast("Fly disabled", getTheme().Muted)
			return false
		end
		if not hrp or not hum then return false end
		hum.PlatformStand = true
		local bv = Instance.new("BodyVelocity")
		bv.Name = "ApexFlyBV"
		bv.Velocity = Vector3.zero
		bv.MaxForce = Vector3.new(9e8, 9e8, 9e8)
		bv.Parent = hrp

		local bg = Instance.new("BodyGyro")
		bg.Name = "ApexFlyBG"
		bg.CFrame = hrp.CFrame
		bg.MaxTorque = Vector3.new(9e8, 9e8, 9e8)
		bg.P = 9e4
		bg.Parent = hrp

		QuickHacks.FlyConn = RunService.RenderStepped:Connect(function()
			local cam = workspace.CurrentCamera
			if not QuickHacks.Fly or not hrp or not hrp.Parent or not cam then return end
			local move = Vector3.zero
			if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end
			bv.Velocity = move.Unit * QuickHacks.FlySpeed
			if move.Magnitude == 0 then bv.Velocity = Vector3.zero end
			bg.CFrame = cam.CFrame
		end)
		Apex.Toast("Fly enabled (WASD + Space/Ctrl)", getTheme().Primary)
		return true
	end

