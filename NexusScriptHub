				root.CFrame = CFrame.new(1754, 4, 58)
				task.wait(0.25)
				Net.SpawnBoat("MilitaryBoatFree")
			else
				Net.SpawnCar("SchoolBus")
			end
			task.wait(0.85)
			local folder = Eng.Vehicle.GetFolder()
			local myCar = folder and folder:FindFirstChild(LocalPlayer.Name .. "Car")
			local seat = Eng.Vehicle.GetSeat(myCar)
			if not myCar or not seat then
				notify("Vehicle Kill", "Could not spawn vehicle.", 3)
				return
			end
			root.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
			pcall(function() seat:Sit(hum) end)
			task.wait(0.35)

			-- Sweep vehicle seats through target to seat them
			local t0 = os.clock()
			local caught = false
			while S.TrollActive and not S.Unloaded and (os.clock() - t0) < 4.5 do
				local tr = getRoot(targetPlr)
				local th = getHum(targetPlr)
				if not tr or not th then break end
				if th.Sit then
					caught = true
					break
				end
