	-- Safe remote swap helper (tracks originals for 100% clean Unload!)
	local function SwapRemoteWithDummy(realName, dummyName, enabled)
		if not RemotesFolder then return end
		if enabled then
			local real = RemotesFolder:FindFirstChild(realName)
			if real and not S.RenamedRemotes[realName] then
				S.RenamedRemotes[realName] = real
				real.Name = dummyName
				local fake = Instance.new("RemoteEvent")
				fake.Name = realName
				fake.Parent = RemotesFolder
				S.FakeRemotes[realName] = fake
			end
		else
			local fake = S.FakeRemotes[realName]
			if fake then pcall(fake.Destroy, fake); S.FakeRemotes[realName] = nil end
			local real = S.RenamedRemotes[realName] or RemotesFolder:FindFirstChild(dummyName)
			if real and real.Parent then real.Name = realName end
			S.RenamedRemotes[realName] = nil
		end
	end

	local function ToggleNamedChild(parentObj, normalName, hiddenName, enabled)
		if not parentObj then return end
		local target = parentObj:FindFirstChild(normalName, true)
			or parentObj:FindFirstChild(hiddenName, true)
		if target then
			target.Name = enabled and hiddenName or normalName
		end
	end

