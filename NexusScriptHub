-- ░░ target selection ░░
local function pickTarget(fovPx, partName, visibleOnly, maxRange)
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local center = cam.ViewportSize * 0.5
	local myRoot = rootOf(LocalPlayer.Character)
	local myPos = myRoot and myRoot.Position or cam.CFrame.Position
	local best, bestScore = nil, math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and not teammateBlocked(player) then
			local ok, char = alive(player)
			if ok and char then
				local root = rootOf(char)
				if root then
					local range = (root.Position - myPos).Magnitude
					if range <= maxRange then
						local part = char:FindFirstChild(partName) or char:FindFirstChild("Head") or root
						local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
						if onScreen and screenPos.Z > 0.5 then
							local score = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
							if score <= fovPx and score < bestScore then
								if (not visibleOnly) or visibleFromCamera(part) then
									bestScore = score
									best = player
								end
							end
						end
					end
				end
			end
		end
	end
	return best, bestScore
end

local function resolvePart(player, partName)
	local char = player and player.Character
	if not char then return nil end
	local wanted = partName or "Head"
	local part = char:FindFirstChild(wanted)
	if not part then
		for _, alt in ipairs({ "Head", "UpperTorso", "HumanoidRootPart", "Torso" }) do
			part = char:FindFirstChild(alt)
			if part then break end
		end
	end
	return part
end

local function targetPosition(player, partName, predict)
	if not player or not player.Character then return nil end
	local char = player.Character
	local part = char:FindFirstChild(partName) or char:FindFirstChild("Head") or rootOf(char)
	if not part then return nil end
	local pos = part.Position
	if predict and predict > 0 then
		local vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
		pos = pos + vel * predict
	end
	return pos, part
end

