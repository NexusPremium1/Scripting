local function setOpen(open)
	if open then
		root.Visible = true
		root.Size = UDim2.new(0, W, 0, H - 14)
		TweenService:Create(root, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, W, 0, H),
		}):Play()
		floatingBtn.Visible = false
	else
		root.Visible = false
		floatingBtn.Visible = true
	end
end

