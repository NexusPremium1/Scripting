function Eng.Player.UpdateESP()
	local myRoot = getRoot()
	local col = Eng.Player.GetESPColor()

	-- 1. Player ESP
	if S.PlayerESP then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LP then
				local ch = getChar(plr)
				local hd = ch and ch:FindFirstChild("Head")
				local rt = getRoot(plr)
				local hm = getHum(plr)
				if ch and hd and rt and hm and hm.Health > 0 then
					local rec = S.ESPPlayers[plr]
					if not rec or rec.Char ~= ch then
						if rec then
							pcall(function() if rec.HL then rec.HL:Destroy() end end)
							pcall(function() if rec.BB then rec.BB:Destroy() end end)
						end
						local hl = Instance.new("Highlight")
						hl.Name = "NexusBF_HL"; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.FillTransparency = 0.65; hl.Adornee = ch; hl.Parent = ch
						local bb, lbl = createBillboard(hd, plr.DisplayName, col)
						rec = { Char = ch, HL = hl, BB = bb, Label = lbl }
						S.ESPPlayers[plr] = rec
					end
					local dist = myRoot and math.floor((myRoot.Position - rt.Position).Magnitude) or 0
					local lv = "?"
					pcall(function() lv = tostring(plr.Data.Level.Value) end)
					rec.HL.FillColor = col; rec.HL.OutlineColor = col
					rec.Label.TextColor3 = col
					rec.Label.Text = string.format("%s [Lv.%s]\n%dm | %d HP", plr.DisplayName, lv, dist, math.floor(hm.Health))
				end
			end
		end
	elseif next(S.ESPPlayers) then
		clearESPMap(S.ESPPlayers)
	end

	-- 2. Dropped Fruit ESP (Vendor-Safe!)
	if S.FruitESP then
		local active = {}
		for _, f in ipairs(Eng.Fruit.GetSpawnedFruits()) do
			active[f.Object] = true
			local rec = S.ESPFruits[f.Object]
			local dist = myRoot and math.floor((myRoot.Position - f.Part.Position).Magnitude) or 0
			if not rec then
				local hl = Instance.new("Highlight")
				hl.FillColor = Color3.fromRGB(255, 85, 220); hl.OutlineColor = Color3.fromRGB(255, 255, 255)
				hl.FillTransparency = 0.35; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.Adornee = f.Object; hl.Parent = f.Object
				local bb, lbl = createBillboard(f.Part, f.Name, Color3.fromRGB(255, 130, 240))
				rec = { HL = hl, BB = bb, Label = lbl }
				S.ESPFruits[f.Object] = rec
			end
			rec.Label.Text = string.format("[FRUIT] %s\n%dm", f.Name, dist)
		end
		for obj, rec in pairs(S.ESPFruits) do
			if not active[obj] or not obj.Parent then
				pcall(function() if rec.HL then rec.HL:Destroy() end end)
				pcall(function() if rec.BB then rec.BB:Destroy() end end)
				S.ESPFruits[obj] = nil
			end
		end
	elseif next(S.ESPFruits) then
		clearESPMap(S.ESPFruits)
	end

	-- 3. Chest ESP
	if S.ChestESP then
		local seen, count = {}, 0
		for _, c in ipairs(Eng.Farm.ScanChests()) do
			if count < 35 then
				count = count + 1
				seen[c.Part] = true
				local rec = S.ESPChests[c.Part]
				local dist = myRoot and math.floor((myRoot.Position - c.Part.Position).Magnitude) or 0
				if not rec then
					local bb, lbl = createBillboard(c.Part, "[CHEST]", Color3.fromRGB(255, 210, 60))
					rec = { BB = bb, Label = lbl }
					S.ESPChests[c.Part] = rec
				end
				rec.Label.Text = string.format("[CHEST] %dm", dist)
			end
		end
		for part, rec in pairs(S.ESPChests) do
			if not seen[part] or not part.Parent then
				pcall(function() if rec.BB then rec.BB:Destroy() end end)
				S.ESPChests[part] = nil
			end
		end
	elseif next(S.ESPChests) then
		clearESPMap(S.ESPChests)
	end

	-- 4. Special Events & Flowers ESP (Mirage / Kitsune / Prehistoric / SeaBeasts / Flowers)
	if S.IslandEventESP then
		local seen = {}
		local function mark(obj, label, color)
			if not obj then return end
			local p = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
			if not p then return end
			seen[obj] = true
			local rec = S.ESPEvents[obj]
			local dist = myRoot and math.floor((myRoot.Position - p.Position).Magnitude) or 0
			if not rec then
				local bb, lbl = createBillboard(p, label, color)
				rec = { BB = bb, Label = lbl }
				S.ESPEvents[obj] = rec
			end
			rec.Label.Text = string.format("[%s] %dm", label, dist)
		end
		local map = Workspace:FindFirstChild("Map")
		if map then
			mark(map:FindFirstChild("MysticIsland"), "MIRAGE ISLAND", Color3.fromRGB(0, 255, 220))
			mark(map:FindFirstChild("KitsuneIsland"), "KITSUNE ISLAND", Color3.fromRGB(110, 175, 255))
			mark(map:FindFirstChild("PrehistoricIsland"), "PREHISTORIC ISLAND", Color3.fromRGB(255, 130, 60))
			mark(map:FindFirstChild("FrozenDimension"), "FROZEN DIMENSION", Color3.fromRGB(160, 235, 255))
		end
		mark(Workspace:FindFirstChild("Flower1"), "BLUE FLOWER", Color3.fromRGB(80, 170, 255))
		mark(Workspace:FindFirstChild("Flower2"), "RED FLOWER", Color3.fromRGB(255, 80, 80))
		local sbs = Workspace:FindFirstChild("SeaBeasts")
		if sbs then
			for _, sb in ipairs(sbs:GetChildren()) do
				mark(sb, "SEA BEAST", Color3.fromRGB(255, 70, 120))
			end
		end
		for obj, rec in pairs(S.ESPEvents) do
			if not seen[obj] or not obj.Parent then
				pcall(function() if rec.BB then rec.BB:Destroy() end end)
				S.ESPEvents[obj] = nil
			end
		end
	elseif next(S.ESPEvents) then
		clearESPMap(S.ESPEvents)
	end
end

