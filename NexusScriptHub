	local function RestoreInfPrompt(p)
		if not p or not p.Parent then return end
		local clone = p.Parent:FindFirstChild("NexusInfPrompt")
		if clone then clone:Destroy() end
		p.Enabled = true
		p:SetAttribute("NexusInfActive", nil)
	end

	local function StepInfPrompt(p)
		if not p or not p.Parent then return end
		local hrp = GetHRP()
		if not hrp then return end
		local pos = GetObjPos(p.Parent)
		if not pos then return end
		local dist = (hrp.Position - pos).Magnitude
		if dist <= (p.MaxActivationDistance + 4) then
			if not p:GetAttribute("NexusInfActive") then
				p:SetAttribute("NexusInfActive", true)
				local clone = p:Clone()
				clone.Name = "NexusInfPrompt"
				clone.HoldDuration = 0
				clone.Parent = p.Parent
				p.Enabled = false
				TrackConn(clone.Triggered:Connect(function()
					if S.Unloaded then return end
					p.Enabled = true
					FirePromptSafe(p)
					task.delay(0.15, function()
						if p and p.Parent and Toggles.InfItems and Toggles.InfItems.Value then
							p.Enabled = false
						end
					end)
				end))
			end
		elseif p:GetAttribute("NexusInfActive") then
			RestoreInfPrompt(p)
		end
	end

	--==========================================================================
	-- EVENT-DRIVEN ESP ROUTER & ENTITY MONITOR
	--==========================================================================
	local function ClassifyAndApplyESP(obj)
		if S.Unloaded or not obj or not obj.Parent then return end
		local n = obj.Name

		-- 1. Doors (Real + Locked + Dupe tag!) — ANY depth under CurrentRooms;
		--    skip inner parts when an ancestor is already named "Door".
		if n == "Door" and obj.Parent then
			local inRooms, roomName, isInner, isDupe = false, nil, false, false
			local p = obj.Parent
			while p and p ~= workspace do
				if p.Name == "CurrentRooms" then inRooms = true end
				if p.Name == "Door" then isInner = true end
				-- The inner shell of a fake door is itself named "Door" and has NO
				-- ancestor called "Door", so without this check it re-classified the
				-- dupe as a normal numberless door and overwrote the red entry with
				-- yellow ("dupeler de sarı").
				if p.Name == "DoorFake" then isDupe = true end
				if not roomName and tonumber(p.Name) then roomName = p.Name end
				p = p.Parent
			end
			if isDupe then
				if Toggles.ESPDoor and Toggles.ESPDoor.Value then
					local target = obj:FindFirstChild("Door") or obj
					ESP:Add(target, "Door", "FAKE DOOR [DUPE]", Color3.fromRGB(255, 85, 85))
				end
				return
			end
			if inRooms and not isInner then
				if Toggles.ESPDoor and Toggles.ESPDoor.Value then
					local roomNum = tonumber(roomName)
					local doorNum = roomNum and (roomNum + 1) or (roomName or "?")
					local isLocked = obj:FindFirstChild("Lock") ~= nil
					local lbl = isLocked and ("Door " .. tostring(doorNum) .. " [LOCKED]") or ("Door " .. tostring(doorNum))
					local target = obj:FindFirstChild("Door") or obj
					-- Door scheme: numbered = green, numberless = yellow (dupes = red).
					-- The real signal is the plaque ON the door: a TextLabel with digits =>
					-- numbered; a TextLabel without digits (EXIT / weird / bridge doors)
					-- => numberless. No readable label at all => room-number fallback.
					local plateDigits = nil
					for _, d in ipairs(obj:GetDescendants()) do
						if d:IsA("TextLabel") or d:IsA("TextButton") then
							local digits = tostring(d.Text or ""):match("%d+")
							if digits then plateDigits = digits; break end
						end
					end
					-- Positive evidence ONLY: digits on the plaque = green. No plaque yet
					-- or a plaque without digits = yellow (the old roomNum fallback painted
					-- label-less / numberless doors green and they never turned yellow).
					local numbered = plateDigits ~= nil
					local doorColor = numbered and Color3.fromRGB(95, 255, 130) or Color3.fromRGB(255, 255, 85)
					ESP:Add(target, "Door", lbl, doorColor)
					-- The door may still be an empty shell (parts / plaque replicate a beat
					-- later): re-classify shortly so the colour and the ESP both land. Keep
					-- retrying while the plaque has no digits yet (max 4) - a genuinely
					-- numberless door just burns the retries and stays yellow.
					if plateDigits == nil or not obj:FindFirstChildWhichIsA("BasePart", true) then
						local tries = (obj:GetAttribute("NexusDoorRecheck") or 0) + 1
						if tries <= 4 then
							obj:SetAttribute("NexusDoorRecheck", tries)
							task.delay(0.6, function()
								if obj.Parent then ClassifyAndApplyESP(obj) end
							end)
						end
					end
				end
				return
			end
		end
		if n == "DoorFake" and Toggles.ESPDoor and Toggles.ESPDoor.Value then
			local target = obj:FindFirstChild("Door") or obj
			ESP:Add(target, "Door", "FAKE DOOR [DUPE]", Color3.fromRGB(255, 85, 85))
			return
		end

		-- 2. Keys & Passes
		if Catalog.Keys[n] then
			if Toggles.ESPKey and Toggles.ESPKey.Value then
				ESP:Add(obj, "Key", Catalog.Keys[n])
			end
			return
		end

		-- 3. Items & Loot
		if Catalog.Items[n] then
			if Toggles.ESPItem and Toggles.ESPItem.Value then
				ESP:Add(obj, "Item", Catalog.Items[n])
			end
			return
		end

		-- 4. Objectives (Anchors, WaterPump, Generators, Terminals, Clocks, HintPaper)
		if Catalog.Objectives[n] then
			if Toggles.ESPObjective and Toggles.ESPObjective.Value then
				local label = Catalog.Objectives[n]
				local target = obj
				if n == "MinesAnchor" then
					local sign = obj:FindFirstChild("Sign")
					local tl = sign and sign:FindFirstChild("TextLabel")
					if tl and tl.Text ~= "" then
						label = "Anchor [" .. tl.Text .. "]"
					end
					if not obj:GetAttribute("NexusAnchorWatch") then
						obj:SetAttribute("NexusAnchorWatch", true)
						TrackConn(obj:GetAttributeChangedSignal("Activated"):Connect(function()
							if obj:GetAttribute("Activated") then
								ESP.Blacklist[obj] = true
								ESP:Remove(obj)
							end
						end))
					end
				elseif n == "WaterPump" then
					target = obj:FindFirstChild("Wheel") or obj
				end
				ESP:Add(target, "Objective", label)
			end
			return
		end

		-- 5. Levers (Gate, Vine, Backdoor Timer)
		if Catalog.Levers[n] then
			if Toggles.ESPLever and Toggles.ESPLever.Value then
				local label = Catalog.Levers[n]
				if n == "TimerLever" then
					local tt = obj:FindFirstChild("TakeTimer")
					local tl = tt and tt:FindFirstChild("TextLabel")
					if tl then label = "Time Lever [+" .. tl.Text .. "s]" end
				end
				ESP:Add(obj, "Lever", label)
			end
			return
		end

		-- 6. Library Books
		if n == "LiveHintBook" then
			if Toggles.ESPBook and Toggles.ESPBook.Value then
				ESP:Add(obj, "Book", "Hint Book")
			end
			return
		end

		-- 7. Breakers & Fuses
		if n == "LiveBreakerPolePickup" or n == "FuseObtain" then
			if Toggles.ESPBreaker and Toggles.ESPBreaker.Value then
				ESP:Add(obj, "Breaker", n == "FuseObtain" and "Fuse" or "Breaker Pole")
			end
			return
		end

		-- 8. Gold Piles (with amount!)
		if n == "GoldPile" then
			if Toggles.ESPGold and Toggles.ESPGold.Value then
				local val = obj:GetAttribute("GoldValue")
				local lbl = val and ("Gold [" .. tostring(val) .. "G]") or "Gold"
				ESP:Add(obj, "Gold", lbl)
			end
			return
		end

		-- 9. Hiding Places
		if Catalog.HidingPlaces[n] then
			if Toggles.ESPHiding and Toggles.ESPHiding.Value then
				ESP:Add(obj, "Hiding", Catalog.HidingPlaces[n])
			end
			return
		end

		-- 10. Ladders
		if n == "Ladder" then
			if Toggles.ESPLadder and Toggles.ESPLadder.Value then
				ESP:Add(obj, "Ladder", "Ladder")
			end
			return
		end

		-- 11. Guidance / Seek Guiding Light
		if n == "SeekGuidingLight" or n == "Guidance" then
			if Toggles.ESPGuidance and Toggles.ESPGuidance.Value then
				ESP:Add(obj, "Guidance", "Guiding Light")
			end
			return
		end

		-- 12. Entities (All 45+ 2026 Entities!)
		local ent = Catalog.Entities[n]
		if ent then
			if Toggles.ESPEntity and Toggles.ESPEntity.Value then
				ESP:Add(obj, "Entity", ent.Name)
			end
		end
	end

	local function RefreshESPKind(kind, enabled)
		ESP:ClearKind(kind)
		if not enabled then return end
		if kind == "Player" then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LocalPlayer and plr.Character then
					local hum = plr.Character:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						local pct = math.floor((hum.Health / math.max(hum.MaxHealth, 1)) * 100)
						ESP:Add(plr.Character, "Player", plr.Name .. " [" .. pct .. "%]")
					end
				end
			end
			return
		end
		if kind == "Entity" then
			for _, child in ipairs(workspace:GetChildren()) do
				if Catalog.Entities[child.Name] then
					ESP:Add(child, "Entity", Catalog.Entities[child.Name].Name)
				end
			end
			local camE = workspace.CurrentCamera
			if camE then
				for _, child in ipairs(camE:GetChildren()) do
					if Catalog.Entities[child.Name] then
						ESP:Add(child, "Entity", Catalog.Entities[child.Name].Name)
					end
				end
			end
		end
		local curRooms = workspace:FindFirstChild("CurrentRooms")
		if curRooms then
			for _, desc in ipairs(curRooms:GetDescendants()) do
				local n = desc.Name
				if kind == "Door" and (n == "Door" or n == "DoorFake") then
					ClassifyAndApplyESP(desc)
				elseif kind == "Key" and Catalog.Keys[n] then
					ClassifyAndApplyESP(desc)
				elseif kind == "Item" and Catalog.Items[n] then
					ClassifyAndApplyESP(desc)
