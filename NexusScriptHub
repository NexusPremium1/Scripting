	elseif S.SelectedBoss and S.SelectedBoss ~= "" then
		local entry = Eng.World.FindBossEntry(S.SelectedBoss)
		if entry then table.insert(targets, entry) end
	end

	for _, b in ipairs(targets) do
		if S.Unloaded or (not S.AutoFarmBoss and not S.AutoFarmAllBosses) then return end
