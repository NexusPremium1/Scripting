-- v3.3 · RAGE HEAD LOCK  +  CPS RAPID FIRE
-- Rage Bot on: no scope key, camera stays glued to the enemy head every frame.
-- ═══════════════════════════════════════════════════════════════════════════
local function isRivalsMateOrImmune(plr)
	if not plr or plr == k then return true end
	if teamCheckEnabled and isTeammate(plr) then return true end
	local ch = plr.Character
	if not ch or not ch.Parent then return true end
	if ch:FindFirstChildOfClass("ForceField") then return true end
	local root = ch:FindFirstChild("HumanoidRootPart")
	if not root then return true end
	return false
end

local function getRageLockTarget()
	-- Prefer the exact target chosen by God-Dodge so movement & aim are 100% synced
	local dodgeTbl = getgenv and getgenv().NexusDodge
	if type(dodgeTbl) == "table" and dodgeTbl.Active and dodgeTbl.TargetPlayer then
		local tp = dodgeTbl.TargetPlayer
		if tp ~= k and isPlayerAlive(tp) and not isRivalsMateOrImmune(tp) then
			rageLockTarget = tp
			return tp
		end
	end

	-- sticky: keep the same target while alive, in range & vulnerable
	if rageLockTarget and rageLockTarget.Character and isPlayerAlive(rageLockTarget) and not isRivalsMateOrImmune(rageLockTarget) then
		local theirRoot = rageLockTarget.Character:FindFirstChild("HumanoidRootPart")
		local myRoot = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
		if theirRoot and myRoot and (theirRoot.Position - myRoot.Position).Magnitude <= rageLockRange then
			return rageLockTarget
		end
	end

	rageLockTarget = nil
	local camPos = Camera.CFrame.Position
	local center = Camera.ViewportSize * 0.5
	local best, bestScore = nil, math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= k and isPlayerAlive(plr) and not isRivalsMateOrImmune(plr) and plr.Character then
			local part = plr.Character:FindFirstChild("HitboxHead") or getTargetPart(plr.Character, "Head")
			if part then
				local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
				local hp = 100
				pcall(function()
					local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
					if hum then hp = tonumber(hum.Health) or 100 end
				end)
				local score
				if onScreen and screenPos.Z > 0 then
					score = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude * 0.5 + hp * 2.5
				else
					score = 100000 + (part.Position - camPos).Magnitude + hp * 2.5
				end
				if score < bestScore then
					bestScore = score
					best = plr
				end
			end
		end
	end

	rageLockTarget = best
	return best
end

local function rageLockCamera()
	if not (rageModeEnabled and rageLockEnabled) then return end
	local dodgeTbl = getgenv and getgenv().NexusDodge
	if type(dodgeTbl) == "table" and type(dodgeTbl.IsInLobby) == "function" and dodgeTbl.IsInLobby() then
		return
	end
	local target = getRageLockTarget()
	if not target or not target.Character then return end
	local head = target.Character:FindFirstChild("HitboxHead") or getTargetPart(target.Character, "Head")
	if not head then return end

	local camPos = Camera.CFrame.Position
	local aimPos = head.Position
	if ragePrediction then
		local hrp = target.Character:FindFirstChild("HumanoidRootPart") or head
		local vel = hrp.AssemblyLinearVelocity or hrp.Velocity
		if vel and vel.Magnitude > 0.05 then
			local ping = 0
			pcall(function()
				ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
			end)
			local dist = (aimPos - camPos).Magnitude
			local lead = math.clamp((dist / 2600 + ping) * 1.15, 0.02, 0.35)
			aimPos = aimPos + vel * lead
		end
	end

	pcall(function()
		Camera.CFrame = CFrame.new(camPos, aimPos)
	end)
end

