local ESP = {
	Settings = {
		Mode            = "Highlight + Text",
		MaxDistance     = 350,
		ShowDistance    = true,
		Tracers         = false,
		TracerOrigin    = "Bottom",
		Arrows          = false,
		Rainbow         = false,
		TextSize        = 14,
		Font            = Enum.Font.GothamBold,
		FillTrans       = 0.72,
		OutlineTrans    = 0.05,
		RenderInterval  = 1 / 60,
	},
	Entries   = {},  -- [Instance] = entry
	ByKind    = {},  -- [kind] = { [Instance] = entry }
	Colors    = {},
	Blacklist = setmetatable({}, { __mode = "k" }),
	-- weak-keyed: adornee retry sayaçları (boş modelken düşen ESP'ler geri gelsin)
	AdrRetry = setmetatable({}, { __mode = "k" }),
	Gui       = nil,
	ArrowGui  = nil,
	Accum     = 0,
}

for k, col in pairs(Catalog.DefaultColors) do
	ESP.Colors[k] = col
	ESP.ByKind[k] = {}
end

do
	local gui = Instance.new("ScreenGui")
	gui.Name = "NexusDoorsESP_" .. HttpService:GenerateGUID(false):sub(1, 8)
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	pcall(function() gui.Parent = CoreGui end)
	if not gui.Parent then
		pcall(function() gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end)
	end
	ESP.Gui = gui
end

local function ESPGetAdornee(obj)
	if not obj or not obj.Parent then return nil end
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChild("Hitbox") or obj:FindFirstChild("Main")
			or obj:FindFirstChild("Door") or obj:FindFirstChild("HumanoidRootPart")
			or obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function ESPMakeDrawing(kind)
	if not Cap.Drawing then return nil end
	local ok, d = pcall(Cap.Drawing.new, kind)
	if ok and d then
		d.Visible = false
		return d
	end
	return nil
end

function ESP:Remove(obj)
	local entry = self.Entries[obj]
	if not entry then return end
	self.Entries[obj] = nil
	if entry.Kind and self.ByKind[entry.Kind] then
		self.ByKind[entry.Kind][obj] = nil
	end
	pcall(function() if entry.Billboard then entry.Billboard:Destroy() end end)
	pcall(function() if entry.Highlight then entry.Highlight:Destroy() end end)
	pcall(function() if entry.Tracer then entry.Tracer:Remove() end end)
	pcall(function() if entry.Arrow then entry.Arrow:Destroy() end end)
	pcall(function() if entry.Conn then entry.Conn:Disconnect() end end)
end

function ESP:ClearKind(kind)
	local bucket = self.ByKind[kind]
	if not bucket then return end
	local list = {}
	for obj in pairs(bucket) do
		list[#list + 1] = obj
	end
	for i = 1, #list do
		self:Remove(list[i])
	end
end

function ESP:ClearAll()
	local list = {}
	for obj in pairs(self.Entries) do
		list[#list + 1] = obj
	end
	for i = 1, #list do
		self:Remove(list[i])
	end
end

function ESP:SetKindColor(kind, color)
	if not kind or not color then return end
	self.Colors[kind] = color
	local bucket = self.ByKind[kind]
	if not bucket then return end
	for _, entry in pairs(bucket) do
		if not entry.FixedColor then
			entry.Color = color
			if not self.Settings.Rainbow then
				if entry.Label then entry.Label.TextColor3 = color end
				if entry.Highlight then
					entry.Highlight.FillColor = color
					entry.Highlight.OutlineColor = color
				end
				if entry.Tracer then entry.Tracer.Color = color end
				if entry.Arrow then entry.Arrow.TextColor3 = color end
			end
		end
	end
end

function ESP:Add(obj, kind, labelText, customColor)
	if S.Unloaded or not obj or not obj.Parent or self.Blacklist[obj] then return end
	local existing = self.Entries[obj]
	if existing then
		existing.Text = labelText or existing.Text
		if customColor then
			existing.Color = customColor
			existing.FixedColor = true
		elseif not existing.FixedColor then
			existing.Color = self.Colors[kind] or existing.Color
		end
		-- Push the NEW colour onto the live visuals (same write-through as
		-- SetKindColor): Step only repaints colours while Rainbow is on, so a
		-- green->yellow door re-classification otherwise stayed green forever
		-- ("numarasiz kapi sari gosterilmiyor").
		if not self.Settings.Rainbow then
			local c = existing.Color
			if existing.Label then existing.Label.TextColor3 = c end
			if existing.Highlight then
				existing.Highlight.FillColor = c
				existing.Highlight.OutlineColor = c
			end
			if existing.Tracer then existing.Tracer.Color = c end
			if existing.Arrow then existing.Arrow.TextColor3 = c end
		end
		return existing
	end

	local adornee = ESPGetAdornee(obj)
	if not adornee then
		-- freshly spawned models can arrive before ANY part replicates - the old
		-- silent return dropped their ESP forever ("bazen kapi esplenmiyor").
		if not obj:IsA("BasePart") and obj.Parent then
			local n = (self.AdrRetry[obj] or 0) + 1
			if n <= 10 then
				self.AdrRetry[obj] = n
				task.delay(0.35, function()
					if obj.Parent then self:Add(obj, kind, labelText, customColor) end
				end)
			end
		end
		return
	end
	local color = customColor or self.Colors[kind] or Color3.new(1, 1, 1)

	-- Billboard label
	local bb = Instance.new("BillboardGui")
	bb.Name = "NexusESP_BB"
	bb.Adornee = adornee
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(220, 38)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 1.5, 0)
	bb.MaxDistance = self.Settings.MaxDistance
	bb.Enabled = (self.Settings.Mode ~= "Highlight Only")
	bb.Parent = self.Gui

	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.Font = self.Settings.Font
	lbl.TextSize = self.Settings.TextSize
	lbl.TextColor3 = color
	lbl.TextStrokeTransparency = 0.25
	lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
	lbl.Text = labelText or obj.Name
	lbl.Parent = bb

	-- 3D Highlight
	local hl = Instance.new("Highlight")
	hl.Name = "NexusESP_HL"
	hl.Adornee = (obj:IsA("Model") or obj:IsA("BasePart")) and obj or adornee
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.FillColor = color
	hl.OutlineColor = color
	hl.FillTransparency = self.Settings.FillTrans
	hl.OutlineTransparency = self.Settings.OutlineTrans
	hl.Enabled = (self.Settings.Mode ~= "Text Only")
	hl.Parent = self.Gui

	-- Optional Tracer (Drawing API)
	local tracer = nil
	if self.Settings.Tracers then
		tracer = ESPMakeDrawing("Line")
		if tracer then
			tracer.Thickness = 1.6
			tracer.Transparency = 0.85
			tracer.Color = color
		end
	end

	-- Optional Offscreen Arrow (ScreenGui TextLabel — works on ALL executors!)
	local arrow = Instance.new("TextLabel")
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.fromOffset(26, 26)
	arrow.AnchorPoint = Vector2.new(0.5, 0.5)
	arrow.Font = Enum.Font.GothamBold
	arrow.TextSize = 20
	arrow.Text = "▲"
	arrow.TextColor3 = color
	arrow.TextStrokeTransparency = 0.2
	arrow.Visible = false
	arrow.Parent = self.Gui

	local entry = {
		Obj       = obj,
		Adornee   = adornee,
		Kind      = kind,
		Text      = labelText or obj.Name,
		Color     = color,
		FixedColor = customColor ~= nil,
		Billboard = bb,
		Label     = lbl,
		Highlight = hl,
		Tracer    = tracer,
		Arrow     = arrow,
	}
	entry.Conn = obj.AncestryChanged:Connect(function(_, parent)
		if not parent then
			self:Remove(obj)
		end
	end)

	self.Entries[obj] = entry
	if not self.ByKind[kind] then self.ByKind[kind] = {} end
	self.ByKind[kind][obj] = entry
	return entry
end

function ESP:ApplyVisualSettings()
	local st = self.Settings
	local showText = (st.Mode ~= "Highlight Only")
	local showHL   = (st.Mode ~= "Text Only")
	for _, entry in pairs(self.Entries) do
		if entry.Billboard then
			entry.Billboard.Enabled = showText
			entry.Billboard.MaxDistance = st.MaxDistance
		end
		if entry.Label then
			entry.Label.Font = st.Font
			entry.Label.TextSize = st.TextSize
		end
		if entry.Highlight then
			entry.Highlight.Enabled = showHL
			entry.Highlight.FillTransparency = st.FillTrans
			entry.Highlight.OutlineTransparency = st.OutlineTrans
		end
		if st.Tracers and not entry.Tracer then
			local tr = ESPMakeDrawing("Line")
			if tr then
				tr.Thickness = 1.6
				tr.Transparency = 0.85
				tr.Color = entry.Color
				entry.Tracer = tr
			end
		elseif not st.Tracers and entry.Tracer then
			pcall(function() entry.Tracer:Remove() end)
			entry.Tracer = nil
		end
		if not st.Arrows and entry.Arrow then
			entry.Arrow.Visible = false
		end
	end
end

function ESP:Step(dt)
	local st = self.Settings
	self.Accum = self.Accum + dt
	if self.Accum < st.RenderInterval then return end
	self.Accum = 0

	local cam = S.Camera
	if not cam then return end
	local hrp = GetHRP()
	local originPos = hrp and hrp.Position or cam.CFrame.Position
	local vp = cam.ViewportSize
	local centerX, centerY = vp.X * 0.5, vp.Y * 0.5
	local originY = (st.TracerOrigin == "Top") and 0
		or ((st.TracerOrigin == "Center") and centerY or vp.Y)

	local rainbowColor = st.Rainbow and Color3.fromHSV((os.clock() * 0.22) % 1, 0.88, 1) or nil
	local showText = (st.Mode ~= "Highlight Only")
	local showHL   = (st.Mode ~= "Text Only")

	for obj, entry in pairs(self.Entries) do
		if not obj or not obj.Parent then
			self:Remove(obj)
		else
			local ad = entry.Adornee
			if not ad or not ad.Parent then
				ad = ESPGetAdornee(obj)
				entry.Adornee = ad
				if ad and entry.Billboard then entry.Billboard.Adornee = ad end
			end
			if ad then
				local pos = ad.Position
				local dist = (originPos - pos).Magnitude
				local inRange = (dist <= st.MaxDistance) or (entry.Kind == "Entity")
				local col = rainbowColor or entry.Color

				if entry.Billboard then
					entry.Billboard.Enabled = showText and inRange
				end
				if entry.Highlight then
					entry.Highlight.Enabled = showHL and inRange
					if rainbowColor then
						entry.Highlight.FillColor = col
						entry.Highlight.OutlineColor = col
					end
				end
				if entry.Label and inRange then
					if st.ShowDistance then
						entry.Label.Text = string.format("%s [%dm]", entry.Text, math.floor(dist + 0.5))
					else
						entry.Label.Text = entry.Text
					end
					if rainbowColor then entry.Label.TextColor3 = col end
				end

				-- Tracers & Offscreen Arrows
				if (st.Tracers or st.Arrows) and inRange then
					local sp, onScreen = cam:WorldToViewportPoint(pos)
					if entry.Tracer then
						if onScreen and sp.Z > 0 then
							entry.Tracer.From = Vector2.new(centerX, originY)
							entry.Tracer.To = Vector2.new(sp.X, sp.Y)
							entry.Tracer.Color = col
							entry.Tracer.Visible = true
						else
							entry.Tracer.Visible = false
						end
					end
					if entry.Arrow then
						if st.Arrows and (not onScreen or sp.Z <= 0) then
							local dx, dy = sp.X - centerX, sp.Y - centerY
							if sp.Z <= 0 then dx, dy = -dx, -dy end
							local angle = math.atan2(dy, dx)
							local rad = math.min(centerX, centerY) - 42
							entry.Arrow.Position = UDim2.fromOffset(
								centerX + math.cos(angle) * rad,
								centerY + math.sin(angle) * rad
							)
							entry.Arrow.Rotation = math.deg(angle) + 90
							entry.Arrow.TextColor3 = col
							entry.Arrow.Visible = true
						else
							entry.Arrow.Visible = false
						end
					end
				else
					if entry.Tracer then entry.Tracer.Visible = false end
					if entry.Arrow then entry.Arrow.Visible = false end
				end
			end
		end
	end
end

