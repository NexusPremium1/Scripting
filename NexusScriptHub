	local function checkBanObj(d)
		local n = d.Name
		if n:find("BannedBlock", 1, true) or n:find("BanBlock", 1, true) or n:find("HouseBan", 1, true) then
			pcall(function() d:Destroy() end)
			removed = removed + 1
		end
	end
	for _, c in ipairs(Workspace:GetChildren()) do
		checkBanObj(c)
	end
	local lots = Eng.House.GetLotsFolder()
	if lots then
		local step = 0
		for _, lot in ipairs(lots:GetChildren()) do
			for _, d in ipairs(lot:GetChildren()) do
				checkBanObj(d)
				if d:IsA("Folder") or d:IsA("Model") then
					for _, sub in ipairs(d:GetChildren()) do
						checkBanObj(sub)
						step = step + 1
						if step % 250 == 0 then task.wait() end
					end
				end
			end
		end
	end
	if not silent then
		if removed > 0 then
			notify("House Unban", "Removed " .. tostring(removed) .. " house ban barrier(s)!", 3.5)
		else
			notify("House Unban", "No active house ban barriers found.", 3)
		end
	end
	return removed
end

function Eng.House.ListLots()
	local lots = Eng.House.GetLotsFolder()
	local out = {}
	if lots then
		for _, lot in ipairs(lots:GetChildren()) do
			local ownerStr = "Vacant"
			local housePicked = lot:FindFirstChild("HousePickedByPlayer")
			if housePicked then
				local ownerVal = housePicked:FindFirstChild("Owner") or lot:FindFirstChild("Owner")
				if ownerVal and ownerVal.Value then
					ownerStr = tostring(ownerVal.Value)
				else
					local model = housePicked:FindFirstChild("HouseModel")
					if model and #model:GetChildren() > 0 then
						ownerStr = "Occupied"
					end
				end
			end
			table.insert(out, lot.Name .. " [" .. ownerStr .. "]")
		end
	end
	table.sort(out)
	if #out == 0 then
		out = { "(No lots found)" }
	end
	return out
end

function Eng.House.ResolveLot(label)
	if not label or label == "" then return nil end
	local lotName = label:match("^(.-)%s*%[") or label
	local lots = Eng.House.GetLotsFolder()
	return lots and lots:FindFirstChild(lotName)
end

function Eng.House.FindMyLot()
	local lots = Eng.House.GetLotsFolder()
	if not lots then return nil end
	local myName = LocalPlayer.Name
	for _, lot in ipairs(lots:GetChildren()) do
		local hp = lot:FindFirstChild("HousePickedByPlayer")
		local owner = (hp and hp:FindFirstChild("Owner")) or lot:FindFirstChild("Owner")
		if owner and tostring(owner.Value) == myName then
			return lot
		end
		if string.find(lot.Name, myName, 1, true) then
			return lot
		end
	end
	return nil
end

function Eng.House.TeleportToLot(lot, toSafe)
	local root = getRoot()
	if not root or not lot then
		notify("House TP", "Target house plot not found.", 3)
		return
	end
	if toSafe then
		local safePart = nil
		for _, d in ipairs(lot:GetDescendants()) do
			local low = string.lower(d.Name)
			if (low:find("safe") or low:find("vault")) and (d:IsA("BasePart") or d:IsA("Model")) then
				if d:IsA("Model") then
					safePart = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true)
				else
					safePart = d
				end
				if safePart then break end
			end
		end
		if safePart then
			safePivot(getChar(), safePart.CFrame * CFrame.new(0, 2, -3))
			notify("House Safe TP", "Teleported to vault/safe in " .. lot.Name .. "!", 3)
			return
		end
		notify("House Safe TP", "No safe found in " .. lot.Name .. " — teleporting to house instead.", 3)
	end
	local cf = nil
	pcall(function() cf = lot:GetPivot() end)
	if not cf then
		local part = lot:FindFirstChildWhichIsA("BasePart", true)
		if part then cf = part.CFrame end
	end
	if cf then
		safePivot(getChar(), cf + Vector3.new(0, 6, 0))
		notify("House TP", "Teleported to " .. lot.Name, 2.5)
	end
end

function Eng.House.SetLocalDoorBypass(state)
	S.UnlockLocalDoorsOn = state == true
	local lots = Eng.House.GetLotsFolder()
	if S.UnlockLocalDoorsOn then
		if not lots then return end
		trackThread(function()
			local count = 0
			local visited = 0
			for _, lot in ipairs(lots:GetChildren()) do
				if not S.UnlockLocalDoorsOn or S.Unloaded then return end
				for _, d in ipairs(lot:GetDescendants()) do
					visited = visited + 1
					if visited % 500 == 0 then
						task.wait()
						if not S.UnlockLocalDoorsOn or S.Unloaded then return end
					end
					if d:IsA("BasePart") then
						local low = string.lower(d.Name)
						if low:find("door", 1, true) or low:find("glass", 1, true) or low:find("gate", 1, true) or low:find("garage", 1, true) or low:find("curtain", 1, true) then
							if S.ModifiedDoors[d] == nil then
								S.ModifiedDoors[d] = { CanCollide = d.CanCollide, Transparency = d.Transparency }
							end
							d.CanCollide = false
							count = count + 1
						end
					end
				end
			end
			notify("House Doors", "Walk-through enabled on " .. tostring(count) .. " house door parts!", 3)
		end)
	else
		for part, orig in pairs(S.ModifiedDoors) do
			if part and part.Parent then
				pcall(function()
					part.CanCollide = orig.CanCollide
					part.Transparency = orig.Transparency
				end)
			end
		end
		S.ModifiedDoors = {}
	end
end

