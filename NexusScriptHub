-- ---- fall damage safety -------------------------------------------------
local flyProtectUntil = 0
local function flyProtectStep()
    if os.clock() > flyProtectUntil then return end
    local h = getRealHum()
    if h and h.Health < h.MaxHealth then
        pcall(function() h.Health = h.MaxHealth end)
    end
end
local function flyProtectArm()
    if not Nexus.Values.FlyProtect then return end
    flyProtectUntil = math.huge
    if not Nexus.Connections.FlyProtect then
        Nexus.Connections.FlyProtect = RunService.Heartbeat:Connect(flyProtectStep)
    end
end
local function flyProtectDisarm()
    flyProtectUntil = os.clock() + 3
    if Nexus.Connections.FlyProtect then
        task.delay(3.2, function()
            if os.clock() >= flyProtectUntil and Nexus.Connections.FlyProtect then
                pcall(function() Nexus.Connections.FlyProtect:Disconnect() end)
                Nexus.Connections.FlyProtect = nil
            end
        end)
    end
end

