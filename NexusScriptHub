	-- Smooth Utility Constructors
	local function mk(className, parent, props)
		local inst = Instance.new(className)
		if props then
			for k, v in pairs(props) do
				pcall(function() inst[k] = v end)
			end
		end
		if parent then inst.Parent = parent end
		return inst
	end

	local function corner(parent, radius)
		return mk("UICorner", parent, { CornerRadius = UDim.new(0, radius or 12) })
	end

	local function stroke(parent, color, thickness, transparency)
		return mk("UIStroke", parent, {
			Color = color or getTheme().Stroke,
			Thickness = thickness or 1,
			Transparency = transparency or 0.3,
		})
	end

	local function tw(obj, duration, props, style, direction)
		if not State.Settings.Animations then
			for k, v in pairs(props) do pcall(function() obj[k] = v end) end
			return
		end
		pcall(function()
			TweenService:Create(obj, TweenInfo.new(duration or 0.18, style or Enum.EasingStyle.Quart, direction or Enum.EasingDirection.Out), props):Play()
		end)
	end

	local function isFav(item)
		return item and State.Favorites[item.Id] == true
	end

	local function isCurrentGame(item)
		return type(Apex.IsCurrentGame) == "function" and Apex.IsCurrentGame(item)
	end

	local function filterItems()
		local list = {}
		local q = string.lower(UI.Query or "")
		for _, item in ipairs(Apex.Registry or {}) do
			local matchesView = true
			if UI.View == "Games" then
				matchesView = (item.Category == "Games")
			elseif UI.View == "Utilities" then
				matchesView = (item.Category == "Utilities")
			elseif UI.View == "Favorites" then
				matchesView = isFav(item)
			elseif UI.View == "Recent" then
				local found = false
				for _, rId in ipairs(State.Recent or {}) do
					if rId == item.Id then found = true break end
				end
				matchesView = found
			end

			if matchesView then
				if q == "" then
					table.insert(list, item)
				else
					local hay = string.lower(tostring(item.Name or "") .. " " .. tostring(item.Sub or "") .. " " .. tostring(item.GameName or "") .. " " .. table.concat(item.Tags or {}, " "))
					if string.find(hay, q, 1, true) then
						table.insert(list, item)
					end
				end
			end
		end

		table.sort(list, function(a, b)
			local ca = isCurrentGame(a) and 1 or 0
			local cb = isCurrentGame(b) and 1 or 0
			if ca ~= cb then return ca > cb end
			local fa = isFav(a) and 1 or 0
			local fb = isFav(b) and 1 or 0
			if fa ~= fb then return fa > fb end
			return (a.Order or 0) < (b.Order or 0)
		end)
		return list
	end

