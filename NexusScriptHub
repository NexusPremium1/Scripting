        Lighting.FogEnd = 50000
        Lighting.FogStart = 5000
        Lighting.Brightness = 2
        Lighting.FogColor = Color3.fromRGB(205, 235, 245)
    end

    if structure and structure:FindFirstChild("Cloud") then
        structure.Cloud.Transparency = Nexus.Toggles.RemoveClouds and 1 or 0
    end

    local expectedGrav = Nexus.Values.Gravity
    if Nexus.Toggles.FixBalloon and char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool and tool.Name:lower():find("balloon") then
            expectedGrav = expectedGrav * 0.306122
        end
    end
    if math.abs(Workspace.Gravity - expectedGrav) > 0.05 then
        Workspace.Gravity = expectedGrav
    end

    if Nexus.Toggles.Godmode and char then
        local fall = char:FindFirstChild("FallDamageScript")
        if fall then
            pcall(function() fall:Destroy() end)
        end
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            hum.BreakJointsOnDeath = false
        end
    end

    if waterPlatform and waterPlatform.Parent then
        local pos = hrp and hrp.Position or Vector3.zero
        local flood = structure and structure:FindFirstChild("FloodLevel")
        local water = Workspace:FindFirstChild("WaterLevel")
        local surfaceY = water and (water.Position.Y - 2.5) or 0
        if flood then
            surfaceY = math.max(surfaceY, flood.Position.Y - 2.5)
        end
        waterPlatform.Position = Vector3.new(pos.X, surfaceY, pos.Z)
        waterPlatform.CanCollide = Nexus.Toggles.WaterWalk
    end

    if Nexus.Toggles.AntiVoid or Nexus.Toggles.Bypass then
        Workspace.FallenPartsDestroyHeight = 0/0
    else
        Workspace.FallenPartsDestroyHeight = -500
    end

    if hum then
        hum.WalkSpeed = Nexus.Values.WalkSpeed
        hum.JumpPower = Nexus.Values.JumpPower
    end

    if char then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                if Nexus.Toggles.Noclip then
                    part.CanCollide = false
                elseif not Nexus.Toggles.Bypass and part.Name == "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
    end

    if char and hrp and hum and not Nexus.Round.Respawning and not Nexus.Fling.Active then
        if Nexus.Toggles.Bypass then
            if not fakeChar.Parent then
                fakeHrp.CFrame = hrp.CFrame
                fakeChar.Parent = Workspace
            end

            fakeHum.WalkSpeed = Nexus.Values.WalkSpeed
            fakeHum.JumpPower = Nexus.Values.JumpPower
            fakeHum.HipHeight = hum.HipHeight
            fakeHum.RigType = hum.RigType
            fakeHum.Health = math.clamp(hum.Health, 1, 100)
            fakeHrp.Size = hrp.Size
            fakeHrp.CanCollide = not Nexus.Toggles.Noclip

            hum.PlatformStand = true
            hum:MoveTo(fakeHrp.Position + (fakeHum.MoveDirection * 50))

            if LocalPlayer.Character ~= fakeChar then
                LocalPlayer.Character = fakeChar
            end

            if Camera and not Nexus.Round.Respawning then
                Camera.CameraSubject = fakeHum
            end

            if fakeHrp.Position.Y <= -25 then
                fakeHrp.AssemblyLinearVelocity = Vector3.new(fakeHrp.AssemblyLinearVelocity.X, math.abs(fakeHrp.AssemblyLinearVelocity.Y) * 0.9 + 20, fakeHrp.AssemblyLinearVelocity.Z)
                fakeChar:PivotTo(fakeHrp.CFrame + Vector3.new(0, 10, 0))
            end

            local spoofOffset = (fakeHrp.CFrame.RightVector * Nexus.Values.PosSpoof.X) +
                                (fakeHrp.CFrame.UpVector * Nexus.Values.PosSpoof.Y) +
                                (fakeHrp.CFrame.LookVector * Nexus.Values.PosSpoof.Z)
            local spoofRot = CFrame.Angles(
                math.rad(Nexus.Values.RotSpoof.X),
                math.rad(Nexus.Values.RotSpoof.Y),
                math.rad(Nexus.Values.RotSpoof.Z)
            )
            char:PivotTo((fakeChar:GetPivot() + spoofOffset) * spoofRot)

            for _, bp in ipairs(char:GetChildren()) do
                if bp:IsA("BasePart") then
                    bp.CanCollide = false
                    bp.AssemblyLinearVelocity = Vector3.new(
                        math.clamp(bp.AssemblyLinearVelocity.X, -1, 1),
                        3,
                        math.clamp(bp.AssemblyLinearVelocity.Z, -1, 1)
                    )
                end
            end
        else
            if LocalPlayer.Character == fakeChar then
                char:PivotTo(fakeChar:GetPivot())
                LocalPlayer.Character = char
                hum.PlatformStand = false
                if Camera then Camera.CameraSubject = hum end
                fakeChar.Parent = nil
            else
                fakeChar:PivotTo(char:GetPivot())
                if fakeChar.Parent then fakeChar.Parent = nil end
            end

            if not Nexus.Toggles.Fly and hrp.AssemblyLinearVelocity.Y < -55 then
                local ray = Workspace:Raycast(hrp.Position, Vector3.new(0, -18, 0))
                if ray then
                    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, -10, hrp.AssemblyLinearVelocity.Z)
                end
            end
        end
    end

    if char and hrp and not Nexus.Round.Respawning and not Nexus.Fling.Active and not Nexus.Toggles.Fly then
        local currentPiv = char:GetPivot()
        if LastPivot and (currentPiv.Position - LastPivot.Position).Magnitude >= 120 and Nexus.Toggles.AntiTeleport then
            char:PivotTo(LastPivot)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        else
            LastPivot = currentPiv
        end
    end

    if Nexus.Toggles.AntiFling or Nexus.Toggles.NoPlayerCollision then
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= LocalPlayer and other.Character then
                for _, part in ipairs(other.Character:GetChildren()) do
                    if part:IsA("BasePart") then
                        if Nexus.Toggles.AntiFling then
                            part.AssemblyLinearVelocity = Vector3.zero
                            part.AssemblyAngularVelocity = Vector3.zero
                        end
                        if Nexus.Toggles.NoPlayerCollision then
                            part.CanCollide = false
                        end
                    end
                end
            end
        end
    end

    local foundDisaster = "None"
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("SurvivalTag") then
            local tagVal = p.Character.SurvivalTag.Value
            if tagVal and tagVal ~= "" then
                foundDisaster = tagVal
                break
            end
        end
    end
    Nexus.Round.Disaster = foundDisaster

    if Nexus.Round.PrevDisaster ~= Nexus.Round.Disaster then
        if Nexus.Round.Disaster ~= "None" then
            Nexus.Round.PrevDisaster = Nexus.Round.Disaster
            if Nexus.Toggles.ChatAnnounce then
                announceDisaster(Nexus.Round.Disaster .. "!")
            end
        else
            if Nexus.Toggles.AutoReset and hum and hum.Health < 99 and not Nexus.Round.Respawning then
                hum.Health = -100
            end
            Nexus.Round.PrevDisaster = "None"
            Nexus.Round.Warning = "None"
        end
        updateHUDText()
    end

    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        local bGui = pGui:FindFirstChild("BlizzardGui")
        if bGui then bGui.Enabled = not Nexus.Toggles.ClearBlizzardUI end
        local sGui = pGui:FindFirstChild("SandStormGui")
        if sGui then sGui.Enabled = not Nexus.Toggles.ClearSandstormUI end
    end

    local trackChar = (Nexus.Toggles.Bypass and fakeChar.Parent and fakeChar) or char
    if trackChar and Nexus.Toggles.PushAura then
        pushAura.Size = Vector3.new(Nexus.Values.PushRadius, Nexus.Values.PushRadius, Nexus.Values.PushRadius)
        pushAura:PivotTo(trackChar:GetPivot())
        local trackHRP = (Nexus.Toggles.Bypass and fakeHrp) or hrp
        if trackHRP then
            pushAura.AssemblyLinearVelocity = trackHRP.AssemblyLinearVelocity
        end

        local centerPos = trackChar:GetPivot().Position
        for i = #pushInsideParts, 1, -1 do
            local part = pushInsideParts[i]
            if part and part.Parent and not part.Anchored and not part:IsGrounded() then
                local partPos = part:GetPivot().Position
                local dist = (centerPos - partPos).Magnitude
                if dist <= Nexus.Values.PushRadius / 2 then
                    local pushDir = CFrame.lookAt(centerPos, partPos).LookVector
                    part.AssemblyLinearVelocity = part.AssemblyLinearVelocity + (pushDir * Nexus.Values.PushPower)
                end
            else
                table.remove(pushInsideParts, i)
            end
        end
    end

    if trackChar and Nexus.Toggles.TornadoEnabled then
        local center = Tornado.TargetLocation or trackChar:GetPivot().Position
        local i = 1
        while i <= #Tornado.PartList do
            local part = Tornado.PartList[i]
            if part and part.Parent and part:IsDescendantOf(Workspace) and not part.Anchored then
                i = i + 1
                if not part:IsGrounded() then
                    part.CanCollide = false
                    Tornado.RotationPowers[part] = Tornado.RotationPowers[part] or Vector3.new(
                        math.random(-2500, 2500),
                        math.random(-2500, 2500),
                        math.random(-2500, 2500)
                    )

                    if not Tornado.TargetLocation then
                        local layer = math.min(math.floor((part.Size.Magnitude / 15) * Nexus.Values.TornadoLayers), Nexus.Values.TornadoLayers) - 1
                        if Nexus.Toggles.TornadoReverse then
                            layer = Nexus.Values.TornadoLayers - layer + 1
                        end

                        local pos = part.Position
                        local dist = (Vector3.new(pos.X, center.Y, pos.Z) - center).Magnitude
                        local newAngle = math.atan2(pos.Z - center.Z, pos.X - center.X) + math.rad(Nexus.Values.TornadoSpeed)

                        local orbitRadius = math.min(Nexus.Values.TornadoRadius, dist) * math.max(layer * Nexus.Values.TornadoLayerModifier, 1)
                        local targetPos = Vector3.new(
                            center.X + math.cos(newAngle) * orbitRadius,
                            center.Y + math.abs(math.sin(pos.Y - center.Y + (layer * Nexus.Values.TornadoHeightModifier))),
                            center.Z + math.sin(newAngle) * orbitRadius
                        )
                        part.AssemblyLinearVelocity = (targetPos - part.Position).Unit * ((Nexus.Values.TornadoSpeed * Nexus.Values.TornadoRadius) * (math.max(layer, 2) / 2))
                    else
                        part.AssemblyLinearVelocity = CFrame.lookAt(part.Position, Tornado.TargetLocation).LookVector * (Nexus.Values.TornadoSpeed * 10)
                    end

                    part.AssemblyAngularVelocity = part.AssemblyAngularVelocity + (Tornado.RotationPowers[part] / 100)
                end
            else
                table.remove(Tornado.PartList, i)
            end
        end
    end

    applyPhysicsClaim()
end)

