--============================================================================--
local Net = {
	CommF = nil,
	Redeem = nil,
	RegAttack = nil,
	RegHit = nil,
	CachedSessionId = nil,
	LastSessionCheck = 0,
}

function Net.GetCommF()
	if Net.CommF and Net.CommF.Parent then return Net.CommF end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if remotes then
		Net.CommF = remotes:FindFirstChild("CommF_")
	end
	return Net.CommF
end

function Net.Comm(...)
	local rf = Net.GetCommF()
	if not rf then return false, nil end
	local args = table.pack(...)
	local ok, res = pcall(function()
		return rf:InvokeServer(table.unpack(args, 1, args.n))
	end)
	return ok, res
end

function Net.RedeemCode(code)
	if not Net.Redeem or not Net.Redeem.Parent then
		local rem = ReplicatedStorage:FindFirstChild("Remotes")
		Net.Redeem = rem and rem:FindFirstChild("Redeem")
	end
	if not Net.Redeem then return false, "Redeem remote missing" end
	return pcall(function()
		return Net.Redeem:InvokeServer(tostring(code))
	end)
end

function Net.ResolveFastAttackRemotes()
	if Net.RegAttack and Net.RegAttack.Parent and Net.RegHit and Net.RegHit.Parent then
		return Net.RegAttack, Net.RegHit
	end
	pcall(function()
		local mods = ReplicatedStorage:FindFirstChild("Modules")
		local netFolder = mods and mods:FindFirstChild("Net")
		if netFolder then
			Net.RegAttack = netFolder:FindFirstChild("RE/RegisterAttack")
			Net.RegHit = netFolder:FindFirstChild("RE/RegisterHit")
		end
	end)
	return Net.RegAttack, Net.RegHit
end

function Net.GetSessionId()
	local now = os.clock()
	if Net.CachedSessionId and (now - Net.LastSessionCheck) < 15 then
		return Net.CachedSessionId
	end
	Net.LastSessionCheck = now
	local ok, sid = pcall(function()
		if type(getrenv) == "function" and type(getupvalues) == "function" then
			local renv = getrenv()
			local sendFn = renv and renv._G and renv._G.SendHitsToServer
			if type(sendFn) == "function" then
				local ups = getupvalues(sendFn)
				if ups and ups[1] then
					local uidSlice = tostring(LP.UserId):sub(2, 4)
					local memSlice = tostring(ups[1]):sub(11, 15)
					if #uidSlice > 0 and #memSlice > 0 then
						return uidSlice .. memSlice
					end
				end
			end
		end
		return nil
	end)
	if ok and type(sid) == "string" and #sid >= 4 then
		Net.CachedSessionId = sid
	end
	return Net.CachedSessionId
end

function Net.ClickAttackFallback()
	local ok = pcall(function()
		if type(mouse1click) == "function" then
			mouse1click()
			return
		end
		if type(mouse1press) == "function" and type(mouse1release) == "function" then
			mouse1press()
			mouse1release()
			return
		end
		error("no native click")
	end)
	if not ok then
		pcall(function()
			local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(800, 600)
			VirtualInputManager:SendMouseButtonEvent(vp.X * 0.5, vp.Y * 0.5, 0, true, game, 0)
			VirtualInputManager:SendMouseButtonEvent(vp.X * 0.5, vp.Y * 0.5, 0, false, game, 0)
		end)
	end
end

-- Modern 2025/2026 Multi-Target AoE Fast Attack (Modules.Net RE/RegisterAttack + RE/RegisterHit)
function Net.FastAttackBurst(range, includeMobs, includePlayers)
	local now = os.clock()
	if (now - (S.LastFastAtk or 0)) < (S.FastAttackDelay or 0.05) then return false end
	S.LastFastAtk = now
	local root = getRoot()
	local char = getChar()
	if not root or not char then return false end
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then return false end

	range = tonumber(range) or S.FastAttackRange or 65
	local hits = {}
	local primaryPart = nil

	local function collectFrom(folder, isPlayerFolder)
		if not folder then return end
		for _, model in ipairs(folder:GetChildren()) do
			if model ~= char and model:IsA("Model") then
				local hum = model:FindFirstChildOfClass("Humanoid")
				local hitPart = model:FindFirstChild("RightLowerLeg")
					or model:FindFirstChild("UpperTorso")
					or model:FindFirstChild("Head")
					or model:FindFirstChild("HumanoidRootPart")
				if hum and hum.Health > 0 and hitPart then
					local d = (hitPart.Position - root.Position).Magnitude
					if d <= range then
						if not primaryPart then primaryPart = hitPart end
						table.insert(hits, { model, hitPart })
					end
				end
			end
		end
	end

	if includeMobs ~= false then
		collectFrom(Workspace:FindFirstChild("Enemies"), false)
		collectFrom(Workspace:FindFirstChild("SeaBeasts"), false)
	end
	if includePlayers then
		collectFrom(Workspace:FindFirstChild("Characters"), true)
	end

	if #hits == 0 or not primaryPart then return false end

	local regAtk, regHit = Net.ResolveFastAttackRemotes()
	if regAtk and regHit then
		local ok = pcall(function()
			regAtk:FireServer(0)
			local sid = Net.GetSessionId()
			if sid then
				regHit:FireServer(primaryPart, hits, nil, sid)
			else
				regHit:FireServer(primaryPart, hits)
			end
		end)
		if ok then return true end
	end

	if S.ClickFallback then
		Net.ClickAttackFallback()
	end
	return false
end

function Net.FastAttackStatus()
	local a, h = Net.ResolveFastAttackRemotes()
	if a and h then
		local sid = Net.GetSessionId()
		return sid and "Modules.Net v2 (SessionID OK)" or "Modules.Net v2 (Active)"
	end
	return "Click Fallback"
end

function Net.SendKey(keyStr)
	pcall(function()
		local kc = Enum.KeyCode[keyStr]
		if kc then
			VirtualInputManager:SendKeyEvent(true, kc, false, game)
			task.wait(0.03)
			VirtualInputManager:SendKeyEvent(false, kc, false, game)
		end
	end)
end

