-- Modern Bring Mob Magnet with SimulationRadius + WalkSpeed=0 freeze
function Eng.Combat.BringMobsTo(targetMob)
	if not S.BringMobs or not targetMob then return end
	local now = os.clock()
	if (now - S.LastBring) < 0.25 then return end
	S.LastBring = now
	local tRoot = targetMob:FindFirstChild("HumanoidRootPart")
	if not tRoot then return end
	local base = Eng.Combat.BaseMobName(targetMob.Name)
	local rad = S.BringRadius or 220

	pcall(function()
		if type(sethiddenproperty) == "function" then
			sethiddenproperty(LP, "SimulationRadius", math.huge)
		end
	end)

	local anchorCF = tRoot.CFrame
	for _, other in ipairs(Eng.Combat.GetEnemies()) do
		if Eng.Combat.MobMatches(other.Name, base) then
			local oroot = other:FindFirstChild("HumanoidRootPart")
			local ohum = other:FindFirstChildOfClass("Humanoid")
			if oroot and ohum and (oroot.Position - anchorCF.Position).Magnitude <= rad then
				pcall(function()
					oroot.CFrame = anchorCF
					oroot.CanCollide = false
					oroot.Size = Vector3.new(12, 12, 12)
					zeroVel(oroot)
					ohum.WalkSpeed = 0
					ohum.JumpPower = 0
					local anim = ohum:FindFirstChildOfClass("Animator")
					if anim then
						for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do tr:Stop() end
					end
				end)
			end
		end
	end
end

