	local snap = S.SavedAvatar
	trackThread(function()
		Net.ResetAvatar()
		task.wait(0.35)
		Net.ChangeBody(snap.Body)
		task.wait(0.2)
		if snap.SkinTone then Net.SkinColor(snap.SkinTone); task.wait(0.1) end
		if snap.Shirt and snap.Shirt > 0 then Net.Wear(snap.Shirt); task.wait(0.1) end
		if snap.Pants and snap.Pants > 0 then Net.Wear(snap.Pants); task.wait(0.1) end
		if snap.Face and snap.Face > 0 then Net.Wear(snap.Face); task.wait(0.1) end
