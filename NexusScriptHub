local function nexusApplySkinMedia(weapon, skin)
	if not weapon or not skin then return 0 end
	local changed = 0
	local wname = type(weapon) == "string" and weapon or weapon.Name
	local sname = type(skin) == "string" and skin or skin.Name
	if not wname or not sname then return 0 end
	local prefix = wname .. "|" .. sname .. "|"
	local soundMap = ag[skin]
	local soundRev = nil
	if type(soundMap) == "table" then
		soundRev = {}
		for base, sk in pairs(soundMap) do soundRev[base] = sk end
	end
	for _, d in ipairs(weapon:GetDescendants()) do
		local cls = d.ClassName
		if cls == "Animation" then
			local id = d.AnimationId
			if type(id) == "string" then
				local newId = nexusHarvestedAnims[prefix .. id]
				if newId and newId ~= "" and newId ~= id then
					d.AnimationId = newId
					changed = changed + 1
				end
			end
		elseif cls == "Sound" and soundRev then
			local sid = d.SoundId
			if type(sid) == "string" then
				local newId = soundRev[sid]
				if newId and newId ~= "" and newId ~= sid then
					d.SoundId = newId
					changed = changed + 1
				end
			end
		end
	end
	return changed
end

