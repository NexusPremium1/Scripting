-- 6. UNIFIED RUNTIME LOOPS & EVENT WATCHERS (Single Heartbeat / Stepped Bus)
--============================================================================--
local function startRuntimeLoops()
	-- Anti-AFK
	trackConn(LocalPlayer.Idled:Connect(function()
		if S.Unloaded or not S.AntiAFKOn then return end
		pcall(function()
			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.zero)
		end)
	end))

	-- Instant Auto-Unban & Anti-Lag & Anti-SoundSpam watcher (event-driven, instant bail when idle!)
	trackConn(Workspace.DescendantAdded:Connect(function(d)
		if S.Unloaded or (not S.AutoUnbanOn and not S.AntiLagOn and not S.AntiSoundSpamOn) then return end
		if S.AutoUnbanOn then
			local n = d.Name
			if n:find("BannedBlock") or n:find("BanBlock") or n:find("HouseBan") then
				task.defer(function()
					pcall(function() d:Destroy() end)
				end)
			end
		end
		if S.AntiLagOn then
			if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles") then
				pcall(function() d.Enabled = false end)
			elseif d:IsA("Explosion") then
				pcall(function() d.Visible = false end)
			end
		end
		if S.AntiSoundSpamOn and isExternalSpamSound(d) then
			if S.MutedSounds[d] == nil then S.MutedSounds[d] = d.Volume end
			d.Volume = 0
		end
	end))

	-- Infinite Jump + Car Jump
	trackConn(UserInputService.JumpRequest:Connect(function()
		if S.Unloaded then return end
		if S.InfJumpOn then
			local hum = getHum()
			if hum and not hum.SeatPart then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
		if S.CarJumpOn then
			local _, seat = Eng.Vehicle.GetSeatedVehicle()
			if seat and seat.Occupant == getHum() then
				seat.AssemblyLinearVelocity = seat.AssemblyLinearVelocity + Vector3.new(0, 65, 0)
			end
		end
	end))

	-- Ctrl + Click Teleport
	trackConn(UserInputService.InputBegan:Connect(function(input, gp)
		if S.Unloaded or gp then return end
		if S.CtrlClickTpOn and input.UserInputType == Enum.UserInputType.MouseButton1 then
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
				local mouse = LocalPlayer:GetMouse()
				if mouse and mouse.Hit then
					safePivot(getChar(), CFrame.new(mouse.Hit.Position + Vector3.new(0, 3.5, 0)))
				end
			end
		end
	end))

	-- Clean ESP on Player Leave
	trackConn(Players.PlayerRemoving:Connect(function(p)
		Eng.Player.ClearESPFor(p)
	end))

	-- Dupe / Hide Tools PreSimulation (Safe Seated state tracking)
	trackConn(RunService.PreSimulation:Connect(function()
		if S.Unloaded then return end
		local char = getChar()
		local hum = getHum()
		if S.DupeToolsOn then
			local root = getRoot()
			local bp = LocalPlayer:FindFirstChild("Backpack")
			if not hum or not root then return end
			if not S.DupeSeatedDisabled then
				pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false) end)
				S.DupeSeatedDisabled = true
			end
			if not S.DupeOrigCF then S.DupeOrigCF = root.CFrame end
			zeroVelocity(root)
			root.CFrame = S.DupeOrigCF
			if bp then
				for _, t in ipairs(bp:GetChildren()) do
					if t:IsA("Tool") then t.Parent = char end
				end
			end
			for _, t in ipairs(char:GetChildren()) do
				if t:IsA("Tool") and t:FindFirstChild("Handle") then
					local vp = Vector3.new(0, -99999, 0)
					if t.GripPos ~= vp then t.GripPos = vp end
				end
			end
		elseif S.DupeSeatedDisabled and hum then
			if not S.AntiSitOn then
				pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
			end
			S.DupeSeatedDisabled = false
			S.DupeOrigCF = nil
		end
	end))

	-- Stepped Bus: Noclip & Car Noclip & Movement Locks (Cached part lists — zero per-frame GetDescendants!)
	local ncCharRef, ncCharParts, ncCharT = nil, {}, 0
	local ncCarRef, ncCarParts, ncCarT = nil, {}, 0
	trackConn(RunService.Stepped:Connect(function()
		if S.Unloaded then return end
		local now = os.clock()
		local char = getChar()
		local hum = getHum()
		if S.NoclipOn and char then
			if char ~= ncCharRef or (now - ncCharT) > 0.6 then
				ncCharRef = char
				ncCharT = now
				ncCharParts = {}
				for _, p in ipairs(char:GetChildren()) do
					if p:IsA("BasePart") then table.insert(ncCharParts, p) end
				end
			end
			for _, p in ipairs(ncCharParts) do
				if p.Parent and p.CanCollide then p.CanCollide = false end
			end
		end
		if S.CarNoclipOn then
			local car, seat = Eng.Vehicle.GetSeatedVehicle()
			if car and seat and seat.Occupant == hum then
				if car ~= ncCarRef or (now - ncCarT) > 0.8 then
					ncCarRef = car
					ncCarT = now
					ncCarParts = {}
					for _, p in ipairs(car:GetDescendants()) do
						if p:IsA("BasePart") then table.insert(ncCarParts, p) end
					end
				end
				for _, p in ipairs(ncCarParts) do
					if p.Parent and p.CanCollide then p.CanCollide = false end
				end
			end
		end
		if hum then
			if S.LockWalkSpeed and hum.WalkSpeed ~= S.WalkSpeed then
				hum.WalkSpeed = S.WalkSpeed
			end
			if S.LockJumpPower then
				if hum.UseJumpPower then
					if hum.JumpPower ~= S.JumpPower then hum.JumpPower = S.JumpPower end
				else
					hum.UseJumpPower = true
					hum.JumpPower = S.JumpPower
				end
			end
			if S.AirSwimOn and not hum.SeatPart then
				hum:ChangeState(Enum.HumanoidStateType.Swimming)
			end
		end
	end))

	-- Heartbeat Bus: Fly, Car Fly, Turbo V2, Follow Modes, Protections, ESP
	local orbitAngle = 0
	local bangPhase = 0
	local lastSlowTick = 0
	local lastProtTick = 0
	trackConn(RunService.Heartbeat:Connect(function(dt)
		if S.Unloaded then return end
		local now = os.clock()

		-- Character Fly & Car Fly
		if S.FlyOn then Eng.Player.UpdateFly() end
		if S.CarFlyOn then Eng.Vehicle.UpdateCarFly(dt) end

		-- Turbo V2 Shift Boost
		if S.CarTurboV2On and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
			local _, seat = Eng.Vehicle.GetSeatedVehicle()
			if seat and seat.Occupant == getHum() then
				local fwd = seat.CFrame.LookVector
				seat.AssemblyLinearVelocity = Vector3.new(fwd.X * S.CarTurboPower, seat.AssemblyLinearVelocity.Y, fwd.Z * S.CarTurboPower)
			end
		end

		-- Spinbot
		if S.SpinOn then
			local root = getRoot()
			local hum = getHum()
			if root and hum and not hum.SeatPart then
				root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(S.SpinSpeed), 0)
			end
		end

		-- Target Follow Modes (Headsit / Orbit / Bang / Loop TP / Child Follow)
		if S.HeadsitOn or S.OrbitOn or S.BangOn or S.LoopTpOn or S.ChildFollowOn then
			local tPlr = resolvePlayer(S.SelectedPlayer)
			local tChar = getChar(tPlr)
			local tRoot = getRoot(tPlr)
			local root = getRoot()
			local hum = getHum()
			if tChar and tRoot and root and hum then
				if S.HeadsitOn then
					local tHead = tChar:FindFirstChild("Head") or tRoot
					hum.Sit = true
					root.CFrame = tHead.CFrame * CFrame.new(0, 1.75, 0)
					zeroVelocity(root)
				elseif S.OrbitOn then
					orbitAngle = (orbitAngle + dt * S.OrbitSpeed) % (math.pi * 2)
					local off = Vector3.new(math.cos(orbitAngle) * S.OrbitRadius, 1.2, math.sin(orbitAngle) * S.OrbitRadius)
					root.CFrame = CFrame.lookAt(tRoot.Position + off, tRoot.Position)
					zeroVelocity(root)
				elseif S.BangOn then
					bangPhase = bangPhase + (dt * S.BangSpeed)
					local dist = 1.15 + math.sin(bangPhase) * 0.75
					root.CFrame = tRoot.CFrame * CFrame.new(0, 0, dist)
					zeroVelocity(root)
				elseif S.LoopTpOn then
					root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
					zeroVelocity(root)
				elseif S.ChildFollowOn then
					root.CFrame = tRoot.CFrame * CFrame.new(1.8, -0.5, 2.2)
					zeroVelocity(root)
				end
			end
		end

		-- Protections tick (12 Hz — fast & light)
		if (now - lastProtTick) >= 0.08 then
			lastProtTick = now
			Eng.Protect.TickProtections()
			if S.CarSpeedLock then
				Eng.Vehicle.ApplyTuning(S.CarSpeedVal, S.CarTurboStage, nil)
			end
		end

		-- ESP update (15 Hz)
		if (now - lastSlowTick) >= 0.065 then
			lastSlowTick = now
			Eng.Player.UpdateESP()
			if S.FullbrightOn then
				Lighting.Brightness = 2.5
				Lighting.ClockTime = 14
				Lighting.GlobalShadows = false
				Lighting.Ambient = Color3.fromRGB(180, 180, 180)
			end
			if S.NoFogOn then
				Lighting.FogEnd = 100000
			end
		end
	end))

	-- Throttled Remote FX Loops (RGB Name/Bio/Body/Car/House, Glitch, Horn, Car/Bomb/Sound/Child Spam)
	trackThread(function()
		local skinIdx = 1
		local glitchStep = 1
		local carSpawnIdx = 1
		local lastBodyT = 0
		local lastCarT = 0
		local lastHouseT = 0
		local lastHornT = 0
		local lastSpamCarT = 0
		local lastBombT = 0
		local lastSfxT = 0
		local lastVolBoostT = 0
		local lastChildT = 0
		local lastGlitchT = 0
		local lastNameT = 0

		while not S.Unloaded do
			local now = os.clock()

			if (S.RainbowNameOn or S.RainbowBioOn) and (now - lastNameT) >= 0.14 then
				lastNameT = now
				local c = nextRainbow(0.035)
				if S.RainbowNameOn then Net.SetRPNameColor(c) end
				if S.RainbowBioOn then Net.SetRPBioColor(c) end
			end

			if S.GlitchNameOn and (now - lastGlitchT) >= 0.25 then
				lastGlitchT = now
				local base = (S.GlitchBaseName ~= "" and S.GlitchBaseName) or "NEXUS"
				glitchStep = (glitchStep % (#base + 2)) + 1
				local shown = (glitchStep <= #base) and string.sub(base, 1, glitchStep) or (base .. " ★")
				Net.SetRPName(shown)
			end

			if S.RainbowBodyOn and (now - lastBodyT) >= 0.35 then
				lastBodyT = now
				skinIdx = (skinIdx % #DATA.SkinTones) + 1
				Net.SkinColor(DATA.SkinTones[skinIdx])
			end

			if S.CarRGBOn and (now - lastCarT) >= math.max(0.05, S.CarRGBSpeed) then
				lastCarT = now
				Net.CarEvent("PickingCarColor", nextRainbow(0.04))
			end

			if S.RainbowHouseOn and (now - lastHouseT) >= 0.22 then
				lastHouseT = now
				Net.HouseEvent("PickingHouseColor", nextRainbow(0.04))
			end

			if S.CarHornSpam and (now - lastHornT) >= 0.25 then
				lastHornT = now
				Net.CarEvent("Horn")
			end

			if S.CarSpamSpawn and (now - lastSpamCarT) >= 0.9 then
				lastSpamCarT = now
				carSpawnIdx = (carSpawnIdx % #DATA.Cars) + 1
				Net.SpawnCar(DATA.Cars[carSpawnIdx])
			end

			if S.BombSpamOn and (now - lastBombT) >= math.max(0.15, S.BombSpamDelay) then
				lastBombT = now
				Net.BlowBomb(math.random(1, 5))
			end

			-- Loop Sound handled by dedicated non-overlapping 1Gu1n loop thread

			if S.AudioMaxVolBoost and (now - lastVolBoostT) >= 0.25 then
				lastVolBoostT = now
				Eng.Audio.TickMaxVolumeBoost()
			end

			if S.ChildSpamOn and (now - lastChildT) >= 0.65 then
				lastChildT = now
				local tPlr = resolvePlayer(S.SelectedPlayer)
				if tPlr then
					Net.TriggerEvent("Client2Client", "Request: Piggyback!", tPlr)
					Net.BabyFollow("FollowPlayer", tPlr)
				end
			end

			task.wait(0.05)
		end
	end)
end

