------------------------------------------------------------------------------
local Engine = {}
local activeTrack, activeId, activeName
local lastAnimObj

function Engine.character()
	local ch = LocalPlayer.Character
	if not ch then
		local ok, c = pcall(function()
			LocalPlayer.CharacterAdded:Wait()
			return LocalPlayer.Character
		end)
		ch = ok and c or LocalPlayer.Character
	end
	return ch
end

function Engine.humanoid(ch)
	ch = ch or Engine.character()
	return ch and ch:FindFirstChildOfClass("Humanoid") or nil
end

function Engine.animator(hum)
	if not hum then return nil end
	local a = hum:FindFirstChildOfClass("Animator")
	if not a then
		a = Instance.new("Animator")
		a.Parent = hum
	end
	return a
end

local PRIORITY = {
	[0] = Enum.AnimationPriority.Action,
	[1] = Enum.AnimationPriority.Movement,
	[2] = Enum.AnimationPriority.Idle,
	[3] = Enum.AnimationPriority.Core,
}
local PRIORITY_NAME = { [0] = "Action", [1] = "Movement", [2] = "Idle", [3] = "Core" }

function Engine.stop(fade)
	local t = activeTrack
	activeTrack = nil
	if t then
		pcall(function() t:Stop(fade or CONFIG.fade) end)
		pcall(function() t:Destroy() end) -- keeps the 64-track limit away
	end
end

function Engine.play(id, name, opts)
	opts = opts or {}
	local hum = Engine.humanoid()
	if not hum then
		toast("No character found — respawn and try again.", "bad")
		return nil
	end
	if hum.RigType == Enum.HumanoidRigType.R6 and not Engine._r6 then
		Engine._r6 = true
		toast("R6 rig detected — some emotes are R15-only.", "warn")
	end

	local animator = Engine.animator(hum)
	if lastAnimObj then pcall(function() lastAnimObj:Destroy() end) end
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. tostring(id)
	lastAnimObj = anim

	Engine.stop(0)
	local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
	if not ok or not track then
		-- animator refresh fallback (track-limit safety net)
		pcall(function() animator:Destroy() end)
		local fresh = Instance.new("Animator")
		fresh.Parent = hum
		ok, track = pcall(function() return fresh:LoadAnimation(anim) end)
	end
	if not ok or not track then
		toast("Could not load ID " .. tostring(id) .. " (restricted asset).", "bad")
		return nil
	end

	pcall(function()
		track.Priority = PRIORITY[CONFIG.priority] or Enum.AnimationPriority.Idle
		track.Looped = (opts.looped ~= nil) and opts.looped or CONFIG.looped
		track:Play(opts.fade or CONFIG.fade)
		track:AdjustSpeed(opts.speed or CONFIG.speed)
	end)

	activeTrack, activeId, activeName = track, id, name or tostring(id)
	if Engine.onChange then Engine.onChange(activeId, activeName) end

	if CONFIG.spam and not opts.noSpam then
		Engine._spamToken = (Engine._spamToken or 0) + 1
		local token = Engine._spamToken
		task.spawn(function()
			while CONFIG.spam and Engine._spamToken == token and activeId == id do
				task.wait(CONFIG.spamDelay)
				if not (CONFIG.spam and Engine._spamToken == token and activeId == id) then break end
				Engine.play(id, name, { fade = 0.04, noSpam = true })
			end
		end)
	end
	return track
end

function Engine.isPlaying() return activeTrack ~= nil end
function Engine.current() return activeId, activeName end

