		local animId = tonumber(entry[2]) or 0
		if isR6 and animId > 1000000000 then
			local CLASSIC = { 180435571, 180435792, 182435998 }
			animId = CLASSIC[math.random(#CLASSIC)]
			pcall(function()
				nexusNotify("R6 avatar: UGC dances need R15, classic dance used")
			end)
		end

		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://" .. tostring(animId)
		pcall(function() anim.Parent = animator or hum end)

		-- v5.4 · v5.2 gave up on an id when LoadAnimation/Length looked wrong.
		-- Now: animator first, humanoid as fallback, and an id is only marked
		-- broken after it really refused to move.
		local track = nil
		if animator then
			local ok, res = pcall(function() return animator:LoadAnimation(anim) end)
			if ok then track = res end
		end
		if not track then
			local ok, res = pcall(function() return hum:LoadAnimation(anim) end)
			if ok then track = res end
		end
		if not track then
			pcall(function() anim:Destroy() end)
			return false, "LoadAnimation failed"
		end

		for _, pr in ipairs({ "Action4", "Action3", "Action2", "Action", "Movement" }) do
			local ok = pcall(function() track.Priority = Enum.AnimationPriority[pr] end)
			if ok then break end
		end
		pcall(function() track.Looped = Anim.Loop ~= false end)

		local spd = tonumber(Anim.Speed) or 1
		local played = pcall(function() track:Play(0.1, 1, spd) end)
		if not played then
			pcall(function() anim:Destroy() end)
			return false, "roblox refused this id"
		end

		Anim.Track = track
		Anim.Name = name
		Anim.Broken[entry[2]] = nil
		local startPos = 0
		pcall(function() startPos = tonumber(track.TimePosition) or 0 end)

		-- 0.6 s later: did the clock actually move? Length and IsPlaying both
		-- lie right after load, TimePosition does not
		task.spawn(function()
			task.wait(0.6)
			if Anim.Track ~= track then return end
			local moving = false
			pcall(function() moving = (tonumber(track.TimePosition) or 0) > startPos + 0.01 end)
			if moving then return end
			pcall(function() track:Play(0.1, 1, spd) end)
			task.wait(0.5)
			local still = false
			pcall(function() still = Anim.Track == track and (tonumber(track.TimePosition) or 0) > startPos + 0.01 end)
			if not still and Anim.Track == track then
				Anim.Broken[entry[2]] = true
				pcall(function() track:Stop(0) end)
				Anim.Track = nil
				Anim.Name = "OFF"
				pcall(function() nexusNotify("this animation id is blocked in this game") end)
				pcall(function() if panel and panel.Paint then panel.Paint() end end)
			end
		end)

		pcall(function()
			track.Stopped:Connect(function()
				if Anim.Track == track and Anim.Name == name and Anim.Loop ~= false then
					pcall(function() track:Play(0.1, 1, spd) end)
				end
			end)
		end)
		return true
	end

