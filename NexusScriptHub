Nexus.Connections.Heartbeat = RunService.RenderStepped:Connect(function(delta)
    local char = getRealChar()
    local hrp = getRealHRP()
    local hum = getRealHum()

    local structure = Workspace:FindFirstChild("Structure")
    if structure then
        local mapModel = structure:FindFirstChildOfClass("Model")
        Nexus.Round.Map = mapModel and mapModel.Name or "Intermission / Lobby"
    else
        Nexus.Round.Map = "Lobby"
    end

