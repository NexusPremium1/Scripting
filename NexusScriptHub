local function LegacyCheckAnimations()
    if not State.LegacyAutoBlock then return end
    -- PERFORMANCE: this function called GetPlayingAnimationTracks() for every player
    -- every frame, which meant 60 Hz * player count calls;
    -- that was the main source of the "itching / stutter" reports. Cut to 20 Hz.
    local clockNow = os.clock()
    if clockNow < (State.LegacyABNext or 0) then return end
    State.LegacyABNext = clockNow + 0.05
    local live = workspace:FindFirstChild("Live")
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char or (live and char.Parent ~= live) then continue end
        local targetRoot = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not targetRoot or not hum then continue end
        local distance = (targetRoot.Position - myRoot.Position).Magnitude
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then continue end
        local playing = {}
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local anim = track.Animation
            local id = anim and tonumber(anim.AnimationId:match("%d+"))
            if id then playing[id] = true end
        end
        local comboCount = 0
        for _, id in ipairs(LegacyComboIDs) do
            if playing[id] then comboCount += 1 end
        end
        for _, group in pairs(LegacyAllIDs) do
            local normalHits = 0
            local special = playing[group.special]
            for i = 1, 4 do
                if playing[group[i]] then normalHits += 1 end
            end
            if comboCount == 2 and normalHits >= 2 and distance <= State.LegacySpecialRange then
                LegacyFireRemote("KeyPress")
                task.delay(0.7, function() LegacyFireRemote("KeyRelease") end)
                return
            elseif normalHits > 0 and distance <= State.LegacyNormalRange then
                LegacyFireRemote("KeyPress")
                task.delay(0.15, function() LegacyFireRemote("KeyRelease") end)
                LegacyDoAfterBlock(targetRoot)
                return
            elseif special and distance <= State.LegacySpecialRange and not State.LegacyM1Catch then
                LegacyFireRemote("KeyPress")
                task.delay(1, function() LegacyFireRemote("KeyRelease") end)
                return
            end
        end
        for animId in pairs(playing) do
            if LegacySkillIDs[animId] and distance <= State.LegacySkillRange then
                LegacyFireRemote("KeyPress")
                task.delay(State.LegacySkillDelay, function() LegacyFireRemote("KeyRelease") end)
                return
            end
        end
    end
end

local function LegacyCheckM1Catch()
    if not State.LegacyAutoBlock or not State.LegacyM1Catch then return end
    local clockNow2 = os.clock()
    if clockNow2 < (State.LegacyM1Next or 0) then return end
    State.LegacyM1Next = clockNow2 + 0.1
    local live = workspace:FindFirstChild("Live")
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char or (live and char.Parent ~= live) then continue end
        local targetRoot = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not targetRoot or not hum then continue end
        local firstDistance = (targetRoot.Position - myRoot.Position).Magnitude
        if firstDistance > 30 then continue end
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then continue end
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local anim = track.Animation
            local id = anim and tonumber(anim.AnimationId:match("%d+"))
            if id == 10479335397 then
                task.delay(0.1, function()
                    if not myRoot.Parent or not targetRoot.Parent then return end
                    local secondDistance = (targetRoot.Position - myRoot.Position).Magnitude
                    if secondDistance < firstDistance - 0.5 and os.clock() - State.LegacyLastCatch >= 5 then
                        State.LegacyLastCatch = os.clock()
                        LegacyFireRemote("LeftClick", true)
                        task.delay(0.2, function() LegacyFireRemote("LeftClickRelease", true) end)
