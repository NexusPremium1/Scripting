local aimScopeHeld = false
pcall(function()
	UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then aimScopeHeld = true end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then aimScopeHeld = false end
	end)
end)

local function aimScoped()
	if aimScopeHeld then return true end
	local ok, pressed = pcall(function()
		return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
	end)
	return (ok and pressed) and true or false
end

local aimbotRange = 900            -- max distance in studs
local aimbotVisibleOnly = false    -- wall check (raycast before aiming)
local aimbotPredictLead = 0.12     -- seconds of velocity lead when Prediction is on

local aimRayParams = nil
local function aimVisible(part)
	local cam = workspace.CurrentCamera
	if not cam or not part then return false end
	if not aimRayParams then
		aimRayParams = RaycastParams.new()
		aimRayParams.FilterType = Enum.RaycastFilterType.Exclude
		aimRayParams.IgnoreWater = true
	end
	local ignore = { cam }
	if k.Character then table.insert(ignore, k.Character) end
	aimRayParams.FilterDescendantsInstances = ignore
	local origin = cam.CFrame.Position
	local hit = Workspace:Raycast(origin, part.Position - origin, aimRayParams)
	if not hit then return true end
	return hit.Instance == part or (part.Parent ~= nil and hit.Instance:IsDescendantOf(part.Parent))
end

local function aimTargetPos(plr, partName, predict)
	local char = plr and plr.Character
	if not char then return nil end
	local part = getTargetPart(char, partName)
	if not part then return nil end
	local pos = part.Position
	if predict and predict > 0 then
		local vel = part.AssemblyLinearVelocity or part.Velocity
		if vel then pos = pos + vel * predict end
	end
	return pos, part
end

local function aimPickByMouse(fovPx, partName, visibleOnly, maxRange)
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local mouse = UserInputService:GetMouseLocation()
	local best, bestDist = nil, math.huge
	local myRoot = k.Character and k.Character:FindFirstChild("HumanoidRootPart")
	local myPos = myRoot and myRoot.Position or cam.CFrame.Position

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= k and isPlayerAlive(plr) then
			local pos, part = aimTargetPos(plr, partName, 0)
			if pos then
				local screenPos, onScreen = cam:WorldToViewportPoint(pos)
				if onScreen and screenPos.Z > 0 then
					local distance = (Vector2.new(screenPos.X, screenPos.Y) - mouse).Magnitude
					local inRange = (myPos - pos).Magnitude <= (maxRange or 900)
					if inRange and distance < fovPx and distance < bestDist then
						local okVisible = true
						if visibleOnly then okVisible = part ~= nil and aimVisible(part) end
						if okVisible then
							bestDist = distance
							best = plr
						end
					end
				end
			end
		end
	end
	return best
end

local function aimMoveMouse(dx, dy)
	if type(mousemoverel) == "function" then
		local ok = pcall(mousemoverel, dx, dy)
		if ok then return true end
	end
	if type(mousemoveabs) == "function" then
		local pos = UserInputService:GetMouseLocation()
		local ok = pcall(mousemoveabs, pos.X + dx, pos.Y + dy)
		if ok then return true end
	end
	return false
end

local aimTarget = nil
local function aimbotStep()
	local active = aimbotEnabled == true
	if fovCircle then
		if active then
			local mouse = UserInputService:GetMouseLocation()
			fovCircle.Position = UDim2.fromOffset(mouse.X, mouse.Y)
			fovCircle.Size = UDim2.new(0, aimbotFov * 2, 0, aimbotFov * 2)
		end
		fovCircle.Visible = active
	end
	if not active then
		aimTarget = nil
		return
	end
	-- v3.8 · if the scope (right mouse) is not held the mouse never moves
	if not aimScoped() then
		aimTarget = nil
		return
	end
	if UserInputService:GetFocusedTextBox() then return end

	local cam = workspace.CurrentCamera
	if not cam then return end

	local target = aimPickByMouse(aimbotFov, aimbonePart, aimbotVisibleOnly, aimbotRange)
	aimTarget = target
	if not target then return end

	local worldPos = aimTargetPos(target, aimbonePart, predictionEnabled and aimbotPredictLead or 0)
	if not worldPos then return end

	local screenPos, onScreen = cam:WorldToViewportPoint(worldPos)
	if not onScreen or screenPos.Z <= 0 then return end

	local goal = Vector2.new(screenPos.X, screenPos.Y)
	local current = UserInputService:GetMouseLocation()
	-- v3.8 · NEXUS AIM CORE:  (target - mouse) / max(1, smoothness / 10)
	-- 1 = instant lock · 100 = slow glide · NO deadzone (hard lock)
	local divisor = math.max(1, (getgenv().Smoothness or 65) / 10)
	local dx = (goal.X - current.X) / divisor
	local dy = (goal.Y - current.Y) / divisor
	aimMoveMouse(dx, dy)
end

