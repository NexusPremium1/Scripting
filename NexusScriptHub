			return
		end
		for index, entry in ipairs(S.Filtered) do
			if entry == target then
				play(index)
				return
			end
		end
		S.Query = ""
		if searchBox then searchBox.Text = "" end
		refilter()
		for index, entry in ipairs(S.Filtered) do
			if entry == target then
				play(index)
				return
			end
		end
		status("that name is not in the list anymore")
	end

	local function pickRandom()
		if os.clock() - (S.LastPlay or 0) < 0.25 then return end
		refilter()
		if #S.Filtered == 0 then
			status("nothing to pick")
			return
		end
		local alive = {}
		for index, entry in ipairs(S.Filtered) do
			if not S.Failed[entry[2]] then table.insert(alive, index) end
		end
		if #alive == 0 then
			status("every name in this search already failed")
			return
		end
		local index = alive[math.random(1, #alive)]
		S.Selected = S.Filtered[index]
		play(index)
	end

