local function setSlot(ch, nodeName, childNames, id)
	local animate = ch:FindFirstChild("Animate")
	if not animate then
		pcall(function()
			local ps = LocalPlayer:FindFirstChild("PlayerScripts")
			local src = ps and ps:FindFirstChild("Animate")
			if src then src.Parent = ch end
		end)
		animate = ch:FindFirstChild("Animate")
	end
	if not animate then return false end
	local node = animate:FindFirstChild(nodeName)
	if not node then return false end
	local done = false
	for _, childName in ipairs(childNames) do
		local a = node:FindFirstChild(childName)
		if a and a:IsA("Animation") then
			pcall(function() a.AnimationId = "rbxassetid://" .. tostring(id) end)
			done = true
		end
	end
	return done
end

function Engine.applyPack(slots, packName)
	local ch = Engine.character()
	local hum = Engine.humanoid(ch)
	if not ch or not hum then
		toast("No character found.", "bad")
		return
	end
	captureOriginals(ch)
	local applied = 0
	for _, slot in ipairs(SLOTS) do
		if CONFIG[slot.cfg] and slots[slot.key] then
			if setSlot(ch, slot.node, slot.children, slots[slot.key]) then
				applied = applied + 1
			end
		end
	end
	pcall(function()
		local animator = Engine.animator(hum)
		for _, t in next, animator:GetPlayingAnimationTracks() do
			pcall(function() t:Stop(0.1) end)
			pcall(function() t:Destroy() end)
		end
		hum:ChangeState(Enum.HumanoidStateType.Landed)
	end)
	toast(("%d slot(s) updated · %s"):format(applied, packName or "pack"), "good")
end

function Engine.resetAnimations()
	local ch = Engine.character()
	local animate = ch and ch:FindFirstChild("Animate")
	if not animate then
		toast("No Animate script — reset your character.", "bad")
		return
	end
	if originals.saved then
		local map = {
			{ "idle", "Animation1", originals.i1 }, { "idle", "Animation2", originals.i2 },
			{ "walk", "WalkAnim", originals.w }, { "run", "RunAnim", originals.r },
			{ "jump", "JumpAnim", originals.j }, { "fall", "FallAnim", originals.f },
			{ "climb", "ClimbAnim", originals.c }, { "swim", "Swim", originals.s },
			{ "swim", "SwimIdle", originals.si },
		}
		for _, row in ipairs(map) do
			local node = animate:FindFirstChild(row[1])
			local target = node and node:FindFirstChild(row[2])
			if target and row[3] then target.AnimationId = row[3] end
		end
	else
		-- originals unknown: let the default Animate script rebuild itself
		pcall(function()
			animate.Disabled = true
			task.wait(0.05)
			animate.Disabled = false
		end)
	end
	toast("Movement restored to default.", "good")
end

local crouching = false
local savedWalkSpeed

function Engine.crouch(state)
	local hum = Engine.humanoid()
	if not hum then return false end
	if state then
		if savedWalkSpeed == nil then savedWalkSpeed = hum.WalkSpeed end
		hum.WalkSpeed = 8
		crouching = true
		Engine.play(182724289, "Crouch", { looped = true, priority = 1 })
	else
		if savedWalkSpeed then hum.WalkSpeed = savedWalkSpeed end
		crouching = false
		Engine.stop()
	end
	return crouching
end

function Engine.isCrouching() return crouching end

