function Apex.ExecuteCompiled(item, fn, token)
	task.spawn(function()
		local started = os.clock()
		local finished = false
		Apex.Runtime.RunningName = item.Name
		-- Most modules never return (they run a RenderStepped loop). Hide the hub after a
		-- moment so the switch happens either way, and release the launch lock.
		task.delay(1.4, function()
			if finished or Apex.Runtime.LaunchToken ~= token or Apex.Runtime.Dead then return end
			Apex.Runtime.Launching = false
			Apex.Runtime.Running = true
			if item.Category == "Games" and State.Settings.CloseOnLaunch then
				Apex.HideHub("● RUNNING: " .. item.Name .. " · press the A button to return")
				Apex.PulseQuick()
			else
				Apex.SetStatus("● RUNNING: " .. item.Name, C.Green)
				Apex.PulseQuick()
			end
		end)
		local ok, err = pcall(fn)
		finished = true
		local elapsed = math.floor((os.clock() - started) * 1000 + 0.5)
		if Apex.Runtime.LaunchToken == token then
			Apex.Runtime.Launching = false
		end
		if not ok then
			Apex.Runtime.Running = false
			Apex.Log("ERROR", "Runtime error in " .. item.Name .. " after " .. tostring(elapsed) .. "ms: " .. tostring(err))
			if Apex.UI.Gui and Apex.UI.Gui.Parent then
				Apex.UI.Gui.Enabled = true
				if Apex.UI.Main then Apex.UI.Main.Visible = true end
				if Apex.UI.MiniDock then Apex.UI.MiniDock.Visible = false end
			end
			Apex.SetStatus("● ERROR — HUB RESTORED: " .. item.Name, C.Red)
			Apex.Toast("⚠ " .. item.Name .. " errored. Hub restored.", C.Red)
			return
		end
		Apex.Log("INFO", "Executed " .. item.Name .. " in " .. tostring(elapsed) .. "ms")
		if item.Category == "Games" and State.Settings.CloseOnLaunch and not Apex.Runtime.Dead then
			-- hide, never destroy: the A button must always get the hub back
			Apex.HideHub("● RUNNING: " .. item.Name .. " · press the A button to return")
			Apex.PulseQuick()
		else
			Apex.SetStatus("● RUNNING: " .. item.Name, C.Green)
			Apex.Toast("✓ " .. item.Name, C.Green)
			if Apex.RebuildCards then Apex.RebuildCards() end
		end
	end)
	task.delay(25, function()
		if Apex.Runtime.LaunchToken == token and Apex.Runtime.Launching then
			Apex.Runtime.Launching = false
			Apex.Log("WARN", item.Name .. " is still running after 25s; watchdog released the launch lock")
		end
	end)
end
function Apex.UnloadPrevious()
	-- stop whatever the hub started before: every bundled script registers
	-- getgenv().NexusUnload, the older ones use their own named hooks
	local genv = (typeof(getgenv) == "function" and getgenv()) or _G
	local stopped = false
	local function call(fn, label)
		if type(fn) ~= "function" then return end
		local ok, err = pcall(fn)
		if not ok then
			Apex.Log("WARN", "unload hook failed: " .. tostring(label) .. " · " .. tostring(err))
		else
			stopped = true
		end
	end
	call(genv.NexusUnload, "NexusUnload")
	call(genv.NexusTSBUnload, "NexusTSBUnload")
	call(genv.NexusMM2Unload, "NexusMM2Unload")
	call(genv.NexusDoorsUnload, "NexusDoorsUnload")
	call(genv.NexusBrookhavenUnload, "NexusBrookhavenUnload")
	call(genv.NexusBloxFruitsUnload, "NexusBloxFruitsUnload")
	if type(genv.NexusNDS) == "table" then call(genv.NexusNDS.Unload, "NexusNDS") end
	if type(genv.NexusBF) == "table" then call(genv.NexusBF.Unload, "NexusBF") end
	if type(genv.Library) == "table" and type(genv.Library.Unload) == "function" then
		call(function() genv.Library:Unload() end, "Library")
	end
	-- the shared hooks must not survive the next launch
	genv.NexusUnload = nil
	genv.NexusTSBUnload = nil
	genv.NexusMM2Unload = nil
	genv.NexusDoorsUnload = nil
	genv.NexusBrookhavenUnload = nil
	genv.NexusBloxFruitsUnload = nil
	if stopped then
		task.wait(0.2)
	end
	return stopped
end

function Apex.Launch(item)
	if not item then return end
	if Apex.Runtime.Launching then
		Apex.Toast("Another launch is in progress. Please wait.", C.Amber)
		return
	end
	if item.Run then
		Apex.RecordUse(item)
		local ok, err = pcall(item.Run)
		if ok then
			Apex.SetStatus("● RUNNING: " .. item.Name, C.Green)
		else
			Apex.Log("ERROR", "Built-in failed for " .. item.Name .. ": " .. tostring(err))
			Apex.Toast("⚠ " .. item.Name .. " failed: " .. tostring(err), C.Red)
		end
		if Apex.RebuildCards then Apex.RebuildCards() end
		return
	end
	Apex.Runtime.Launching = true
	Apex.Runtime.LaunchToken = Apex.Runtime.LaunchToken + 1
	local token = Apex.Runtime.LaunchToken
	-- v14: never unload previous scripts — every module self-manages its own
	-- re-run guard, so separate scripts keep running side by side.
	Apex.SetStatus("● COMPILING: " .. item.Name, C.Purple)
	local fn, err = Apex.Compile(item)
	if not fn then
		Apex.Runtime.Launching = false
		Apex.SetStatus("● COMPILE ERROR: " .. item.Name, C.Red)
		Apex.Toast("⚠ Compile error: " .. tostring(err), C.Red)
		return
	end
	Apex.RecordUse(item)
	Apex.SetStatus("● LAUNCHING: " .. item.Name, C.Purple)
	Apex.Toast("▶ Launching: " .. item.Name, C.Purple)
	Apex.Emit("Launch", item)
	if item.Category == "Games" and State.Settings.CloseOnLaunch and Apex.UI.Gui then
		-- keep the hub object alive, only hide it: the A button re-opens it at any time
		Apex.HideHub("● LAUNCHING: " .. item.Name, true)
		task.delay(0.3, function()
			if not Apex.Runtime.Dead then
				Apex.ExecuteCompiled(item, fn, token)
			end
		end)
	else
		Apex.ExecuteCompiled(item, fn, token)
	end
end
