--==============================================================================
-- BRANCH 2: DOORS IN-GAME (All Floors — 6 Clean Tabs, Zero-Leak Event Engine)
--==============================================================================
local function RunInGameBranch()
	EnableAntiAFK()

	-- Safe Game References (never hangs if a subfloor omits an optional remote)
	local GameData      = ReplicatedStorage:WaitForChild("GameData", 15)
	local Floor         = GameData and GameData:FindFirstChild("Floor")
	local LatestRoom    = GameData and GameData:FindFirstChild("LatestRoom")
	local RemotesFolder = ReplicatedStorage:FindFirstChild("EntityInfo")
		or ReplicatedStorage:FindFirstChild("RemotesFolder")
		or ReplicatedStorage:FindFirstChild("Bricks")
	local ClientModules = ReplicatedStorage:FindFirstChild("ModulesClient")
		or ReplicatedStorage:FindFirstChild("ClientModules")
	local MotorRep      = RemotesFolder and RemotesFolder:FindFirstChild("MotorReplication")
	local PLRemote      = RemotesFolder and RemotesFolder:FindFirstChild("PL")
	local MainUI        = LocalPlayer:WaitForChild("PlayerGui", 15):FindFirstChild("MainUI")
	local MainGame      = MainUI and MainUI:FindFirstChild("Initiator")
		and MainUI.Initiator:FindFirstChild("Main_Game")
	local RemoteListener = MainGame and MainGame:FindFirstChild("RemoteListener")
	-- CRITICAL FIX (image-7.png): DO NOT call require(MainGame) from an executor thread!
	-- Calling require(MainGame) in an executor (identity 7/8) tags Main_Game in Roblox VM as
	-- a RobloxScript module. When DOORS game script RemoteListener runs at line 19,
	-- it calls require(script.Parent) and crashes with:
	-- "Cannot require a RobloxScript module from a non RobloxScript context".
	-- Leaving RequiredMainGame nil keeps RemoteListener 100% stable without any errors.
	local RequiredMainGame = nil

	S.GameRefs = {
		Floor = Floor, LatestRoom = LatestRoom, RemotesFolder = RemotesFolder,
		ClientModules = ClientModules, MotorRep = MotorRep, PLRemote = PLRemote,
		MainGame = MainGame, RemoteListener = RemoteListener,
		RequiredMainGame = RequiredMainGame,
	}

	-- Screech models belong to the native game lifecycle. Never destroy them.
	-- Look assistance only; the game's own handler performs cleanup.
	-- Camera writes run at RenderPriority.Camera+1 — AFTER the game's own
	-- camera scripts. The old task.wait(0.05) loop lost the frame race: the
	-- look was overwritten before the game's damage check, so Screech bit.
	local function LookAtScreech(model)
		if S.Unloaded or not model or not model.Parent then return end
		local toggle = Toggles.AntiScreech
		if not toggle or not toggle.Value then return end
		S.ScreechLookTargets = S.ScreechLookTargets or {}
		S.ScreechLookTargets[model] = os.clock() + 6
	end
	S.ScreechLookTargets = {}
	pcall(function() RunService:UnbindFromRenderStep("NexusScreechLook") end)
	RunService:BindToRenderStep("NexusScreechLook", Enum.RenderPriority.Camera.Value + 1, function()
		local cam = workspace.CurrentCamera
		if not cam or S.Unloaded then return end
		if not (Toggles.AntiScreech and Toggles.AntiScreech.Value) then
			table.clear(S.ScreechLookTargets)
			return
		end
		local now = os.clock()
		for model, untilT in pairs(S.ScreechLookTargets) do
			if now > untilT or not model.Parent then
				S.ScreechLookTargets[model] = nil
			else
				local target = model:FindFirstChild("Root") or model:FindFirstChildWhichIsA("BasePart")
				if target and target:IsA("BasePart") then
					pcall(function()
						cam.CFrame = CFrame.lookAt(cam.CFrame.Position, target.Position)
					end)
				end
			end
		end
	end)
	-- (Re)bind the camera-screech hook: CurrentCamera is REPLACED on respawn,
	-- elevator and floor transitions — a once-bound connection silently dies
	-- there and AntiScreech stops firing (classic Screech = camera child).
	local function BindScreechCamera()
		local cam = workspace.CurrentCamera
		if not cam or S.ScreechCamBound == cam then return end
		S.ScreechCamBound = cam
		local function hook(child)
			if child.Name == "Screech" or child.Name == "SCJVEREECH" or child.Name == "ScreechRetro" then
				task.delay(0.05, function() pcall(LookAtScreech, child) end)
			end
		end
		for _, child in ipairs(cam:GetChildren()) do
			hook(child)
		end
		TrackConn(cam.ChildAdded:Connect(function(child)
			if S.Unloaded then return end
			hook(child)
		end))
	end
	BindScreechCamera()
	TrackConn(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		task.defer(BindScreechCamera)
	end))

	S.SeekPathFolder = Instance.new("Folder")
	S.SeekPathFolder.Name = "NexusSeekPath"
	S.SeekPathFolder.Parent = workspace


	-- Originals-Safe Property Mutators (0 attribute type errors, 100% restorable)
	local function ApplyPromptDuration(p, instant)
		if not p or not p:IsA("ProximityPrompt") then return end
		if instant then
			if S.PromptDuration[p] == nil then S.PromptDuration[p] = p.HoldDuration end
			p.HoldDuration = 0
		elseif S.PromptDuration[p] ~= nil then
			p.HoldDuration = S.PromptDuration[p]
		end
	end

	local function ApplyPromptRange(p, enabled)
		if not p or not p:IsA("ProximityPrompt") then return end
		if enabled then
			if S.PromptRange[p] == nil then S.PromptRange[p] = p.MaxActivationDistance end
			local mult = (Options.PromptReachMult and Options.PromptReachMult.Value) or 2
			p.MaxActivationDistance = S.PromptRange[p] * mult
		elseif S.PromptRange[p] ~= nil then
			p.MaxActivationDistance = S.PromptRange[p]
		end
	end

	local function ApplyPromptLOS(p, noClip)
		if not p or not p:IsA("ProximityPrompt") then return end
		if noClip then
			if S.PromptLOS[p] == nil then S.PromptLOS[p] = p.RequiresLineOfSight end
			p.RequiresLineOfSight = false
		elseif S.PromptLOS[p] ~= nil then
			-- Fixed legacy bug: Lua `false or true` always evaluated to true!
			p.RequiresLineOfSight = S.PromptLOS[p]
		end
	end

	local function ApplyPartTouch(part, disableTouch)
		if not part or not part:IsA("BasePart") then return end
		if disableTouch then
			if S.PartCanTouch[part] == nil then S.PartCanTouch[part] = part.CanTouch end
			part.CanTouch = false
		elseif S.PartCanTouch[part] ~= nil then
			part.CanTouch = S.PartCanTouch[part]
		end
	end

	local function ApplyModelTouch(model, disableTouch)
		if not model then return end
		if model:IsA("BasePart") then
			ApplyPartTouch(model, disableTouch)
			return
		end
		for _, child in ipairs(model:GetDescendants()) do
			if child:IsA("BasePart") then
				ApplyPartTouch(child, disableTouch)
			end
		end
	end

	local function ApplyPartAntiLag(part, enabled)
		if not part or not part:IsA("BasePart") then return end
		if enabled then
			if S.PartMaterial[part] == nil then S.PartMaterial[part] = part.Material end
			if S.PartShadow[part] == nil then S.PartShadow[part] = part.CastShadow end
			part.Material = Enum.Material.SmoothPlastic
			part.CastShadow = false
		else
			if S.PartMaterial[part] ~= nil then part.Material = S.PartMaterial[part] end
			if S.PartShadow[part] ~= nil then part.CastShadow = S.PartShadow[part] end
		end
	end

