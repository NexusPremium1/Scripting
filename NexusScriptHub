local function isTeammate(plr)
	if plr == nil or plr == k then return false end

	-- 1. Manual marks
	local NT = (type(getgenv) == "function" and getgenv().NexusTeam) or _G.NexusTeam
	if type(NT) == "table" then
		if NT.Manual and NT.Manual[plr.Name] then return true end
		if (NT.Mode == "Friends" or teamCheckMode == "Friends") then
			local ok, isFr = pcall(function() return plr:IsFriendsWith(k.UserId) end)
			if ok and isFr then return true end
			return false
		end
	end

	-- 2. Plain Roblox Teams (Roblox mode or Auto)
	local myTeam, theirTeam = k.Team, plr.Team
	if myTeam ~= nil and theirTeam ~= nil then
		return theirTeam == myTeam
	end
	if k.TeamColor ~= nil and plr.TeamColor ~= nil then
		local myTc = tostring(k.TeamColor)
		local thTc = tostring(plr.TeamColor)
		if myTc ~= "White" and myTc ~= "" and myTc == thTc then
			return true
		end
	end

	-- 3. Rivals Attributes (Auto Mode): TeamID, Team, Squad, Party
	local myTid = k:GetAttribute("TeamID") or k:GetAttribute("Team") or k:GetAttribute("Squad")
	local thTid = plr:GetAttribute("TeamID") or plr:GetAttribute("Team") or plr:GetAttribute("Squad")
	if not myTid and k.Character then
		myTid = k.Character:GetAttribute("TeamID") or k.Character:GetAttribute("Team")
	end
	if not thTid and plr.Character then
		thTid = plr.Character:GetAttribute("TeamID") or plr.Character:GetAttribute("Team")
	end

	if myTid ~= nil and thTid ~= nil and myTid ~= 0 and myTid ~= "" and myTid ~= "None" and myTid ~= "0" then
		if tostring(myTid) == tostring(thTid) then
			-- Ensure there is at least one other player with a different TeamID (avoids lobby/FFA shared ID)
			local hasDiff = false
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= k then
					local ot = other:GetAttribute("TeamID") or other:GetAttribute("Team")
					if ot ~= nil and tostring(ot) ~= tostring(myTid) and ot ~= 0 and ot ~= "0" then
						hasDiff = true
						break
					end
				end
			end
			if hasDiff then return true end
		else
			return false
		end
	end

	-- 4. NexusTeam Core Fallback
	if type(NT) == "table" and type(NT.IsTeammate) == "function" then
		local ok, res = pcall(NT.IsTeammate, plr)
		if ok and res then return true end
	end

	return false
end

