local rageDistance = 4
local rageBurstCount = 5
local rageAntiKatana = true
local rageAntiRecoil = true
local rageOrbitAngle = 0

-- [AntiFallDamage loop completely deleted - zero air floating, natural gravity restored]

local function triggerSafeTpKill()
	if isSafeTpKilling then return end
	local char = k.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return end

	local myRoot = hrp
	local bestTarget, bestDist = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= k and isPlayerAlive(p) and not isTeammate(p) then
			local tRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if tRoot then
				local d = (tRoot.Position - myRoot.Position).Magnitude
				if d < bestDist then
					bestDist = d
					bestTarget = p
				end
			end
		end
	end

	if not bestTarget or not bestTarget.Character then return end
	local tHRP = bestTarget.Character:FindFirstChild("HumanoidRootPart")
	local tHead = bestTarget.Character:FindFirstChild("HitboxHead") or bestTarget.Character:FindFirstChild("Head") or tHRP
	if not tHRP then return end

	isSafeTpKilling = true
	local originalCF = hrp.CFrame

	-- Teleport safely behind enemy
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.CFrame = tHRP.CFrame * CFrame.new(0, 1.2, 3.5)
	if tHead then
		Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHead.Position)
	end

	-- Lethal burst fire
	for i = 1, 6 do
		if mouse1click then mouse1click() end
		rageToolActivate()
		task.wait(0.015)
	end

	-- Safe return with zero velocity
	hrp.CFrame = originalCF
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hum.PlatformStand = false
	isSafeTpKilling = false
end

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.G then
		triggerSafeTpKill()
	end
end)


--[[ ==========================================================================
 v5.19 · RIVALS ULTRA RAGE · AUTO WEAPON
   · when rage turns on it equips weapon 1 (Backpack order)
   · when the ammo runs out it moves to weapon 2, then 3, ...
   · when everything is empty it teleports to space, refills, and comes back
   · then loop goto / burst continues from where it left off
 Hook-free: only Humanoid:EquipTool + the ammo values inside the tool.
 ]]
;(function()
	local Players = game:GetService("Players")
	local plr = Players.LocalPlayer
	local clock = os.clock

	local SKIP = {
		map = true, camera = true, ["radio"] = true, ["gamepass"] = true,
		["tool"] = true, ["item"] = true, ["pickaxe"] = true,
	}
	local AMMO_WORDS = { "ammo", "clip", "mag", "bullet", "round", "shell", "reserve", "shots" }
	local MAX_WORDS = { "max", "capacity", "size", "limit", "total" }

	local W = {
		Active = false,
		Index = 1,
		Tool = nil,
		List = {},
		Switches = 0, Refills = 0, SpaceRuns = 0,
		SpaceAlt = 3000, SpaceFor = 0.45, NextSpace = 0, LastGround = nil,
		Busy = false, NextScan = 0, LastSlot = nil,
	}
	getgenv().NexusArsenal = W

	--------------------------------------------------------------- helpers
	local function humanoid()
		local char = plr.Character
		return char and char:FindFirstChildOfClass("Humanoid"), char
	end

	local function backpack()
		return plr:FindFirstChild("Backpack")
	end

	local function isWeapon(tool)
		if not tool or not tool:IsA("Tool") then return false end
		local name = string.lower(tostring(tool.Name or ""))
		if SKIP[name] then return false end
		-- weapons either have a handle or carry an ammo / damage field
		if tool:FindFirstChild("Handle") then return true end
		local ok, has = pcall(function() return tool:FindFirstChildWhichIsA("BasePart") ~= nil end)
		return ok and has == true
	end

	local function numberValues(root)
		local found = {}
		if not root then return found end
		pcall(function()
			for _, child in ipairs(root:GetChildren()) do
				if child:IsA("ValueBase") and (child:IsA("IntValue") or child:IsA("NumberValue")) then
					found[#found + 1] = child
				end
			end
		end)
		return found
	end

	local function looksAmmo(name)
		local low = string.lower(tostring(name or ""))
		for _, word in ipairs(AMMO_WORDS) do
			if string.find(low, word, 1, true) then return true end
		end
		return false
	end

	local function looksMax(name)
		local low = string.lower(tostring(name or ""))
		for _, word in ipairs(MAX_WORDS) do
			if string.find(low, word, 1, true) then return true end
		end
		return false
	end

	-- current / max ammo of a tool, or nil when it is not an ammo weapon
	function W.AmmoOf(tool)
		if not tool then return nil end
		local current, maximum = nil, nil
		for _, value in ipairs(numberValues(tool)) do
			local name = value.Name
			if looksAmmo(name) then
				local num = tonumber(value.Value) or 0
				if looksMax(name) then
					maximum = num
				else
					if current == nil then current = num end
				end
			end
		end
		if current == nil then
			-- some games keep the count in an attribute instead of a value
			pcall(function()
				local attr = tool:GetAttribute("Ammo") or tool:GetAttribute("CurrentAmmo")
					or tool:GetAttribute("AmmoCount") or tool:GetAttribute("Clip")
				if attr ~= nil then current = tonumber(attr) or 0 end
				local amax = tool:GetAttribute("MaxAmmo") or tool:GetAttribute("MagSize")
					or tool:GetAttribute("ClipSize")
				if amax ~= nil then maximum = tonumber(amax) end
			end)
		end
		if current == nil then return nil end
		return current, maximum
	end

	function W.Empty(tool)
		local current = W.AmmoOf(tool)
		if current == nil then return false end -- not an ammo weapon: never "empty"
		return current <= 0
	end

	-- write the ammo back up; returns true when something actually changed
	function W.Refill(tool)
		if not tool then return false end
		local touched = false
		local current, maximum = W.AmmoOf(tool)
		local target = math.max(30, tonumber(maximum) or 0, tonumber(current) or 0)
		for _, value in ipairs(numberValues(tool)) do
			local name = value.Name
			if looksAmmo(name) and not looksMax(name) then
				pcall(function()
					value.Value = target
					touched = true
				end)
			end
		end
		pcall(function()
			if tool:GetAttribute("Ammo") ~= nil then tool:SetAttribute("Ammo", target); touched = true end
			if tool:GetAttribute("CurrentAmmo") ~= nil then tool:SetAttribute("CurrentAmmo", target); touched = true end
			if tool:GetAttribute("AmmoCount") ~= nil then tool:SetAttribute("AmmoCount", target); touched = true end
			if tool:GetAttribute("Clip") ~= nil then tool:SetAttribute("Clip", target); touched = true end
		end)
		if touched then W.Refills = (W.Refills or 0) + 1 end
		return touched
	end

	------------------------------------------------------------ the roster
	function W.Scan()
		W.List = {}
		local bag = backpack()
		local seen = {}
		local function add(tool)
			if tool and not seen[tool] and isWeapon(tool) then
				seen[tool] = true
				W.List[#W.List + 1] = tool
			end
		end
		if bag then
			for _, child in ipairs(bag:GetChildren()) do add(child) end
		end
		local _, char = humanoid()
		if char then
			for _, child in ipairs(char:GetChildren()) do
				if child:IsA("Tool") then add(child) end
			end
		end
		return #W.List
	end

	function W.CurrentTool()
		local _, char = humanoid()
		return char and char:FindFirstChildOfClass("Tool") or nil
	end

	function W.Equip(index)
		local hum = humanoid()
		if not hum then return false end
		local tool = W.List[index]
		if not tool or not tool.Parent then
			W.Scan()
			tool = W.List[index]
		end
		if not tool then return false end
		if tool.Parent ~= plr.Character then
			pcall(function() hum:EquipTool(tool) end)
		end
		W.Tool = tool
		W.Index = index
		return true
	end

	-------------------------------------------------------- the space refill
	local function dodge()
		local ok, d = pcall(function() return getgenv().NexusDodge end)
		if ok and type(d) == "table" then return d end
		return nil
	end

	-- teleport to space, refill the ammo, go back to the old spot (loop goto continues)
	function W.SpaceRefill()
		if W.Busy then return false end
		W.Busy = true
		pcall(function()
			W.Scan()
			for _, tool in ipairs(W.List) do W.Refill(tool) end
			W.SpaceRuns = (W.SpaceRuns or 0) + 1
		end)
		W.Busy = false
		pcall(function()
			if type(getgenv().nexusNotify) == "function" then
				getgenv().nexusNotify("Weapons: ammo refilled safely")
			end
		end)
		return true
	end

	------------------------------------------------------------ the cycle
	function W.NextWeapon()
		if #W.List == 0 then W.Scan() end
		if #W.List == 0 then return false end
		local from = W.Index or 1
		for step = 1, #W.List do
			local idx = ((from - 1 + step - 1) % #W.List) + 1
			local tool = W.List[idx]
			if tool and tool.Parent then
				local ammo = W.AmmoOf(tool)
				if ammo == nil or ammo > 0 then
					if W.Equip(idx) then
						W.Switches = (W.Switches or 0) + 1
						return true
					end
				end
			end
		end
		return false
	end

	function W.Start()
		W.Active = true
		W.Switches, W.Refills, W.SpaceRuns = 0, 0, 0
		W.NextScan, W.NextSpace = 0, 0
		W.LastGround = nil
		W.Scan()
		W.Index = 1
		W.Equip(1)
		return #W.List
	end

	function W.Stop()
		W.Active = false
		W.Busy = false
	end

	-- v6.2 · RIVALS HUD Ammo reader (0 require, reads PlayerGui Reserve/Ammo cleanly!)
	local VIM_A = game:GetService("VirtualInputManager")
	local function pressKeyCode(kc)
		pcall(function()
			VIM_A:SendKeyEvent(true, kc, false, game)
			task.wait(0.02)
			VIM_A:SendKeyEvent(false, kc, false, game)
		end)
	end

	local function readRivalsHudAmmo()
		local pg = plr:FindFirstChild("PlayerGui")
		if not pg then return nil end
		local ok, val = pcall(function()
			for _, v in ipairs(pg:GetDescendants()) do
				if v:IsA("Frame") and v.Visible then
					local reserve = v:FindFirstChild("Reserve")
					if reserve and v:FindFirstChild("Icon") and v:FindFirstChild("ItemName") then
						local ammoLbl = reserve:FindFirstChild("Ammo")
						if ammoLbl and ammoLbl:IsA("TextLabel") then
							return tonumber(tostring(ammoLbl.Text):match("%d+"))
						end
					end
				end
			end
			return nil
		end)
		return ok and val or nil
	end

	W.RivalsSlot = 1
	W.NextHudSwitch = 0

	-- one pass: supports BOTH classic Tools AND RIVALS ViewModel/HUD ammo (slot 1 -> slot 2 -> space reload!)
	function W.Tick()
		if not W.Active or W.Busy then return end
		local now = clock()
		local d = dodge()
		if d and type(d.IsInLobby) == "function" and d.IsInLobby() then return end

		if now >= (W.NextScan or 0) then
			W.NextScan = now + 0.75
			W.Scan()
		end

		-- Path A: Classic Tool-based games
		if #W.List > 0 then
			local held = W.CurrentTool()
			if not held or not held:IsDescendantOf(plr.Character or plr) then
				W.Equip(W.Index or 1)
				held = W.CurrentTool()
			end
			if not held then return end
			if not W.Empty(held) then return end
			if W.Refill(held) and not W.Empty(held) then return end
			if W.NextWeapon() then return end
			if now < (W.NextSpace or 0) then return end
			W.SpaceRefill()
			return
		end

		-- Path B: RIVALS ViewModel HUD Ammo (0 bullets -> swap Primary/Secondary -> Space Safe Reload with R!)
		local hudAmmo = readRivalsHudAmmo()
		if hudAmmo ~= nil and hudAmmo <= 0 and now >= (W.NextHudSwitch or 0) then
			W.NextHudSwitch = now + 0.55
			if W.RivalsSlot == 1 then
				W.RivalsSlot = 2
				W.Switches = (W.Switches or 0) + 1
				pressKeyCode(Enum.KeyCode.Two)
			else
				W.RivalsSlot = 1
				if now >= (W.NextSpace or 0) then
					-- Trigger safe space-reload: Dodge holds space + presses R so we reload with 0 damage taken!
					pressKeyCode(Enum.KeyCode.R)
					W.SpaceRefill()
					task.delay(math.max(0.25, (tonumber(W.SpaceFor) or 0.45) + 0.05), function()
						if W.Active then pressKeyCode(Enum.KeyCode.One) end
					end)
				else
					pressKeyCode(Enum.KeyCode.One)
				end
			end
		end
	end

	function W.Status()
		local held = W.CurrentTool()
		local ammo, max = W.AmmoOf(held)
		return string.format("weapons %s · slot %d/%d · %s · ammo %s · %d switches · %d refills · %d space runs",
			W.Active and "ON" or "OFF", W.Index or 0, #W.List,
			held and held.Name or "none",
			ammo and (tostring(ammo) .. (max and ("/" .. tostring(max)) or "")) or "—",
			W.Switches or 0, W.Refills or 0, W.SpaceRuns or 0)
	end

	-- driver: 4 Hz is plenty, it keeps the frame budget untouched
	getgenv().NexusArsenalStarted = (getgenv().NexusArsenalStarted or 0) + 1
	local id = getgenv().NexusArsenalStarted
	task.spawn(function()
		while getgenv().NexusArsenalStarted == id do
			task.wait(0.25)
			pcall(W.Tick)
		end
	end)
end)()

--[[ ==========================================================================
 v5.19 · RIVALS ULTRA RAGE · FX HUB  (hook-free · client-side visuals only)
   · screen HUD     : draggable chip top left, shows the live keybind,
                      a click opens / closes the menu
   · rage on        : rainbow ring + tracers ESP switch on automatically
   · crosshair      : NONE · the crosshair and the "+" button are deleted,
                      nothing is drawn in the middle of the screen
   · tracers ESP    : OFF by default, can be switched on by hand
   Nothing is hooked, no remote is touched: Drawing /
   Instance only. The chip text refreshes at 5 Hz, ring and tracers share one loop.
 ]]
;(function()
	local Players = game:GetService("Players")
	local UIS = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local plr = Players.LocalPlayer
	local clock = os.clock

	local FX = {
		RingOn = false, RingSize = 96, RingThickness = 2, RingSpin = true,
		TracerOn = false, TracerFrom = "Top", TracerThickness = 1.5,
		TracerRGB = true, TracerColor = Color3.fromRGB(255, 92, 132), TracerRange = 5000,
		MenuKey = Enum.KeyCode.RightShift, RageKey = Enum.KeyCode.P,
		SilentKey = Enum.KeyCode.B, EspKey = Enum.KeyCode.X,
		MenuOpen = true,
		Tracers = {},
	}
	getgenv().NexusFX = FX

	local function rainbow(t, speed)
		return Color3.fromHSV((t * (speed or 0.22)) % 1, 0.85, 1)
	end

	local function rootOf(char)
		if not char then return nil end
		return char:FindFirstChild("HumanoidRootPart")
			or char:FindFirstChild("UpperTorso")
			or char:FindFirstChild("Torso")
	end

	local function alive(char)
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		return hum ~= nil and (tonumber(hum.Health) or 0) > 0
	end

	local function guiFor(name, order)
		local g = Instance.new("ScreenGui")
		g.Name = name
		g.ResetOnSpawn = false
		g.IgnoreGuiInset = true
		g.DisplayOrder = order or 90
		pcall(function() g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end)
		pcall(function()
			if gethui then
				g.Parent = gethui()
			else
				g.Parent = game:GetService("CoreGui")
			end
		end)
		if not g.Parent then
			g.Parent = plr:FindFirstChild("PlayerGui") or plr:WaitForChild("PlayerGui")
		end
		return g
	end

	------------------------------------------------------------- HUD (chip)
	local hud = guiFor("NexusFXHud", 92)

	local chip = Instance.new("Frame")
	chip.Name = "Chip"
	chip.Size = UDim2.fromOffset(330, 26)
	chip.Position = UDim2.fromOffset(16, 16)
	chip.BackgroundColor3 = Color3.fromRGB(14, 11, 24)
	chip.BackgroundTransparency = 0.22
	chip.BorderSizePixel = 0
	chip.Active = true
	chip.Parent = hud
	Instance.new("UICorner", chip).CornerRadius = UDim.new(0, 8)
	local chipStroke = Instance.new("UIStroke", chip)
	chipStroke.Color = Color3.fromRGB(178, 102, 255)
	chipStroke.Thickness = 1
	chipStroke.Transparency = 0.35

	local dot = Instance.new("Frame")
	dot.Size = UDim2.fromOffset(7, 7)
	dot.Position = UDim2.fromOffset(11, 10)
	dot.BackgroundColor3 = Color3.fromRGB(120, 110, 145)
	dot.BorderSizePixel = 0
	dot.Parent = chip
	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

	local chipText = Instance.new("TextLabel")
	chipText.BackgroundTransparency = 1
	chipText.Position = UDim2.fromOffset(24, 0)
	chipText.Size = UDim2.new(1, -32, 1, 0)
	chipText.Font = Enum.Font.GothamBold
	chipText.TextSize = 11
	chipText.TextXAlignment = Enum.TextXAlignment.Left
	chipText.TextColor3 = Color3.fromRGB(206, 196, 232)
	chipText.Text = "Nx ultra rage · idle · Menu (RShift)"
	chipText.Parent = chip

	------------------------------------------------------------ rage ring
	local ring = Instance.new("Frame")
	ring.Name = "RageRing"
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.new(0.5, 0, 0.5, 0)
	ring.Size = UDim2.fromOffset(FX.RingSize, FX.RingSize)
	ring.BackgroundTransparency = 1
	ring.BorderSizePixel = 0
	ring.Visible = false
	local ringGui = guiFor("NexusRageRing", 91)
	ring.Parent = ringGui
	Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
	local ringStroke = Instance.new("UIStroke", ring)
	ringStroke.Thickness = FX.RingThickness
	ringStroke.Transparency = 0.1
	local ringGlow = Instance.new("UIStroke", ring)
	ringGlow.Thickness = FX.RingThickness + 3
	ringGlow.Transparency = 0.8
	local ringGrad = Instance.new("UIGradient", ring)
	pcall(function()
		ringGrad.Color = ColorSequence.new{
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 92, 132)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(178, 102, 255)),
			ColorSequenceKeypoint.new(0.50, Color3.fromRGB(102, 178, 255)),
			ColorSequenceKeypoint.new(0.75, Color3.fromRGB(126, 247, 198)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 92, 132)),
		}
	end)
	pcall(function() ringGrad.Rotation = 0 end)

	-------------------------------------------------------------- menu api
	local function libLib()
		local lib = getgenv().__NexusSkinLib or getgenv().Library
		if type(lib) == "table" then return lib end
		return nil
	end

	local function menuState()
		local lib = libLib()
		if lib and lib.Toggled ~= nil then
			FX.MenuOpen = lib.Toggled == true
		end
		return FX.MenuOpen
	end
	FX.MenuState = menuState

	local function setMenu(open)
		open = open and true or false
		FX.MenuOpen = open
		local lib = libLib()
		if lib and type(lib.Toggle) == "function" then
			pcall(function()
				if lib.Toggled ~= open then lib:Toggle(open) end
			end)
		end
		return open
	end
	FX.SetMenu = setMenu

	-- v5.28 · ONE handler only.
	-- The library used to read the same key as the FX hub, so RightShift ran
	-- both toggles in the same frame and the window opened and shut again -
	-- that is why the menu key "did nothing". The library key is parked on
	-- Unknown here (its comparison now ignores Unknown, so a mouse click can
	-- never match it) and the FX hub is the single owner of the key.
	do
		local lib = libLib()
		if lib then pcall(function() lib.ToggleKeybind = Enum.KeyCode.Unknown end) end
	end

	----------------------------------------------------------------- tracers
	local function tracerFor(p)
		local line = FX.Tracers[p]
		if line then return line end
		if not Drawing or type(Drawing.new) ~= "function" then return nil end
		local ok, made = pcall(function()
			local l = Drawing.new("Line")
			l.Thickness = tonumber(FX.TracerThickness) or 1.5
			l.Transparency = 1
			l.Visible = false
			return l
		end)
		if not ok or not made then return nil end
		FX.Tracers[p] = made
		return made
	end

	local function dropTracer(p)
		local line = FX.Tracers[p]
		if line then pcall(function() line:Remove() end) end
		FX.Tracers[p] = nil
	end
	FX.DropTracer = dropTracer

	local function tracerOrigin()
		local camera = workspace.CurrentCamera
		local vp = camera and camera.ViewportSize or Vector2.new(1280, 720)
		if FX.TracerFrom == "Bottom" then
			return Vector2.new(vp.X / 2, vp.Y)
		elseif FX.TracerFrom == "Mouse" then
			local spot = nil
			pcall(function() spot = UIS:GetMouseLocation() end)
			if spot then return Vector2.new(spot.X, spot.Y) end
		end
		return Vector2.new(vp.X / 2, 0)
	end

	local function tracerStep(t)
		for p in pairs(FX.Tracers) do
			local gone = true
			pcall(function() gone = p.Parent == nil end)
			if gone then dropTracer(p) end
		end
		if not FX.TracerOn then
			for _, line in pairs(FX.Tracers) do
				pcall(function() line.Visible = false end)
			end
			return
		end
		local camera = workspace.CurrentCamera
		if not camera then return end
		local from = tracerOrigin()
		local all = Players:GetPlayers()
		for i = 1, #all do
			local other = all[i]
			if other ~= plr then
				local char = other.Character
				local root = rootOf(char)
				local line = FX.Tracers[other]
				if root and alive(char) then
					local dist = (root.Position - camera.CFrame.Position).Magnitude
					if dist <= (tonumber(FX.TracerRange) or 5000) then
						line = line or tracerFor(other)
						if line then
							local screen, onScreen = camera:WorldToViewportPoint(root.Position)
							local col = FX.TracerRGB
								and rainbow(t + (i * 0.06), 0.22) or FX.TracerColor
							pcall(function()
								line.From = from
								line.To = Vector2.new(screen.X, screen.Y)
								line.Color = col
								line.Thickness = tonumber(FX.TracerThickness) or 1.5
								-- onScreen is false only when the game says so
								line.Visible = (screen.Z or 0) > 0 and (onScreen ~= false)
							end)
						end
					elseif line then
						pcall(function() line.Visible = false end)
					end
				elseif line then
					pcall(function() line.Visible = false end)
				end
			end
		end
	end

	---------------------------------------------------------- on / off APIs
	local function setRing(on)
		FX.RingOn = on and true or false
		if not FX.RingOn then ring.Visible = false end
		return FX.RingOn
	end
	local function setTracers(on)
		FX.TracerOn = on and true or false
		if not FX.TracerOn then
			for _, line in pairs(FX.Tracers) do
				pcall(function() line.Visible = false end)
			end
		end
		return FX.TracerOn
	end
	FX.SetRing = setRing
	FX.SetTracers = setTracers

	-- rage on -> ring + tracers on; rage off -> the user's own choice comes back
	local RageFx = { Applied = false, Ring = false, Tracer = false, Rage = false }
	function FX.PushRage(on)
		on = on and true or false
		RageFx.Rage = on
		if on and not RageFx.Applied then
			RageFx.Applied = true
			RageFx.Ring = FX.RingOn
			RageFx.Tracer = FX.TracerOn
			setRing(true)
			setTracers(true)
		elseif not on and RageFx.Applied then
			RageFx.Applied = false
			setRing(RageFx.Ring)
			setTracers(RageFx.Tracer)
		end
	end
	FX.Rage = RageFx

	---------------------------------------------------------------- keybinds
	local NAMES = {
		RightShift = "RShift", LeftShift = "LShift", RightControl = "RCtrl",
		LeftControl = "LCtrl", LeftAlt = "LAlt", RightAlt = "RAlt",
		Backquote = "`", Minus = "-", Equals = "=", Unknown = "—",
		Capital = "Caps", Space = "Space", Tab = "Tab", Escape = "Esc",
	}
	local function keyName(code)
		if code == nil then return "—" end
		if type(code) == "table" or type(code) == "userdata" then
			pcall(function() code = code.Name end)
		end
		if type(code) ~= "string" then return "—" end
		return NAMES[code] or code
	end
	FX.KeyName = keyName

	local function setToggle(name, value)
		local hit = false
		pcall(function()
			local bags = {}
			if type(Toggles) == "table" then table.insert(bags, Toggles) end
			if Library and type(Library.Toggles) == "table" then table.insert(bags, Library.Toggles) end
			for _, bag in ipairs(bags) do
				local t = bag[name]
				if t then
					if type(t.SetValue) == "function" then pcall(function() t:SetValue(value) end) end
					if type(t.Set) == "function" then pcall(function() t:Set(value, true) end) end
					pcall(function() t.Value = value end)
					hit = true
				end
			end
		end)
		return hit
	end
	FX.SetToggle = setToggle

	FX.PickNext = nil
	FX.Binding = nil
	function FX.PickNext(field, done)
		FX.Binding = { Field = field, Done = done }
	end

	local function applyBinding(code)
		local b = FX.Binding
		FX.Binding = nil
		if not b then return false end
		if code == Enum.KeyCode.Escape then
			if b.Done then pcall(b.Done, nil) end
			return true
		end
		FX[b.Field] = code
		if b.Done then pcall(b.Done, code) end
		return true
	end

	FX.InputBegan = UIS.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		local typed = false
		pcall(function() typed = UIS:GetFocusedTextBox() ~= nil end)
		if typed then return end
		local code = input.KeyCode
		if code == Enum.KeyCode.Unknown then return end
		if FX.Binding then
			applyBinding(code)
			return
		end
		if code == FX.MenuKey then
			setMenu(not menuState())
		elseif code == FX.RageKey then
			pcall(function() if type(toggleRageMode) == "function" then toggleRageMode() end end)
		elseif code == FX.SilentKey then
			pcall(function()
				silentEnabled = not silentEnabled
				setToggle("SilentAim", silentEnabled)
				if _G.SilentAim and _G.SilentAim.Toggle then _G.SilentAim.Toggle(silentEnabled) end
			end)
		elseif code == FX.EspKey then
			pcall(function()
				ESP_CONFIG.Enabled = not ESP_CONFIG.Enabled
				setToggle("EspEnabled", ESP_CONFIG.Enabled)
			end)
		end
	end)

	------------------------------------------------------------------ drag it
	do
		local dragging, start, origin = false, nil, nil
		chip.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				start = UIS:GetMouseLocation()
				origin = chip.Position
			end
		end)
		UIS.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				local now = UIS:GetMouseLocation()
				chip.Position = UDim2.new(
					origin.X.Scale, origin.X.Offset + (now.X - start.X),
					origin.Y.Scale, origin.Y.Offset + (now.Y - start.Y))
			end
		end)
		UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
	end

	-- chip: drag to move, a short click opens / closes the menu
	do
		local down, moved, start, origin = nil, false, nil, nil
		chip.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				down = clock()
				moved = false
				start = UIS:GetMouseLocation()
				origin = chip.Position
			end
		end)
		UIS.InputChanged:Connect(function(input)
			if not down then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				local now = UIS:GetMouseLocation()
				local dx, dy = now.X - start.X, now.Y - start.Y
				if not moved and (math.abs(dx) + math.abs(dy)) > 6 then moved = true end
				if moved then
					chip.Position = UDim2.new(
						origin.X.Scale, origin.X.Offset + dx,
						origin.Y.Scale, origin.Y.Offset + dy)
				end
			end
		end)
		UIS.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				if down and not moved and (clock() - down) < 0.6 then
					setMenu(not menuState())
				end
				down = nil
				moved = false
			end
		end)
	end


	------------------------------------------------------------------ driver
	FX.Chip = chip
	FX.ChipText = chipText
	FX.Ring = ring
	local lastChip, fpsSmooth, chipClock = nil, 60, 0
	FX.Step = function(dt)
		local t = clock()
		if dt and dt > 0.001 and dt < 1 then
			fpsSmooth = fpsSmooth + ((1 / dt) - fpsSmooth) * 0.08
		end
		-- ring
		if FX.RingOn then
			ring.Visible = true
			local size = tonumber(FX.RingSize) or 96
			ring.Size = UDim2.fromOffset(size, size)
			local thick = tonumber(FX.RingThickness) or 2
			ringStroke.Thickness = thick
			ringGlow.Thickness = thick + 3
			if FX.RingSpin then ringGrad.Rotation = (t * 90) % 360 end
			local col = rainbow(t, 0.18)
			ringStroke.Color = col
			ringGlow.Color = col
		elseif ring.Visible then
			ring.Visible = false
		end
		pcall(tracerStep, t)
		-- chip text: 5 Hz, driven by the frame delta so it never misses
		-- a real frame delta is used when there is one; a stalled delta
		-- (instant frames / tests) falls back to a nominal 60 fps step
		chipClock = chipClock + ((dt and dt > 0.0001) and dt or (1 / 60))
		if chipClock >= 0.2 then
			chipClock = 0
			local rageOn = rageModeEnabled == true
			local text = string.format("Nx ultra rage · %s · Menu %s (%s) · %dfps",
				rageOn and "RAGE BOT" or "idle",
				open and "OPEN" or "closed",
				keyName(FX.MenuKey),
				math.floor(fpsSmooth + 0.5))
			if text ~= lastChip then
				chipText.Text = text
				lastChip = text
			end
			dot.BackgroundColor3 = rageOn and Color3.fromRGB(244, 63, 94) or Color3.fromRGB(120, 110, 145)
			chipText.TextColor3 = rageOn and Color3.fromRGB(255, 138, 160) or Color3.fromRGB(206, 196, 232)
			chipStroke.Transparency = rageOn and 0.15 or 0.35
		end
	end

	getgenv().NexusFXStarted = (getgenv().NexusFXStarted or 0) + 1
	local fxId = getgenv().NexusFXStarted
	task.spawn(function()
		local prev = clock()
		while getgenv().NexusFXStarted == fxId do
			local now = clock()
			local dt = now - prev
			prev = now
			if FX.Step then pcall(FX.Step, dt) end
			task.wait()
		end
		pcall(function()
			if FX.InputBegan and FX.InputBegan.Disconnect then FX.InputBegan:Disconnect() end
			for p in pairs(FX.Tracers) do dropTracer(p) end
			if hud then hud:Destroy() end
			if ringGui then ringGui:Destroy() end
		end)
	end)

	FX.Destroy = function()
		getgenv().NexusFXStarted = (getgenv().NexusFXStarted or 0) + 1
		pcall(function()
			if FX.InputBegan and FX.InputBegan.Disconnect then FX.InputBegan:Disconnect() end
			for p in pairs(FX.Tracers) do dropTracer(p) end
			if hud then hud:Destroy() end
			if ringGui then ringGui:Destroy() end
		end)
		getgenv().NexusFX = nil
	end
end)()

